#, kde-format
msgid "layout unify works on the whole document; leave --pages off."
msgstr "layout unify agit sur tout le document ; n'indiquez pas --pages."

#: src/cli/CommandsLayout.cpp:502
#, kde-format
msgid "Brought every page to one size. Wrote %1."
msgstr "Toutes les pages ont été ramenées à une seule taille. %1 a été écrit."

#: src/cli/CommandsLayout.cpp:514
#, kde-format
msgid ""
"layout bleed needs a bleed (--bleed), in millimetres. Three is the usual "
"answer."
msgstr ""
"layout bleed a besoin d'un fond perdu (--bleed), en millimètres. Trois "
"est la valeur habituelle."

#: src/cli/CommandsLayout.cpp:520 src/cli/CommandsLayout.cpp:568
#: src/cli/CommandsLayout.cpp:574 src/cli/CommandsLayout.cpp:700
#, kde-format
msgid ""
"“%1” is not a length. Give millimetres, or a number with mm, cm, in or pt "
"after it."
msgstr ""
"« %1 » n'est pas une longueur. Indiquez des millimètres, ou un nombre "
"suivi de mm, cm, in ou pt."

#: src/cli/CommandsLayout.cpp:537
#, kde-format
msgctxt "@info"
msgid "Gave %1 page a %2 mm bleed."
msgid_plural "Gave %1 pages a %2 mm bleed."
msgstr[0] "Un fond perdu de %2 mm a été donné à %1 page."
msgstr[1] "Un fond perdu de %2 mm a été donné à %1 pages."

#: src/cli/CommandsLayout.cpp:540
#, kde-format
msgid ""
"The trim is what the pages showed before; the sheet grew where it had to. "
"Wrote %1."
msgstr ""
"La zone de rogne correspond à ce que les pages montraient auparavant ; la "
"feuille s'est agrandie là où il le fallait. %1 a été écrit."

#: src/cli/CommandsLayout.cpp:555
#, kde-format
msgid "layout marks marks every page; leave --pages off."
msgstr "layout marks marque toutes les pages ; n'indiquez pas --pages."

#: src/cli/CommandsLayout.cpp:560
#, kde-format
msgid ""
"“%1” is not a list of marks. Use crop, registration, colour-bar, "
"page-info or all, separated by commas."
msgstr ""
"« %1 » n'est pas une liste de repères. Utilisez crop, registration, "
"colour-bar, page-info ou all, séparés par des virgules."

#: src/cli/CommandsLayout.cpp:580
#, kde-format
msgid ""
"“%1” is not a length. Give points, or a number with mm, cm, in or pt "
"after it."
msgstr ""
"« %1 » n'est pas une longueur. Indiquez des points, ou un nombre suivi de "
"mm, cm, in ou pt."

#: src/cli/CommandsLayout.cpp:594 src/ui/ToolLayoutDialog.cpp:909
#, kde-format
msgctxt "@item a kind of printer's mark"
msgid "crop marks"
msgstr "traits de coupe"

#: src/cli/CommandsLayout.cpp:597 src/ui/ToolLayoutDialog.cpp:912
#, kde-format
msgctxt "@item a kind of printer's mark"
msgid "registration marks"
msgstr "repères de repérage"

#: src/cli/CommandsLayout.cpp:600 src/ui/ToolLayoutDialog.cpp:915
#, kde-format
msgctxt "@item a kind of printer's mark"
msgid "colour bars"
msgstr "barres de couleurs"

#: src/cli/CommandsLayout.cpp:603 src/ui/ToolLayoutDialog.cpp:918
#, kde-format
msgctxt "@item a kind of printer's mark"
msgid "page information"
msgstr "informations de page"

#: src/cli/CommandsLayout.cpp:606 src/ui/ToolLayoutDialog.cpp:933
#, kde-format
msgid "Added %1, %2 mm outside the trim."
msgstr "Ajout de %1, à %2 mm à l'extérieur de la zone de rogne."

#: src/cli/CommandsLayout.cpp:624
#, kde-format
msgid ""
"“%1” is not a place to cut. Give a fraction between 0 and 1, for example "
"0.5 for the middle."
msgstr ""
"« %1 » n'est pas un endroit où couper. Indiquez une fraction entre 0 et "
"1, par exemple 0.5 pour le milieu."

#: src/cli/CommandsLayout.cpp:643
#, kde-format
msgctxt "@info"
msgid "Cut %1 page in two."
msgid_plural "Cut %1 pages in two."
msgstr[0] "%1 page a été coupée en deux."
msgstr[1] "%1 pages ont été coupées en deux."

#: src/cli/CommandsLayout.cpp:644
#, kde-format
msgid "Left half first, then the right. Wrote %1."
msgstr "La moitié gauche d'abord, puis la droite. %1 a été écrit."

#: src/cli/CommandsLayout.cpp:645
#, kde-format
msgid "Top half first, then the bottom. Wrote %1."
msgstr "La moitié haute d'abord, puis la basse. %1 a été écrit."

#: src/cli/CommandsLayout.cpp:653
#, kde-format
msgid "layout overlay needs two files: the document, then what to lay over it."
msgstr ""
"layout overlay a besoin de deux fichiers : le document, puis ce qu'il "
"faut poser dessus."

#: src/cli/CommandsLayout.cpp:658 src/cli/Common.cpp:46 src/cli/main.cpp:74
#: src/core/Archival.cpp:606 src/core/Compressor.cpp:208
#: src/core/Convert.cpp:2178 src/core/Convert.cpp:2324
#: src/core/Preflight.cpp:2599
#, kde-format
msgid "“%1” does not exist."
msgstr "« %1 » n'existe pas."

#: src/cli/CommandsLayout.cpp:674
#, kde-format
msgid "Laid %1 over %2. Wrote %3."
msgstr "%1 a été posé sur %2. %3 a été écrit."

#: src/cli/CommandsLayout.cpp:687
#, kde-format
msgid "layout poster needs a sheet size (--size), for example a4 or 210x297mm."
msgstr ""
"layout poster a besoin d'une taille de feuille (--size), par exemple a4 "
"ou 210x297mm."

#: src/cli/CommandsLayout.cpp:720
#, kde-format
msgid "Tiled page %2 across %1 sheet."
msgid_plural "Tiled page %2 across %1 sheets."
msgstr[0] "La page %2 a été répartie sur %1 feuille."
msgstr[1] "La page %2 a été répartie sur %1 feuilles."

#: src/cli/CommandsLayout.cpp:721
#, kde-format
msgid ""
"The page is tiled at its own size. Resize it first for a bigger poster. "
"Wrote %1."
msgstr ""
"La page est répartie à sa propre taille. Redimensionnez-la d'abord pour "
"obtenir une affiche plus grande. %1 a été écrit."

#: src/cli/CommandsLayout.cpp:742
#, kde-format
msgid ""
"Reordered into printer's spreads. Run “nup --per-sheet 2” over this to "
"get the sheets themselves."
msgstr ""
"Les pages ont été réordonnées en planches d'imposition. Lancez « nup "
"--per-sheet 2 » sur ce résultat pour obtenir les feuilles elles-mêmes."

#: src/cli/CommandsLayout.cpp:744 src/ui/ToolLayoutDialog.cpp:1161
#, kde-format
msgid "Put the pages back into reading order."
msgstr "Les pages ont été remises dans l'ordre de lecture."

#: src/cli/CommandsLayout.cpp:777 src/ui/ToolLayoutDialog.cpp:1278
#, kde-format
msgid ""
"This document has no page labels, so readers show the physical page "
"numbers."
msgstr ""
"Ce document n'a pas d'étiquettes de page ; les lecteurs affichent donc "
"les numéros de page physiques."

#: src/cli/CommandsLayout.cpp:781 src/ui/ToolLayoutDialog.cpp:1286
#, kde-format
msgctxt "@info physical page number, then the label the reader shows"
msgid "Page %1: %2"
msgstr "Page %1 : %2"

#: src/cli/CommandsLayout.cpp:798
#, kde-format
msgid ""
"layout set-labels needs at least one --page-label, as "
"PAGE:STYLE[:PREFIX[:START]]."
msgstr ""
"layout set-labels a besoin d'au moins un --page-label, sous la forme "
"PAGE:STYLE[:PRÉFIXE[:DÉBUT]]."

#: src/cli/CommandsLayout.cpp:806
#, kde-format
msgid ""
"“%1” is not a page label. The form is PAGE:STYLE[:PREFIX[:START]], for "
"example 1:roman-lower or 9:decimal:A-:1."
msgstr ""
"« %1 » n'est pas une étiquette de page. La forme est "
"PAGE:STYLE[:PRÉFIXE[:DÉBUT]], par exemple 1:roman-lower ou 9:decimal:A-:1."

#: src/cli/CommandsLayout.cpp:821
#, kde-format
msgid ""
"“%1” is not a numbering style. Use decimal, roman-upper, roman-lower, "
"letter-upper, letter-lower or none."
msgstr ""
"« %1 » n'est pas un style de numérotation. Utilisez decimal, roman-upper, "
"roman-lower, letter-upper, letter-lower ou none."

#: src/cli/CommandsLayout.cpp:832
#, kde-format
msgid "“%1” is not a number to start at."
msgstr "« %1 » n'est pas un nombre de départ."

#: src/cli/CommandsLayout.cpp:845
#, kde-format
msgctxt "@info"
msgid "Wrote %1 numbering range."
msgid_plural "Wrote %1 numbering ranges."
msgstr[0] "%1 intervalle de numérotation a été écrit."
msgstr[1] "%1 intervalles de numérotation ont été écrits."

#: src/cli/CommandsLayout.cpp:861
#, kde-format
msgid "“%1” is not a number of painting operators."
msgstr "« %1 » n'est pas un nombre d'opérateurs de dessin."

#: src/cli/CommandsLayout.cpp:884 src/ui/ToolLayoutDialog.cpp:1418
#, kde-format
msgid "Every page paints something."
msgstr "Toutes les pages dessinent quelque chose."

#: src/cli/CommandsLayout.cpp:887
#, kde-format
msgctxt "@info"
msgid "%1 page paints nothing: %2"
msgid_plural "%1 pages paint nothing: %2"
msgstr[0] "%1 page ne dessine rien : %2"
msgstr[1] "%1 pages ne dessinent rien : %2"

#: src/cli/CommandsLayout.cpp:890
#, kde-format
msgid "Take them out with “layout remove --pages %1”."
msgstr "Retirez-les avec « layout remove --pages %1 »."

#: src/cli/CommandsLayout.cpp:904
#, kde-format
msgid "layout remove needs the pages to take out (--pages), e.g. 3,7-9."
msgstr "layout remove a besoin des pages à retirer (--pages), p. ex. 3,7-9."

#: src/cli/CommandsLayout.cpp:919
#, kde-format
msgctxt "@info"
msgid "Took out %1 page."
msgid_plural "Took out %1 pages."
msgstr[0] "%1 page a été retirée."
msgstr[1] "%1 pages ont été retirées."

#: src/cli/CommandsLayout.cpp:927
#, kde-format
msgid "layout limits takes no arguments."
msgstr "layout limits ne prend aucun argument."

#: src/cli/CommandsLayout.cpp:929
#, kde-format
msgctxt "@title heading before a list"
msgid "What page layout cannot promise:"
msgstr "Ce que la mise en page ne peut pas garantir :"

#: src/cli/CommandsLayout.cpp:943
#, kde-format
msgid "How content lands on a new sheet: scale, centre or shrink."
msgstr ""
"Comment le contenu se place sur une nouvelle feuille : scale, centre ou "
"shrink."

#: src/cli/CommandsLayout.cpp:946
#, kde-format
msgid ""
"Bleed in millimetres. On “marks”, how far outside the trim the marks sit."
msgstr ""
"Fond perdu en millimètres. Avec « marks », la distance des repères à "
"l'extérieur de la zone de rogne."

#: src/cli/CommandsLayout.cpp:949
#, kde-format
msgid ""
"Printer's marks to add: crop, registration, colour-bar, page-info or all."
msgstr ""
"Repères d'impression à ajouter : crop, registration, colour-bar, "
"page-info ou all."

#: src/cli/CommandsLayout.cpp:951
#, kde-format
msgid "How long a crop mark is, in millimetres."
msgstr "La longueur d'un trait de coupe, en millimètres."

#: src/cli/CommandsLayout.cpp:953
#, kde-format
msgid "How thick a printer's mark is, in points."
msgstr "L'épaisseur d'un repère d'impression, en points."

#: src/cli/CommandsLayout.cpp:956
#, kde-format
msgid ""
"New /MediaBox as X,Y,WIDTH,HEIGHT in points from the bottom-left corner."
msgstr ""
"Nouvelle /MediaBox, sous la forme X,Y,LARGEUR,HAUTEUR en points depuis le "
"coin inférieur gauche."

#: src/cli/CommandsLayout.cpp:958
#, kde-format
msgid "New /CropBox, or “none” to take it away."
msgstr "Nouvelle /CropBox, ou « none » pour la retirer."

#: src/cli/CommandsLayout.cpp:960
#, kde-format
msgid "New /BleedBox, or “none” to take it away."
msgstr "Nouvelle /BleedBox, ou « none » pour la retirer."

#: src/cli/CommandsLayout.cpp:962
#, kde-format
msgid "New /TrimBox, or “none” to take it away."
msgstr "Nouvelle /TrimBox, ou « none » pour la retirer."

#: src/cli/CommandsLayout.cpp:964
#, kde-format
msgid "New /ArtBox, or “none” to take it away."
msgstr "Nouvelle /ArtBox, ou « none » pour la retirer."

#: src/cli/CommandsLayout.cpp:966
#, kde-format
msgid "Where to cut a page in two, as a fraction."
msgstr "L'endroit où couper une page en deux, sous forme de fraction."

#: src/cli/CommandsLayout.cpp:969
#, kde-format
msgid "Cut into a top and a bottom half instead of a left and a right."
msgstr ""
"Couper en une moitié haute et une moitié basse au lieu d'une gauche et "
"d'une droite."

#: src/cli/CommandsLayout.cpp:971
#, kde-format
msgid "Start the overlay again when it runs out, for a letterhead."
msgstr ""
"Recommencer la superposition quand elle est épuisée, pour un papier à "
"en-tête."

#: src/cli/CommandsLayout.cpp:972
#, kde-format
msgid "How far poster sheets overlap, in millimetres."
msgstr "Le recouvrement des feuilles de l'affiche, en millimètres."

#: src/cli/CommandsLayout.cpp:974
#, kde-format
msgid "Draw the cut line and number each poster sheet."
msgstr "Dessiner la ligne de coupe et numéroter chaque feuille de l'affiche."

#: src/cli/CommandsLayout.cpp:976
#, kde-format
msgid "A numbering range, as PAGE:STYLE[:PREFIX[:START]]. Repeat for more."
msgstr ""
"Un intervalle de numérotation, sous la forme "
"PAGE:STYLE[:PRÉFIXE[:DÉBUT]]. À répéter pour en ajouter d'autres."

#: src/cli/CommandsLayout.cpp:979
#, kde-format
msgid "How much painting a page may still hold and count as blank."
msgstr ""
"La quantité de dessin qu'une page peut encore contenir tout en comptant "
"comme vierge."

#: src/cli/CommandsLayout.cpp:981
#, kde-format
msgid "Turn printer's spreads back into reading order."
msgstr "Remettre les cahiers d'imprimeur dans l'ordre de lecture."

#: src/cli/CommandsLayout.cpp:992
#, kde-format
msgctxt "@info a list of the actions “layout” takes"
msgid ""
"boxes, set-boxes, resize, unify, bleed, marks, split, overlay, poster, "
"booklet, labels, set-labels, blanks, remove or limits"
msgstr ""
"boxes, set-boxes, resize, unify, bleed, marks, split, overlay, poster, "
"booklet, labels, set-labels, blanks, remove ou limits"

#: src/cli/CommandsLayout.cpp:995
#, kde-format
msgid "layout needs something to do: %1."
msgstr "layout a besoin d'une action : %1."

#: src/cli/CommandsLayout.cpp:1047
#, kde-format
msgid "“layout %1” is not something layout does. Try %2."
msgstr "« layout %1 » n'est pas une action de layout. Essayez %2."

#: src/cli/CommandsLayout.cpp:1056
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout boxes      FILE                 Show the five page boxes, and "
"which are absent"
msgstr ""
"  layout boxes      FICHIER              Afficher les cinq zones de la "
"page, et celles qui manquent"

#: src/cli/CommandsLayout.cpp:1058
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout set-boxes  FILE      -o OUT     Write /MediaBox, /CropBox, "
"/BleedBox, /TrimBox, /ArtBox"
msgstr ""
"  layout set-boxes  FICHIER   -o SORTIE  Écrire /MediaBox, /CropBox, "
"/BleedBox, /TrimBox, /ArtBox"

#: src/cli/CommandsLayout.cpp:1060
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout resize     FILE      -o OUT     Put the pages on a different "
"paper size"
msgstr ""
"  layout resize     FICHIER   -o SORTIE  Placer les pages sur un autre "
"format de papier"

#: src/cli/CommandsLayout.cpp:1062
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout unify      FILE      -o OUT     Bring every page to one size"
msgstr ""
"  layout unify      FICHIER   -o SORTIE  Ramener toutes les pages à une "
"seule taille"

#: src/cli/CommandsLayout.cpp:1064
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout bleed      FILE      -o OUT     Give the pages a bleed, growing "
"the sheet"
msgstr ""
"  layout bleed      FICHIER   -o SORTIE  Ajouter un fond perdu aux pages, "
"en agrandissant la feuille"

#: src/cli/CommandsLayout.cpp:1066
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout marks      FILE      -o OUT     Add printer's marks outside the "
"trim"
msgstr ""
"  layout marks      FICHIER   -o SORTIE  Ajouter des repères d'impression "
"hors de la zone de rogne"

#: src/cli/CommandsLayout.cpp:1068
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout split      FILE      -o OUT     Cut each page in two, for "
"scanned books"
msgstr ""
"  layout split      FICHIER   -o SORTIE  Couper chaque page en deux, pour "
"les livres numérisés"

#: src/cli/CommandsLayout.cpp:1070
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout overlay    BASE OVER -o OUT     Lay one document over another"
msgstr ""
"  layout overlay    BASE DESSUS -o SORTIE Superposer un document à un "
"autre"

#: src/cli/CommandsLayout.cpp:1072
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout poster     FILE      -o OUT     Tile one page across several "
"sheets"
msgstr ""
"  layout poster     FICHIER   -o SORTIE  Répartir une page en mosaïque "
"sur plusieurs feuilles"

#: src/cli/CommandsLayout.cpp:1074
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout booklet    FILE      -o OUT     Reorder pages into printer's "
"spreads"
msgstr ""
"  layout booklet    FICHIER   -o SORTIE  Réordonner les pages en cahiers "
"d'imprimeur"

#: src/cli/CommandsLayout.cpp:1076
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout labels     FILE                 Show the numbers the reader "
"displays"
msgstr ""
"  layout labels     FICHIER              Afficher les numéros que le "
"lecteur affiche"

#: src/cli/CommandsLayout.cpp:1078
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout set-labels FILE      -o OUT     Write /PageLabels, e.g. i, ii, "
"iii and then 1"
msgstr ""
"  layout set-labels FICHIER   -o SORTIE  Écrire /PageLabels, par exemple "
"i, ii, iii puis 1"

#: src/cli/CommandsLayout.cpp:1080
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout blanks     FILE                 Find pages that paint nothing"
msgstr ""
"  layout blanks     FICHIER              Trouver les pages qui ne "
"dessinent rien"

#: src/cli/CommandsLayout.cpp:1082
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout remove     FILE      -o OUT     Take pages out"
msgstr "  layout remove     FICHIER   -o SORTIE  Retirer des pages"

#: src/cli/CommandsLayout.cpp:1084
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout limits                          What page layout cannot promise"
msgstr ""
"  layout limits                          Ce que la mise en page ne peut "
"pas garantir"

