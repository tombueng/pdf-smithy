#: src/ui/ToolFormBuilderDialog.cpp:1515
#, kde-format
msgid "“%1” cannot be worked out from itself."
msgstr "« %1 » ne peut pas être calculé à partir de lui-même."

#: src/ui/ToolFormBuilderDialog.cpp:1533
#, kde-format
msgid "“%2” is now the %3 of one field."
msgid_plural "“%2” is now the %3 of %1 fields."
msgstr[0] "« %2 » se calcule maintenant ainsi : %3 d'un champ."
msgstr[1] "« %2 » se calcule maintenant ainsi : %3 de %1 champs."

#: src/ui/ToolFormBuilderDialog.cpp:1546
#, kde-format
msgid ""
"Say which button this is about. A document with no push button on it has "
"nothing to press."
msgstr ""
"Indiquez de quel bouton il s'agit. Un document sans aucun bouton n'a rien "
"sur quoi appuyer."

#: src/ui/ToolFormBuilderDialog.cpp:1555
#, kde-format
msgid "Say where it sends or goes: an address, or a page number."
msgstr ""
"Indiquez où il envoie ou bien où il mène : une adresse, ou un numéro de "
"page."

#: src/ui/ToolFormBuilderDialog.cpp:1571
#, kde-format
msgctxt "@info a button and what pressing it now does"
msgid "Pressing “%1” now does this: %2."
msgstr "Appuyer sur « %1 » fait maintenant ceci : %2."

#: src/ui/ToolFormBuilderDialog.cpp:1583
#, kde-format
msgctxt "@title:group"
msgid "Take the answers out"
msgstr "Extraire les réponses"

#: src/ui/ToolFormBuilderDialog.cpp:1584
#, kde-format
msgid ""
"Writes what the fields hold to an FDF, XFDF or CSV file, chosen by what "
"the file is called. The document itself is not in it, which is what makes "
"it small enough to send and useless to anybody without the form."
msgstr ""
"Écrit le contenu des champs dans un fichier FDF, XFDF ou CSV, choisi "
"d'après le nom donné au fichier. Le document lui-même ne s'y trouve pas, "
"ce qui rend ce fichier assez petit pour être envoyé et inutilisable pour "
"qui n'a pas le formulaire."

#: src/ui/ToolFormBuilderDialog.cpp:1590
#, kde-format
msgctxt "@action:button"
msgid "Write the Answers…"
msgstr "Écrire les réponses…"

#: src/ui/ToolFormBuilderDialog.cpp:1595
#, kde-format
msgctxt "@title:group"
msgid "Put answers in"
msgstr "Insérer des réponses"

#: src/ui/ToolFormBuilderDialog.cpp:1596
#, kde-format
msgid ""
"Fills the fields from an FDF, XFDF or CSV file: one filled copy per run, "
"which is how a hundred contracts get made from one letter and a "
"spreadsheet."
msgstr ""
"Remplit les champs à partir d'un fichier FDF, XFDF ou CSV : une copie "
"remplie par exécution, c'est ainsi que cent contrats naissent d'une seule "
"lettre et d'un tableur."

#: src/ui/ToolFormBuilderDialog.cpp:1601
#, kde-format
msgctxt "@action:button"
msgid "Read the Answers…"
msgstr "Lire les réponses…"

#: src/ui/ToolFormBuilderDialog.cpp:1606
#, kde-format
msgctxt "@title:group"
msgid "Gather many filled-in copies"
msgstr "Rassembler de nombreuses copies remplies"

#: src/ui/ToolFormBuilderDialog.cpp:1607
#, kde-format
msgid ""
"One row per document, one column per field. What comes back from twenty "
"people as twenty files becomes a table."
msgstr ""
"Une ligne par document, une colonne par champ. Ce que vingt personnes "
"renvoient sous forme de vingt fichiers devient un tableau."

#: src/ui/ToolFormBuilderDialog.cpp:1612
#, kde-format
msgctxt "@action:button"
msgid "Gather into a Table…"
msgstr "Rassembler dans un tableau…"

#: src/ui/ToolFormBuilderDialog.cpp:1617
#, kde-format
msgctxt "@title:group"
msgid "Take the fields from another document"
msgstr "Reprendre les champs d'un autre document"

#: src/ui/ToolFormBuilderDialog.cpp:1618
#, kde-format
msgid ""
"Copies every field of an empty form onto this one, where it sits and how "
"it looks. It needs the two to have the same layout: the fields land at "
"the coordinates they had, not next to whatever text they were beside."
msgstr ""
"Copie sur ce document tous les champs d'un formulaire vide, avec leur "
"position et leur apparence. Il faut que les deux aient la même mise en "
"page : les champs se posent aux coordonnées qu'ils avaient, et non à côté "
"du texte qu'ils accompagnaient."

#: src/ui/ToolFormBuilderDialog.cpp:1624
#, kde-format
msgctxt "@action:button"
msgid "Copy the Fields Over…"
msgstr "Copier les champs…"

#: src/ui/ToolFormBuilderDialog.cpp:1647
#, kde-format
msgctxt "@title:window"
msgid "Write the Answers"
msgstr "Écrire les réponses"

#: src/ui/ToolFormBuilderDialog.cpp:1648 src/ui/ToolFormBuilderDialog.cpp:1670
#, kde-format
msgid "Form data (*.fdf *.xfdf *.csv);;All files (*)"
msgstr "Données de formulaire (*.fdf *.xfdf *.csv);;Tous les fichiers (*)"

#: src/ui/ToolFormBuilderDialog.cpp:1659
#, kde-format
msgid "The answers could not be written."
msgstr "Impossible d'écrire les réponses."

#: src/ui/ToolFormBuilderDialog.cpp:1669
#, kde-format
msgctxt "@title:window"
msgid "Read the Answers"
msgstr "Lire les réponses"

#: src/ui/ToolFormBuilderDialog.cpp:1685
#, kde-format
msgid "None of the names in that file is a field of this document."
msgstr "Aucun des noms de ce fichier ne correspond à un champ de ce document."

#: src/ui/ToolFormBuilderDialog.cpp:1686
#, kde-format
msgid "Filled in one field."
msgid_plural "Filled in %1 fields."
msgstr[0] "Un champ a été rempli."
msgstr[1] "%1 champs ont été remplis."

#: src/ui/ToolFormBuilderDialog.cpp:1695
#, kde-format
msgctxt "@title:window"
msgid "The Filled-In Copies"
msgstr "Les copies remplies"

#: src/ui/ToolFormBuilderDialog.cpp:1703
#, kde-format
msgctxt "@title:window"
msgid "Where the Table Goes"
msgstr "Emplacement du tableau"

#: src/ui/ToolFormBuilderDialog.cpp:1704
#, kde-format
msgid "Tables (*.csv);;All files (*)"
msgstr "Tableaux (*.csv);;Tous les fichiers (*)"

#: src/ui/ToolFormBuilderDialog.cpp:1715
#, kde-format
msgid "The table could not be written."
msgstr "Impossible d'écrire le tableau."

#: src/ui/ToolFormBuilderDialog.cpp:1719
#, kde-format
msgid "Wrote the answers of one document to %2, one row each."
msgid_plural "Wrote the answers of %1 documents to %2, one row each."
msgstr[0] ""
"Les réponses d'un document ont été écrites dans %2, une ligne chacune."
msgstr[1] ""
"Les réponses de %1 documents ont été écrites dans %2, une ligne chacune."

#: src/ui/ToolFormBuilderDialog.cpp:1728
#, kde-format
msgctxt "@title:window"
msgid "The Form to Take the Fields From"
msgstr "Le formulaire dont les champs seront repris"

#: src/ui/ToolFormBuilderDialog.cpp:1744
#, kde-format
msgid "Took one field from “%2” and put it on this document."
msgid_plural "Took %1 fields from “%2” and put them on this document."
msgstr[0] "Un champ a été repris de « %2 » et placé sur ce document."
msgstr[1] "%1 champs ont été repris de « %2 » et placés sur ce document."

#: src/ui/ToolImagesDialog.cpp:236
