#: src/cli/main.cpp:1915
#, kde-format
msgid ""
"PDF Smithy (command line)\n"
"\n"
"Commands:\n"
"  info      FILE                      Show page count, size and "
"dimensions\n"
"  merge     FILE...  -o OUT           Glue documents together\n"
"  split     FILE     [-o TEMPLATE]    Break a document apart\n"
"  pages     FILE     -o OUT           Select, reorder and rotate pages\n"
"  compress  FILE     -o OUT           Make a document smaller\n"
"  ocr       FILE     -o OUT           Make a scan searchable\n"
"  sign      FILE     -o OUT           Stamp a signature image onto pages\n"
"  watermark FILE     -o OUT           Lay text across pages\n"
"  meta      FILE                      Show metadata; --sanitize -o OUT "
"strips it\n"
"  protect   FILE     -o OUT           Set or remove a password\n"
"  from-images IMAGE... -o OUT         Build a document from pictures\n"
"  export-images FILE                  Render pages to image files\n"
"  number    FILE     -o OUT           Page numbers, headers and Bates "
"stamping\n"
"  crop      FILE     -o OUT           Trim the empty border off pages\n"
"  redact    FILE     -o OUT           Take content out of an area for "
"good\n"
"  nup       FILE     -o OUT           Put several pages on one sheet\n"
"  annotate  FILE                      List, add, remove or flatten "
"comments\n"
"  outline   FILE                      Show or rewrite the table of "
"contents\n"
"  form      FILE                      List, fill in or flatten form "
"fields\n"
"  text      FILE                      Show the text of a page, or correct "
"it\n"
"  batch     FILE...  --out-dir DIR    Do one thing to many files\n"
"  compare   LEFT RIGHT                Show what changed between two "
"documents\n"
"  archive   FILE     -o OUT           Convert to PDF/A for long-term "
"keeping\n"
"  archive-check FILE                  Look for what stops a file being "
"archival\n"
msgstr ""
"PDF Smithy (ligne de commande)\n"
"\n"
"Commandes :\n"
"  info      FICHIER                   Afficher le nombre de pages, la "
"taille et les dimensions\n"
"  merge     FICHIER...  -o SORTIE     Fusionner plusieurs documents\n"
"  split     FICHIER  [-o MODÈLE]      Diviser un document en morceaux\n"
"  pages     FICHIER  -o SORTIE        Sélectionner, réorganiser et "
"pivoter les pages\n"
"  compress  FICHIER  -o SORTIE        Réduire la taille d'un document\n"
"  ocr       FICHIER  -o SORTIE        Rendre une numérisation "
"consultable\n"
"  sign      FICHIER  -o SORTIE        Apposer une image de signature sur "
"des pages\n"
"  watermark FICHIER  -o SORTIE        Poser un texte en travers des "
"pages\n"
"  meta      FICHIER                   Afficher les métadonnées ; "
"--sanitize -o SORTIE les supprime\n"
"  protect   FICHIER  -o SORTIE        Définir ou retirer un mot de passe\n"
"  from-images IMAGE... -o SORTIE      Construire un document à partir "
"d'images\n"
"  export-images FICHIER               Rendre les pages dans des fichiers "
"image\n"
"  number    FICHIER  -o SORTIE        Numéros de page, en-têtes et "
"numérotation Bates\n"
"  crop      FICHIER  -o SORTIE        Rogner la bordure vide des pages\n"
"  redact    FICHIER  -o SORTIE        Retirer définitivement le contenu "
"d'une zone\n"
"  nup       FICHIER  -o SORTIE        Placer plusieurs pages sur une "
"feuille\n"
"  annotate  FICHIER                   Lister, ajouter, retirer ou aplatir "
"les commentaires\n"
"  outline   FICHIER                   Afficher ou réécrire la table des "
"matières\n"
"  form      FICHIER                   Lister, remplir ou aplatir les "
"champs de formulaire\n"
"  text      FICHIER                   Afficher le texte d'une page, ou le "
"corriger\n"
"  batch     FICHIER...  --out-dir DOSSIER Appliquer une même opération à "
"plusieurs fichiers\n"
"  compare   GAUCHE DROITE             Montrer ce qui a changé entre deux "
"documents\n"
"  archive   FICHIER  -o SORTIE        Convertir en PDF/A pour une "
"conservation à long terme\n"
"  archive-check FICHIER               Chercher ce qui empêche un fichier "
"d'être archivable\n"

#: src/cli/main.cpp:1943
#, kde-format
msgid ""
"\n"
"Examples:\n"
"  pdf-smithy-cli merge a.pdf b.pdf -o both.pdf\n"
"  pdf-smithy-cli split invoices.pdf --every 1\n"
"  pdf-smithy-cli pages report.pdf --keep 1-3,7 --rotate 4:90 -o "
"short.pdf\n"
"  pdf-smithy-cli compress scan.pdf --level strong -o small.pdf\n"
"  pdf-smithy-cli ocr scan.pdf --languages deu+eng --straighten -o "
"searchable.pdf\n"
"  pdf-smithy-cli sign contract.pdf --image signature.png --pages last -o "
"signed.pdf\n"
"  pdf-smithy-cli watermark offer.pdf --text DRAFT --opacity 20 -o "
"marked.pdf\n"
"  pdf-smithy-cli meta payslip.pdf --sanitize -o clean.pdf\n"
"  pdf-smithy-cli protect contract.pdf --password geheim -o locked.pdf\n"
"  pdf-smithy-cli from-images scan*.png --page-size a4 -o scans.pdf\n"
"  pdf-smithy-cli export-images report.pdf --pages 1-3 --dpi 300\n"
"  pdf-smithy-cli number report.pdf --text \"{page} / {pages}\" -o "
"numbered.pdf\n"
"  pdf-smithy-cli number bundle.pdf --text {bates} --bates ACME- -o "
"stamped.pdf\n"
"  pdf-smithy-cli crop scan.pdf --auto -o trimmed.pdf\n"
"  pdf-smithy-cli redact case.pdf --area 1:72,700,180,16 -o public.pdf\n"
"  pdf-smithy-cli nup slides.pdf --per-sheet 4 --borders -o handout.pdf\n"
"  pdf-smithy-cli annotate report.pdf --list\n"
"  pdf-smithy-cli outline manual.pdf --json > toc.json\n"
"  pdf-smithy-cli form application.pdf --list\n"
"  pdf-smithy-cli text letter.pdf --page 1\n"
"  pdf-smithy-cli batch scans/*.pdf --op ocr --out-dir searchable/\n"
"  pdf-smithy-cli compare contract-v1.pdf contract-v2.pdf\n"
"  pdf-smithy-cli archive invoice.pdf --level 2b -o invoice-archival.pdf\n"
"  pdf-smithy-cli to-pdfx cover.pdf --pdfx-level x4 -o cover-print.pdf\n"
"  pdf-smithy-cli tables report.pdf --pages 3-5\n"
"  pdf-smithy-cli to-svg poster.pdf --pages 1-4 -o poster.svg\n"
"  pdf-smithy-cli linearise handbook.pdf -o handbook-web.pdf\n"
"  pdf-smithy-cli set-version old.pdf --pdf-version 1.7 -o modern.pdf\n"
"  pdf-smithy-cli text letter.pdf --replace \"1:4=Sehr geehrte Frau "
"Meier\" -o fixed.pdf\n"
"  pdf-smithy-cli form application.pdf --set Name=Bueng --set Ort=Bern -o "
"filled.pdf\n"
"  pdf-smithy-cli annotate report.pdf --export-xfdf comments.xfdf\n"
"  pdf-smithy-cli annotate report.pdf --note 2:120,600 --text \"Check "
"this\" -o marked.pdf\n"
"  pdf-smithy-cli split handbook.pdf --bookmarks\n"
"\n"
"Duplicating pages needs no separate command: a range may repeat a page,\n"
"so \"pages FILE --keep 1,1,2-4\" writes page 1 twice."
msgstr ""
"\n"
"Exemples :\n"
"  pdf-smithy-cli merge a.pdf b.pdf -o both.pdf\n"
"  pdf-smithy-cli split invoices.pdf --every 1\n"
"  pdf-smithy-cli pages report.pdf --keep 1-3,7 --rotate 4:90 -o "
"short.pdf\n"
"  pdf-smithy-cli compress scan.pdf --level strong -o small.pdf\n"
"  pdf-smithy-cli ocr scan.pdf --languages deu+eng --straighten -o "
"searchable.pdf\n"
"  pdf-smithy-cli sign contract.pdf --image signature.png --pages last -o "
"signed.pdf\n"
"  pdf-smithy-cli watermark offer.pdf --text BROUILLON --opacity 20 -o "
"marked.pdf\n"
"  pdf-smithy-cli meta payslip.pdf --sanitize -o clean.pdf\n"
"  pdf-smithy-cli protect contract.pdf --password secret -o locked.pdf\n"
"  pdf-smithy-cli from-images scan*.png --page-size a4 -o scans.pdf\n"
"  pdf-smithy-cli export-images report.pdf --pages 1-3 --dpi 300\n"
"  pdf-smithy-cli number report.pdf --text \"{page} / {pages}\" -o "
"numbered.pdf\n"
"  pdf-smithy-cli number bundle.pdf --text {bates} --bates ACME- -o "
"stamped.pdf\n"
"  pdf-smithy-cli crop scan.pdf --auto -o trimmed.pdf\n"
"  pdf-smithy-cli redact case.pdf --area 1:72,700,180,16 -o public.pdf\n"
"  pdf-smithy-cli nup slides.pdf --per-sheet 4 --borders -o handout.pdf\n"
"  pdf-smithy-cli annotate report.pdf --list\n"
"  pdf-smithy-cli outline manual.pdf --json > toc.json\n"
"  pdf-smithy-cli form application.pdf --list\n"
"  pdf-smithy-cli text letter.pdf --page 1\n"
"  pdf-smithy-cli batch scans/*.pdf --op ocr --out-dir searchable/\n"
"  pdf-smithy-cli compare contract-v1.pdf contract-v2.pdf\n"
"  pdf-smithy-cli archive invoice.pdf --level 2b -o invoice-archival.pdf\n"
"  pdf-smithy-cli to-pdfx cover.pdf --pdfx-level x4 -o cover-print.pdf\n"
"  pdf-smithy-cli tables report.pdf --pages 3-5\n"
"  pdf-smithy-cli to-svg poster.pdf --pages 1-4 -o poster.svg\n"
"  pdf-smithy-cli linearise handbook.pdf -o handbook-web.pdf\n"
"  pdf-smithy-cli set-version old.pdf --pdf-version 1.7 -o modern.pdf\n"
"  pdf-smithy-cli text letter.pdf --replace \"1:4=Chere Madame Meier\" -o "
"fixed.pdf\n"
"  pdf-smithy-cli form application.pdf --set Nom=Bueng --set Ville=Berne "
"-o filled.pdf\n"
"  pdf-smithy-cli annotate report.pdf --export-xfdf comments.xfdf\n"
"  pdf-smithy-cli annotate report.pdf --note 2:120,600 --text \"Vérifier "
"ceci\" -o marked.pdf\n"
"  pdf-smithy-cli split handbook.pdf --bookmarks\n"
"\n"
"Dupliquer des pages ne demande pas de commande à part : un intervalle "
"peut répéter une page,\n"
"ainsi « pages FICHIER --keep 1,1,2-4 » écrit deux fois la page 1."

#: src/cli/main.cpp:1982
#, kde-format
msgid "The command to run."
msgstr "La commande à exécuter."

#: src/cli/main.cpp:1987
#, kde-format
msgid "Where to write the result."
msgstr "Où écrire le résultat."

#: src/cli/main.cpp:1988
#, kde-format
msgid "Machine-readable output."
msgstr "Sortie lisible par une machine."

#: src/cli/main.cpp:1989
#, kde-format
msgid "Pages to keep, e.g. 1-3,7,9-last."
msgstr "Pages à conserver, par exemple 1-3,7,9-last."

#: src/cli/main.cpp:1991
#, kde-format
msgid "Rotate pages, e.g. 1-3:90,7:180."
msgstr "Pivoter des pages, par exemple 1-3:90,7:180."

#: src/cli/main.cpp:1993
#, kde-format
msgid "Split into chunks of this many pages."
msgstr "Diviser en blocs de ce nombre de pages."

#: src/cli/main.cpp:1996
#, kde-format
msgid "Split into one file per range, e.g. 1-3,4-9."
msgstr "Diviser en un fichier par intervalle, par exemple 1-3,4-9."

#: src/cli/main.cpp:1998
#, kde-format
msgid "Split into pieces no larger than this, e.g. 5M."
msgstr "Diviser en morceaux ne dépassant pas cette taille, par exemple 5M."

#: src/cli/main.cpp:2000
#, kde-format
msgid "Compression: lossless, balanced, strong or extreme."
msgstr "Compression : lossless, balanced, strong ou extreme."

#: src/cli/main.cpp:2001
#, kde-format
msgid "Convert to grayscale while compressing."
msgstr "Convertir en niveaux de gris pendant la compression."

#: src/cli/main.cpp:2002
#, kde-format
msgid "OCR languages, e.g. deu+eng."
msgstr "Langues pour la reconnaissance de texte, par exemple deu+eng."

#: src/cli/main.cpp:2004
#, kde-format
msgid "Correct crooked scans."
msgstr "Redresser les numérisations de travers."

#: src/cli/main.cpp:2005
#, kde-format
msgid "Signature image to stamp."
msgstr "Image de signature à apposer."

#: src/cli/main.cpp:2007
#, kde-format
msgid "Where to put it: bottom-right, centre, top-left…"
msgstr "Où la placer : bottom-right, centre, top-left…"

#: src/cli/main.cpp:2009
#, kde-format
msgid "Width as a fraction of the page, e.g. 0.3."
msgstr "Largeur en fraction de la page, par exemple 0.3."

#: src/cli/main.cpp:2015
#, kde-format
msgid "Distance from the page edge, in points."
msgstr "Distance au bord de la page, en points."

#: src/cli/main.cpp:2017
#, kde-format
msgid "Watermark text."
msgstr "Texte du filigrane."

#: src/cli/main.cpp:2018
#, kde-format
msgid "Watermark angle in degrees."
msgstr "Angle du filigrane en degrés."

#: src/cli/main.cpp:2020
#, kde-format
msgid "Watermark strength, 1 to 100 percent."
msgstr "Intensité du filigrane, de 1 à 100 pour cent."

#: src/cli/main.cpp:2022
#, kde-format
msgid "Watermark colour, a name or #rrggbb."
msgstr "Couleur du filigrane, un nom ou #rrggbb."

#: src/cli/main.cpp:2025
#, kde-format
msgid "Draw the watermark as an outline, keeping the page readable."
msgstr "Dessiner le filigrane en contour, pour garder la page lisible."

#: src/cli/main.cpp:2026
#, kde-format
msgid "Which pages, e.g. 1-3,last. Default: all."
msgstr "Quelles pages, par exemple 1-3,last. Par défaut : toutes."

#: src/cli/main.cpp:2029
#, kde-format
msgid "Fit images into a4, a3, a5, letter or legal."
msgstr "Ajuster les images au format a4, a3, a5, letter ou legal."

#: src/cli/main.cpp:2030
#, kde-format
msgid "Resolution for image export, in dots per inch."
msgstr "Résolution de l'export d'images, en points par pouce."

#: src/cli/main.cpp:2032
#, kde-format
msgid "Image format: png, jpeg or tiff."
msgstr "Format d'image : png, jpeg ou tiff."

#: src/cli/main.cpp:2035
#, kde-format
msgid "JPEG quality when importing, 0 keeps the pixels."
msgstr "Qualité JPEG à l'import, 0 conserve les pixels."

#: src/cli/main.cpp:2038
#, kde-format
msgid "Strip metadata, JavaScript and embedded files."
msgstr "Supprimer les métadonnées, le JavaScript et les fichiers incorporés."

#: src/cli/main.cpp:2039
#, kde-format
msgid "Password to set."
msgstr "Mot de passe à définir."

#: src/cli/main.cpp:2042
#, kde-format
msgid "Password the input already has, if any."
msgstr "Mot de passe que le fichier d'entrée possède déjà, le cas échéant."

#: src/cli/main.cpp:2044
#, kde-format
msgid "Remove the password instead of setting one."
msgstr "Retirer le mot de passe au lieu d'en définir un."

#: src/cli/main.cpp:2045
#, kde-format
msgid "Ask readers not to print."
msgstr "Demander aux lecteurs de ne pas imprimer."

#: src/cli/main.cpp:2046
#, kde-format
msgid "Ask readers not to copy text."
msgstr "Demander aux lecteurs de ne pas copier le texte."

#: src/cli/main.cpp:2047
#, kde-format
msgid "Split wherever a bookmark starts."
msgstr "Diviser à chaque début de signet."

#: src/cli/main.cpp:2050
#, kde-format
msgid ""
"A colour profile to embed: sRGB for “archive”, a CMYK printing condition "
"for “to-pdfx”. Leave out to look for one on the system."
msgstr ""
"Un profil de couleur à incorporer : sRGB pour « archive », une condition "
"d'impression CMYK pour « to-pdfx ». À omettre pour en chercher un sur le "
"système."

#: src/cli/main.cpp:2053
#, kde-format
msgid "Document title to write."
msgstr "Titre du document à écrire."

#: src/cli/main.cpp:2055
#, kde-format
msgid "Document author to write."
msgstr "Auteur du document à écrire."

#: src/cli/main.cpp:2059
#, kde-format
msgid ""
"How different two pixels may be before they count as changed, in levels "
"of brightness out of 255. On “colour replace” it is a distance in colour "
"between 0 and 1."
msgstr ""
"Écart maximal entre deux pixels avant qu'ils ne comptent comme modifiés, "
"en niveaux de luminosité sur 255. Pour « colour replace », il s'agit "
"d'une distance colorimétrique comprise entre 0 et 1."

#: src/cli/main.cpp:2063
#, kde-format
msgid "Treat a different line break as a change."
msgstr "Considérer un saut de ligne différent comme une modification."

#: src/cli/main.cpp:2065
#, kde-format
msgid "Write a side-by-side picture of one page, with -o."
msgstr "Écrire une image côte à côte d'une page, avec -o."

#: src/cli/main.cpp:2067
#, kde-format
msgid "Folder to write the finished files into."
msgstr "Dossier où écrire les fichiers terminés."

#: src/cli/main.cpp:2070
#, kde-format
msgid ""
"What to do to each file: compress, sanitize, flatten-comments, "
"flatten-form or ocr."
msgstr ""
"Ce qu'il faut faire de chaque fichier : compress, sanitize, "
"flatten-comments, flatten-form ou ocr."

#: src/cli/main.cpp:2074
#, kde-format
msgid "Replace a line, as PAGE:LINE=New text. Repeat for more."
msgstr ""
"Remplacer une ligne, sous la forme PAGE:LIGNE=Nouveau texte. À répéter "
"pour en indiquer plusieurs."

#: src/cli/main.cpp:2076
#, kde-format
msgid "Which page to list the text of."
msgstr "La page dont il faut afficher le texte."

#: src/cli/main.cpp:2079
#, kde-format
msgid "Fill in a field, as NAME=VALUE. Repeat for more."
msgstr ""
"Remplir un champ, sous la forme NOM=VALEUR. À répéter pour en indiquer "
"plusieurs."

#: src/cli/main.cpp:2081
#, kde-format
msgid "Add a bookmark, as PAGE:Title. Repeat for more."
msgstr ""
"Ajouter un signet, sous la forme PAGE:Titre. À répéter pour en indiquer "
"plusieurs."

#: src/cli/main.cpp:2083
#, kde-format
msgid "Replace the table of contents from a JSON file, as --json writes it."
msgstr ""
"Remplacer la table des matières à partir d'un fichier JSON, tel que "
"--json l'écrit."

#: src/cli/main.cpp:2086
#, kde-format
msgid "Write the comments to an XFDF file, without the document."
msgstr "Écrire les commentaires dans un fichier XFDF, sans le document."

#: src/cli/main.cpp:2089
#, kde-format
msgid "Read comments from an XFDF file and add them."
msgstr "Lire les commentaires d'un fichier XFDF et les ajouter."

#: src/cli/main.cpp:2090
#, kde-format
msgid "Show the comments instead of changing them."
msgstr "Afficher les commentaires au lieu de les modifier."

#: src/cli/main.cpp:2092
#, kde-format
msgid "Highlight an area, as PAGE:X,Y,WIDTH,HEIGHT. Repeat for more."
msgstr ""
"Surligner une zone, sous la forme PAGE:X,Y,LARGEUR,HAUTEUR. À répéter "
"pour en indiquer plusieurs."

#: src/cli/main.cpp:2094
#, kde-format
msgid "Put a note marker at PAGE:X,Y. Repeat for more."
msgstr ""
"Placer un repère de note à PAGE:X,Y. À répéter pour en indiquer plusieurs."

#: src/cli/main.cpp:2099
#, kde-format
msgid "Take every comment out, leaving form fields alone."
msgstr "Retirer tous les commentaires, sans toucher aux champs de formulaire."

#: src/cli/main.cpp:2100
#, kde-format
msgid "Name to put on the comment."
msgstr "Nom à apposer sur le commentaire."

#: src/cli/main.cpp:2103
#, kde-format
msgid "Draw the comments into the pages and remove them."
msgstr "Dessiner les commentaires dans les pages et les retirer."

#: src/cli/main.cpp:2105
#, kde-format
msgid "How many pages go on one sheet, e.g. 2, 4 or 9."
msgstr "Combien de pages tiennent sur une feuille, par exemple 2, 4 ou 9."

#: src/cli/main.cpp:2107
#, kde-format
msgid "Exact arrangement as COLUMNSxROWS, e.g. 2x3."
msgstr "Disposition exacte sous la forme COLUMNSxROWS, par exemple 2x3."

#: src/cli/main.cpp:2109
#, kde-format
msgid "Gap between the slots, in points."
msgstr "Espace entre les emplacements, en points."

#: src/cli/main.cpp:2112
#, kde-format
msgid "Empty border around the sheet, in points."
msgstr "Bordure vide autour de la feuille, en points."

#: src/cli/main.cpp:2114
#, kde-format
msgid "Draw a hairline around each slot."
msgstr "Dessiner un filet maigre autour de chaque emplacement."

#: src/cli/main.cpp:2115
#, kde-format
msgid "Fill downwards before moving right."
msgstr "Remplir vers le bas avant d'aller vers la droite."

#: src/cli/main.cpp:2117
#, kde-format
msgid ""
"Area to redact, as PAGE:X,Y,WIDTH,HEIGHT in points from the bottom-left "
"corner. Repeat for more."
msgstr ""
"Zone à caviarder, sous la forme PAGE:X,Y,LARGEUR,HAUTEUR en points depuis "
"le coin inférieur gauche. À répéter pour en indiquer plusieurs."

#: src/cli/main.cpp:2121
#, kde-format
msgid "Leave the gap open instead of painting it black."
msgstr "Laisser l'espace vide au lieu de le peindre en noir."

#: src/cli/main.cpp:2122
#, kde-format
msgid "Find the empty border and trim it."
msgstr "Trouver la bordure vide et la rogner."

#: src/cli/main.cpp:2123
#, kde-format
msgid "Remove the crop instead of setting one."
msgstr "Retirer le recadrage au lieu d'en définir un."

#: src/cli/main.cpp:2124
#, kde-format
msgid "Points to trim from the left."
msgstr "Points à rogner à gauche."

#: src/cli/main.cpp:2126
#, kde-format
msgid "Points to trim from the right."
msgstr "Points à rogner à droite."

#: src/cli/main.cpp:2128
#, kde-format
msgid "Points to trim from the top."
msgstr "Points à rogner en haut."

#: src/cli/main.cpp:2130
#, kde-format
msgid "Points to trim from the bottom."
msgstr "Points à rogner en bas."

#: src/cli/main.cpp:2132
#, kde-format
msgid "Prefix for Bates numbering, e.g. ACME-."
msgstr "Préfixe de la numérotation Bates, par exemple ACME-."

#: src/cli/main.cpp:2134
#, kde-format
msgid "Zero padding for the Bates number."
msgstr "Nombre de zéros de remplissage du numéro Bates."

#: src/cli/main.cpp:2136
#, kde-format
msgid "Number the first stamped page as this."
msgstr "Numéro à donner à la première page tamponnée."

#: src/cli/main.cpp:2138
#, kde-format
msgid "Text size in points."
msgstr "Taille du texte en points."

#: src/cli/main.cpp:2142
#, kde-format
msgid "Recognise text even on pages that already have some."
msgstr "Reconnaître le texte même sur les pages qui en ont déjà."

#: src/cli/main.cpp:2284
#, kde-format
msgid "This build has no OCR support."
msgstr "Cette version ne prend pas en charge la reconnaissance de texte."

#: src/cli/main.cpp:2297
#, kde-format
msgid "Unknown command “%1”."
msgstr "Commande « %1 » inconnue."

#: src/core/Annotation.cpp:475
#, kde-format
msgid "There is nothing to add."
msgstr "Il n'y a rien à ajouter."

#: src/core/Annotation.cpp:895 src/ui/MainWindow.cpp:1916
#, kde-format
msgid "This document has no comments to write out."
msgstr "Ce document n'a aucun commentaire à écrire."

#: src/core/Annotation.cpp:921
#, kde-format
msgid "“%1” could not be opened for writing."
msgstr "Impossible d'ouvrir « %1 » en écriture."

#: src/core/Annotation.cpp:1147
#, kde-format
msgid "“%1” is not a valid XFDF file: %2"
msgstr "« %1 » n'est pas un fichier XFDF valable : %2"

#: src/core/Annotation.cpp:1153
#, kde-format
msgid "“%1” holds no comments this can use."
msgstr "« %1 » ne contient aucun commentaire exploitable."

#: src/core/Annotation.cpp:1159
#, kde-format
msgid "One comment names a page this document does not have and was left out."
msgid_plural ""
"%1 comments name pages this document does not have and were left out."
msgstr[0] ""
"Un commentaire désigne une page absente de ce document et a été laissé de "
"côté."
msgstr[1] ""
"%1 commentaires désignent des pages absentes de ce document et ont été "
"laissés de côté."

#: src/core/Archival.cpp:130 src/core/Preflight.cpp:327
#, kde-format
msgctxt "@item a font the file does not name"
msgid "an unnamed font"
msgstr "une police sans nom"

#: src/core/Archival.cpp:348
#, kde-format
msgid ""
"The document is encrypted. An archive has to be able to open it in fifty "
"years' time, without a password, so PDF/A does not allow that."
msgstr ""
"Le document est chiffré. Une archive doit pouvoir être ouverte dans "
"cinquante ans, sans mot de passe ; le PDF/A ne l'autorise donc pas."

#: src/core/Archival.cpp:351
#, kde-format
msgid ""
"The document contains scripts, or an action that runs when it is opened. "
"PDF/A allows neither."
msgstr ""
"Le document contient des scripts, ou une action qui s'exécute à "
"l'ouverture. Le PDF/A n'autorise ni l'un ni l'autre."

#: src/core/Archival.cpp:354
#, kde-format
msgid "The document carries other files inside it. Only PDF/A-3 allows that."
msgstr "Le document contient d'autres fichiers. Seul le PDF/A-3 l'autorise."

#: src/core/Archival.cpp:361
#, kde-format
msgctxt "@item separator in a list of font names"
msgid ", "
msgstr ", "

#: src/core/Archival.cpp:356
#, kde-format
msgid ""
"%1 font is not embedded (%2), so its text will be set in whatever the "
"reader happens to have instead."
msgid_plural ""
"%1 fonts are not embedded (%2), so their text will be set in whatever the "
"reader happens to have instead."
msgstr[0] ""
"%1 police n'est pas incorporée (%2) ; son texte sera donc composé avec ce "
"dont dispose le lecteur."
msgstr[1] ""
"%1 polices ne sont pas incorporées (%2) ; leur texte sera donc composé "
"avec ce dont dispose le lecteur."

#: src/core/Archival.cpp:363 src/core/Preflight.cpp:1592
#, kde-format
msgid ""
"The document has no output intent, so nothing in it says what its colours "
"are meant to look like."
msgstr ""
"Le document n'a pas d'intention de sortie ; rien n'y indique donc "
"l'aspect attendu de ses couleurs."

#: src/core/Archival.cpp:373
#, kde-format
msgid "The password protection was removed, because PDF/A does not allow it."
msgstr ""
"La protection par mot de passe a été retirée, car le PDF/A ne l'autorise "
"pas."

#: src/core/Archival.cpp:375
#, kde-format
msgid "Scripts and actions that run on their own were removed."
msgstr ""
"Les scripts et les actions qui s'exécutent d'eux-mêmes ont été retirés."

#: src/core/Archival.cpp:377
#, kde-format
msgid ""
"The files carried inside the document were dropped. Convert to PDF/A-3 if "
"they matter."
msgstr ""
"Les fichiers contenus dans le document ont été abandonnés. Il faut "
"convertir en PDF/A-3 s'ils sont importants."

#: src/core/Archival.cpp:379
#, kde-format
msgid ""
"The fonts were embedded, so the text keeps its shape on a machine that "
"does not have them."
msgstr ""
"Les polices ont été incorporées ; le texte garde donc son aspect sur une "
"machine qui ne les possède pas."

#: src/core/Archival.cpp:381
#, kde-format
msgid ""
"An sRGB output intent was added, so the colours are stated rather than "
"assumed."
msgstr ""
"Une intention de sortie sRGB a été ajoutée ; les couleurs sont donc "
"déclarées plutôt que supposées."

#: src/core/Archival.cpp:536 src/core/Compressor.cpp:292
#: src/core/Convert.cpp:1311 src/core/Convert.cpp:1676
#: src/core/Encryption.cpp:57 src/core/ImageIO.cpp:166 src/core/Metadata.cpp:72
#: src/core/Overlay.cpp:125 src/core/PageCrop.cpp:108
#: src/core/PageLayout.cpp:616 src/core/Preflight.cpp:2308
#: src/core/ScanProcessor.cpp:582
#, kde-format
msgid "Could not write “%1”."
msgstr "Impossible d'écrire « %1 »."

#: src/core/Archival.cpp:558
#, kde-format
msgctxt "@item PDF/A level"
msgid "PDF/A-1b (oldest, strictest, accepted everywhere)"
msgstr "PDF/A-1b (le plus ancien, le plus strict, accepté partout)"

#: src/core/Archival.cpp:560
#, kde-format
msgctxt "@item PDF/A level"
msgid "PDF/A-2b (what most archives ask for)"
msgstr "PDF/A-2b (ce que demandent la plupart des archives)"

#: src/core/Archival.cpp:562
#, kde-format
msgctxt "@item PDF/A level"
msgid "PDF/A-3b (as PDF/A-2b, but attachments may stay)"
msgstr "PDF/A-3b (comme PDF/A-2b, mais les pièces jointes peuvent rester)"

#: src/core/Archival.cpp:570
#, kde-format
msgid ""
"This is not a full validation. It looks for the faults that account for "
"most rejections (encryption, scripts, attachments, fonts that are not "
"embedded, a missing output intent) and nothing else."
msgstr ""
"Il ne s'agit pas d'une validation complète. Seuls sont recherchés les "
"défauts à l'origine de la plupart des rejets (chiffrement, scripts, "
"pièces jointes, polices non incorporées, intention de sortie manquante), "
"et rien d'autre."

#: src/core/Archival.cpp:573
#, kde-format
msgid ""
"A file can pass every check here and still be refused by a strict "
"validator such as veraPDF, which is the tool to reach for when an archive "
"has to sign the file off."
msgstr ""
"Un fichier peut passer toutes les vérifications proposées ici et être "
"malgré tout refusé par un validateur strict comme veraPDF, l'outil à "
"employer lorsqu'une archive doit valider le fichier."

#: src/core/Archival.cpp:575
#, kde-format
msgid ""
"Only what the file says about itself is read. A document claiming "
"PDF/A-2b is taken at its word on that point."
msgstr ""
"Seul ce que le fichier déclare de lui-même est lu. Un document qui se dit "
"PDF/A-2b est cru sur parole sur ce point."

#: src/core/Archival.cpp:614
#, kde-format
msgid ""
"Ghostscript is not installed, so documents cannot be converted for "
"archiving. Install the “ghostscript” package."
msgstr ""
"Ghostscript n'est pas installé ; les documents ne peuvent donc pas être "
"convertis pour l'archivage. Il faut installer le paquet « ghostscript »."

#: src/core/Archival.cpp:630 src/core/Convert.cpp:2343
#, kde-format
msgid "The colour profile “%1” does not exist."
msgstr "Le profil de couleur « %1 » n'existe pas."

#: src/core/Archival.cpp:638
#, kde-format
msgid ""
"No sRGB colour profile was found on this system, so Ghostscript's "
"built-in default was used. The file will have no output intent, which a "
"strict check may object to. Installing the “icc-profiles-free” package "
"fixes it."
msgstr ""
"Aucun profil de couleur sRGB n'a été trouvé sur ce système ; le profil "
"par défaut intégré à Ghostscript a donc été utilisé. Le fichier n'aura "
"pas d'intention de sortie, ce qu'une vérification stricte peut refuser. "
"L'installation du paquet « icc-profiles-free » corrige cela."

#: src/core/Archival.cpp:646 src/core/Convert.cpp:2373
#: src/core/Preflight.cpp:2607
#, kde-format
msgid "Could not create a temporary directory."
msgstr "Impossible de créer un dossier temporaire."

#: src/core/Archival.cpp:661 src/core/BlankPdf.cpp:44
#: src/core/Compressor.cpp:222 src/core/Convert.cpp:2388
