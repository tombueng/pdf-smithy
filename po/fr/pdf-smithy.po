msgstr "%1 a été superposé au document."

#: src/ui/ToolLayoutDialog.cpp:1184
#, kde-format
msgid "The overlay started again whenever it ran out."
msgstr "La superposition a recommencé chaque fois qu'elle était épuisée."

#: src/ui/ToolLayoutDialog.cpp:1185
#, kde-format
msgid "Pages past the end of the overlay were left as they were."
msgstr ""
"Les pages situées au-delà de la fin de la superposition ont été laissées "
"telles quelles."

