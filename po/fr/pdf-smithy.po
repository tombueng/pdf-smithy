#: src/cli/CommandsFonts.cpp:424 src/ui/ToolFontsDialog.cpp:1078
#, kde-format
msgid ""
"The text already on those pages still uses the fonts it always did. The "
"new one is a resource to write with, not a replacement for what is there."
msgstr ""
"Le texte déjà présent sur ces pages continue d'utiliser les polices qu'il "
"a toujours utilisées. La nouvelle est une ressource pour écrire, pas un "
"remplacement de ce qui existe."

#: src/cli/CommandsFonts.cpp:440
#, kde-format
msgid ""
"fonts strip needs to know which fonts, as --font-name Helvetica, or --all "
"for every embedded one."
msgstr ""
"fonts strip doit savoir quelles polices, sous la forme --font-name "
"Helvetica, ou --all pour toutes les polices incorporées."

