"%1 objects. The number in the first column is what --object takes."
msgstr[0] ""
"%1 objet. Le numéro de la première colonne est celui qu'attend --object."
msgstr[1] ""
"%1 objets. Le numéro de la première colonne est celui qu'attend --object."

#: src/cli/CommandsObjects.cpp:403
#, kde-format
msgid "Boundaries are in points from the bottom-left corner of the page."
msgstr "Les limites sont en points depuis le coin inférieur gauche de la page."

#: src/cli/CommandsObjects.cpp:424
#, kde-format
msgid ""
"Give a point with --at X,Y, or an area with --area X,Y,WIDTH,HEIGHT, in "
"points from the bottom-left corner of the page."
msgstr ""
"Indiquez un point avec --at X,Y, ou une zone avec --area "
"X,Y,LARGEUR,HAUTEUR, en points depuis le coin inférieur gauche de la page."

#: src/cli/CommandsObjects.cpp:434 src/cli/CommandsObjects.cpp:600
#, kde-format
msgid ""
"“%1” is not a point. The form is X,Y, in points from the bottom-left "
"corner of the page."
msgstr ""
"« %1 » n'est pas un point. La forme est X,Y, en points depuis le coin "
"inférieur gauche de la page."

#: src/cli/CommandsObjects.cpp:457
#, kde-format
msgid ""
"“%1” is not an area. The form is X,Y,WIDTH,HEIGHT, in points from the "
"bottom-left corner of the page."
msgstr ""
"« %1 » n'est pas une zone. La forme est X,Y,LARGEUR,HAUTEUR, en points "
"depuis le coin inférieur gauche de la page."

#: src/cli/CommandsObjects.cpp:513
#, kde-format
msgid "Nothing is drawn at %1, %2 on page %3."
msgstr "Rien n'est dessiné en %1, %2 sur la page %3."

#: src/cli/CommandsObjects.cpp:514
#, kde-format
msgid "Nothing on page %1 meets that area."
msgstr "Rien sur la page %1 ne touche cette zone."

#: src/cli/CommandsObjects.cpp:523
#, kde-format
msgid "%1 object, topmost first."
msgid_plural "%1 objects, topmost first."
msgstr[0] "%1 objet, en commençant par celui du dessus."
msgstr[1] "%1 objets, en commençant par celui du dessus."

#: src/cli/CommandsObjects.cpp:557
#, kde-format
msgid ""
"Say how far with --by DX,DY, in points. Positive numbers move right and "
"up."
msgstr ""
"Indiquez la distance avec --by DX,DY, en points. Les nombres positifs "
"déplacent vers la droite et vers le haut."

#: src/cli/CommandsObjects.cpp:571
#, kde-format
msgid ""
"Say how much with --by FACTOR, e.g. 1.5, or --by FX,FY to stretch one way "
"only."
msgstr ""
"Indiquez l'ampleur avec --by FACTOR, par exemple 1.5, ou --by FX,FY pour "
"étirer dans un seul sens."

#: src/cli/CommandsObjects.cpp:575
#, kde-format
msgid "A factor of zero would flatten the object out of existence."
msgstr "Un facteur de zéro écraserait l'objet jusqu'à le faire disparaître."

#: src/cli/CommandsObjects.cpp:583
#, kde-format
msgid "Say how far round with --angle DEGREES, counter-clockwise."
msgstr "Indiquez la rotation avec --angle DEGRÉS, dans le sens antihoraire."

#: src/cli/CommandsObjects.cpp:709 src/cli/CommandsObjects.cpp:835
#, kde-format
msgid "“%1” is not a line width in points."
msgstr "« %1 » n'est pas une épaisseur de trait en points."

#: src/cli/CommandsObjects.cpp:714
#, kde-format
msgid "Say what to change: --fill, --stroke or --line-width."
msgstr "Indiquez ce qu'il faut changer : --fill, --stroke ou --line-width."

#: src/cli/CommandsObjects.cpp:780
#, kde-format
msgid ""
"Say what to insert with --shape: text, image, rectangle, ellipse or line."
msgstr ""
"Indiquez quoi insérer avec --shape : text, image, rectangle, ellipse ou "
"line."

#: src/cli/CommandsObjects.cpp:785
#, kde-format
msgid ""
"Say where with --rect X,Y,WIDTH,HEIGHT, in points from the bottom-left "
"corner of the page."
msgstr ""
"Indiquez l'endroit avec --rect X,Y,LARGEUR,HAUTEUR, en points depuis le "
"coin inférieur gauche de la page."

#: src/cli/CommandsObjects.cpp:796
#, kde-format
msgid "Say what it should read with --text."
msgstr "Indiquez le texte à afficher avec --text."

#: src/cli/CommandsObjects.cpp:806
#, kde-format
msgid "“%1” is not a text size in points."
msgstr "« %1 » n'est pas une taille de texte en points."

#: src/cli/CommandsObjects.cpp:814
#, kde-format
msgid "Say which picture with --image."
msgstr "Indiquez l'image avec --image."

#: src/cli/CommandsObjects.cpp:818 src/cli/main.cpp:414
#: src/ui/SignEditor.cpp:269 src/ui/WatermarkEditor.cpp:328
#, kde-format
msgid "“%1” could not be read as an image."
msgstr "Impossible de lire « %1 » comme une image."

#: src/cli/CommandsObjects.cpp:847
#, kde-format
msgid ""
"“%1” is not a place. The form is X,Y,WIDTH,HEIGHT, in points from the "
"bottom-left corner of the page."
msgstr ""
"« %1 » n'est pas un emplacement. La forme est X,Y,LARGEUR,HAUTEUR, en "
"points depuis le coin inférieur gauche de la page."

#: src/cli/CommandsObjects.cpp:862
#, kde-format
msgctxt "@title heading before a list"
msgid "Reading a page as objects:"
msgstr "Lire une page comme des objets :"

#: src/cli/CommandsObjects.cpp:866
#, kde-format
msgctxt "@title heading before a list"
msgid "Changing what is on a page:"
msgstr "Modifier ce qui se trouve sur une page :"

#: src/cli/CommandsObjects.cpp:879
#, kde-format
msgid ""
"Which object, by the number “objects list” prints. Repeat, or separate "
"with commas, to change several at once."
msgstr ""
"Quel objet, d'après le numéro qu'affiche « objects list ». Répétez "
"l'option, ou séparez par des virgules, pour en modifier plusieurs à la "
"fois."

#: src/cli/CommandsObjects.cpp:883
#, kde-format
msgid "How far to move, as DX,DY in points, or how much to scale, as a factor."
msgstr ""
"De combien déplacer, sous la forme DX,DY en points, ou de combien "
"redimensionner, sous la forme d'un facteur."

#: src/cli/CommandsObjects.cpp:886
#, kde-format
msgid ""
"Point to scale or turn around, as X,Y in points from the bottom-left "
"corner. Without it, each object uses its own middle."
msgstr ""
"Point autour duquel redimensionner ou pivoter, sous la forme X,Y en "
"points depuis le coin inférieur gauche. Sans lui, chaque objet utilise "
"son propre centre."

#: src/cli/CommandsObjects.cpp:890
#, kde-format
msgid "Fill colour, a name or #rrggbb. For text, the colour of the letters."
msgstr ""
"Couleur de remplissage, un nom ou #rrggbb. Pour le texte, la couleur des "
"lettres."

#: src/cli/CommandsObjects.cpp:891
#, kde-format
msgid "Outline colour, a name or #rrggbb."
msgstr "Couleur du trait, un nom ou #rrggbb."

#: src/cli/CommandsObjects.cpp:892
#, kde-format
msgid "Outline width in points."
msgstr "Épaisseur du trait en points."

#: src/cli/CommandsObjects.cpp:893
#, kde-format
msgid "What to insert: text, image, rectangle, ellipse or line."
msgstr "Ce qu'il faut insérer : text, image, rectangle, ellipse ou line."

#: src/cli/CommandsObjects.cpp:897
#, kde-format
msgid ""
"Where it goes, as X,Y,WIDTH,HEIGHT in points from the bottom-left corner "
"of the page. Repeat to insert several."
msgstr ""
"Où le placer, sous la forme X,Y,LARGEUR,HAUTEUR en points depuis le coin "
"inférieur gauche de la page. Répétez l'option pour en insérer plusieurs."

#: src/cli/CommandsObjects.cpp:903
#, kde-format
msgid "Standard font for inserted text: Helvetica, Times-Roman or Courier."
msgstr "Police standard du texte inséré : Helvetica, Times-Roman ou Courier."

#: src/cli/CommandsObjects.cpp:915
#, kde-format
msgid "Everything drawn on the page, with the number to grab it by"
msgstr ""
"Tout ce qui est dessiné sur la page, avec le numéro qui permet de le "
"saisir"

#: src/cli/CommandsObjects.cpp:916
#, kde-format
msgid "What is under a point, topmost first"
msgstr "Ce qui se trouve sous un point, en commençant par le dessus"

#: src/cli/CommandsObjects.cpp:917
#, kde-format
msgid "Shift an object across the page"
msgstr "Déplacer un objet sur la page"

#: src/cli/CommandsObjects.cpp:918
#, kde-format
msgid "Make an object larger or smaller"
msgstr "Agrandir ou réduire un objet"

#: src/cli/CommandsObjects.cpp:919
#, kde-format
msgid "Turn an object, counter-clockwise"
msgstr "Faire pivoter un objet, dans le sens antihoraire"

#: src/cli/CommandsObjects.cpp:920
#, kde-format
msgid "Take an object off the page for good"
msgstr "Retirer définitivement un objet de la page"

#: src/cli/CommandsObjects.cpp:921
#, kde-format
msgid "Change the colours or the line width"
msgstr "Changer les couleurs ou l'épaisseur du trait"

#: src/cli/CommandsObjects.cpp:922
#, kde-format
msgid "Put text, a picture or a shape on the page"
msgstr "Placer du texte, une image ou une forme sur la page"

#: src/cli/CommandsObjects.cpp:923
#, kde-format
msgid "What reading and editing objects cannot reach"
msgstr ""
"Ce que la lecture et la modification des objets ne peuvent pas atteindre"

#: src/cli/CommandsObjects.cpp:937
#, kde-format
msgid ""
"Say what to do: objects list, at, move, scale, rotate, delete, restyle, "
"insert or limits."
msgstr ""
"Indiquez quoi faire : objects list, at, move, scale, rotate, delete, "
"restyle, insert ou limits."

#: src/cli/CommandsObjects.cpp:968
#, kde-format
msgid ""
"“objects %1” is not a command. Try list, at, move, scale, rotate, delete, "
"restyle, insert or limits."
msgstr ""
"« objects %1 » n'est pas une commande. Essayez list, at, move, scale, "
"rotate, delete, restyle, insert ou limits."

