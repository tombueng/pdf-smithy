#: src/cli/CommandsFonts.cpp:360 src/cli/CommandsFonts.cpp:511
#, kde-format
msgid "“%1” is not a cut. Use bold, italic, bold-italic or regular."
msgstr ""
"« %1 » n'est pas un style de police. Utilisez bold, italic, bold-italic "
"ou regular."

#: src/cli/CommandsFonts.cpp:366
#, kde-format
msgid ""
"fonts embed needs the characters to put in, as --text “Müller”. Only "
"those go in, which is what keeps the document from growing by a whole "
"font."
msgstr ""
"fonts embed a besoin des caractères à inclure, sous la forme --text "
"« Müller ». Seuls ceux-là sont inclus, ce qui évite au document de "
"grossir d'une police entière."

#: src/cli/CommandsFonts.cpp:375
#, kde-format
msgid ""
"No font called “%1” that could be embedded is installed on this system. "
"“fonts find” says what is there."
msgstr ""
"Aucune police nommée « %1 » pouvant être incorporée n'est installée sur "
"ce système. « fonts find » indique ce qui est disponible."

