msgstr ""
"Leur texte peut désormais être copié et recherché, par ce programme comme "
"par tout autre."

#: src/cli/CommandsFonts.cpp:505
#, kde-format
msgid "fonts find needs one family name, as: fonts find “DejaVu Sans”."
