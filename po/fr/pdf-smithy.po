msgid "Work on the Pixels"
msgstr "Travailler les pixels"

#: src/ui/ToolImagesDialog.cpp:243
#, kde-format
msgctxt "@title:tab"
msgid "Tidying Up"
msgstr "Nettoyage"

#: src/ui/ToolImagesDialog.cpp:267
