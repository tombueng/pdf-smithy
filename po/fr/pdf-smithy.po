#, kde-format
msgid "No font called “%1” is installed on this system."
msgstr "Aucune police nommée « %1 » n'est installée sur ce système."

#: src/cli/CommandsFonts.cpp:524
#, kde-format
msgid ""
"That file was found, but it is not a TrueType or OpenType font, and only "
"those can be cut down and embedded."
msgstr ""
"Ce fichier a été trouvé, mais ce n'est pas une police TrueType ou "
"OpenType, et seules celles-ci peuvent être réduites et incorporées."

