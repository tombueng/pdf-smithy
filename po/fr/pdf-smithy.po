msgstr "« %1 » n'est pas une épaisseur de bordure."

#: src/cli/CommandsForm.cpp:251 src/cli/CommandsForm.cpp:567
#, kde-format
msgid "“%1” is not a border. Use solid, dashed, beveled, inset or underline."
msgstr ""
"« %1 » n'est pas une bordure. Utilisez solid, dashed, beveled, inset ou "
"underline."

#: src/cli/CommandsForm.cpp:257 src/cli/CommandsForm.cpp:573
#, kde-format
msgid "“%1” is not an alignment. Use left, centre or right."
msgstr "« %1 » n'est pas un alignement. Utilisez left, centre ou right."

#: src/cli/CommandsForm.cpp:286
#, kde-format
msgid ""
"Say where the field goes and how big it is, e.g. --at 72,700 --size "
"200x18."
msgstr ""
"Indiquez où va le champ et quelle est sa taille, par exemple --at 72,700 "
"--size 200x18."

#: src/cli/CommandsForm.cpp:292
#, kde-format
msgid "Give one --size for them all, or one for every --at."
msgstr "Indiquez un seul --size pour tous, ou un par --at."

#: src/cli/CommandsForm.cpp:299 src/cli/CommandsForm.cpp:860
#, kde-format
msgid ""
"“%1” is not a place. The form is X,Y, in points from the bottom-left "
"corner of the page as it is shown."
msgstr ""
"« %1 » n'est pas une position. La forme est X,Y, en points depuis le coin "
"inférieur gauche de la page telle qu'elle est affichée."

#: src/cli/CommandsForm.cpp:307 src/cli/CommandsForm.cpp:867
#: src/cli/CommandsForm.cpp:887
#, kde-format
msgid "“%1” is not a size. The form is WIDTHxHEIGHT, in points."
msgstr "« %1 » n'est pas une taille. La forme est WIDTHxHEIGHT, en points."

#: src/cli/CommandsForm.cpp:327
#, kde-format
msgid ""
"Say what kind of field with --type: text, password, checkbox, radio, "
"choice, list, button or signature."
msgstr ""
"Indiquez le type de champ avec --type : text, password, checkbox, radio, "
"choice, list, button ou signature."

#: src/cli/CommandsForm.cpp:332
#, kde-format
msgid ""
"“%1” is not a kind of field. Use text, password, checkbox, radio, choice, "
"list, button or signature."
msgstr ""
"« %1 » n'est pas un type de champ. Utilisez text, password, checkbox, "
"radio, choice, list, button ou signature."

#: src/cli/CommandsForm.cpp:340
#, kde-format
msgid ""
"Give the field a name with --name. That is the name filling in addresses, "
"and a full stop in it makes a group: Adresse.Strasse and Adresse.Ort "
"belong together."
msgstr ""
"Donnez un nom au champ avec --name. C'est ce nom qu'utilise le "
"remplissage des adresses, et un point dans ce nom crée un groupe : "
"Adresse.Rue et Adresse.Ville vont ensemble."

