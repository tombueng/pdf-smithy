#: src/cli/CommandsColour.cpp:88
#, kde-format
msgctxt "@item something the document does"
msgid "yes"
msgstr "oui"

#: src/cli/CommandsColour.cpp:89
#, kde-format
msgctxt "@item something the document does not do"
msgid "no"
msgstr "non"

#: src/cli/CommandsColour.cpp:147
#, kde-format
msgid "File:"
msgstr "Fichier :"

#: src/cli/CommandsColour.cpp:148
#, kde-format
msgid "Pages:"
msgstr "Pages :"

#: src/cli/CommandsColour.cpp:149
#, kde-format
msgid "Colour spaces:"
msgstr "Espaces colorimétriques :"

#: src/cli/CommandsColour.cpp:150 src/cli/CommandsColour.cpp:152
#: src/cli/CommandsColour.cpp:165
#, kde-format
msgctxt "@item nothing was found"
msgid "none"
msgstr "aucun"

#: src/cli/CommandsColour.cpp:151
#, kde-format
msgid "Spot colours:"
msgstr "Tons directs :"

#: src/cli/CommandsColour.cpp:154
#, kde-format
msgid "ICC profile:"
msgstr "Profil ICC :"

#: src/cli/CommandsColour.cpp:155
#, kde-format
msgid "Output intent:"
msgstr "Intention de sortie :"

#: src/cli/CommandsColour.cpp:156
#, kde-format
msgid "Transparency:"
msgstr "Transparence :"

#: src/cli/CommandsColour.cpp:157
#, kde-format
msgid "Overprint:"
msgstr "Surimpression :"

#: src/cli/CommandsColour.cpp:158
#, kde-format
msgid "RGB pages:"
msgstr "Pages RGB :"

#: src/cli/CommandsColour.cpp:159 src/cli/CommandsColour.cpp:161
#, kde-format
msgctxt "@info a count out of the whole document"
msgid "%1 of %2"
msgstr "%1 sur %2"

#: src/cli/CommandsColour.cpp:160
#, kde-format
msgid "CMYK pages:"
msgstr "Pages CMYK :"

#: src/cli/CommandsColour.cpp:162
#, kde-format
msgid "Strokes:"
msgstr "Traits :"

#: src/cli/CommandsColour.cpp:163
#, kde-format
msgctxt "@info how many strokes, and the finest of them"
msgid "%1, thinnest %2 pt"
msgstr "%1, le plus fin %2 pt"

#: src/cli/CommandsColour.cpp:166
#, kde-format
msgid "Hairlines:"
msgstr "Filets maigres :"

#: src/cli/CommandsColour.cpp:171
#, kde-format
msgid ""
"%1 stroke is thinner than a quarter point and may vanish in print. "
"“colour hairlines” thickens them."
msgid_plural ""
"%1 strokes are thinner than a quarter point and may vanish in print. "
"“colour hairlines” thickens them."
msgstr[0] ""
"%1 trait est plus fin qu'un quart de point et risque de disparaître à "
"l'impression. « colour hairlines » les épaissit."
msgstr[1] ""
"%1 traits sont plus fins qu'un quart de point et risquent de disparaître "
"à l'impression. « colour hairlines » les épaissit."

#: src/cli/CommandsColour.cpp:179
#, kde-format
msgctxt "@title heading before a list"
msgid "Notes:"
msgstr "Notes :"

#: src/cli/CommandsColour.cpp:193
#, kde-format
msgid "Say what to convert to: --to grey, bw, rgb or cmyk."
msgstr "Indiquez la cible de la conversion : --to grey, bw, rgb ou cmyk."

#: src/cli/CommandsColour.cpp:198
#, kde-format
msgid "“%1” is not a colour target. Use grey, bw, rgb or cmyk."
msgstr "« %1 » n'est pas une cible de couleur. Utilisez grey, bw, rgb ou cmyk."

#: src/cli/CommandsColour.cpp:205
#, kde-format
msgid "--threshold is a brightness between 0 and 1, e.g. 0.5."
msgstr "--threshold est une luminosité comprise entre 0 et 1, par exemple 0.5."

#: src/cli/CommandsColour.cpp:213
#, kde-format
msgid "--quality is a number between 0 and 100."
msgstr "--quality est un nombre compris entre 0 et 100."

#: src/cli/CommandsColour.cpp:236 src/cli/CommandsColour.cpp:292
#: src/cli/CommandsColour.cpp:334 src/cli/CommandsColour.cpp:364
#: src/cli/CommandsColour.cpp:391 src/cli/CommandsConvert.cpp:276
#: src/cli/CommandsConvert.cpp:350 src/cli/CommandsFonts.cpp:423
#: src/cli/CommandsLayout.cpp:464 src/cli/CommandsLayout.cpp:609
#: src/cli/CommandsLayout.cpp:746 src/cli/CommandsLayout.cpp:846
#: src/cli/CommandsLayout.cpp:920 src/cli/CommandsObjects.cpp:327
#: src/cli/CommandsPreflight.cpp:433
#, kde-format
msgid "Wrote %1."
msgstr "%1 a été écrit."

#: src/cli/CommandsColour.cpp:238
#, kde-format
msgid "Nothing in this document needed converting."
msgstr "Rien dans ce document n'avait besoin d'être converti."

#: src/cli/CommandsColour.cpp:244 src/cli/CommandsConvert.cpp:324
#, kde-format
msgctxt "@title heading before a list"
msgid "What happened:"
msgstr "Ce qui s'est passé :"

#: src/cli/CommandsColour.cpp:259
#, kde-format
msgid "Give both colours: --from red --to-colour '#0044cc'."
msgstr "Indiquez les deux couleurs : --from red --to-colour '#0044cc'."

#: src/cli/CommandsColour.cpp:264 src/cli/CommandsColour.cpp:268
#: src/cli/CommandsForm.cpp:274 src/cli/CommandsForm.cpp:590
#: src/cli/CommandsObjects.cpp:298 src/cli/CommandsTypeset.cpp:341
#: src/cli/CommandsTypeset.cpp:541 src/cli/main.cpp:457
#, kde-format
msgid "“%1” is not a colour. Try a name or #rrggbb."
msgstr "« %1 » n'est pas une couleur. Essayez un nom ou #rrggbb."

#: src/cli/CommandsColour.cpp:279
#, kde-format
msgid ""
"--tolerance is a distance in colour between 0 and 1; 0.05 forgives "
"rounding."
msgstr ""
"--tolerance est une distance colorimétrique comprise entre 0 et 1 ; 0.05 "
"tolère les arrondis."

#: src/cli/CommandsColour.cpp:293
#, kde-format
msgid "Replaced %1 colour."
msgid_plural "Replaced %1 colours."
msgstr[0] "%1 couleur a été remplacée."
msgstr[1] "%1 couleurs ont été remplacées."

#: src/cli/CommandsColour.cpp:295
#, kde-format
msgid ""
"Nothing matched. Colours are matched in the drawing operators, not in the "
"pixels of photographs; --tolerance 0.05 forgives the rounding a design "
"tool leaves behind."
msgstr ""
"Aucune correspondance. Les couleurs sont recherchées dans les opérateurs "
"de dessin, pas dans les pixels des photographies ; --tolerance 0.05 "
"tolère les arrondis laissés par un logiciel de création."

#: src/cli/CommandsColour.cpp:314
#, kde-format
msgid "“%1” should look like OLD=NEW, for example “Pantone 300 C=Hausblau”."
msgstr ""
"« %1 » doit ressembler à ANCIEN=NOUVEAU, par exemple « Pantone 300 "
"C=BleuMaison »."

#: src/cli/CommandsColour.cpp:321
#, kde-format
msgid ""
"Say what to do with the inks: --rename OLD=NEW, or --to-process INK to "
"dissolve one into process colour."
msgstr ""
"Indiquez quoi faire des encres : --rename ANCIEN=NOUVEAU, ou --to-process "
"ENCRE pour en dissoudre une dans la quadrichromie."

#: src/cli/CommandsColour.cpp:335
#, kde-format
msgid "Changed %1 separation."
msgid_plural "Changed %1 separations."
msgstr[0] "%1 séparation a été modifiée."
msgstr[1] "%1 séparations ont été modifiées."

#: src/cli/CommandsColour.cpp:337
#, kde-format
msgid ""
"No ink of that name is in this document. “colour inspect” lists the ones "
"that are."
msgstr ""
"Aucune encre de ce nom n'est présente dans ce document. « colour "
"inspect » énumère celles qui le sont."

#: src/cli/CommandsColour.cpp:353
#, kde-format
msgid "--min-width is a stroke width in points, e.g. 0.25."
msgstr "--min-width est une épaisseur de trait en points, par exemple 0.25."

#: src/cli/CommandsColour.cpp:366
#, kde-format
msgid "No stroke was thinner than %1 pt."
msgstr "Aucun trait n'était plus fin que %1 pt."

#: src/cli/CommandsColour.cpp:369
#, kde-format
msgid "Thickened %1 stroke to %2 pt."
msgid_plural "Thickened %1 strokes to %2 pt."
msgstr[0] "%1 trait a été épaissi à %2 pt."
msgstr[1] "%1 traits ont été épaissis à %2 pt."

#: src/cli/CommandsColour.cpp:392
#, kde-format
msgid "Black now overprints in %1 place."
msgid_plural "Black now overprints in %1 places."
msgstr[0] "Le noir est maintenant en surimpression à %1 endroit."
msgstr[1] "Le noir est maintenant en surimpression à %1 endroits."

#: src/cli/CommandsColour.cpp:393
#, kde-format
msgid "Black is now set not to overprint in %1 place."
msgid_plural "Black is now set not to overprint in %1 places."
msgstr[0] "Le noir est maintenant réglé sans surimpression à %1 endroit."
msgstr[1] "Le noir est maintenant réglé sans surimpression à %1 endroits."

#: src/cli/CommandsColour.cpp:428
#, kde-format
msgid "Highest total ink: %1 % of a page."
msgstr "Encrage total le plus élevé : %1 % d'une page."

#: src/cli/CommandsColour.cpp:432
#, kde-format
msgid ""
"Over 300 %, which most presses cannot dry. Ask the print shop for their "
"ink limit."
msgstr ""
"Au-delà de 300 %, ce que la plupart des presses ne peuvent pas faire "
"sécher. Demandez à l'imprimeur sa limite d'encrage."

#: src/cli/CommandsColour.cpp:447
#, kde-format
msgid ""
"Say which plate: --ink Cyan, Magenta, Yellow, Black, or a separation name "
"as “colour inspect” reports it."
msgstr ""
"Indiquez la plaque : --ink Cyan, Magenta, Yellow, Black, ou un nom de "
"séparation tel que « colour inspect » l'indique."

#: src/cli/CommandsColour.cpp:455
#, kde-format
msgid "--page is a page number, counting from 1."
msgstr "--page est un numéro de page, à compter de 1."

#: src/cli/CommandsColour.cpp:459
#, kde-format
msgid "--dpi is a resolution in dots per inch, e.g. 150."
msgstr "--dpi est une résolution en points par pouce, par exemple 150."

#: src/cli/CommandsColour.cpp:476 src/core/Annotation.cpp:1001
#: src/core/BlankPdf.cpp:87 src/ui/RemoteFile.cpp:98
#, kde-format
msgid "“%1” could not be written."
msgstr "Impossible d'écrire « %1 »."

#: src/cli/CommandsColour.cpp:479
#, kde-format
msgid "Wrote the %1 plate of page %2 to %3."
msgstr "La plaque %1 de la page %2 a été écrite dans %3."

#: src/cli/CommandsColour.cpp:480
#, kde-format
msgid "It is an ink density map: black is full ink, white is bare paper."
msgstr ""
"C'est une carte de densité d'encre : le noir correspond à l'encre pleine, "
"le blanc au papier nu."

#: src/cli/CommandsColour.cpp:487
#, kde-format
msgid "“colour limits” takes no file."
msgstr "« colour limits » ne prend aucun fichier."

#: src/cli/CommandsColour.cpp:491
#, kde-format
msgid "This build converts into CMYK itself, given an ICC profile."
msgstr ""
"Cette version convertit elle-même en CMYK, si un profil ICC est fourni."

#: src/cli/CommandsColour.cpp:492
#, kde-format
msgid ""
"This build has no colour management, so converting into CMYK goes through "
"Ghostscript."
msgstr ""
"Cette version n'a pas de gestion des couleurs ; la conversion en CMYK "
"passe donc par Ghostscript."

#: src/cli/CommandsColour.cpp:497
#, kde-format
msgid ""
"No CMYK profile was found on this system. A print job names the profile "
"it wants; pass it with --icc-profile."
msgstr ""
"Aucun profil CMYK n'a été trouvé sur ce système. Un travail d'impression "
"nomme le profil qu'il attend ; fournissez-le avec --icc-profile."

#: src/cli/CommandsColour.cpp:499
#, kde-format
msgid "CMYK profile found on this system: %1"
msgstr "Profil CMYK trouvé sur ce système : %1"

#: src/cli/CommandsColour.cpp:503 src/cli/CommandsConvert.cpp:77
#, kde-format
msgctxt "@title heading before a list"
msgid "What this cannot promise:"
msgstr "Ce que cela ne peut pas garantir :"

#: src/cli/CommandsColour.cpp:509
#, kde-format
msgid "Colour to convert to: grey, bw, rgb or cmyk."
msgstr "Couleur cible de la conversion : grey, bw, rgb ou cmyk."

#: src/cli/CommandsColour.cpp:511
#, kde-format
msgid "For --to bw: brighter than this becomes white, 0 to 1."
msgstr ""
"Pour --to bw : au-dessus de cette luminosité, tout devient blanc, de 0 à "
"1."

#: src/cli/CommandsColour.cpp:512
#, kde-format
msgid "The colour to replace, a name or #rrggbb."
msgstr "La couleur à remplacer, un nom ou #rrggbb."

#: src/cli/CommandsColour.cpp:513
#, kde-format
msgid "The colour to put in its place."
msgstr "La couleur à mettre à sa place."

#: src/cli/CommandsColour.cpp:516
#, kde-format
msgid ""
"Rename a spot colour, as OLD=NEW. Repeat for more; two inks given the "
"same name are merged."
msgstr ""
"Renommer un ton direct, sous la forme ANCIEN=NOUVEAU. À répéter pour "
"d'autres ; deux encres portant le même nom sont fusionnées."

#: src/cli/CommandsColour.cpp:518
#, kde-format
msgid "Dissolve this spot colour into process colour. Repeat for more."
msgstr ""
"Dissoudre ce ton direct dans la quadrichromie. À répéter pour d'autres."

#: src/cli/CommandsColour.cpp:519
#, kde-format
msgid "Thinnest stroke that still prints, in points."
msgstr "Trait le plus fin qui s'imprime encore, en points."

#: src/cli/CommandsColour.cpp:521
#, kde-format
msgid "Turn black overprint off instead of on."
msgstr "Désactiver la surimpression du noir au lieu de l'activer."

#: src/cli/CommandsColour.cpp:523
#, kde-format
msgid ""
"Which plate to render: Cyan, Magenta, Yellow, Black or a separation name."
msgstr ""
"Plaque à générer : Cyan, Magenta, Yellow, Black ou un nom de séparation."

#: src/cli/CommandsColour.cpp:570
#, kde-format
msgid ""
"“colour” needs something to do: inspect, convert, replace, spot, "
"hairlines, overprint, coverage, separate or limits."
msgstr ""
"« colour » a besoin d'une action : inspect, convert, replace, spot, "
"hairlines, overprint, coverage, separate ou limits."

#: src/cli/CommandsColour.cpp:574
#, kde-format
msgid ""
"“colour %1” is not something this can do. Try inspect, convert, replace, "
"spot, hairlines, overprint, coverage, separate or limits."
msgstr ""
"« colour %1 » n'est pas une action possible. Essayez inspect, convert, "
"replace, spot, hairlines, overprint, coverage, separate ou limits."

#: src/cli/CommandsColour.cpp:589
#, kde-format
msgid "What the document does with colour"
msgstr "Ce que le document fait avec la couleur"

#: src/cli/CommandsColour.cpp:590
#, kde-format
msgid "Convert to grey, black and white, RGB or CMYK"
msgstr "Convertir en niveaux de gris, noir et blanc, RGB ou CMYK"

#: src/cli/CommandsColour.cpp:591
#, kde-format
msgid "Swap one colour for another, everywhere"
msgstr "Remplacer une couleur par une autre, partout"

#: src/cli/CommandsColour.cpp:592
#, kde-format
msgid "Rename, merge or dissolve named separations"
msgstr "Renommer, fusionner ou dissoudre des séparations nommées"

#: src/cli/CommandsColour.cpp:593
#, kde-format
msgid "Thicken strokes too thin to print"
msgstr "Épaissir les traits trop fins pour l'impression"

#: src/cli/CommandsColour.cpp:594
#, kde-format
msgid "Set or clear overprint on black"
msgstr "Activer ou désactiver la surimpression du noir"

#: src/cli/CommandsColour.cpp:595
#, kde-format
msgid "Measure the total ink on each page"
msgstr "Mesurer l'encrage total de chaque page"

#: src/cli/CommandsColour.cpp:596
#, kde-format
msgid "Render one printing plate as an image"
msgstr "Générer une plaque d'impression sous forme d'image"

#: src/cli/CommandsColour.cpp:597
#, kde-format
msgid "What the colour work here cannot promise"
msgstr "Ce que le traitement des couleurs ne peut pas garantir ici"

#: src/cli/CommandsConvert.cpp:70
#, kde-format
msgid "Ghostscript is installed, so “to-pdfx” can run on this machine."
msgstr ""
"Ghostscript est installé, « to-pdfx » peut donc fonctionner sur cette "
"machine."

#: src/cli/CommandsConvert.cpp:71
#, kde-format
msgid ""
"Ghostscript is not installed, so “to-pdfx” cannot run on this machine. It "
"comes in the “ghostscript” package."
msgstr ""
"Ghostscript n'est pas installé, « to-pdfx » ne peut donc pas fonctionner "
"sur cette machine. Il est fourni par le paquet « ghostscript »."

#: src/cli/CommandsConvert.cpp:164
#, kde-format
msgid "Wrote %1 page as SVG."
msgid_plural "Wrote %1 pages as SVG."
msgstr[0] "%1 page a été écrite en SVG."
msgstr[1] "%1 pages ont été écrites en SVG."

#: src/cli/CommandsConvert.cpp:168
#, kde-format
msgid ""
"Where pdftocairo did the work the text is still text. Where Ghostscript "
"had to stand in for it, the letters are outlines and no longer searchable."
msgstr ""
"Là où pdftocairo a fait le travail, le texte reste du texte. Là où "
"Ghostscript a dû le remplacer, les lettres sont des contours et ne "
"peuvent plus être recherchées."

#: src/cli/CommandsConvert.cpp:212
#, kde-format
msgid ""
"No table was found. There may be none, or its columns may not line up "
"well enough to be recognised; “to-text” gives the words either way."
msgstr ""
"Aucun tableau n'a été trouvé. Il n'y en a peut-être aucun, ou ses "
"colonnes ne s'alignent pas assez bien pour être reconnues ; « to-text » "
"donne les mots dans tous les cas."

#: src/cli/CommandsConvert.cpp:221
#, kde-format
msgctxt ""
"@info a table that was found: its page, its size and how sure the "
"detection is"
msgid "Page %1  %2 × %3  confidence %4"
msgstr "Page %1  %2 × %3  confiance %4"

#: src/cli/CommandsConvert.cpp:232
#, kde-format
msgid ""
"%1 table found. Confidence is how much of a guess it was; below 0.5, "
"check it against the page."
msgid_plural ""
"%1 tables found. Confidence is how much of a guess each was; below 0.5, "
"check them against the page."
msgstr[0] ""
"%1 tableau trouvé. La confiance indique la part de supposition ; en "
"dessous de 0.5, vérifiez-le sur la page."
msgstr[1] ""
"%1 tableaux trouvés. La confiance indique la part de supposition pour "
"chacun ; en dessous de 0.5, vérifiez-les sur la page."

#: src/cli/CommandsConvert.cpp:267
#, kde-format
msgid ""
"No table was found in this document. There may be none, or its columns "
"may not line up well enough to be recognised; “tables” shows what was "
"considered."
msgstr ""
"Aucun tableau n'a été trouvé dans ce document. Il n'y en a peut-être "
"aucun, ou ses colonnes ne s'alignent pas assez bien pour être reconnues ; "
"« tables » montre ce qui a été examiné."

#: src/cli/CommandsConvert.cpp:277
#, kde-format
msgid ""
"%1 table, taken from where the text sits and not from any structure in "
"the file."
msgid_plural ""
"%1 tables, separated by a blank line, taken from where the text sits and "
"not from any structure in the file."
msgstr[0] ""
"%1 tableau, déduit de la position du texte et non d'une structure du "
"fichier."
msgstr[1] ""
"%1 tableaux, séparés par une ligne vide, déduits de la position du texte "
"et non d'une structure du fichier."

#: src/cli/CommandsConvert.cpp:301
#, kde-format
msgid ""
"Ghostscript is not installed, and it does the conversion to PDF/X. "
"Install the “ghostscript” package and try again."
msgstr ""
"Ghostscript n'est pas installé, et c'est lui qui effectue la conversion "
"en PDF/X. Installez le paquet « ghostscript » et réessayez."

#: src/cli/CommandsConvert.cpp:308
#, kde-format
msgid "“%1” is not a PDF/X level. Use x1a, x3 or x4."
msgstr "« %1 » n'est pas un niveau PDF/X. Utilisez x1a, x3 ou x4."

#: src/cli/CommandsConvert.cpp:320 src/cli/main.cpp:902
#, kde-format
msgid "Wrote %1 as %2."
msgstr "%1 a été écrit en %2."

#: src/cli/CommandsConvert.cpp:326 src/cli/CommandsConvert.cpp:385
#: src/cli/CommandsConvert.cpp:392 src/cli/CommandsFonts.cpp:410
#: src/cli/CommandsForm.cpp:941 src/cli/CommandsImages.cpp:839
#: src/cli/CommandsObjects.cpp:321 src/cli/CommandsTypeset.cpp:738
#: src/cli/main.cpp:910 src/cli/main.cpp:1268 src/cli/main.cpp:1368
#: src/cli/main.cpp:1551 src/cli/main.cpp:1790
#, kde-format
msgid "Note: %1"
msgstr "Remarque : %1"

#: src/cli/CommandsConvert.cpp:353
#, kde-format
msgid ""
"A reader can now show page one before it has the rest. That is worth "
"nothing on a local disk and a great deal over a slow link; the file "
"itself is no smaller."
msgstr ""
"Un lecteur peut maintenant afficher la première page avant d'avoir le "
"reste. Cela ne vaut rien sur un disque local et beaucoup sur une liaison "
"lente ; le fichier lui-même n'est pas plus petit."

#: src/cli/CommandsConvert.cpp:373
#, kde-format
msgid "Say which version the header should claim: --pdf-version 1.7."
msgstr "Indiquez la version que l'en-tête doit annoncer : --pdf-version 1.7."

#: src/cli/CommandsConvert.cpp:390
#, kde-format
msgid "Wrote %1, claiming PDF %2."
msgstr "%1 a été écrit, annonçant PDF %2."

#: src/cli/CommandsConvert.cpp:402
#, kde-format
msgid "Which PDF/X to write: x1a, x3 or x4. Most printers still ask for x1a."
msgstr ""
"Quel PDF/X écrire : x1a, x3 ou x4. La plupart des imprimeurs demandent "
"encore x1a."

#: src/cli/CommandsConvert.cpp:405
#, kde-format
msgid "The version the PDF header should claim, e.g. 1.7."
msgstr "La version que l'en-tête PDF doit annoncer, par exemple 1.7."

#: src/cli/CommandsConvert.cpp:445
#, kde-format
msgid "Draw each page as an SVG file"
msgstr "Dessiner chaque page dans un fichier SVG"

#: src/cli/CommandsConvert.cpp:446
#, kde-format
msgid "Show the tables it can find, and how sure it is"
msgstr "Afficher les tableaux détectés et le degré de certitude"

#: src/cli/CommandsConvert.cpp:447
#, kde-format
msgid "Write those tables out as comma-separated values"
msgstr "Écrire ces tableaux en valeurs séparées par des virgules"

#: src/cli/CommandsConvert.cpp:448
#, kde-format
msgid "Convert to PDF/X for a commercial printer"
msgstr "Convertir en PDF/X pour un imprimeur professionnel"

#: src/cli/CommandsConvert.cpp:449
#, kde-format
msgid "Rewrite so page one arrives over a slow link first"
msgstr ""
"Réécrire pour que la première page arrive d'abord sur une liaison lente"

#: src/cli/CommandsConvert.cpp:450
#, kde-format
msgid "Set the PDF version the header claims"
msgstr "Définir la version PDF annoncée par l'en-tête"

#: src/cli/CommandsFonts.cpp:166 src/ui/ToolFontsDialog.cpp:65
#, kde-format
msgctxt "@item a font with no /BaseFont"
msgid "unnamed"
msgstr "sans nom"

#: src/cli/CommandsFonts.cpp:164
#, kde-format
msgctxt "@item a font, the name a page calls it by, and where it is used"
msgid "%2 (%3, page %4)"
msgid_plural "%2 (%3, pages %4)"
msgstr[0] "%2 (%3, page %4)"
msgstr[1] "%2 (%3, pages %4)"

