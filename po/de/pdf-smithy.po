#, kde-format
msgid ""
"“%1” has no rectangle. Give it as \"rect\": { \"x\": 72, \"y\": 700, "
"\"width\": 200, \"height\": 18 }."
msgstr ""
"„%1“ hat kein Rechteck. Geben Sie es als \"rect\": { \"x\": 72, \"y\": 700, "
"\"width\": 200, \"height\": 18 } an."

#: src/cli/CommandsForm.cpp:677 src/cli/main.cpp:1302
