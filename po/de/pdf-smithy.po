#, kde-format
msgid "Overprint:"
msgstr "Überdrucken:"

#: src/cli/CommandsColour.cpp:158
#, kde-format
msgid "RGB pages:"
msgstr "RGB-Seiten:"

#: src/cli/CommandsColour.cpp:159 src/cli/CommandsColour.cpp:161
#, kde-format
msgctxt "@info a count out of the whole document"
msgid "%1 of %2"
msgstr "%1 von %2"

#: src/cli/CommandsColour.cpp:160
#, kde-format
msgid "CMYK pages:"
msgstr "CMYK-Seiten:"

#: src/cli/CommandsColour.cpp:162
#, kde-format
msgid "Strokes:"
msgstr "Linien:"

#: src/cli/CommandsColour.cpp:163
#, kde-format
msgctxt "@info how many strokes, and the finest of them"
msgid "%1, thinnest %2 pt"
msgstr "%1, dünnste %2 pt"

#: src/cli/CommandsColour.cpp:166
#, kde-format
msgid "Hairlines:"
msgstr "Haarlinien:"

#: src/cli/CommandsColour.cpp:171
#, kde-format
msgid ""
"%1 stroke is thinner than a quarter point and may vanish in print. “colour "
"hairlines” thickens them."
msgid_plural ""
"%1 strokes are thinner than a quarter point and may vanish in print. “colour "
"hairlines” thickens them."
msgstr[0] ""
"%1 Linie ist dünner als ein viertel Punkt und kann im Druck verschwinden. "
"„colour hairlines“ verstärkt sie."
msgstr[1] ""
"%1 Linien sind dünner als ein viertel Punkt und können im Druck "
"verschwinden. „colour hairlines“ verstärkt sie."

#: src/cli/CommandsColour.cpp:179
#, kde-format
msgctxt "@title heading before a list"
msgid "Notes:"
msgstr "Hinweise:"

#: src/cli/CommandsColour.cpp:193
#, kde-format
msgid "Say what to convert to: --to grey, bw, rgb or cmyk."
msgstr "Angeben, wohin umgewandelt werden soll: --to grey, bw, rgb oder cmyk."

#: src/cli/CommandsColour.cpp:198
#, kde-format
msgid "“%1” is not a colour target. Use grey, bw, rgb or cmyk."
msgstr "„%1“ ist kein Farbziel. Möglich sind grey, bw, rgb oder cmyk."

#: src/cli/CommandsColour.cpp:205
#, kde-format
msgid "--threshold is a brightness between 0 and 1, e.g. 0.5."
msgstr "--threshold ist eine Helligkeit zwischen 0 und 1, z. B. 0.5."

#: src/cli/CommandsColour.cpp:213
#, kde-format
msgid "--quality is a number between 0 and 100."
msgstr "--quality ist eine Zahl zwischen 0 und 100."

#: src/cli/CommandsColour.cpp:236 src/cli/CommandsColour.cpp:292
#: src/cli/CommandsColour.cpp:334 src/cli/CommandsColour.cpp:364
#: src/cli/CommandsColour.cpp:391 src/cli/CommandsConvert.cpp:276
#: src/cli/CommandsConvert.cpp:350 src/cli/CommandsFonts.cpp:423
#: src/cli/CommandsLayout.cpp:464 src/cli/CommandsLayout.cpp:609
#: src/cli/CommandsLayout.cpp:746 src/cli/CommandsLayout.cpp:846
#: src/cli/CommandsLayout.cpp:920 src/cli/CommandsObjects.cpp:327
#: src/cli/CommandsPreflight.cpp:433
#, kde-format
msgid "Wrote %1."
msgstr "%1 geschrieben."

#: src/cli/CommandsColour.cpp:238
#, kde-format
msgid "Nothing in this document needed converting."
msgstr "In diesem Dokument musste nichts umgewandelt werden."

#: src/cli/CommandsColour.cpp:244 src/cli/CommandsConvert.cpp:324
#, kde-format
msgctxt "@title heading before a list"
msgid "What happened:"
msgstr "Was geschehen ist:"

#: src/cli/CommandsColour.cpp:259
#, kde-format
msgid "Give both colours: --from red --to-colour '#0044cc'."
msgstr "Geben Sie beide Farben an: --from red --to-colour '#0044cc'."

#: src/cli/CommandsColour.cpp:264 src/cli/CommandsColour.cpp:268
#: src/cli/CommandsForm.cpp:274 src/cli/CommandsForm.cpp:590
#: src/cli/CommandsObjects.cpp:298 src/cli/CommandsTypeset.cpp:341
#: src/cli/CommandsTypeset.cpp:541 src/cli/main.cpp:457
#, kde-format
msgid "“%1” is not a colour. Try a name or #rrggbb."
msgstr "„%1“ ist keine Farbe. Möglich sind ein Name oder #rrggbb."

#: src/cli/CommandsColour.cpp:279
#, kde-format
msgid ""
"--tolerance is a distance in colour between 0 and 1; 0.05 forgives rounding."
msgstr ""
"--tolerance ist ein Farbabstand zwischen 0 und 1; 0.05 verzeiht Rundungen."

#: src/cli/CommandsColour.cpp:293
#, kde-format
msgid "Replaced %1 colour."
msgid_plural "Replaced %1 colours."
msgstr[0] "%1 Farbe ersetzt."
msgstr[1] "%1 Farben ersetzt."

#: src/cli/CommandsColour.cpp:295
#, kde-format
msgid ""
"Nothing matched. Colours are matched in the drawing operators, not in the "
"pixels of photographs; --tolerance 0.05 forgives the rounding a design tool "
"leaves behind."
msgstr ""
"Nichts hat gepasst. Farben werden in den Zeichenbefehlen verglichen, nicht "
"in den Bildpunkten von Fotos; --tolerance 0.05 verzeiht die Rundung, die ein "
"Layoutprogramm hinterlässt."

#: src/cli/CommandsColour.cpp:314
#, kde-format
msgid "“%1” should look like OLD=NEW, for example “Pantone 300 C=Hausblau”."
msgstr ""
"„%1“ sollte wie ALT=NEU aussehen, zum Beispiel „Pantone 300 C=Hausblau“."

#: src/cli/CommandsColour.cpp:321
#, kde-format
msgid ""
"Say what to do with the inks: --rename OLD=NEW, or --to-process INK to "
"dissolve one into process colour."
msgstr ""
"Sagen Sie, was mit den Druckfarben geschehen soll: --rename ALT=NEU oder --"
"to-process DRUCKFARBE, um eine davon in Prozessfarbe aufzulösen."

#: src/cli/CommandsColour.cpp:335
#, kde-format
msgid "Changed %1 separation."
msgid_plural "Changed %1 separations."
msgstr[0] "%1 Separation geändert."
msgstr[1] "%1 Separationen geändert."

#: src/cli/CommandsColour.cpp:337
#, kde-format
msgid ""
"No ink of that name is in this document. “colour inspect” lists the ones "
"that are."
msgstr ""
"Eine Druckfarbe dieses Namens gibt es in diesem Dokument nicht. „colour "
"inspect“ listet die vorhandenen auf."

#: src/cli/CommandsColour.cpp:353
#, kde-format
msgid "--min-width is a stroke width in points, e.g. 0.25."
msgstr "--min-width ist eine Linienstärke in Punkt, z. B. 0.25."

#: src/cli/CommandsColour.cpp:366
#, kde-format
msgid "No stroke was thinner than %1 pt."
msgstr "Keine Linie war dünner als %1 pt."

#: src/cli/CommandsColour.cpp:369
#, kde-format
msgid "Thickened %1 stroke to %2 pt."
msgid_plural "Thickened %1 strokes to %2 pt."
msgstr[0] "%1 Linie auf %2 pt verstärkt."
msgstr[1] "%1 Linien auf %2 pt verstärkt."

#: src/cli/CommandsColour.cpp:392
#, kde-format
msgid "Black now overprints in %1 place."
msgid_plural "Black now overprints in %1 places."
msgstr[0] "Schwarz überdruckt jetzt an %1 Stelle."
msgstr[1] "Schwarz überdruckt jetzt an %1 Stellen."

#: src/cli/CommandsColour.cpp:393
#, kde-format
msgid "Black is now set not to overprint in %1 place."
msgid_plural "Black is now set not to overprint in %1 places."
msgstr[0] "Schwarz ist jetzt an %1 Stelle auf Aussparen gesetzt."
msgstr[1] "Schwarz ist jetzt an %1 Stellen auf Aussparen gesetzt."

#: src/cli/CommandsColour.cpp:428
#, kde-format
msgid "Highest total ink: %1 % of a page."
msgstr "Höchste Gesamtdeckung: %1 % einer Seite."

#: src/cli/CommandsColour.cpp:432
#, kde-format
msgid ""
"Over 300 %, which most presses cannot dry. Ask the print shop for their ink "
"limit."
msgstr ""
"Über 300 %, das bekommen die meisten Druckmaschinen nicht trocken. Fragen "
"Sie die Druckerei nach ihrer Deckungsgrenze."

#: src/cli/CommandsColour.cpp:447
#, kde-format
msgid ""
"Say which plate: --ink Cyan, Magenta, Yellow, Black, or a separation name as "
"“colour inspect” reports it."
msgstr ""
"Sagen Sie, welche Druckplatte: --ink Cyan, Magenta, Yellow, Black oder ein "
"Separationsname, wie ihn „colour inspect“ meldet."

#: src/cli/CommandsColour.cpp:455
#, kde-format
msgid "--page is a page number, counting from 1."
msgstr "--page ist eine Seitenzahl, gezählt ab 1."

#: src/cli/CommandsColour.cpp:459
#, kde-format
msgid "--dpi is a resolution in dots per inch, e.g. 150."
msgstr "--dpi ist eine Auflösung in Punkten pro Zoll, z. B. 150."

#: src/cli/CommandsColour.cpp:476 src/core/Annotation.cpp:1001
#: src/core/BlankPdf.cpp:87 src/ui/RemoteFile.cpp:98
#, kde-format
msgid "“%1” could not be written."
msgstr "„%1“ konnte nicht geschrieben werden."

#: src/cli/CommandsColour.cpp:479
#, kde-format
msgid "Wrote the %1 plate of page %2 to %3."
msgstr "Druckplatte %1 von Seite %2 nach %3 geschrieben."

#: src/cli/CommandsColour.cpp:480
#, kde-format
msgid "It is an ink density map: black is full ink, white is bare paper."
msgstr ""
"Es ist eine Karte der Farbdichte: Schwarz ist volle Deckung, Weiß ist "
"blankes Papier."

#: src/cli/CommandsColour.cpp:487
#, kde-format
msgid "“colour limits” takes no file."
msgstr "„colour limits“ nimmt keine Datei."

#: src/cli/CommandsColour.cpp:491
#, kde-format
msgid "This build converts into CMYK itself, given an ICC profile."
msgstr ""
"Diese Fassung wandelt selbst nach CMYK um, sofern ein ICC-Profil vorliegt."

#: src/cli/CommandsColour.cpp:492
#, kde-format
msgid ""
"This build has no colour management, so converting into CMYK goes through "
"Ghostscript."
msgstr ""
"Diese Fassung hat kein Farbmanagement, die Umwandlung nach CMYK läuft daher "
"über Ghostscript."

#: src/cli/CommandsColour.cpp:497
#, kde-format
msgid ""
"No CMYK profile was found on this system. A print job names the profile it "
"wants; pass it with --icc-profile."
msgstr ""
"Auf diesem System wurde kein CMYK-Profil gefunden. Ein Druckauftrag nennt "
"das Profil, das er verlangt; geben Sie es mit --icc-profile an."

#: src/cli/CommandsColour.cpp:499
#, kde-format
msgid "CMYK profile found on this system: %1"
msgstr "Auf diesem System gefundenes CMYK-Profil: %1"

#: src/cli/CommandsColour.cpp:503 src/cli/CommandsConvert.cpp:77
#, kde-format
msgctxt "@title heading before a list"
msgid "What this cannot promise:"
msgstr "Was dies nicht zusichern kann:"

#: src/cli/CommandsColour.cpp:509
#, kde-format
msgid "Colour to convert to: grey, bw, rgb or cmyk."
msgstr "Farbe, in die umgewandelt wird: grey, bw, rgb oder cmyk."

#: src/cli/CommandsColour.cpp:511
#, kde-format
msgid "For --to bw: brighter than this becomes white, 0 to 1."
msgstr "Für --to bw: Was heller ist als dies, wird weiß; 0 bis 1."

#: src/cli/CommandsColour.cpp:512
#, kde-format
msgid "The colour to replace, a name or #rrggbb."
msgstr "Die zu ersetzende Farbe, Name oder #rrggbb."

#: src/cli/CommandsColour.cpp:513
#, kde-format
msgid "The colour to put in its place."
msgstr "Die Farbe, die an ihre Stelle tritt."

#: src/cli/CommandsColour.cpp:516
#, kde-format
msgid ""
"Rename a spot colour, as OLD=NEW. Repeat for more; two inks given the same "
"name are merged."
msgstr ""
"Eine Sonderfarbe umbenennen, als ALT=NEU. Mehrfach angebbar; zwei "
"Druckfarben mit demselben Namen werden zusammengeführt."

#: src/cli/CommandsColour.cpp:518
#, kde-format
msgid "Dissolve this spot colour into process colour. Repeat for more."
msgstr "Diese Sonderfarbe in Prozessfarbe auflösen. Mehrfach angebbar."

#: src/cli/CommandsColour.cpp:519
#, kde-format
msgid "Thinnest stroke that still prints, in points."
msgstr "Dünnste Linie, die noch druckt, in Punkt."

#: src/cli/CommandsColour.cpp:521
#, kde-format
msgid "Turn black overprint off instead of on."
msgstr "Überdrucken von Schwarz aus- statt einschalten."

#: src/cli/CommandsColour.cpp:523
#, kde-format
msgid ""
"Which plate to render: Cyan, Magenta, Yellow, Black or a separation name."
msgstr ""
"Welche Druckplatte gezeichnet wird: Cyan, Magenta, Yellow, Black oder ein "
"Separationsname."

#: src/cli/CommandsColour.cpp:570
#, kde-format
msgid ""
"“colour” needs something to do: inspect, convert, replace, spot, hairlines, "
"overprint, coverage, separate or limits."
msgstr ""
"„colour“ benötigt eine Aufgabe: inspect, convert, replace, spot, hairlines, "
"overprint, coverage, separate oder limits."

#: src/cli/CommandsColour.cpp:574
#, kde-format
msgid ""
"“colour %1” is not something this can do. Try inspect, convert, replace, "
"spot, hairlines, overprint, coverage, separate or limits."
msgstr ""
"„colour %1“ gibt es hier nicht. Möglich sind inspect, convert, replace, "
"spot, hairlines, overprint, coverage, separate oder limits."

#: src/cli/CommandsColour.cpp:589
#, kde-format
msgid "What the document does with colour"
msgstr "Was das Dokument mit Farbe macht"

#: src/cli/CommandsColour.cpp:590
#, kde-format
msgid "Convert to grey, black and white, RGB or CMYK"
msgstr "In Graustufen, Schwarzweiß, RGB oder CMYK umwandeln"

#: src/cli/CommandsColour.cpp:591
#, kde-format
msgid "Swap one colour for another, everywhere"
msgstr "Eine Farbe überall gegen eine andere tauschen"

#: src/cli/CommandsColour.cpp:592
#, kde-format
msgid "Rename, merge or dissolve named separations"
msgstr "Benannte Separationen umbenennen, zusammenführen oder auflösen"

#: src/cli/CommandsColour.cpp:593
#, kde-format
msgid "Thicken strokes too thin to print"
msgstr "Linien verstärken, die zum Drucken zu dünn sind"

#: src/cli/CommandsColour.cpp:594
#, kde-format
msgid "Set or clear overprint on black"
msgstr "Überdrucken von Schwarz setzen oder entfernen"

#: src/cli/CommandsColour.cpp:595
#, kde-format
msgid "Measure the total ink on each page"
msgstr "Die Gesamtdeckung jeder Seite messen"

#: src/cli/CommandsColour.cpp:596
#, kde-format
msgid "Render one printing plate as an image"
msgstr "Eine Druckplatte als Bild zeichnen"

#: src/cli/CommandsColour.cpp:597
#, kde-format
msgid "What the colour work here cannot promise"
msgstr "Was die Farbarbeit hier nicht versprechen kann"

#: src/cli/CommandsConvert.cpp:70
#, kde-format
msgid "Ghostscript is installed, so “to-pdfx” can run on this machine."
msgstr ""
"Ghostscript ist installiert, „to-pdfx“ kann auf diesem Rechner also laufen."

#: src/cli/CommandsConvert.cpp:71
#, kde-format
msgid ""
"Ghostscript is not installed, so “to-pdfx” cannot run on this machine. It "
"comes in the “ghostscript” package."
msgstr ""
"Ghostscript ist nicht installiert, „to-pdfx“ kann auf diesem Rechner also "
"nicht laufen. Es steckt im Paket „ghostscript“."

#: src/cli/CommandsConvert.cpp:164
#, kde-format
msgid "Wrote %1 page as SVG."
msgid_plural "Wrote %1 pages as SVG."
msgstr[0] "%1 Seite als SVG geschrieben."
msgstr[1] "%1 Seiten als SVG geschrieben."

#: src/cli/CommandsConvert.cpp:168
#, kde-format
msgid ""
"Where pdftocairo did the work the text is still text. Where Ghostscript had "
"to stand in for it, the letters are outlines and no longer searchable."
msgstr ""
"Wo pdftocairo die Arbeit erledigt hat, ist der Text noch Text. Wo "
"Ghostscript einspringen musste, sind die Buchstaben Umrisse und nicht mehr "
"durchsuchbar."

#: src/cli/CommandsConvert.cpp:212
#, kde-format
msgid ""
"No table was found. There may be none, or its columns may not line up well "
"enough to be recognised; “to-text” gives the words either way."
msgstr ""
"Es wurde keine Tabelle gefunden. Es gibt vielleicht keine, oder ihre Spalten "
"fluchten nicht genau genug, um erkannt zu werden; „to-text“ liefert die "
"Wörter in jedem Fall."

#: src/cli/CommandsConvert.cpp:221
#, kde-format
msgctxt ""
"@info a table that was found: its page, its size and how sure the detection "
"is"
msgid "Page %1  %2 × %3  confidence %4"
msgstr "Seite %1  %2 × %3  Verlässlichkeit %4"

#: src/cli/CommandsConvert.cpp:232
#, kde-format
msgid ""
"%1 table found. Confidence is how much of a guess it was; below 0.5, check "
"it against the page."
msgid_plural ""
"%1 tables found. Confidence is how much of a guess each was; below 0.5, "
"check them against the page."
msgstr[0] ""
"%1 Tabelle gefunden. Die Verlässlichkeit sagt, wie sehr sie geraten war; "
"unter 0,5 vergleichen Sie sie mit der Seite."
msgstr[1] ""
"%1 Tabellen gefunden. Die Verlässlichkeit sagt, wie sehr jede davon geraten "
"war; unter 0,5 vergleichen Sie sie mit der Seite."

#: src/cli/CommandsConvert.cpp:267
#, kde-format
msgid ""
"No table was found in this document. There may be none, or its columns may "
"not line up well enough to be recognised; “tables” shows what was considered."
msgstr ""
"In diesem Dokument wurde keine Tabelle gefunden. Es gibt vielleicht keine, "
"oder ihre Spalten fluchten nicht genau genug, um erkannt zu werden; „tables“ "
"zeigt, was in Betracht kam."

#: src/cli/CommandsConvert.cpp:277
#, kde-format
msgid ""
"%1 table, taken from where the text sits and not from any structure in the "
"file."
msgid_plural ""
"%1 tables, separated by a blank line, taken from where the text sits and not "
"from any structure in the file."
msgstr[0] ""
"%1 Tabelle, gewonnen aus der Lage des Textes und nicht aus einer Struktur in "
"der Datei."
msgstr[1] ""
"%1 Tabellen, durch eine Leerzeile getrennt, gewonnen aus der Lage des Textes "
"und nicht aus einer Struktur in der Datei."

#: src/cli/CommandsConvert.cpp:301
#, kde-format
msgid ""
"Ghostscript is not installed, and it does the conversion to PDF/X. Install "
"the “ghostscript” package and try again."
msgstr ""
"Ghostscript ist nicht installiert, und es erledigt die Umwandlung nach PDF/"
"X. Installieren Sie das Paket „ghostscript“ und versuchen Sie es erneut."

#: src/cli/CommandsConvert.cpp:308
#, kde-format
msgid "“%1” is not a PDF/X level. Use x1a, x3 or x4."
msgstr "„%1“ ist keine PDF/X-Stufe. Möglich sind x1a, x3 oder x4."

#: src/cli/CommandsConvert.cpp:320 src/cli/main.cpp:902
#, kde-format
msgid "Wrote %1 as %2."
msgstr "%1 als %2 geschrieben."

#: src/cli/CommandsConvert.cpp:326 src/cli/CommandsConvert.cpp:385
#: src/cli/CommandsConvert.cpp:392 src/cli/CommandsFonts.cpp:410
#: src/cli/CommandsForm.cpp:941 src/cli/CommandsImages.cpp:839
#: src/cli/CommandsObjects.cpp:321 src/cli/CommandsTypeset.cpp:738
#: src/cli/main.cpp:910 src/cli/main.cpp:1268 src/cli/main.cpp:1368
#: src/cli/main.cpp:1551 src/cli/main.cpp:1790
#, kde-format
msgid "Note: %1"
msgstr "Hinweis: %1"

#: src/cli/CommandsConvert.cpp:353
#, kde-format
msgid ""
"A reader can now show page one before it has the rest. That is worth nothing "
"on a local disk and a great deal over a slow link; the file itself is no "
"smaller."
msgstr ""
"Ein Leseprogramm kann jetzt Seite eins anzeigen, bevor es den Rest hat. Auf "
"einer lokalen Platte ist das nichts wert, über eine langsame Leitung sehr "
"viel; die Datei selbst wird dadurch nicht kleiner."

#: src/cli/CommandsConvert.cpp:373
#, kde-format
msgid "Say which version the header should claim: --pdf-version 1.7."
msgstr ""
"Sagen Sie, welche Version der Dateikopf angeben soll: --pdf-version 1.7."

#: src/cli/CommandsConvert.cpp:390
#, kde-format
msgid "Wrote %1, claiming PDF %2."
msgstr "%1 geschrieben, ausgewiesen als PDF %2."

#: src/cli/CommandsConvert.cpp:402
#, kde-format
msgid "Which PDF/X to write: x1a, x3 or x4. Most printers still ask for x1a."
msgstr ""
"Welches PDF/X geschrieben wird: x1a, x3 oder x4. Die meisten Druckereien "
"verlangen weiterhin x1a."

#: src/cli/CommandsConvert.cpp:405
#, kde-format
msgid "The version the PDF header should claim, e.g. 1.7."
msgstr "Die Version, die der PDF-Dateikopf angeben soll, z. B. 1.7."

#: src/cli/CommandsConvert.cpp:445
#, kde-format
msgid "Draw each page as an SVG file"
msgstr "Jede Seite als SVG-Datei zeichnen"

#: src/cli/CommandsConvert.cpp:446
#, kde-format
msgid "Show the tables it can find, and how sure it is"
msgstr ""
"Zeigen, welche Tabellen sich finden lassen, und wie verlässlich das ist"

#: src/cli/CommandsConvert.cpp:447
#, kde-format
msgid "Write those tables out as comma-separated values"
msgstr "Diese Tabellen als kommagetrennte Werte herausschreiben"

#: src/cli/CommandsConvert.cpp:448
#, kde-format
msgid "Convert to PDF/X for a commercial printer"
msgstr "In PDF/X für eine Druckerei umwandeln"

#: src/cli/CommandsConvert.cpp:449
#, kde-format
msgid "Rewrite so page one arrives over a slow link first"
msgstr ""
"So umschreiben, dass Seite eins über eine langsame Leitung zuerst ankommt"

#: src/cli/CommandsConvert.cpp:450
#, kde-format
msgid "Set the PDF version the header claims"
msgstr "Die PDF-Version setzen, die der Dateikopf angibt"

#: src/cli/CommandsFonts.cpp:166 src/ui/ToolFontsDialog.cpp:65
#, kde-format
msgctxt "@item a font with no /BaseFont"
msgid "unnamed"
msgstr "unbenannt"

#: src/cli/CommandsFonts.cpp:164
#, kde-format
msgctxt "@item a font, the name a page calls it by, and where it is used"
msgid "%2 (%3, page %4)"
msgid_plural "%2 (%3, pages %4)"
msgstr[0] "%2 (%3, Seite %4)"
msgstr[1] "%2 (%3, Seiten %4)"

#: src/cli/CommandsFonts.cpp:196 src/ui/ToolFontsDialog.cpp:375
#, kde-format
msgid ""
