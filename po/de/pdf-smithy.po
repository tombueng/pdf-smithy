#: src/cli/CommandsObjects.cpp:424
#, kde-format
msgid ""
"Give a point with --at X,Y, or an area with --area X,Y,WIDTH,HEIGHT, in "
"points from the bottom-left corner of the page."
msgstr ""
"Geben Sie mit --at X,Y einen Punkt an oder mit --area X,Y,BREITE,HÖHE einen "
"Bereich, in Punkt von der linken unteren Ecke der Seite."

#: src/cli/CommandsObjects.cpp:434 src/cli/CommandsObjects.cpp:600
#, kde-format
msgid ""
"“%1” is not a point. The form is X,Y, in points from the bottom-left corner "
"of the page."
msgstr ""
"„%1“ ist kein Punkt. Die Form lautet X,Y, in Punkt von der linken unteren "
"Ecke der Seite."

#: src/cli/CommandsObjects.cpp:457
#, kde-format
msgid ""
"“%1” is not an area. The form is X,Y,WIDTH,HEIGHT, in points from the bottom-"
"left corner of the page."
msgstr ""
"„%1“ ist kein Bereich. Die Form lautet X,Y,BREITE,HÖHE, in Punkt von der "
"linken unteren Ecke der Seite."

#: src/cli/CommandsObjects.cpp:513
#, kde-format
msgid "Nothing is drawn at %1, %2 on page %3."
msgstr "Bei %1, %2 auf Seite %3 ist nichts gezeichnet."

#: src/cli/CommandsObjects.cpp:514
#, kde-format
