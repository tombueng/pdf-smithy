msgstr "Auswahl: %1"

#: src/cli/CommandsForm.cpp:715
#, kde-format
msgid "label: %1"
msgstr "Beschriftung: %1"

#: src/cli/CommandsForm.cpp:718
#, kde-format
msgid "%1 field."
msgid_plural "%1 fields."
msgstr[0] "%1 Feld."
msgstr[1] "%1 Felder."

#: src/cli/CommandsForm.cpp:730
#, kde-format
msgid ""
"Note: a radio group takes its labels from --options, so --tooltip is not "
"used for it."
msgstr ""
"Hinweis: Eine Optionsschaltergruppe nimmt ihre Beschriftungen aus --options, "
"--tooltip wird für sie daher nicht verwendet."

#: src/cli/CommandsForm.cpp:740
#, kde-format
