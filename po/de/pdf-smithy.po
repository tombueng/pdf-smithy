#: src/ui/ToolFontsDialog.cpp:295
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"What the selected font lets this document address. Text edited in that font "
"can use these characters and no others, unless a font is added."
msgstr ""
"Was die gewählte Schrift dieses Dokument ansprechen lässt. In dieser Schrift "
"bearbeiteter Text kann diese Zeichen verwenden und keine anderen, solange "
"keine Schrift hinzukommt."

#: src/ui/ToolFontsDialog.cpp:299 src/ui/ToolLayoutDialog.cpp:440
