#, kde-format
msgctxt "@item nothing was found"
msgid "none"
msgstr "keine"

#: src/cli/CommandsColour.cpp:151
#, kde-format
msgid "Spot colours:"
msgstr "Sonderfarben:"

#: src/cli/CommandsColour.cpp:154
#, kde-format
msgid "ICC profile:"
msgstr "ICC-Profil:"

#: src/cli/CommandsColour.cpp:155
