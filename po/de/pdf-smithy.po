#: src/core/Preflight.cpp:2646 src/core/Preflight.cpp:2932
#: src/core/ScanProcessor.cpp:319
#, kde-format
msgid "Cannot write to “%1”."
msgstr "In „%1“ kann nicht geschrieben werden."

