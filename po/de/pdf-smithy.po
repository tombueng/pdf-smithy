#: src/cli/CommandsLayout.cpp:502
#, kde-format
msgid "Brought every page to one size. Wrote %1."
msgstr "Alle Seiten auf ein Format gebracht. %1 geschrieben."

#: src/cli/CommandsLayout.cpp:514
#, kde-format
msgid ""
"layout bleed needs a bleed (--bleed), in millimetres. Three is the usual "
"answer."
msgstr ""
"layout bleed benötigt einen Anschnitt (--bleed), in Millimetern. Üblich sind "
"drei."

#: src/cli/CommandsLayout.cpp:520 src/cli/CommandsLayout.cpp:568
#: src/cli/CommandsLayout.cpp:574 src/cli/CommandsLayout.cpp:700
#, kde-format
msgid ""
"“%1” is not a length. Give millimetres, or a number with mm, cm, in or pt "
"after it."
msgstr ""
"„%1“ ist keine Länge. Geben Sie Millimeter an oder eine Zahl mit mm, cm, in "
"oder pt dahinter."

#: src/cli/CommandsLayout.cpp:537
#, kde-format
msgctxt "@info"
msgid "Gave %1 page a %2 mm bleed."
msgid_plural "Gave %1 pages a %2 mm bleed."
msgstr[0] "%1 Seite %2 mm Anschnitt gegeben."
msgstr[1] "%1 Seiten %2 mm Anschnitt gegeben."

#: src/cli/CommandsLayout.cpp:540
#, kde-format
msgid ""
"The trim is what the pages showed before; the sheet grew where it had to. "
"Wrote %1."
msgstr ""
"Das Endformat ist das, was die Seiten vorher zeigten; das Blatt ist "
"gewachsen, wo es musste. %1 geschrieben."

#: src/cli/CommandsLayout.cpp:555
#, kde-format
msgid "layout marks marks every page; leave --pages off."
msgstr "layout marks versieht jede Seite mit Marken; lassen Sie --pages weg."

#: src/cli/CommandsLayout.cpp:560
#, kde-format
msgid ""
"“%1” is not a list of marks. Use crop, registration, colour-bar, page-info "
"or all, separated by commas."
msgstr ""
"„%1“ ist keine Liste von Marken. Möglich sind crop, registration, colour-"
"bar, page-info oder all, durch Kommas getrennt."

#: src/cli/CommandsLayout.cpp:580
#, kde-format
msgid ""
"“%1” is not a length. Give points, or a number with mm, cm, in or pt after "
"it."
msgstr ""
"„%1“ ist keine Länge. Geben Sie Punkt an oder eine Zahl mit mm, cm, in oder "
"pt dahinter."

#: src/cli/CommandsLayout.cpp:594 src/ui/ToolLayoutDialog.cpp:909
#, kde-format
msgctxt "@item a kind of printer's mark"
msgid "crop marks"
msgstr "Schnittmarken"

#: src/cli/CommandsLayout.cpp:597 src/ui/ToolLayoutDialog.cpp:912
#, kde-format
msgctxt "@item a kind of printer's mark"
msgid "registration marks"
msgstr "Passermarken"

#: src/cli/CommandsLayout.cpp:600 src/ui/ToolLayoutDialog.cpp:915
#, kde-format
msgctxt "@item a kind of printer's mark"
msgid "colour bars"
msgstr "Farbkontrollstreifen"

#: src/cli/CommandsLayout.cpp:603 src/ui/ToolLayoutDialog.cpp:918
#, kde-format
msgctxt "@item a kind of printer's mark"
msgid "page information"
msgstr "Seiteninformationen"

#: src/cli/CommandsLayout.cpp:606 src/ui/ToolLayoutDialog.cpp:933
#, kde-format
msgid "Added %1, %2 mm outside the trim."
msgstr "%1 hinzugefügt, %2 mm außerhalb des Endformats."

#: src/cli/CommandsLayout.cpp:624
#, kde-format
msgid ""
"“%1” is not a place to cut. Give a fraction between 0 and 1, for example 0.5 "
"for the middle."
msgstr ""
"„%1“ ist keine Stelle zum Schneiden. Geben Sie einen Anteil zwischen 0 und 1 "
"an, zum Beispiel 0.5 für die Mitte."

#: src/cli/CommandsLayout.cpp:643
#, kde-format
msgctxt "@info"
msgid "Cut %1 page in two."
msgid_plural "Cut %1 pages in two."
msgstr[0] "%1 Seite in zwei geteilt."
msgstr[1] "%1 Seiten in zwei geteilt."

#: src/cli/CommandsLayout.cpp:644
#, kde-format
msgid "Left half first, then the right. Wrote %1."
msgstr "Erst die linke Hälfte, dann die rechte. %1 geschrieben."

#: src/cli/CommandsLayout.cpp:645
#, kde-format
msgid "Top half first, then the bottom. Wrote %1."
msgstr "Erst die obere Hälfte, dann die untere. %1 geschrieben."

#: src/cli/CommandsLayout.cpp:653
#, kde-format
msgid "layout overlay needs two files: the document, then what to lay over it."
msgstr ""
"layout overlay benötigt zwei Dateien: das Dokument und dann das, was "
"darübergelegt wird."

#: src/cli/CommandsLayout.cpp:658 src/cli/Common.cpp:46 src/cli/main.cpp:74
#: src/core/Archival.cpp:606 src/core/Compressor.cpp:208
#: src/core/Convert.cpp:2178 src/core/Convert.cpp:2324
#: src/core/Preflight.cpp:2599
#, kde-format
msgid "“%1” does not exist."
msgstr "„%1“ existiert nicht."

#: src/cli/CommandsLayout.cpp:674
#, kde-format
msgid "Laid %1 over %2. Wrote %3."
msgstr "%1 über %2 gelegt. %3 geschrieben."

#: src/cli/CommandsLayout.cpp:687
#, kde-format
msgid "layout poster needs a sheet size (--size), for example a4 or 210x297mm."
msgstr ""
"layout poster benötigt ein Blattformat (--size), zum Beispiel a4 oder "
"210x297mm."

#: src/cli/CommandsLayout.cpp:720
#, kde-format
msgid "Tiled page %2 across %1 sheet."
msgid_plural "Tiled page %2 across %1 sheets."
msgstr[0] "Seite %2 auf %1 Bogen gekachelt."
msgstr[1] "Seite %2 auf %1 Bogen gekachelt."

#: src/cli/CommandsLayout.cpp:721
#, kde-format
msgid ""
"The page is tiled at its own size. Resize it first for a bigger poster. "
"Wrote %1."
msgstr ""
"Die Seite wird in ihrer eigenen Größe aufgeteilt. Vergrößern Sie sie vorher "
"für ein größeres Poster. %1 geschrieben."

#: src/cli/CommandsLayout.cpp:742
#, kde-format
msgid ""
"Reordered into printer's spreads. Run “nup --per-sheet 2” over this to get "
"the sheets themselves."
msgstr ""
"In Druckerdoppelseiten umsortiert. Lassen Sie „nup --per-sheet 2“ darüber "
"laufen, um die Bogen selbst zu erhalten."

#: src/cli/CommandsLayout.cpp:744 src/ui/ToolLayoutDialog.cpp:1161
#, kde-format
msgid "Put the pages back into reading order."
msgstr "Die Seiten wieder in die Lesereihenfolge gebracht."

#: src/cli/CommandsLayout.cpp:777 src/ui/ToolLayoutDialog.cpp:1278
#, kde-format
msgid ""
"This document has no page labels, so readers show the physical page numbers."
msgstr ""
"Dieses Dokument hat keine Seitenbeschriftungen, Leseprogramme zeigen daher "
"die physischen Seitenzahlen."

#: src/cli/CommandsLayout.cpp:781 src/ui/ToolLayoutDialog.cpp:1286
#, kde-format
msgctxt "@info physical page number, then the label the reader shows"
msgid "Page %1: %2"
msgstr "Seite %1: %2"

#: src/cli/CommandsLayout.cpp:798
#, kde-format
msgid ""
"layout set-labels needs at least one --page-label, as "
"PAGE:STYLE[:PREFIX[:START]]."
msgstr ""
"layout set-labels benötigt mindestens ein --page-label, als "
"SEITE:STIL[:PRÄFIX[:START]]."

#: src/cli/CommandsLayout.cpp:806
#, kde-format
msgid ""
"“%1” is not a page label. The form is PAGE:STYLE[:PREFIX[:START]], for "
"example 1:roman-lower or 9:decimal:A-:1."
msgstr ""
"„%1“ ist keine Seitenbeschriftung. Die Form lautet "
"SEITE:STIL[:PRÄFIX[:START]], zum Beispiel 1:roman-lower oder 9:decimal:A-:1."

#: src/cli/CommandsLayout.cpp:821
#, kde-format
msgid ""
"“%1” is not a numbering style. Use decimal, roman-upper, roman-lower, letter-"
"upper, letter-lower or none."
msgstr ""
"„%1“ ist kein Nummerierungsstil. Möglich sind decimal, roman-upper, roman-"
"lower, letter-upper, letter-lower oder none."

#: src/cli/CommandsLayout.cpp:832
#, kde-format
msgid "“%1” is not a number to start at."
msgstr "„%1“ ist keine Zahl zum Anfangen."

#: src/cli/CommandsLayout.cpp:845
#, kde-format
msgctxt "@info"
msgid "Wrote %1 numbering range."
msgid_plural "Wrote %1 numbering ranges."
msgstr[0] "%1 Nummerierungsbereich geschrieben."
msgstr[1] "%1 Nummerierungsbereiche geschrieben."

#: src/cli/CommandsLayout.cpp:861
#, kde-format
msgid "“%1” is not a number of painting operators."
msgstr "„%1“ ist keine Anzahl von Zeichenbefehlen."

#: src/cli/CommandsLayout.cpp:884 src/ui/ToolLayoutDialog.cpp:1418
#, kde-format
msgid "Every page paints something."
msgstr "Jede Seite zeichnet etwas."

#: src/cli/CommandsLayout.cpp:887
#, kde-format
msgctxt "@info"
msgid "%1 page paints nothing: %2"
msgid_plural "%1 pages paint nothing: %2"
msgstr[0] "%1 Seite malt nichts: %2"
msgstr[1] "%1 Seiten malen nichts: %2"

#: src/cli/CommandsLayout.cpp:890
#, kde-format
msgid "Take them out with “layout remove --pages %1”."
msgstr "Mit „layout remove --pages %1“ entfernen Sie sie."

#: src/cli/CommandsLayout.cpp:904
#, kde-format
msgid "layout remove needs the pages to take out (--pages), e.g. 3,7-9."
msgstr ""
"layout remove benötigt die zu entfernenden Seiten (--pages), z. B. 3,7-9."

#: src/cli/CommandsLayout.cpp:919
#, kde-format
msgctxt "@info"
msgid "Took out %1 page."
msgid_plural "Took out %1 pages."
msgstr[0] "%1 Seite entfernt."
msgstr[1] "%1 Seiten entfernt."

#: src/cli/CommandsLayout.cpp:927
#, kde-format
msgid "layout limits takes no arguments."
msgstr "layout limits nimmt keine Argumente."

#: src/cli/CommandsLayout.cpp:929
#, kde-format
msgctxt "@title heading before a list"
msgid "What page layout cannot promise:"
msgstr "Was das Seitenformat nicht zusichern kann:"

#: src/cli/CommandsLayout.cpp:943
#, kde-format
msgid "How content lands on a new sheet: scale, centre or shrink."
msgstr "Wie der Inhalt auf ein neues Blatt kommt: scale, centre oder shrink."

#: src/cli/CommandsLayout.cpp:946
#, kde-format
msgid ""
"Bleed in millimetres. On “marks”, how far outside the trim the marks sit."
msgstr ""
"Anschnitt in Millimetern. Bei „marks“, wie weit außerhalb des Endformats die "
"Marken sitzen."

#: src/cli/CommandsLayout.cpp:949
#, kde-format
msgid ""
"Printer's marks to add: crop, registration, colour-bar, page-info or all."
msgstr ""
"Hinzuzufügende Druckmarken: crop, registration, colour-bar, page-info oder "
"all."

#: src/cli/CommandsLayout.cpp:951
#, kde-format
msgid "How long a crop mark is, in millimetres."
msgstr "Wie lang eine Schnittmarke ist, in Millimetern."

#: src/cli/CommandsLayout.cpp:953
#, kde-format
msgid "How thick a printer's mark is, in points."
msgstr "Wie dick eine Druckmarke ist, in Punkt."

#: src/cli/CommandsLayout.cpp:956
#, kde-format
msgid ""
"New /MediaBox as X,Y,WIDTH,HEIGHT in points from the bottom-left corner."
msgstr ""
"Neue /MediaBox als X,Y,BREITE,HÖHE in Punkt von der linken unteren Ecke."

#: src/cli/CommandsLayout.cpp:958
#, kde-format
msgid "New /CropBox, or “none” to take it away."
msgstr "Neue /CropBox oder „none“, um sie zu entfernen."

#: src/cli/CommandsLayout.cpp:960
#, kde-format
msgid "New /BleedBox, or “none” to take it away."
msgstr "Neue /BleedBox oder „none“, um sie zu entfernen."

#: src/cli/CommandsLayout.cpp:962
#, kde-format
msgid "New /TrimBox, or “none” to take it away."
msgstr "Neue /TrimBox oder „none“, um sie zu entfernen."

#: src/cli/CommandsLayout.cpp:964
#, kde-format
msgid "New /ArtBox, or “none” to take it away."
msgstr "Neue /ArtBox oder „none“, um sie zu entfernen."

#: src/cli/CommandsLayout.cpp:966
#, kde-format
msgid "Where to cut a page in two, as a fraction."
msgstr "Wo eine Seite in zwei geschnitten wird, als Anteil."

#: src/cli/CommandsLayout.cpp:969
#, kde-format
msgid "Cut into a top and a bottom half instead of a left and a right."
msgstr ""
"In eine obere und eine untere Hälfte schneiden statt in eine linke und eine "
"rechte."

#: src/cli/CommandsLayout.cpp:971
#, kde-format
msgid "Start the overlay again when it runs out, for a letterhead."
msgstr ""
"Das aufgelegte Dokument wieder von vorn beginnen, wenn es ausgeht, etwa für "
"einen Briefbogen."

#: src/cli/CommandsLayout.cpp:972
#, kde-format
msgid "How far poster sheets overlap, in millimetres."
msgstr "Wie weit sich Posterblätter überlappen, in Millimetern."

#: src/cli/CommandsLayout.cpp:974
#, kde-format
msgid "Draw the cut line and number each poster sheet."
msgstr "Die Schnittlinie zeichnen und jedes Posterblatt nummerieren."

#: src/cli/CommandsLayout.cpp:976
#, kde-format
msgid "A numbering range, as PAGE:STYLE[:PREFIX[:START]]. Repeat for more."
msgstr ""
"Ein Nummerierungsbereich, als SEITE:STIL[:PRÄFIX[:START]]. Mehrfach angebbar."

#: src/cli/CommandsLayout.cpp:979
#, kde-format
msgid "How much painting a page may still hold and count as blank."
msgstr "Wie viel eine Seite noch zeichnen darf und trotzdem als leer gilt."

#: src/cli/CommandsLayout.cpp:981
#, kde-format
msgid "Turn printer's spreads back into reading order."
msgstr "Druckerdoppelseiten wieder in die Lesereihenfolge bringen."

#: src/cli/CommandsLayout.cpp:992
#, kde-format
msgctxt "@info a list of the actions “layout” takes"
msgid ""
"boxes, set-boxes, resize, unify, bleed, marks, split, overlay, poster, "
"booklet, labels, set-labels, blanks, remove or limits"
msgstr ""
"boxes, set-boxes, resize, unify, bleed, marks, split, overlay, poster, "
"booklet, labels, set-labels, blanks, remove oder limits"

#: src/cli/CommandsLayout.cpp:995
#, kde-format
msgid "layout needs something to do: %1."
msgstr "layout benötigt eine Aufgabe: %1."

#: src/cli/CommandsLayout.cpp:1047
#, kde-format
msgid "“layout %1” is not something layout does. Try %2."
msgstr "„layout %1“ macht layout nicht. Möglich sind %2."

#: src/cli/CommandsLayout.cpp:1056
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout boxes      FILE                 Show the five page boxes, and which "
"are absent"
msgstr ""
"  layout boxes      DATEI                Die fünf Seitenrahmen zeigen und "
"welche fehlen"

#: src/cli/CommandsLayout.cpp:1058
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout set-boxes  FILE      -o OUT     Write /MediaBox, /CropBox, /"
"BleedBox, /TrimBox, /ArtBox"
msgstr ""
"  layout set-boxes  DATEI      -o AUS    /MediaBox, /CropBox, /BleedBox, /"
"TrimBox, /ArtBox schreiben"

#: src/cli/CommandsLayout.cpp:1060
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout resize     FILE      -o OUT     Put the pages on a different paper "
"size"
msgstr ""
"  layout resize     DATEI      -o AUS    Die Seiten auf ein anderes "
"Papierformat legen"

#: src/cli/CommandsLayout.cpp:1062
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout unify      FILE      -o OUT     Bring every page to one size"
msgstr ""
"  layout unify      DATEI      -o AUS    Alle Seiten auf ein Format bringen"

#: src/cli/CommandsLayout.cpp:1064
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout bleed      FILE      -o OUT     Give the pages a bleed, growing the "
"sheet"
msgstr ""
"  layout bleed      DATEI      -o AUS    Den Seiten Anschnitt geben, das "
"Blatt wächst mit"

#: src/cli/CommandsLayout.cpp:1066
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout marks      FILE      -o OUT     Add printer's marks outside the trim"
msgstr ""
"  layout marks      DATEI      -o AUS    Druckmarken außerhalb des "
"Endformats setzen"

#: src/cli/CommandsLayout.cpp:1068
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout split      FILE      -o OUT     Cut each page in two, for scanned "
"books"
msgstr ""
"  layout split      DATEI      -o AUS    Jede Seite in zwei schneiden, für "
"Buchscans"

#: src/cli/CommandsLayout.cpp:1070
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout overlay    BASE OVER -o OUT     Lay one document over another"
msgstr ""
"  layout overlay    BASIS ÜBER -o AUS    Ein Dokument über ein anderes legen"

#: src/cli/CommandsLayout.cpp:1072
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout poster     FILE      -o OUT     Tile one page across several sheets"
msgstr ""
"  layout poster     DATEI      -o AUS    Eine Seite auf mehrere Blätter "
"verteilen"

#: src/cli/CommandsLayout.cpp:1074
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout booklet    FILE      -o OUT     Reorder pages into printer's spreads"
msgstr ""
"  layout booklet    DATEI      -o AUS    Seiten in Druckerdoppelseiten "
"umsortieren"

#: src/cli/CommandsLayout.cpp:1076
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout labels     FILE                 Show the numbers the reader displays"
msgstr ""
"  layout labels     DATEI                Die Zahlen zeigen, die das "
"Leseprogramm anzeigt"

#: src/cli/CommandsLayout.cpp:1078
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout set-labels FILE      -o OUT     Write /PageLabels, e.g. i, ii, iii "
"and then 1"
msgstr ""
"  layout set-labels DATEI      -o AUS    /PageLabels schreiben, z. B. i, ii, "
"iii und dann 1"

#: src/cli/CommandsLayout.cpp:1080
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout blanks     FILE                 Find pages that paint nothing"
msgstr ""
"  layout blanks     DATEI                Seiten finden, die nichts zeichnen"

#: src/cli/CommandsLayout.cpp:1082
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout remove     FILE      -o OUT     Take pages out"
msgstr "  layout remove     DATEI      -o AUS    Seiten entfernen"

#: src/cli/CommandsLayout.cpp:1084
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid ""
"  layout limits                          What page layout cannot promise"
msgstr ""
"  layout limits                          Was das Seitenlayout nicht "
"versprechen kann"

