msgstr[0] "%1 Objekt, das oberste zuerst."
msgstr[1] "%1 Objekte, das oberste zuerst."

#: src/cli/CommandsObjects.cpp:557
#, kde-format
msgid ""
"Say how far with --by DX,DY, in points. Positive numbers move right and up."
msgstr ""
"Sagen Sie mit --by DX,DY, wie weit, in Punkt. Positive Zahlen verschieben "
