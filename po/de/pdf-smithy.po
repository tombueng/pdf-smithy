#: src/ui/ToolObjectsDialog.cpp:945
#, kde-format
msgid ""
"For a shape this is the fill and the outline; for text it is the colour of "
"the letters. A picture takes no notice."
msgstr ""
"Bei einer Form sind das Füllung und Kontur, bei Text die Farbe der "
"Buchstaben. Ein Bild nimmt davon keine Notiz."

#: src/ui/ToolObjectsDialog.cpp:952
#, kde-format
msgctxt "@action:button"
