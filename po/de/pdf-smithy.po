#: src/cli/main.cpp:1915
#, kde-format
msgid ""
"PDF Smithy (command line)\n"
"\n"
"Commands:\n"
"  info      FILE                      Show page count, size and dimensions\n"
"  merge     FILE...  -o OUT           Glue documents together\n"
"  split     FILE     [-o TEMPLATE]    Break a document apart\n"
"  pages     FILE     -o OUT           Select, reorder and rotate pages\n"
"  compress  FILE     -o OUT           Make a document smaller\n"
"  ocr       FILE     -o OUT           Make a scan searchable\n"
"  sign      FILE     -o OUT           Stamp a signature image onto pages\n"
"  watermark FILE     -o OUT           Lay text across pages\n"
"  meta      FILE                      Show metadata; --sanitize -o OUT "
"strips it\n"
"  protect   FILE     -o OUT           Set or remove a password\n"
"  from-images IMAGE... -o OUT         Build a document from pictures\n"
"  export-images FILE                  Render pages to image files\n"
"  number    FILE     -o OUT           Page numbers, headers and Bates "
"stamping\n"
"  crop      FILE     -o OUT           Trim the empty border off pages\n"
"  redact    FILE     -o OUT           Take content out of an area for good\n"
"  nup       FILE     -o OUT           Put several pages on one sheet\n"
"  annotate  FILE                      List, add, remove or flatten comments\n"
"  outline   FILE                      Show or rewrite the table of contents\n"
"  form      FILE                      List, fill in or flatten form fields\n"
"  text      FILE                      Show the text of a page, or correct "
"it\n"
"  batch     FILE...  --out-dir DIR    Do one thing to many files\n"
"  compare   LEFT RIGHT                Show what changed between two "
"documents\n"
"  archive   FILE     -o OUT           Convert to PDF/A for long-term "
"keeping\n"
"  archive-check FILE                  Look for what stops a file being "
"archival\n"
msgstr ""
"PDF Smithy (Kommandozeile)\n"
"\n"
"Befehle:\n"
"  info      DATEI                     Seitenzahl, Größe und Abmessungen "
"anzeigen\n"
"  merge     DATEI...  -o AUS          Dokumente zusammenfügen\n"
"  split     DATEI     [-o MUSTER]     Ein Dokument aufteilen\n"
"  pages     DATEI     -o AUS          Seiten wählen, sortieren und drehen\n"
"  compress  DATEI     -o AUS          Ein Dokument verkleinern\n"
"  ocr       DATEI     -o AUS          Einen Scan durchsuchbar machen\n"
"  sign      DATEI     -o AUS          Unterschriftsbild auf Seiten stempeln\n"
"  watermark DATEI     -o AUS          Text über die Seiten legen\n"
"  meta      DATEI                     Metadaten zeigen; --sanitize -o AUS "
"entfernt sie\n"
"  protect   DATEI     -o AUS          Passwort setzen oder entfernen\n"
"  from-images BILD... -o AUS          Dokument aus Bildern erstellen\n"
"  export-images DATEI                 Seiten als Bilddateien ausgeben\n"
"  number    DATEI     -o AUS          Seitenzahlen, Kopfzeilen und Bates-"
"Stempel\n"
"  crop      DATEI     -o AUS          Leeren Rand von Seiten beschneiden\n"
"  redact    DATEI     -o AUS          Inhalt eines Bereichs endgültig "
"entfernen\n"
"  nup       DATEI     -o AUS          Mehrere Seiten auf ein Blatt setzen\n"
"  annotate  DATEI                     Kommentare zeigen, setzen, entfernen, "
"einbrennen\n"
"  outline   DATEI                     Inhaltsverzeichnis zeigen oder neu "
"schreiben\n"
"  form      DATEI                     Formularfelder zeigen, ausfüllen, "
"festschreiben\n"
"  text      DATEI                     Text einer Seite zeigen oder "
"korrigieren\n"
"  batch     DATEI...  --out-dir VERZ  Eine Sache mit vielen Dateien machen\n"
"  compare   LINKS RECHTS              Zeigen, was sich zwischen zwei "
"Dokumenten geändert hat\n"
"  archive   DATEI     -o AUS          In PDF/A für die Langzeitaufbewahrung "
"umwandeln\n"
"  archive-check DATEI                 Suchen, was eine Datei nicht "
"archivfähig macht\n"

#: src/cli/main.cpp:1943
#, kde-format
msgid ""
"\n"
"Examples:\n"
"  pdf-smithy-cli merge a.pdf b.pdf -o both.pdf\n"
"  pdf-smithy-cli split invoices.pdf --every 1\n"
"  pdf-smithy-cli pages report.pdf --keep 1-3,7 --rotate 4:90 -o short.pdf\n"
"  pdf-smithy-cli compress scan.pdf --level strong -o small.pdf\n"
"  pdf-smithy-cli ocr scan.pdf --languages deu+eng --straighten -o "
"searchable.pdf\n"
"  pdf-smithy-cli sign contract.pdf --image signature.png --pages last -o "
"signed.pdf\n"
"  pdf-smithy-cli watermark offer.pdf --text DRAFT --opacity 20 -o "
"marked.pdf\n"
"  pdf-smithy-cli meta payslip.pdf --sanitize -o clean.pdf\n"
"  pdf-smithy-cli protect contract.pdf --password geheim -o locked.pdf\n"
"  pdf-smithy-cli from-images scan*.png --page-size a4 -o scans.pdf\n"
"  pdf-smithy-cli export-images report.pdf --pages 1-3 --dpi 300\n"
"  pdf-smithy-cli number report.pdf --text \"{page} / {pages}\" -o "
"numbered.pdf\n"
"  pdf-smithy-cli number bundle.pdf --text {bates} --bates ACME- -o "
"stamped.pdf\n"
"  pdf-smithy-cli crop scan.pdf --auto -o trimmed.pdf\n"
"  pdf-smithy-cli redact case.pdf --area 1:72,700,180,16 -o public.pdf\n"
"  pdf-smithy-cli nup slides.pdf --per-sheet 4 --borders -o handout.pdf\n"
"  pdf-smithy-cli annotate report.pdf --list\n"
"  pdf-smithy-cli outline manual.pdf --json > toc.json\n"
"  pdf-smithy-cli form application.pdf --list\n"
"  pdf-smithy-cli text letter.pdf --page 1\n"
"  pdf-smithy-cli batch scans/*.pdf --op ocr --out-dir searchable/\n"
"  pdf-smithy-cli compare contract-v1.pdf contract-v2.pdf\n"
"  pdf-smithy-cli archive invoice.pdf --level 2b -o invoice-archival.pdf\n"
"  pdf-smithy-cli to-pdfx cover.pdf --pdfx-level x4 -o cover-print.pdf\n"
"  pdf-smithy-cli tables report.pdf --pages 3-5\n"
"  pdf-smithy-cli to-svg poster.pdf --pages 1-4 -o poster.svg\n"
"  pdf-smithy-cli linearise handbook.pdf -o handbook-web.pdf\n"
"  pdf-smithy-cli set-version old.pdf --pdf-version 1.7 -o modern.pdf\n"
"  pdf-smithy-cli text letter.pdf --replace \"1:4=Sehr geehrte Frau Meier\" "
"-o fixed.pdf\n"
"  pdf-smithy-cli form application.pdf --set Name=Bueng --set Ort=Bern -o "
"filled.pdf\n"
"  pdf-smithy-cli annotate report.pdf --export-xfdf comments.xfdf\n"
"  pdf-smithy-cli annotate report.pdf --note 2:120,600 --text \"Check this\" "
"-o marked.pdf\n"
"  pdf-smithy-cli split handbook.pdf --bookmarks\n"
"\n"
"Duplicating pages needs no separate command: a range may repeat a page,\n"
"so \"pages FILE --keep 1,1,2-4\" writes page 1 twice."
msgstr ""
"\n"
"Beispiele:\n"
"  pdf-smithy-cli merge a.pdf b.pdf -o beide.pdf\n"
"  pdf-smithy-cli split rechnungen.pdf --every 1\n"
"  pdf-smithy-cli pages bericht.pdf --keep 1-3,7 --rotate 4:90 -o kurz.pdf\n"
"  pdf-smithy-cli compress scan.pdf --level strong -o klein.pdf\n"
"  pdf-smithy-cli ocr scan.pdf --languages deu+eng --straighten -o "
"durchsuchbar.pdf\n"
"  pdf-smithy-cli sign vertrag.pdf --image unterschrift.png --pages last -o "
"signiert.pdf\n"
"  pdf-smithy-cli watermark angebot.pdf --text ENTWURF --opacity 20 -o "
"markiert.pdf\n"
"  pdf-smithy-cli meta gehalt.pdf --sanitize -o sauber.pdf\n"
"  pdf-smithy-cli protect vertrag.pdf --password geheim -o gesperrt.pdf\n"
"  pdf-smithy-cli from-images scan*.png --page-size a4 -o scans.pdf\n"
"  pdf-smithy-cli export-images bericht.pdf --pages 1-3 --dpi 300\n"
"  pdf-smithy-cli number bericht.pdf --text \"{page} / {pages}\" -o "
"nummeriert.pdf\n"
"  pdf-smithy-cli number bundle.pdf --text {bates} --bates ACME- -o "
"gestempelt.pdf\n"
"  pdf-smithy-cli crop scan.pdf --auto -o beschnitten.pdf\n"
"  pdf-smithy-cli redact akte.pdf --area 1:72,700,180,16 -o oeffentlich.pdf\n"
"  pdf-smithy-cli nup folien.pdf --per-sheet 4 --borders -o handzettel.pdf\n"
"  pdf-smithy-cli annotate bericht.pdf --list\n"
"  pdf-smithy-cli outline handbuch.pdf --json > inhalt.json\n"
"  pdf-smithy-cli form antrag.pdf --list\n"
"  pdf-smithy-cli text brief.pdf --page 1\n"
"  pdf-smithy-cli batch scans/*.pdf --op ocr --out-dir durchsuchbar/\n"
"  pdf-smithy-cli compare vertrag-v1.pdf vertrag-v2.pdf\n"
"  pdf-smithy-cli archive rechnung.pdf --level 2b -o rechnung-archiv.pdf\n"
"  pdf-smithy-cli to-pdfx umschlag.pdf --pdfx-level x4 -o umschlag-druck.pdf\n"
"  pdf-smithy-cli tables bericht.pdf --pages 3-5\n"
"  pdf-smithy-cli to-svg plakat.pdf --pages 1-4 -o plakat.svg\n"
"  pdf-smithy-cli linearise handbuch.pdf -o handbuch-web.pdf\n"
"  pdf-smithy-cli set-version alt.pdf --pdf-version 1.7 -o modern.pdf\n"
"  pdf-smithy-cli text brief.pdf --replace \"1:4=Sehr geehrte Frau Meier\" -o "
"korrigiert.pdf\n"
"  pdf-smithy-cli form antrag.pdf --set Name=Bueng --set Ort=Bern -o "
"ausgefuellt.pdf\n"
"  pdf-smithy-cli annotate bericht.pdf --export-xfdf kommentare.xfdf\n"
"  pdf-smithy-cli annotate bericht.pdf --note 2:120,600 --text \"Bitte "
"prüfen\" -o kommentiert.pdf\n"
"  pdf-smithy-cli split handbuch.pdf --bookmarks\n"
"\n"
"Seiten duplizieren braucht keinen eigenen Befehl: ein Bereich darf eine "
"Seite\n"
"wiederholen, „pages DATEI --keep 1,1,2-4“ schreibt Seite 1 also zweimal."

#: src/cli/main.cpp:1982
#, kde-format
msgid "The command to run."
msgstr "Der auszuführende Befehl."

#: src/cli/main.cpp:1987
#, kde-format
msgid "Where to write the result."
msgstr "Wohin das Ergebnis geschrieben wird."

#: src/cli/main.cpp:1988
#, kde-format
msgid "Machine-readable output."
msgstr "Maschinenlesbare Ausgabe."

#: src/cli/main.cpp:1989
#, kde-format
msgid "Pages to keep, e.g. 1-3,7,9-last."
msgstr "Zu behaltende Seiten, z. B. 1-3,7,9-last."

#: src/cli/main.cpp:1991
#, kde-format
msgid "Rotate pages, e.g. 1-3:90,7:180."
msgstr "Seiten drehen, z. B. 1-3:90,7:180."

#: src/cli/main.cpp:1993
#, kde-format
msgid "Split into chunks of this many pages."
msgstr "In Blöcke dieser Seitenzahl aufteilen."

#: src/cli/main.cpp:1996
#, kde-format
msgid "Split into one file per range, e.g. 1-3,4-9."
msgstr "Je Bereich eine Datei erzeugen, z. B. 1-3,4-9."

#: src/cli/main.cpp:1998
#, kde-format
msgid "Split into pieces no larger than this, e.g. 5M."
msgstr "In Teile aufteilen, die höchstens so groß sind, z. B. 5M."

#: src/cli/main.cpp:2000
#, kde-format
msgid "Compression: lossless, balanced, strong or extreme."
msgstr "Komprimierung: lossless, balanced, strong oder extreme."

#: src/cli/main.cpp:2001
#, kde-format
msgid "Convert to grayscale while compressing."
msgstr "Beim Komprimieren in Graustufen umwandeln."

#: src/cli/main.cpp:2002
#, kde-format
msgid "OCR languages, e.g. deu+eng."
msgstr "OCR-Sprachen, z. B. deu+eng."

#: src/cli/main.cpp:2004
#, kde-format
msgid "Correct crooked scans."
msgstr "Schiefe Scans geraderücken."

#: src/cli/main.cpp:2005
#, kde-format
msgid "Signature image to stamp."
msgstr "Zu stempelndes Unterschriftsbild."

#: src/cli/main.cpp:2007
#, kde-format
msgid "Where to put it: bottom-right, centre, top-left…"
msgstr "Wohin damit: bottom-right, centre, top-left …"

#: src/cli/main.cpp:2009
#, kde-format
msgid "Width as a fraction of the page, e.g. 0.3."
msgstr "Breite als Anteil der Seite, z. B. 0.3."

#: src/cli/main.cpp:2015
#, kde-format
msgid "Distance from the page edge, in points."
msgstr "Abstand zum Seitenrand, in Punkt."

#: src/cli/main.cpp:2017
#, kde-format
msgid "Watermark text."
msgstr "Text des Wasserzeichens."

#: src/cli/main.cpp:2018
#, kde-format
msgid "Watermark angle in degrees."
msgstr "Winkel des Wasserzeichens in Grad."

#: src/cli/main.cpp:2020
#, kde-format
msgid "Watermark strength, 1 to 100 percent."
msgstr "Stärke des Wasserzeichens, 1 bis 100 Prozent."

#: src/cli/main.cpp:2022
#, kde-format
msgid "Watermark colour, a name or #rrggbb."
msgstr "Farbe des Wasserzeichens, Name oder #rrggbb."

#: src/cli/main.cpp:2025
#, kde-format
msgid "Draw the watermark as an outline, keeping the page readable."
msgstr "Wasserzeichen als Umriss zeichnen, damit die Seite lesbar bleibt."

#: src/cli/main.cpp:2026
#, kde-format
msgid "Which pages, e.g. 1-3,last. Default: all."
msgstr "Welche Seiten, z. B. 1-3,last. Vorgabe: alle."

#: src/cli/main.cpp:2029
#, kde-format
msgid "Fit images into a4, a3, a5, letter or legal."
msgstr "Bilder in a4, a3, a5, letter oder legal einpassen."

#: src/cli/main.cpp:2030
#, kde-format
msgid "Resolution for image export, in dots per inch."
msgstr "Auflösung für den Bildexport, in Punkten pro Zoll."

#: src/cli/main.cpp:2032
#, kde-format
msgid "Image format: png, jpeg or tiff."
msgstr "Bildformat: png, jpeg oder tiff."

#: src/cli/main.cpp:2035
#, kde-format
msgid "JPEG quality when importing, 0 keeps the pixels."
msgstr "JPEG-Qualität beim Import, 0 behält die Pixel."

#: src/cli/main.cpp:2038
#, kde-format
msgid "Strip metadata, JavaScript and embedded files."
msgstr "Metadaten, JavaScript und eingebettete Dateien entfernen."

#: src/cli/main.cpp:2039
#, kde-format
msgid "Password to set."
msgstr "Zu setzendes Passwort."

#: src/cli/main.cpp:2042
#, kde-format
msgid "Password the input already has, if any."
msgstr "Passwort, das die Eingabedatei bereits hat, falls vorhanden."

#: src/cli/main.cpp:2044
#, kde-format
msgid "Remove the password instead of setting one."
msgstr "Passwort entfernen statt eines zu setzen."

#: src/cli/main.cpp:2045
#, kde-format
msgid "Ask readers not to print."
msgstr "Leseprogramme bitten, nicht zu drucken."

#: src/cli/main.cpp:2046
#, kde-format
msgid "Ask readers not to copy text."
msgstr "Leseprogramme bitten, keinen Text zu kopieren."

#: src/cli/main.cpp:2047
#, kde-format
msgid "Split wherever a bookmark starts."
msgstr "Überall dort teilen, wo ein Lesezeichen beginnt."

#: src/cli/main.cpp:2050
#, kde-format
msgid ""
"A colour profile to embed: sRGB for “archive”, a CMYK printing condition for "
"“to-pdfx”. Leave out to look for one on the system."
msgstr ""
"Ein einzubettendes Farbprofil: sRGB für „archive“, eine CMYK-Druckbedingung "
"für „to-pdfx“. Weglassen, um auf dem System nach einem zu suchen."

#: src/cli/main.cpp:2053
#, kde-format
msgid "Document title to write."
msgstr "Zu schreibender Dokumenttitel."

#: src/cli/main.cpp:2055
#, kde-format
msgid "Document author to write."
msgstr "Zu schreibender Dokumentautor."

#: src/cli/main.cpp:2059
#, kde-format
msgid ""
"How different two pixels may be before they count as changed, in levels of "
"brightness out of 255. On “colour replace” it is a distance in colour "
"between 0 and 1."
msgstr ""
"Wie verschieden zwei Bildpunkte sein dürfen, bevor sie als geändert gelten, "
"in Helligkeitsstufen von 255. Bei „colour replace“ ist es ein Farbabstand "
"zwischen 0 und 1."

#: src/cli/main.cpp:2063
#, kde-format
msgid "Treat a different line break as a change."
msgstr "Einen anderen Zeilenumbruch als Änderung behandeln."

#: src/cli/main.cpp:2065
#, kde-format
msgid "Write a side-by-side picture of one page, with -o."
msgstr "Beide Fassungen einer Seite nebeneinander als Bild schreiben, mit -o."

#: src/cli/main.cpp:2067
#, kde-format
msgid "Folder to write the finished files into."
msgstr "Ordner, in den die fertigen Dateien geschrieben werden."

#: src/cli/main.cpp:2070
#, kde-format
msgid ""
"What to do to each file: compress, sanitize, flatten-comments, flatten-form "
"or ocr."
msgstr ""
"Was mit jeder Datei geschehen soll: compress, sanitize, flatten-comments, "
"flatten-form oder ocr."

#: src/cli/main.cpp:2074
#, kde-format
msgid "Replace a line, as PAGE:LINE=New text. Repeat for more."
msgstr "Eine Zeile ersetzen, als SEITE:ZEILE=Neuer Text. Mehrfach angebbar."

#: src/cli/main.cpp:2076
#, kde-format
msgid "Which page to list the text of."
msgstr "Von welcher Seite der Text aufgelistet werden soll."

#: src/cli/main.cpp:2079
#, kde-format
msgid "Fill in a field, as NAME=VALUE. Repeat for more."
msgstr "Ein Feld ausfüllen, als NAME=WERT. Mehrfach angebbar."

#: src/cli/main.cpp:2081
#, kde-format
msgid "Add a bookmark, as PAGE:Title. Repeat for more."
msgstr "Ein Lesezeichen hinzufügen, als SEITE:Titel. Mehrfach angebbar."

#: src/cli/main.cpp:2083
#, kde-format
msgid "Replace the table of contents from a JSON file, as --json writes it."
msgstr ""
"Das Inhaltsverzeichnis aus einer JSON-Datei ersetzen, so wie --json sie "
"schreibt."

#: src/cli/main.cpp:2086
#, kde-format
msgid "Write the comments to an XFDF file, without the document."
msgstr "Die Kommentare in eine XFDF-Datei schreiben, ohne das Dokument."

#: src/cli/main.cpp:2089
#, kde-format
msgid "Read comments from an XFDF file and add them."
msgstr "Kommentare aus einer XFDF-Datei lesen und hinzufügen."

#: src/cli/main.cpp:2090
#, kde-format
msgid "Show the comments instead of changing them."
msgstr "Die Kommentare anzeigen, statt sie zu ändern."

#: src/cli/main.cpp:2092
#, kde-format
msgid "Highlight an area, as PAGE:X,Y,WIDTH,HEIGHT. Repeat for more."
msgstr ""
"Einen Bereich hervorheben, als SEITE:X,Y,BREITE,HÖHE. Mehrfach angebbar."

#: src/cli/main.cpp:2094
#, kde-format
msgid "Put a note marker at PAGE:X,Y. Repeat for more."
msgstr "Einen Notizmarker bei SEITE:X,Y setzen. Mehrfach angebbar."

#: src/cli/main.cpp:2099
#, kde-format
msgid "Take every comment out, leaving form fields alone."
msgstr "Alle Kommentare entfernen, Formularfelder bleiben unberührt."

#: src/cli/main.cpp:2100
#, kde-format
msgid "Name to put on the comment."
msgstr "Name, der am Kommentar stehen soll."

#: src/cli/main.cpp:2103
#, kde-format
msgid "Draw the comments into the pages and remove them."
msgstr "Die Kommentare in die Seiten zeichnen und dann entfernen."

#: src/cli/main.cpp:2105
#, kde-format
msgid "How many pages go on one sheet, e.g. 2, 4 or 9."
msgstr "Wie viele Seiten auf ein Blatt kommen, z. B. 2, 4 oder 9."

#: src/cli/main.cpp:2107
#, kde-format
msgid "Exact arrangement as COLUMNSxROWS, e.g. 2x3."
msgstr "Genaue Anordnung als SPALTENxZEILEN, z. B. 2x3."

#: src/cli/main.cpp:2109
#, kde-format
msgid "Gap between the slots, in points."
msgstr "Abstand zwischen den Plätzen, in Punkt."

#: src/cli/main.cpp:2112
#, kde-format
msgid "Empty border around the sheet, in points."
msgstr "Leerer Rand um das Blatt, in Punkt."

#: src/cli/main.cpp:2114
#, kde-format
msgid "Draw a hairline around each slot."
msgstr "Feine Linie um jeden Platz ziehen."

#: src/cli/main.cpp:2115
#, kde-format
msgid "Fill downwards before moving right."
msgstr "Erst nach unten füllen, dann nach rechts."

#: src/cli/main.cpp:2117
#, kde-format
msgid ""
"Area to redact, as PAGE:X,Y,WIDTH,HEIGHT in points from the bottom-left "
"corner. Repeat for more."
msgstr ""
"Zu schwärzender Bereich als SEITE:X,Y,BREITE,HÖHE in Punkt von der linken "
"unteren Ecke. Mehrfach angebbar."

#: src/cli/main.cpp:2121
#, kde-format
msgid "Leave the gap open instead of painting it black."
msgstr "Die Lücke offen lassen, statt sie schwarz zu füllen."

#: src/cli/main.cpp:2122
#, kde-format
msgid "Find the empty border and trim it."
msgstr "Leeren Rand finden und beschneiden."

#: src/cli/main.cpp:2123
#, kde-format
msgid "Remove the crop instead of setting one."
msgstr "Beschnitt entfernen statt setzen."

#: src/cli/main.cpp:2124
#, kde-format
msgid "Points to trim from the left."
msgstr "Punkte, die links beschnitten werden."

#: src/cli/main.cpp:2126
#, kde-format
msgid "Points to trim from the right."
msgstr "Punkte, die rechts beschnitten werden."

#: src/cli/main.cpp:2128
#, kde-format
msgid "Points to trim from the top."
msgstr "Punkte, die oben beschnitten werden."

#: src/cli/main.cpp:2130
#, kde-format
msgid "Points to trim from the bottom."
msgstr "Punkte, die unten beschnitten werden."

#: src/cli/main.cpp:2132
#, kde-format
msgid "Prefix for Bates numbering, e.g. ACME-."
msgstr "Präfix für die Bates-Nummerierung, z. B. ACME-."

#: src/cli/main.cpp:2134
#, kde-format
msgid "Zero padding for the Bates number."
msgstr "Auffüllen der Bates-Nummer mit Nullen."

#: src/cli/main.cpp:2136
#, kde-format
msgid "Number the first stamped page as this."
msgstr "Die erste gestempelte Seite so nummerieren."

#: src/cli/main.cpp:2138
#, kde-format
msgid "Text size in points."
msgstr "Textgröße in Punkt."

#: src/cli/main.cpp:2142
#, kde-format
msgid "Recognise text even on pages that already have some."
msgstr "Text auch auf Seiten erkennen, die bereits welchen haben."

#: src/cli/main.cpp:2284
#, kde-format
msgid "This build has no OCR support."
msgstr "Diese Programmfassung hat keine OCR-Unterstützung."

#: src/cli/main.cpp:2297
#, kde-format
msgid "Unknown command “%1”."
msgstr "Unbekannter Befehl „%1“."

#: src/core/Annotation.cpp:475
#, kde-format
msgid "There is nothing to add."
msgstr "Es gibt nichts hinzuzufügen."

#: src/core/Annotation.cpp:895 src/ui/MainWindow.cpp:1916
#, kde-format
msgid "This document has no comments to write out."
msgstr "Dieses Dokument hat keine Kommentare zum Herausschreiben."

#: src/core/Annotation.cpp:921
#, kde-format
msgid "“%1” could not be opened for writing."
msgstr "„%1“ konnte nicht zum Schreiben geöffnet werden."

#: src/core/Annotation.cpp:1147
#, kde-format
msgid "“%1” is not a valid XFDF file: %2"
msgstr "„%1“ ist keine gültige XFDF-Datei: %2"

#: src/core/Annotation.cpp:1153
#, kde-format
msgid "“%1” holds no comments this can use."
msgstr ""
"„%1“ enthält keine Kommentare, mit denen sich hier etwas anfangen lässt."

#: src/core/Annotation.cpp:1159
#, kde-format
msgid "One comment names a page this document does not have and was left out."
msgid_plural ""
"%1 comments name pages this document does not have and were left out."
msgstr[0] ""
"Ein Kommentar nennt eine Seite, die dieses Dokument nicht hat, und wurde "
"ausgelassen."
msgstr[1] ""
"%1 Kommentare nennen Seiten, die dieses Dokument nicht hat, und wurden "
"ausgelassen."

#: src/core/Archival.cpp:130 src/core/Preflight.cpp:327
#, kde-format
msgctxt "@item a font the file does not name"
msgid "an unnamed font"
msgstr "eine unbenannte Schrift"

#: src/core/Archival.cpp:348
#, kde-format
msgid ""
"The document is encrypted. An archive has to be able to open it in fifty "
"years' time, without a password, so PDF/A does not allow that."
msgstr ""
"Das Dokument ist verschlüsselt. Ein Archiv muss es in fünfzig Jahren ohne "
"Passwort öffnen können, daher erlaubt PDF/A das nicht."

#: src/core/Archival.cpp:351
#, kde-format
msgid ""
"The document contains scripts, or an action that runs when it is opened. PDF/"
"A allows neither."
msgstr ""
"Das Dokument enthält Skripte oder eine Aktion, die beim Öffnen ausgeführt "
"wird. PDF/A erlaubt beides nicht."

#: src/core/Archival.cpp:354
#, kde-format
msgid "The document carries other files inside it. Only PDF/A-3 allows that."
msgstr "Das Dokument trägt andere Dateien in sich. Nur PDF/A-3 erlaubt das."

#: src/core/Archival.cpp:361
#, kde-format
msgctxt "@item separator in a list of font names"
msgid ", "
msgstr ", "

#: src/core/Archival.cpp:356
#, kde-format
msgid ""
"%1 font is not embedded (%2), so its text will be set in whatever the reader "
"happens to have instead."
msgid_plural ""
"%1 fonts are not embedded (%2), so their text will be set in whatever the "
"reader happens to have instead."
msgstr[0] ""
"%1 Schrift ist nicht eingebettet (%2), ihr Text wird daher in dem gesetzt, "
"was das Leseprogramm gerade zur Hand hat."
msgstr[1] ""
"%1 Schriften sind nicht eingebettet (%2), ihr Text wird daher in dem "
"gesetzt, was das Leseprogramm gerade zur Hand hat."

#: src/core/Archival.cpp:363 src/core/Preflight.cpp:1592
#, kde-format
msgid ""
"The document has no output intent, so nothing in it says what its colours "
"are meant to look like."
msgstr ""
"Das Dokument hat keinen Output Intent, es sagt also nirgends, wie seine "
"Farben aussehen sollen."

#: src/core/Archival.cpp:373
#, kde-format
msgid "The password protection was removed, because PDF/A does not allow it."
msgstr "Der Passwortschutz wurde entfernt, weil PDF/A ihn nicht erlaubt."

#: src/core/Archival.cpp:375
#, kde-format
msgid "Scripts and actions that run on their own were removed."
msgstr "Skripte und Aktionen, die von selbst laufen, wurden entfernt."

#: src/core/Archival.cpp:377
#, kde-format
msgid ""
"The files carried inside the document were dropped. Convert to PDF/A-3 if "
"they matter."
msgstr ""
"Die im Dokument mitgeführten Dateien wurden verworfen. Wandeln Sie in PDF/"
"A-3 um, wenn sie wichtig sind."

#: src/core/Archival.cpp:379
#, kde-format
msgid ""
"The fonts were embedded, so the text keeps its shape on a machine that does "
"not have them."
msgstr ""
"Die Schriften wurden eingebettet, der Text behält daher auch auf einem "
"Rechner ohne sie seine Form."

#: src/core/Archival.cpp:381
#, kde-format
msgid ""
"An sRGB output intent was added, so the colours are stated rather than "
"assumed."
msgstr ""
"Ein sRGB-Output-Intent wurde hinzugefügt, die Farben sind damit angegeben "
"statt vermutet."

#: src/core/Archival.cpp:536 src/core/Compressor.cpp:292
#: src/core/Convert.cpp:1311 src/core/Convert.cpp:1676
#: src/core/Encryption.cpp:57 src/core/ImageIO.cpp:166 src/core/Metadata.cpp:72
#: src/core/Overlay.cpp:125 src/core/PageCrop.cpp:108
#: src/core/PageLayout.cpp:616 src/core/Preflight.cpp:2308
#: src/core/ScanProcessor.cpp:582
#, kde-format
msgid "Could not write “%1”."
msgstr "„%1“ konnte nicht geschrieben werden."

#: src/core/Archival.cpp:558
#, kde-format
msgctxt "@item PDF/A level"
msgid "PDF/A-1b (oldest, strictest, accepted everywhere)"
msgstr "PDF/A-1b (am ältesten, am strengsten, überall akzeptiert)"

#: src/core/Archival.cpp:560
#, kde-format
msgctxt "@item PDF/A level"
msgid "PDF/A-2b (what most archives ask for)"
msgstr "PDF/A-2b (was die meisten Archive verlangen)"

#: src/core/Archival.cpp:562
#, kde-format
msgctxt "@item PDF/A level"
msgid "PDF/A-3b (as PDF/A-2b, but attachments may stay)"
msgstr "PDF/A-3b (wie PDF/A-2b, aber Anhänge dürfen bleiben)"

#: src/core/Archival.cpp:570
#, kde-format
msgid ""
"This is not a full validation. It looks for the faults that account for most "
"rejections (encryption, scripts, attachments, fonts that are not embedded, a "
"missing output intent) and nothing else."
msgstr ""
"Dies ist keine vollständige Prüfung. Gesucht wird nach den Fehlern, auf die "
"die meisten Ablehnungen zurückgehen (Verschlüsselung, Skripte, Anhänge, "
"nicht eingebettete Schriften, ein fehlender Output Intent), und nach nichts "
"weiter."

#: src/core/Archival.cpp:573
#, kde-format
msgid ""
"A file can pass every check here and still be refused by a strict validator "
"such as veraPDF, which is the tool to reach for when an archive has to sign "
"the file off."
msgstr ""
"Eine Datei kann hier jede Prüfung bestehen und von einem strengen "
"Prüfprogramm wie veraPDF dennoch abgelehnt werden, zu dem man greift, wenn "
"ein Archiv die Datei abnehmen muss."

#: src/core/Archival.cpp:575
#, kde-format
msgid ""
"Only what the file says about itself is read. A document claiming PDF/A-2b "
"is taken at its word on that point."
msgstr ""
"Gelesen wird nur, was die Datei über sich selbst sagt. Ein Dokument, das PDF/"
"A-2b behauptet, wird in diesem Punkt beim Wort genommen."

#: src/core/Archival.cpp:614
#, kde-format
msgid ""
"Ghostscript is not installed, so documents cannot be converted for "
"archiving. Install the “ghostscript” package."
msgstr ""
"Ghostscript ist nicht installiert, daher können Dokumente nicht für die "
"Archivierung umgewandelt werden. Installieren Sie das Paket „ghostscript“."

#: src/core/Archival.cpp:630 src/core/Convert.cpp:2343
#, kde-format
msgid "The colour profile “%1” does not exist."
msgstr "Das Farbprofil „%1“ existiert nicht."

#: src/core/Archival.cpp:638
#, kde-format
msgid ""
"No sRGB colour profile was found on this system, so Ghostscript's built-in "
"default was used. The file will have no output intent, which a strict check "
"may object to. Installing the “icc-profiles-free” package fixes it."
msgstr ""
"Auf diesem System wurde kein sRGB-Farbprofil gefunden, daher wurde die "
"eingebaute Vorgabe von Ghostscript verwendet. Die Datei erhält keinen Output "
"Intent, woran eine strenge Prüfung Anstoß nehmen kann. Das Paket „icc-"
"profiles-free“ zu installieren behebt das."

#: src/core/Archival.cpp:646 src/core/Convert.cpp:2373
#: src/core/Preflight.cpp:2607
#, kde-format
msgid "Could not create a temporary directory."
msgstr "Ein temporäres Verzeichnis konnte nicht angelegt werden."

#: src/core/Archival.cpp:661 src/core/BlankPdf.cpp:44
#: src/core/Compressor.cpp:222 src/core/Convert.cpp:2388
#: src/core/Encryption.cpp:42 src/core/ImageIO.cpp:70 src/core/Metadata.cpp:42
