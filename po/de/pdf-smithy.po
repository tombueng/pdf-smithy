msgstr "Dieses Dokument hat kein Feld namens „%1“."

#: src/cli/CommandsForm.cpp:526 src/cli/CommandsForm.cpp:850
#, kde-format
msgid "“%1” is not a kind of field."
msgstr "„%1“ ist keine Feldart."

#: src/cli/CommandsForm.cpp:531 src/core/FormBuilder.cpp:873
#: src/core/FormBuilder.cpp:1351 src/core/FormBuilder.cpp:1663
#, kde-format
