msgid "Note: the repaired file could not be checked again: %1"
msgstr "Hinweis: Die reparierte Datei konnte nicht erneut geprüft werden: %1"

#: src/cli/CommandsPreflight.cpp:426
#, kde-format
msgid "Nothing found here can be mended automatically."
msgstr "Nichts von dem hier Gefundenen lässt sich automatisch beheben."

