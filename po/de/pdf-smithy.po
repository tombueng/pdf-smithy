msgid_plural "%1 of them cannot be judged here: %2."
msgstr[0] "Eine davon lässt sich hier nicht beurteilen: %2."
msgstr[1] "%1 davon lassen sich hier nicht beurteilen: %2."

#: src/cli/CommandsPreflight.cpp:520
#, kde-format
msgid ""
"Check against one with “preflight FILE --profile ID”, or against a profile "
"of your own by giving its file name instead."
msgstr ""
"Prüfen Sie dagegen mit „preflight DATEI --profile ID“ oder gegen ein eigenes "
"Profil, indem Sie stattdessen dessen Dateinamen angeben."

