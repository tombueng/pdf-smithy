msgstr "转换生成的文件为空。"

#: src/core/Archival.cpp:727
#, kde-format
msgid "Some colours could not be converted to a device-independent space, so a strict check may object to them."
msgstr "部分颜色无法转换到与设备无关的颜色空间，严格检查可能会对此提出异议。"

#: src/core/Archival.cpp:735 src/core/Compressor.cpp:309
#: src/core/Convert.cpp:1756 src/core/Convert.cpp:2468
#: src/core/Preflight.cpp:2727 src/core/Preflight.cpp:3017
#, kde-format
msgid "Could not replace “%1”."
msgstr "无法替换“%1”。"

#: src/core/Archival.cpp:743 src/core/Convert.cpp:2473
#, kde-format
msgid "The file now identifies itself as %1."
msgstr "该文件现在将自身标识为 %1。"

#: src/core/Archival.cpp:761
#, kde-format
msgid "The converted file could not be read back, so what it now contains is unverified."
msgstr "无法重新读取转换后的文件，因此它现在包含的内容未经验证。"

#: src/core/Archival.cpp:766
#, kde-format
msgid "The original could not be examined, so the list of changes is incomplete."
msgstr "无法检查原始文件，因此更改列表并不完整。"

#: src/core/NUp.cpp:47
#, kde-format
msgid "A sheet has to hold at least two pages."
msgstr "每张纸至少要容纳两页。"

#: src/core/NUp.cpp:82
#, kde-format
msgid "The margins and gaps leave no room on the sheet. Reduce them or use a larger sheet."
msgstr "页边距和间距没有在纸张上留下空间。请减小它们，或使用更大的纸张。"

#: src/core/ImageIO.cpp:61
#, kde-format
msgid "No images were given."
msgstr "未提供图片。"

#: src/core/ImageIO.cpp:143
#, kde-format
msgid "None of the files could be read as an image."
msgstr "所有文件都无法作为图片读取。"

#: src/core/ImageIO.cpp:190
#, kde-format
msgid "There are no pages to export."
msgstr "没有要导出的页面。"

#: src/core/ImageIO.cpp:196 src/core/Splitter.cpp:111
#, kde-format
msgid "No output file name was given."
msgstr "未指定输出文件名。"

#: src/core/ImageIO.cpp:248
