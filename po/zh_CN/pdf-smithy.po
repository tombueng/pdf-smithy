msgstr "无法把“%1”作为图片读取。"

#: src/ui/ToolImagesDialog.cpp:627
#, kde-format
msgid "Page %1 now draws the new picture, in the place %2 had."
msgstr "第 %1 页现在会在 %2 原来的位置绘制新图片。"

#: src/ui/ToolImagesDialog.cpp:630
#, kde-format
msgid "It was fitted inside that place and centred, so its proportions are its own."
msgstr "新图片已缩放到该位置之内并居中放置，因此保持了自身的比例。"

#: src/ui/ToolImagesDialog.cpp:631 src/cli/CommandsImages.cpp:555
#, kde-format
msgid "It was stretched to fill that place exactly."
msgstr "新图片被拉伸，正好填满该位置。"

#: src/ui/ToolImagesDialog.cpp:658 src/cli/CommandsImages.cpp:593
#, kde-format
msgid "Turned %2 on page %3 by %4°, in one place."
msgid_plural "Turned %2 on page %3 by %4°, in %1 places."
msgstr[0] "已把第 %3 页上的 %2 旋转 %4°，共 %1 处。"

#: src/ui/ToolImagesDialog.cpp:662 src/cli/CommandsImages.cpp:597
#, kde-format
msgid "Not one stored byte of the picture was rewritten."
msgstr "图片存储的字节一个也没有被重写。"

#: src/ui/ToolImagesDialog.cpp:665
#, kde-format
msgid "One placement was left alone: its own matrix cannot be reversed, so no turn could be worked out for it."
msgid_plural "%1 placements were left alone: their own matrices cannot be reversed, so no turn could be worked out for them."
msgstr[0] "有 %1 处未作改动：它们自身的矩阵无法求逆，因此算不出应有的旋转。"

#: src/ui/ToolImagesDialog.cpp:687
#, kde-format
msgid "Page %1 will stop drawing %2. The stored bytes go when nothing else in the document points at them."
msgstr "第 %1 页将不再绘制 %2。当文档里再没有别的地方引用这些存储的字节时，它们就会被清除。"

#: src/ui/ToolImagesDialog.cpp:702 src/cli/CommandsImages.cpp:624
#, kde-format
msgid "Page %1 no longer draws %2."
msgstr "第 %1 页不再绘制 %2。"

