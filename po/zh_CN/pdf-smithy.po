msgstr "“%1”要求第 %2 页，而此文档没有该页。"

#: src/core/FormBuilder.cpp:1356
#, kde-format
msgid "“%1” has no size, so nothing could be drawn for it."
msgstr "“%1”没有大小，因此无法为它绘制任何内容。"

#: src/core/FormBuilder.cpp:1464
#, kde-format
msgid "There are no fields to change."
msgstr "没有要更改的字段。"

#: src/core/FormBuilder.cpp:1545
#, kde-format
msgid "There are no fields to remove."
msgstr "没有要移除的字段。"

#: src/core/FormBuilder.cpp:1668
#, kde-format
msgid "A field can be renamed but not moved into another group, so “%1” cannot become “%2”."
msgstr "字段可以重命名，但不能移入其他分组，因此“%1”不能变成“%2”。"

#: src/core/FormBuilder.cpp:1705 src/core/FontEmbedder.cpp:2412
#, kde-format
msgid "This document has no page %1."
msgstr "此文档没有第 %1 页。"

#: src/core/FormBuilder.cpp:1712
#, kde-format
msgid "There is nothing on page %1 to put in order."
msgstr "第 %1 页上没有可设置顺序的内容。"

#: src/core/FormBuilder.cpp:1799
#, kde-format
msgid "The smallest value allowed is larger than the largest."
msgstr "允许的最小值大于最大值。"

#: src/core/FormBuilder.cpp:1825
#, kde-format
msgid "A calculation needs at least one field to work from."
msgstr "计算至少需要一个作为依据的字段。"

#: src/core/FormBuilder.cpp:1910
#, kde-format
msgid "A button that submits a form needs an address to submit it to."
msgstr "提交表单的按钮需要一个提交地址。"

#: src/core/FormBuilder.cpp:1931
#, kde-format
msgid "“%1” is not a page of this document."
msgstr "“%1”不是此文档中的页面。"

#: src/core/FormBuilder.cpp:1945
#, kde-format
msgid "A button that opens a link needs an address."
msgstr "打开链接的按钮需要一个地址。"

#: src/core/FormBuilder.cpp:1957
#, kde-format
