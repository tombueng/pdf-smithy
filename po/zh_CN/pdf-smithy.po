msgstr[0] "已导出 %1 张图片，合计 %2。"

#: src/ui/ToolImagesDialog.cpp:586
#, kde-format
msgid "Left one picture in the document: its pixels are stored in a form this cannot open."
msgid_plural "Left %1 pictures in the document: their pixels are stored in a form this cannot open."
msgstr[0] "有 %1 张图片留在了文档中：它们的像素以本工具无法打开的形式存储。"

