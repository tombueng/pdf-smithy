#, kde-format
msgid "Note: a list box and a drop-down read back the same, so “%1” is written as a drop-down. Add --type list to keep a list box."
msgstr "注意：列表框和下拉框读回来是一样的，因此“%1”会写成下拉框。要保留列表框，请加上 --type list。"

#: src/cli/CommandsForm.cpp:915
#, kde-format
msgid "Changed “%1” in %2."
msgstr "已更改 %2 中的“%1”。"

#: src/cli/CommandsForm.cpp:923
#, kde-format
