#: src/ui/CropEditor.cpp:131
#, kde-format
msgctxt "@action:button"
msgid "Find the border for me"
msgstr "自动查找边界"

#: src/ui/CropEditor.cpp:133
#, kde-format
msgctxt "@info:tooltip"
msgid "Looks at the pages and measures the empty margin, taking the smallest trim that is safe for all of them."
msgstr "检查这些页面并测量空白页边距，取对所有页面都安全的最小裁剪量。"

#: src/ui/CropEditor.cpp:138
#, kde-format
msgid "Nothing is cut away. Trimming sets the visible area, so it can be undone at any time and the page keeps its content."
msgstr "不会删除任何内容。裁剪只是设定可见区域，因此随时可以撤销，页面的内容也会完整保留。"

#: src/ui/CropEditor.cpp:152
#, kde-format
msgctxt "@action:button"
msgid "Trim"
msgstr "裁剪"

#: src/ui/CropEditor.cpp:230
#, kde-format
msgid "These pages have no empty border in common, so there is nothing to trim."
msgstr "这些页面没有共同的空白边界，因此没有可裁剪的部分。"

#: src/ui/CropEditor.cpp:237
#, kde-format
msgid "Measured across %1 pages. Adjust anything that looks too tight before trimming."
msgstr "已在 %1 页上测量。裁剪前请调整任何看起来过紧的数值。"

#: src/ui/CropEditor.cpp:252
#, kde-format
msgctxt "@title:window"
msgid "Trim Pages"
msgstr "裁剪页面"

#: src/ui/CropEditor.cpp:275
#, kde-format
msgid "This editor has nothing to trim with."
msgstr "此编辑器中没有可供裁剪的内容。"

