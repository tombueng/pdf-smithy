#: src/ui/AlignmentPanel.cpp:30
#, kde-format
msgctxt "@action:button"
msgid "Align Left"
msgstr "左对齐"

#: src/ui/AlignmentPanel.cpp:31
#, kde-format
msgctxt "@info:tooltip"
msgid "Line the left edges up with the leftmost."
msgstr "将左边缘与最左侧的对象对齐。"

#: src/ui/AlignmentPanel.cpp:35
#, kde-format
msgctxt "@action:button line the boxes up on a shared upright line"
msgid "Align Centre"
msgstr "水平居中"

#: src/ui/AlignmentPanel.cpp:36
#, kde-format
msgctxt "@info:tooltip"
msgid "Line the centres up on one upright line, halfway across the selection."
msgstr "将各对象的中心对齐到一条竖直线上，位于所选内容的水平中点。"

#: src/ui/AlignmentPanel.cpp:40
#, kde-format
msgctxt "@action:button"
msgid "Align Right"
msgstr "右对齐"

#: src/ui/AlignmentPanel.cpp:41
#, kde-format
msgctxt "@info:tooltip"
msgid "Line the right edges up with the rightmost."
msgstr "将右边缘与最右侧的对象对齐。"

#: src/ui/AlignmentPanel.cpp:45
#, kde-format
msgctxt "@action:button"
msgid "Space Out Sideways"
msgstr "水平等距分布"

#: src/ui/AlignmentPanel.cpp:46
#, kde-format
msgctxt "@info:tooltip"
msgid "Put equal gaps between them from left to right. The outermost two stay put."
msgstr "从左到右在各对象之间留出相等的间距，最外侧的两个保持不动。"

#: src/ui/AlignmentPanel.cpp:51
#, kde-format
msgctxt "@action:button"
msgid "Align Top"
msgstr "顶端对齐"

#: src/ui/AlignmentPanel.cpp:52
#, kde-format
msgctxt "@info:tooltip"
msgid "Line the top edges up with the highest."
msgstr "将上边缘与最上方的对象对齐。"

#: src/ui/AlignmentPanel.cpp:56
#, kde-format
msgctxt "@action:button line the boxes up on a shared level line"
msgid "Align Middle"
msgstr "垂直居中"

#: src/ui/AlignmentPanel.cpp:57
#, kde-format
msgctxt "@info:tooltip"
msgid "Line the centres up on one level line, halfway up the selection."
msgstr "将各对象的中心对齐到一条水平线上，位于所选内容的垂直中点。"

#: src/ui/AlignmentPanel.cpp:61
#, kde-format
msgctxt "@action:button"
msgid "Align Bottom"
msgstr "底端对齐"

#: src/ui/AlignmentPanel.cpp:62
#, kde-format
msgctxt "@info:tooltip"
msgid "Line the bottom edges up with the lowest."
msgstr "将下边缘与最下方的对象对齐。"

#: src/ui/AlignmentPanel.cpp:66
#, kde-format
msgctxt "@action:button"
msgid "Space Out Upright"
msgstr "垂直等距分布"

#: src/ui/AlignmentPanel.cpp:67
#, kde-format
msgctxt "@info:tooltip"
msgid "Put equal gaps between them from bottom to top. The outermost two stay put."
msgstr "从下到上在各对象之间留出相等的间距，最外侧的两个保持不动。"

#: src/ui/AlignmentPanel.cpp:74
#, kde-format
msgctxt "@action:button"
msgid "Same Width"
msgstr "宽度相同"

#: src/ui/AlignmentPanel.cpp:75
#, kde-format
msgctxt "@info:tooltip"
msgid "Give everything the width of the widest, keeping each top left corner."
msgstr "让所有对象都采用最宽者的宽度，各自的左上角保持不变。"

#: src/ui/AlignmentPanel.cpp:79
#, kde-format
msgctxt "@action:button"
msgid "Same Height"
msgstr "高度相同"

#: src/ui/AlignmentPanel.cpp:80
#, kde-format
msgctxt "@info:tooltip"
msgid "Give everything the height of the tallest, keeping each top left corner."
msgstr "让所有对象都采用最高者的高度，各自的左上角保持不变。"

#: src/ui/AlignmentPanel.cpp:84
#, kde-format
msgctxt "@action:button"
msgid "Same Size"
msgstr "大小相同"

#: src/ui/AlignmentPanel.cpp:86
#, kde-format
msgctxt "@info:tooltip"
msgid "Give everything the width of the widest and the height of the tallest, keeping each top left corner."
msgstr "让所有对象都采用最宽者的宽度和最高者的高度，各自的左上角保持不变。"

#: src/ui/AlignmentPanel.cpp:168
#, kde-format
msgctxt "@info:tooltip why a button cannot be pressed"
msgid "Choose at least three things. Spacing out moves what lies between the outermost two, and two things have nothing between them."
msgstr "请至少选择三个对象。等距分布移动的是最外侧两个之间的对象，而两个对象之间没有任何东西。"

#: src/ui/AlignmentPanel.cpp:171
#, kde-format
msgctxt "@info:tooltip why a button cannot be pressed"
msgid "Choose at least two things. One is already lined up with itself."
msgstr "请至少选择两个对象。单个对象与它自己本来就是对齐的。"

#: src/ui/PageClipboard.cpp:57
#, kde-format
msgctxt "@info stands for a copied picture where only text can go"
msgid "[picture, %1 × %2 pixels]"
msgstr "[图片，%1 × %2 像素]"

#: src/ui/PageClipboard.cpp:60
#, kde-format
