msgstr "请用 --order 给出顺序，形式为一个字段名称列表。"

#: src/cli/CommandsForm.cpp:936
#, kde-format
msgid "The tab key now walks %1 field of page %2 in that order. The result is in %3."
msgid_plural "The tab key now walks %1 fields of page %2 in that order. The result is in %3."
msgstr[0] "Tab 键现在会按该顺序走过第 %2 页的 %1 个字段。结果保存在 %3 中。"

#: src/cli/CommandsForm.cpp:955
#, kde-format
