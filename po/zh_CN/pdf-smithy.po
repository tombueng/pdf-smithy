#: src/core/FormBuilder.cpp:1863 src/core/Forms.cpp:668
#: src/cli/CommandsForm.cpp:480 src/cli/CommandsForm.cpp:905
#, kde-format
msgid "This document has no field called “%1”."
msgstr "此文档没有名为“%1”的字段。"

#: src/core/FormBuilder.cpp:1321
#, kde-format
msgid "There are no fields to add."
msgstr "没有要添加的字段。"

#: src/core/FormBuilder.cpp:1350
#, kde-format
