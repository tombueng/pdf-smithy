#: src/ui/ToolFontsDialog.cpp:277
#, kde-format
msgctxt "@info:tooltip"
msgid "The glyphs travel with the document."
msgstr "字形随文档一起传递。"

#: src/ui/ToolFontsDialog.cpp:278
#, kde-format
msgctxt "@info:tooltip"
msgid "Only part of the font is here."
msgstr "这里只有字体的一部分。"

#: src/ui/ToolFontsDialog.cpp:280
#, kde-format
msgctxt "@info:tooltip"
msgid "Its text can be copied out, searched and read aloud."
msgstr "它的文本可以复制、搜索和朗读。"

#: src/ui/ToolFontsDialog.cpp:291 src/ui/ToolLayoutDialog.cpp:439
#: src/ui/ToolImagesDialog.cpp:331 src/ui/ToolColourDialog.cpp:195
#: src/ui/ToolFormBuilderDialog.cpp:993
#, kde-format
msgctxt "@action:button"
