msgstr "要放入的图片"

#: src/ui/ToolImagesDialog.cpp:606
#, kde-format
msgid "Pictures (*.png *.jpg *.jpeg *.tif *.tiff *.webp *.bmp);;All files (*)"
msgstr "图片 (*.png *.jpg *.jpeg *.tif *.tiff *.webp *.bmp);;所有文件 (*)"

