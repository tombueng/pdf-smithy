msgctxt "@info page, font, the /Fx name it got, glyph count and size"
msgid "Page %1: %2 added as %3, %4 glyphs, %5"
msgstr "第 %1 页：已添加 %2，名称为 %3，%4 个字形，%5"

#: src/cli/CommandsFonts.cpp:446
#, kde-format
msgid "fonts strip needs to know which fonts, as --font-name Helvetica, or --all for every embedded one."
msgstr "fonts strip 需要知道针对哪些字体，例如 --font-name Helvetica，或用 --all 处理所有已嵌入的字体。"

#: src/cli/CommandsFonts.cpp:458
#, kde-format
msgid "Threw the glyphs of %1 font away."
msgid_plural "Threw the glyphs of %1 fonts away."
msgstr[0] "已丢弃 %1 种字体的字形。"

#: src/cli/CommandsFonts.cpp:481
#, kde-format
msgid "Reduced %1 duplicate font to the one the pages now share."
msgid_plural "Reduced %1 duplicate fonts to the ones the pages now share."
msgstr[0] "已把 %1 种重复的字体合并，各页面现在共用同一份。"

#: src/cli/CommandsFonts.cpp:503
#, kde-format
msgid "Wrote a /ToUnicode map for %1 font."
msgid_plural "Wrote a /ToUnicode map for %1 fonts."
msgstr[0] "已为 %1 种字体写入 /ToUnicode 映射。"

#: src/cli/CommandsFonts.cpp:511
#, kde-format
msgid "fonts find needs one family name, as: fonts find “DejaVu Sans”."
msgstr "fonts find 需要一个字体家族名称，例如：fonts find “DejaVu Sans”。"

#: src/cli/CommandsFonts.cpp:531
#, kde-format
msgid "That file was found, but it is not a TrueType or OpenType font, and only those can be cut down and embedded."
msgstr "找到了该文件，但它不是 TrueType 或 OpenType 字体，只有这两种才能子集化并嵌入。"

#: src/cli/CommandsFonts.cpp:558
#, kde-format
msgid "Which font to embed, by family name, e.g. “DejaVu Sans”."
msgstr "要嵌入哪种字体，按家族名称给出，例如“DejaVu Sans”。"

#: src/cli/CommandsFonts.cpp:559
#, kde-format
msgid "Which font in the document to act on, by its /BaseFont name. Repeat for more."
msgstr "要处理文档中的哪种字体，按它的 /BaseFont 名称给出。要处理多种，请重复使用该选项。"

#: src/cli/CommandsFonts.cpp:561
#, kde-format
msgid "Which cut of the family: bold, italic, bold-italic or regular."
msgstr "字体家族中的哪一种样式：bold、italic、bold-italic 或 regular。"

#: src/cli/CommandsFonts.cpp:562
#, kde-format
msgid "Act on every embedded font, not a named one."
msgstr "处理所有已嵌入的字体，而不是指定的某一种。"

#: src/cli/CommandsFonts.cpp:572
#, kde-format
msgid "Every font, where it is used and what is wrong with it"
msgstr "所有字体、它们的使用位置以及存在的问题"

#: src/cli/CommandsFonts.cpp:573
#, kde-format
msgid "Exit non-zero when a font is missing or unreadable"
msgstr "字体缺失或无法读取时以非零状态退出"

#: src/cli/CommandsFonts.cpp:574
#, kde-format
msgid "Add a system font, cut down to the characters asked for"
msgstr "添加系统字体，并子集化为所需的字符"

#: src/cli/CommandsFonts.cpp:575
#, kde-format
msgid "Throw embedded glyphs away and keep the text"
msgstr "丢弃嵌入的字形，保留文本"

#: src/cli/CommandsFonts.cpp:576
#, kde-format
msgid "Join duplicate subsets of the same font into one"
msgstr "把同一字体的重复子集合并为一个"

#: src/cli/CommandsFonts.cpp:577
#, kde-format
msgid "Write /ToUnicode maps so the text can be copied"
msgstr "写入 /ToUnicode 映射，让文本可以复制"

#: src/cli/CommandsFonts.cpp:578
#, kde-format
msgid "Where this system keeps a font, if it has it"
msgstr "本系统中某种字体的存放位置（如果装有）"

#: src/cli/CommandsFonts.cpp:579
#, kde-format
msgid "What the font tools cannot promise"
msgstr "字体工具无法保证的事情"

#: src/cli/CommandsFonts.cpp:589
#, kde-format
msgid "Cutting an embedded font down to the glyphs a page uses, and swapping one font for another, both mean rewriting every character code on every page that refers to it, and a wrong answer there is a page of wrong letters. Neither is done here. “fonts merge” joins duplicate subsets, and “fonts strip” drops the glyphs and keeps the text."
msgstr "把已嵌入的字体裁减为页面用到的字形，以及用一种字体替换另一种，都意味着要重写引用它的每一页上的每一个字符编码，一旦算错，整页字母就都错了。这两件事本程序都不做。“fonts merge”会合并重复的子集，“fonts strip”会丢弃字形并保留文本。"

#: src/cli/CommandsFonts.cpp:595
#, kde-format
msgid "“%1” is not something fonts can do. Try list, check, embed, strip, merge, unicode, find or limits."
msgstr "“%1”不是 fonts 能做的事情。请尝试 list、check、embed、strip、merge、unicode、find 或 limits。"

#: src/cli/CommandsFonts.cpp:611
#, kde-format
msgid "fonts needs to be told what to do:"
msgstr "需要告诉 fonts 要做什么:"

#: src/cli/Common.cpp:29
#, kde-format
msgctxt "@info error prefix on the command line"
msgid "Error: "
msgstr "错误: "

#: src/cli/Common.cpp:41
#, kde-format
msgid "“%1” works on one document at a time."
msgstr "“%1”一次只能处理一个文档。"

#: src/cli/CommandsImages.cpp:61
#, kde-format
msgid "Which page? Give --page, counting from 1."
msgstr "哪一页？请给出 --page，从 1 开始计数。"

#: src/cli/CommandsImages.cpp:79
#, kde-format
msgid "Which picture? Give --resource, as “images list” shows it."
msgstr "哪张图片？请给出 --resource，取值见“images list”的输出。"

#: src/cli/CommandsImages.cpp:92
#, kde-format
msgid "That would write over the original. Give -o another name."
msgstr "这样会覆盖原文件。请用 -o 换一个名称。"

#: src/cli/CommandsImages.cpp:202
#, kde-format
msgctxt "@info where the result was written"
msgid "Wrote %1."
msgstr "已写入 %1。"

#: src/cli/CommandsImages.cpp:236
#, kde-format
msgctxt "@item how often the same picture is drawn in the document"
msgid "drawn %1 time"
msgid_plural "drawn %1 times"
msgstr[0] "绘制 %1 次"

#: src/cli/CommandsImages.cpp:301
#, kde-format
msgctxt "@title:column how the pixels are stored"
msgid "Format"
msgstr "格式"

#: src/cli/CommandsImages.cpp:354
#, kde-format
msgid "%1 picture, %2 in all."
msgid_plural "%1 pictures, %2 in all."
msgstr[0] "共 %1 张图片，合计 %2。"

#: src/cli/CommandsImages.cpp:356
#, kde-format
msgid "%1 of them sits above %2 dpi and holds %3, more than any printer will show."
msgid_plural "%1 of them sit above %2 dpi and hold %3, more than any printer will show."
msgstr[0] "其中 %1 张高于 %2 dpi，共占 %3，超出了任何打印机能呈现的程度。"

#: src/cli/CommandsImages.cpp:360
#, kde-format
msgid "“images resample %1 --max-dpi 150 -o smaller.pdf” brings them down."
msgstr "“images resample %1 --max-dpi 150 -o smaller.pdf”可以把它们降下来。"

#: src/cli/CommandsImages.cpp:387
#, kde-format
msgid "JPEG 2000 cannot be written. Use --format jpeg, or --format keep to re-pack the pixels without any loss at all."
msgstr "无法写出 JPEG 2000。请使用 --format jpeg，或用 --format keep 重新打包像素，完全不损失质量。"

#: src/cli/CommandsImages.cpp:392
#, kde-format
msgid "“%1” is not a picture format here. Use jpeg or keep."
msgstr "“%1”不是这里可用的图片格式。请使用 jpeg 或 keep。"

#: src/cli/CommandsImages.cpp:407
#, kde-format
msgid "Left %1 picture alone: its pixels are stored in a form this cannot open."
msgid_plural "Left %1 pictures alone: their pixels are stored in a form this cannot open."
msgstr[0] "有 %1 张图片未作处理：它们的像素以本程序无法打开的形式存储。"

#: src/cli/CommandsImages.cpp:416
#, kde-format
msgid "No picture needed re-encoding, so %1 is a copy of the original."
msgstr "没有图片需要重新编码，因此 %1 是原文件的副本。"

#: src/cli/CommandsImages.cpp:465
#, kde-format
msgid "Re-packing at up to %1 dpi, with no loss of quality at all."
msgstr "以最高 %1 dpi 重新打包，完全不损失质量。"

#: src/cli/CommandsImages.cpp:469
#, kde-format
msgid "Re-encoding at up to %1 dpi, quality %2."
msgstr "以最高 %1 dpi 重新编码，质量为 %2。"

#: src/cli/CommandsImages.cpp:474
#, kde-format
msgid "A lower --dpi or --quality would give it something to work with."
msgstr "把 --dpi 或 --quality 调低一些才会有效果。"

#: src/cli/CommandsImages.cpp:481
#, kde-format
msgid "How fine should the pictures still be? Give --max-dpi, for example 150 for reading on screen or 300 for printing."
msgstr "图片还需要多精细？请给出 --max-dpi，例如屏幕阅读用 150，打印用 300。"

#: src/cli/CommandsImages.cpp:490
#, kde-format
msgid "--max-dpi has to be more than zero."
msgstr "--max-dpi 必须大于零。"

#: src/cli/CommandsImages.cpp:521
#, kde-format
msgid "Every picture is already at or below %1 dpi."
msgstr "所有图片都已不高于 %1 dpi。"

#: src/cli/CommandsImages.cpp:536
#, kde-format
msgid "Which picture should go in? Give --with a file."
msgstr "要放进哪张图片？请用 --with 给出一个文件。"

#: src/cli/CommandsImages.cpp:553
#, kde-format
msgid "Page %1 now draws %2, in the place the old picture had."
msgstr "第 %1 页现在在原图片的位置绘制 %2。"

#: src/cli/CommandsImages.cpp:570
#, kde-format
msgid "By how much? Give --angle 90, or any number of degrees."
msgstr "旋转多少？请给出 --angle 90，或任意度数。"

#: src/cli/CommandsImages.cpp:575
#, kde-format
msgid "“%1” is not an angle in degrees."
msgstr "“%1”不是以度为单位的角度。"

#: src/cli/CommandsImages.cpp:600
#, kde-format
msgctxt "@info a caveat on the command line"
msgid "Note: "
msgstr "注意: "

#: src/cli/CommandsImages.cpp:651
#, kde-format
msgid "--brightness and --contrast run from -1 to 1."
msgstr "--brightness 和 --contrast 的取值范围是 -1 到 1。"

#: src/cli/CommandsImages.cpp:654
#, kde-format
msgid "--gamma has to be more than zero. Above 1 lifts the midtones, below 1 lowers them."
msgstr "--gamma 必须大于零。大于 1 会提亮中间调，小于 1 会压暗中间调。"

#: src/cli/CommandsImages.cpp:674
#, kde-format
msgid "Nothing to adjust. Try --brightness, --contrast, --gamma, --sharpen, --despeckle, --auto-levels, --grayscale or --black-white."
msgstr "没有要调整的内容。请尝试 --brightness、--contrast、--gamma、--sharpen、--despeckle、--auto-levels、--grayscale 或 --black-white。"

#: src/cli/CommandsImages.cpp:708
#, kde-format
msgid "Which part should stay? Give --keep-box X,Y,WIDTH,HEIGHT as fractions of the picture, measured from its top-left corner, for example 0,0,1,0.5 for the upper half."
msgstr "要保留哪一部分？请给出 --keep-box X,Y,WIDTH,HEIGHT，取值是相对图片的比例，从它的左上角算起，例如 0,0,1,0.5 表示上半部分。"

#: src/cli/CommandsImages.cpp:719
#, kde-format
msgid "“%1” is not an area. The form is X,Y,WIDTH,HEIGHT as fractions, e.g. 0.1,0,0.8,1."
msgstr "“%1”不是区域。格式为 X,Y,WIDTH,HEIGHT，取值是比例，例如 0.1,0,0.8,1。"

#: src/cli/CommandsImages.cpp:726
#, kde-format
msgid "The area has to lie inside the picture, as fractions between 0 and 1."
msgstr "该区域必须落在图片之内，取值是 0 到 1 之间的比例。"

#: src/cli/CommandsImages.cpp:766
#, kde-format
msgid "Where should the pictures go? Give --out-dir a folder."
msgstr "图片要放到哪里？请用 --out-dir 给出一个文件夹。"

#: src/cli/CommandsImages.cpp:780
#, kde-format
msgid "“%1” is not a picture format this can write. Try png, jpg, tif or webp."
msgstr "“%1”不是本程序能写出的图片格式。请尝试 png、jpg、tif 或 webp。"

#: src/cli/CommandsImages.cpp:815
#, kde-format
msgctxt "@info"
msgid "Wrote one picture, %1."
msgstr "已写出一张图片，%1。"

#: src/cli/CommandsImages.cpp:853
#, kde-format
msgctxt "@info"
msgid "Wrote %1 picture, %2 in all."
msgid_plural "Wrote %1 pictures, %2 in all."
msgstr[0] "已写出 %1 张图片，合计 %2。"

#: src/cli/CommandsImages.cpp:856
#, kde-format
msgid "Left %1 picture in the document: its pixels are stored in a form this cannot open."
msgid_plural "Left %1 pictures in the document: their pixels are stored in a form this cannot open."
msgstr[0] "有 %1 张图片留在了文档中：它们的像素以本程序无法打开的形式存储。"

#: src/cli/CommandsImages.cpp:881
#, kde-format
msgid "No picture is stored more than once, so %1 is a copy of the original."
msgstr "没有图片被重复存储，因此 %1 是原文件的副本。"

#: src/cli/CommandsImages.cpp:884
#, kde-format
msgid "Merged %1 duplicate into the picture it repeated, freeing %2."
msgid_plural "Merged %1 duplicates into the pictures they repeated, freeing %2."
msgstr[0] "已把 %1 个重复的图片合并到它所重复的图片中，释放了 %2。"

#: src/cli/CommandsImages.cpp:895
#, kde-format
msgid "Which picture, by the resource name “images list” shows."
msgstr "哪张图片，按“images list”显示的资源名称给出。"

#: src/cli/CommandsImages.cpp:897
#, kde-format
msgid "The picture file to put in instead."
msgstr "用来替换的图片文件。"

#: src/cli/CommandsImages.cpp:899
#, kde-format
msgid "Bring anything finer than this down to it, e.g. 150."
msgstr "把高于此值的图片降到该值，例如 150。"

#: src/cli/CommandsImages.cpp:901
#, kde-format
msgid "Fill the old place exactly instead of fitting the picture inside it."
msgstr "完全填满原有位置，而不是把图片按比例放在里面。"

#: src/cli/CommandsImages.cpp:904
#, kde-format
msgid "The part of a picture to keep, as X,Y,WIDTH,HEIGHT in fractions from its top-left corner."
msgstr "图片中要保留的部分，形式为 X,Y,WIDTH,HEIGHT，取值是从左上角算起的比例。"

#: src/cli/CommandsImages.cpp:905
#, kde-format
msgid "Brightness, -1 to 1."
msgstr "亮度，-1 到 1。"

#: src/cli/CommandsImages.cpp:906
#, kde-format
msgid "Contrast, -1 to 1."
msgstr "对比度，-1 到 1。"

#: src/cli/CommandsImages.cpp:907
#, kde-format
msgid "Gamma; above 1 lifts the midtones, below 1 lowers them."
msgstr "伽马值；大于 1 会提亮中间调，小于 1 会压暗中间调。"

#: src/cli/CommandsImages.cpp:909
#, kde-format
msgid "Sharpen the picture."
msgstr "锐化图片。"

#: src/cli/CommandsImages.cpp:910
#, kde-format
msgid "Take the specks out of a scan."
msgstr "去掉扫描件上的杂点。"

#: src/cli/CommandsImages.cpp:911
#, kde-format
msgid "Spread the tones over the full range."
msgstr "把色调拉伸到整个范围。"

#: src/cli/CommandsImages.cpp:912
#, kde-format
msgid "Reduce the picture to black and white."
msgstr "把图片变成黑白两色。"

#: src/cli/CommandsImages.cpp:914
#, kde-format
msgid "Where black turns into white, 0 to 255."
msgstr "黑白的分界处，0 到 255。"

#: src/cli/CommandsImages.cpp:932
#, kde-format
msgid "images needs to know what to do: %1."
msgstr "images 需要知道要做什么：%1。"

#: src/cli/CommandsImages.cpp:980
#, kde-format
msgid "“images %1” is not something this can do. Try %2."
msgstr "“images %1”不是本程序能做的事情。请尝试 %2。"

#: src/cli/CommandsImages.cpp:989
#, kde-format
msgid "Every picture, with the resolution it really has"
msgstr "所有图片，以及它们真正的分辨率"

#: src/cli/CommandsImages.cpp:990
#, kde-format
msgid "Re-encode the pictures, smaller"
msgstr "重新编码图片，让它更小"

#: src/cli/CommandsImages.cpp:991
#, kde-format
msgid "Bring anything finer than that down to it"
msgstr "把高于指定值的图片降到该值"

#: src/cli/CommandsImages.cpp:992
#, kde-format
msgid "Put another picture in the same place"
msgstr "在同一位置换上另一张图片"

#: src/cli/CommandsImages.cpp:993
#, kde-format
msgid "Turn one picture, without re-encoding it"
msgstr "旋转某张图片，不重新编码"

#: src/cli/CommandsImages.cpp:994
#, kde-format
msgid "Stop a page drawing one"
msgstr "让页面不再绘制某张图片"

#: src/cli/CommandsImages.cpp:995
#, kde-format
msgid "Write the stored pictures out as they are"
msgstr "按原样把存储的图片写出来"

#: src/cli/CommandsImages.cpp:996
#, kde-format
msgid "Brightness, contrast, gamma, sharpen, despeckle"
msgstr "亮度、对比度、伽马、锐化、去杂点"

#: src/cli/CommandsImages.cpp:997
#, kde-format
msgid "Cut pixels off one picture for good"
msgstr "永久裁掉某张图片的像素"

#: src/cli/CommandsImages.cpp:998
#, kde-format
msgid "Merge pictures the file stores twice"
msgstr "合并文件中存了两遍的图片"

#: src/cli/CommandsImages.cpp:999
#, kde-format
msgid "What working on pictures cannot promise"
msgstr "处理图片无法保证的事情"

