#, kde-format
msgid "Took %1 field from “%2” and put it on “%3”."
msgid_plural "Took %1 fields from “%2” and put them on “%3”."
msgstr[0] "已从“%2”取用 %1 个字段并放到“%3”上。"

#: src/cli/CommandsForm.cpp:1128
#, kde-format
