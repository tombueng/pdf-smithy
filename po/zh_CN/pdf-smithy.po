msgstr "注意事项:"

#: src/cli/CommandsColour.cpp:195
#, kde-format
msgid "Say what to convert to: --to grey, bw, rgb or cmyk."
msgstr "请指明要转换成什么: --to grey、bw、rgb 或 cmyk。"

#: src/cli/CommandsColour.cpp:200
#, kde-format
msgid "“%1” is not a colour target. Use grey, bw, rgb or cmyk."
msgstr "“%1”不是有效的颜色目标。请使用 grey、bw、rgb 或 cmyk。"

#: src/cli/CommandsColour.cpp:207
#, kde-format
msgid "--threshold is a brightness between 0 and 1, e.g. 0.5."
msgstr "--threshold 是 0 到 1 之间的亮度值,例如 0.5。"

#: src/cli/CommandsColour.cpp:215
#, kde-format
msgid "--quality is a number between 0 and 100."
msgstr "--quality 是 0 到 100 之间的数字。"

#: src/cli/CommandsColour.cpp:238 src/cli/CommandsColour.cpp:294
#: src/cli/CommandsColour.cpp:337 src/cli/CommandsColour.cpp:368
