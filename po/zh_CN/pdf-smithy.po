msgstr "请说明是哪个按钮以及它应该做什么：--name Senden --action submit --target https://example.org/eingang。"

#: src/cli/CommandsForm.cpp:1088
#, kde-format
msgid "“%1” is not something a button can do. Use reset, submit, goto or url."
msgstr "“%1”不是按钮能做的事情。请使用 reset、submit、goto 或 url。"

#: src/cli/CommandsForm.cpp:1097
#, kde-format
msgid "Pressing “%1” now does that. The result is in %2."
msgstr "现在按下“%1”就会执行该操作。结果保存在 %2 中。"

