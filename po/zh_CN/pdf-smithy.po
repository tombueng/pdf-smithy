msgstr "“%1”不是可写入的数据文件类型。请使用 .fdf、.xfdf 或 .csv。"

#: src/core/FormBuilder.cpp:2207 src/cli/CommandsLayout.cpp:661
#: src/cli/CommandsForm.cpp:1109 src/cli/CommandsForm.cpp:1170
#: src/cli/Common.cpp:50
#, kde-format
msgid "“%1” cannot be read."
msgstr "无法读取“%1”。"

#: src/core/FormBuilder.cpp:2220
#, kde-format
