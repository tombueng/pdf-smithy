#: src/cli/CommandsFonts.cpp:429
#, kde-format
msgid "Wrote %1."
msgstr "已写入 %1。"

#: src/cli/CommandsColour.cpp:240
#, kde-format
msgid "Nothing in this document needed converting."
msgstr "此文档中没有需要转换的内容。"

#: src/cli/CommandsColour.cpp:246 src/cli/CommandsConvert.cpp:325
#, kde-format
msgctxt "@title heading before a list"
msgid "What happened:"
msgstr "处理结果:"

#: src/cli/CommandsColour.cpp:261
#, kde-format
msgid "Give both colours: --from red --to-colour '#0044cc'."
msgstr "请同时给出两种颜色: --from red --to-colour '#0044cc'。"

#: src/cli/CommandsColour.cpp:281
#, kde-format
msgid "--tolerance is a distance in colour between 0 and 1; 0.05 forgives rounding."
msgstr "--tolerance 是 0 到 1 之间的颜色距离,0.05 可以容忍取整误差。"

#: src/cli/CommandsColour.cpp:295
#, kde-format
msgid "Replaced %1 colour."
msgid_plural "Replaced %1 colours."
msgstr[0] "已替换 %1 种颜色。"

#: src/cli/CommandsColour.cpp:297
#, kde-format
msgid "Nothing matched. Colours are matched in the drawing operators, not in the pixels of photographs; --tolerance 0.05 forgives the rounding a design tool leaves behind."
msgstr "没有匹配到任何内容。颜色是在绘图操作符中匹配的,而不是在照片的像素中匹配的,--tolerance 0.05 可以容忍设计工具留下的取整误差。"

#: src/cli/CommandsColour.cpp:316
#, kde-format
msgid "“%1” should look like OLD=NEW, for example “Pantone 300 C=Hausblau”."
msgstr "“%1”应写成 OLD=NEW 的形式，例如“Pantone 300 C=Hausblau”。"

#: src/cli/CommandsColour.cpp:324
#, kde-format
msgid "Say what to do with the inks: --rename OLD=NEW, or --to-process INK to dissolve one into process colour."
msgstr "请说明如何处理油墨：用 --rename OLD=NEW 重命名，或用 --to-process INK 将某个专色并入印刷色。"

#: src/cli/CommandsColour.cpp:338
#, kde-format
msgid "Changed %1 separation."
msgid_plural "Changed %1 separations."
msgstr[0] "已更改%1个分色。"

#: src/cli/CommandsColour.cpp:340
#, kde-format
msgid "No ink of that name is in this document. “colour inspect” lists the ones that are."
msgstr "本文档中没有该名称的油墨。“colour inspect”会列出文档中实际含有的油墨。"

#: src/cli/CommandsColour.cpp:357
#, kde-format
msgid "--min-width is a stroke width in points, e.g. 0.25."
msgstr "--min-width 是以点为单位的线条宽度，例如 0.25。"

#: src/cli/CommandsColour.cpp:370
#, kde-format
msgid "No stroke was thinner than %1 pt."
msgstr "没有线条细于%1 pt。"

#: src/cli/CommandsColour.cpp:373
#, kde-format
msgid "Thickened %1 stroke to %2 pt."
msgid_plural "Thickened %1 strokes to %2 pt."
msgstr[0] "已将%1条线条加粗到%2 pt。"

#: src/cli/CommandsColour.cpp:397
#, kde-format
msgid "Black now overprints in %1 place."
msgid_plural "Black now overprints in %1 places."
msgstr[0] "现已在%1处将黑色设为叠印。"

#: src/cli/CommandsColour.cpp:398
#, kde-format
msgid "Black is now set not to overprint in %1 place."
msgid_plural "Black is now set not to overprint in %1 places."
msgstr[0] "现已在%1处取消黑色叠印。"

#: src/cli/CommandsColour.cpp:434
#, kde-format
msgid "Highest total ink: %1 % of a page."
msgstr "页面上的最高总墨量：%1 %。"

#: src/cli/CommandsColour.cpp:438
#, kde-format
msgid "Over 300 %, which most presses cannot dry. Ask the print shop for their ink limit."
msgstr "超过 300 %，多数印刷机无法将其烘干。请向印刷厂询问他们的墨量上限。"

#: src/cli/CommandsColour.cpp:454
#, kde-format
msgid "Say which plate: --ink Cyan, Magenta, Yellow, Black, or a separation name as “colour inspect” reports it."
msgstr "请说明是哪个印版：--ink Cyan、Magenta、Yellow、Black，或“colour inspect”所报告的分色名称。"

#: src/cli/CommandsColour.cpp:462
#, kde-format
msgid "--page is a page number, counting from 1."
msgstr "--page 是页码，从 1 开始计数。"

#: src/cli/CommandsColour.cpp:466
#, kde-format
msgid "--dpi is a resolution in dots per inch, e.g. 150."
msgstr "--dpi 是以每英寸点数为单位的分辨率，例如 150。"

#: src/cli/CommandsColour.cpp:486
#, kde-format
msgid "Wrote the %1 plate of page %2 to %3."
msgstr "已将第%2页的%1印版写入 %3。"

#: src/cli/CommandsColour.cpp:487
#, kde-format
msgid "It is an ink density map: black is full ink, white is bare paper."
msgstr "这是一张墨量密度图：黑色表示满版着墨，白色表示空白纸张。"

#: src/cli/CommandsColour.cpp:494
#, kde-format
msgid "“colour limits” takes no file."
msgstr "“colour limits”不接受文件参数。"

#: src/cli/CommandsColour.cpp:498
#, kde-format
msgid "This build converts into CMYK itself, given an ICC profile."
msgstr "本版本在给出 ICC 配置文件后可自行转换为 CMYK。"

#: src/cli/CommandsColour.cpp:499
#, kde-format
msgid "This build has no colour management, so converting into CMYK goes through Ghostscript."
msgstr "本版本不含色彩管理，因此转换为 CMYK 需要通过 Ghostscript 完成。"

#: src/cli/CommandsColour.cpp:504
#, kde-format
msgid "No CMYK profile was found on this system. A print job names the profile it wants; pass it with --icc-profile."
msgstr "在本系统上未找到 CMYK 配置文件。印刷任务会指定所需的配置文件，请用 --icc-profile 传入。"

#: src/cli/CommandsColour.cpp:506
#, kde-format
msgid "CMYK profile found on this system: %1"
msgstr "在本系统上找到的 CMYK 配置文件：%1"

#: src/cli/CommandsColour.cpp:510 src/cli/CommandsConvert.cpp:77
#, kde-format
msgctxt "@title heading before a list"
msgid "What this cannot promise:"
msgstr "本功能无法保证的内容："

#: src/cli/CommandsColour.cpp:516
#, kde-format
msgid "Colour to convert to: grey, bw, rgb or cmyk."
msgstr "要转换成的颜色模式：grey、bw、rgb 或 cmyk。"

#: src/cli/CommandsColour.cpp:518
#, kde-format
msgid "For --to bw: brighter than this becomes white, 0 to 1."
msgstr "用于 --to bw：亮度高于此值的部分会变成白色，取值 0 到 1。"

#: src/cli/CommandsColour.cpp:519
#, kde-format
msgid "The colour to replace, a name or #rrggbb."
msgstr "要替换的颜色，可用名称或 #rrggbb。"

#: src/cli/CommandsColour.cpp:520
#, kde-format
msgid "The colour to put in its place."
msgstr "用来取代它的颜色。"

#: src/cli/CommandsColour.cpp:523
#, kde-format
msgid "Rename a spot colour, as OLD=NEW. Repeat for more; two inks given the same name are merged."
msgstr "重命名专色，格式为 OLD=NEW。可重复使用以处理多个；被指定为同一名称的两种油墨会被合并。"

#: src/cli/CommandsColour.cpp:526
#, kde-format
msgid "Dissolve this spot colour into process colour. Repeat for more."
msgstr "将此专色并入印刷色。可重复使用以处理多个。"

#: src/cli/CommandsColour.cpp:527
#, kde-format
msgid "Thinnest stroke that still prints, in points."
msgstr "仍能印刷出来的最细线条宽度，以点为单位。"

#: src/cli/CommandsColour.cpp:529
#, kde-format
msgid "Turn black overprint off instead of on."
msgstr "关闭黑色叠印，而不是打开。"

#: src/cli/CommandsColour.cpp:531
#, kde-format
msgid "Which plate to render: Cyan, Magenta, Yellow, Black or a separation name."
msgstr "要渲染哪个印版：Cyan、Magenta、Yellow、Black 或分色名称。"

#: src/cli/CommandsColour.cpp:578
#, kde-format
msgid "“colour” needs something to do: inspect, convert, replace, spot, hairlines, overprint, coverage, separate or limits."
msgstr "“colour”需要指定一项操作：inspect、convert、replace、spot、hairlines、overprint、coverage、separate 或 limits。"

#: src/cli/CommandsColour.cpp:582
#, kde-format
msgid "“colour %1” is not something this can do. Try inspect, convert, replace, spot, hairlines, overprint, coverage, separate or limits."
msgstr "“colour %1”不是可以执行的操作。请尝试 inspect、convert、replace、spot、hairlines、overprint、coverage、separate 或 limits。"

#: src/cli/CommandsColour.cpp:597
#, kde-format
msgid "What the document does with colour"
msgstr "文档如何使用颜色"

#: src/cli/CommandsColour.cpp:598
#, kde-format
msgid "Convert to grey, black and white, RGB or CMYK"
msgstr "转换为灰度、黑白、RGB 或 CMYK"

#: src/cli/CommandsColour.cpp:599
#, kde-format
msgid "Swap one colour for another, everywhere"
msgstr "在全文档中把一种颜色换成另一种"

#: src/cli/CommandsColour.cpp:600
#, kde-format
msgid "Rename, merge or dissolve named separations"
msgstr "重命名、合并命名分色，或将其并入印刷色"

#: src/cli/CommandsColour.cpp:601
#, kde-format
msgid "Thicken strokes too thin to print"
msgstr "加粗过细而无法印刷的线条"

#: src/cli/CommandsColour.cpp:602
#, kde-format
msgid "Set or clear overprint on black"
msgstr "设置或清除黑色叠印"

#: src/cli/CommandsColour.cpp:603
#, kde-format
msgid "Measure the total ink on each page"
msgstr "测量每一页的总墨量"

#: src/cli/CommandsColour.cpp:604
#, kde-format
msgid "Render one printing plate as an image"
msgstr "将某个印版渲染为图片"

#: src/cli/CommandsColour.cpp:605
#, kde-format
msgid "What the colour work here cannot promise"
msgstr "此处的颜色处理无法保证的内容"

#: src/cli/CommandsLayout.cpp:249 src/cli/CommandsLayout.cpp:322
#, kde-format
msgid "“%1” has no pages."
msgstr "“%1”没有页面。"

#: src/cli/CommandsLayout.cpp:263
#, kde-format
msgctxt "@info a page box: its corner, then its size in points and in millimetres"
msgid "%1, %2   %3 × %4 pt   (%5 × %6 mm)"
msgstr "%1, %2   %3 × %4 pt   (%5 × %6 mm)"

#: src/cli/CommandsLayout.cpp:342
#, kde-format
msgctxt "@title heading before the boxes of one page"
msgid "Page %1"
msgstr "第%1页"

#: src/cli/CommandsLayout.cpp:375
#, kde-format
msgid "“%1” is not a box. Give X,Y,WIDTH,HEIGHT in points from the bottom-left corner, or “none” to take the box away."
msgstr "“%1”不是有效的框。请以点为单位、从左下角起给出 X,Y,WIDTH,HEIGHT，或用“none”移除该框。"

#: src/cli/CommandsLayout.cpp:381
#, kde-format
msgid "A page without a /MediaBox is not a page, so --media-box cannot be “none”."
msgstr "没有 /MediaBox 的页面就不成其为页面，因此 --media-box 不能为“none”。"

#: src/cli/CommandsLayout.cpp:387
#, kde-format
msgid "layout set-boxes needs at least one of --media-box, --crop-box, --bleed-box, --trim-box or --art-box."
msgstr "layout set-boxes 至少需要 --media-box、--crop-box、--bleed-box、--trim-box 或 --art-box 中的一项。"

#: src/cli/CommandsLayout.cpp:404
#, kde-format
msgid "Setting %1. These are taken away where the pages have them: %2."
msgstr "正在设置%1。在含有以下框的页面上会将其移除：%2。"

#: src/cli/CommandsLayout.cpp:414
#, kde-format
msgctxt "@info"
msgid "Wrote the boxes of %1 page to %2."
msgid_plural "Wrote the boxes of %1 pages to %2."
msgstr[0] "已将%1页的框写入 %2。"

#: src/cli/CommandsLayout.cpp:431
#, kde-format
msgid "layout resize needs a paper size (--size), for example a4, letter or 210x297mm."
msgstr "layout resize 需要纸张大小（--size），例如 a4、letter 或 210x297mm。"

#: src/cli/CommandsLayout.cpp:436 src/cli/CommandsLayout.cpp:483
#: src/cli/CommandsLayout.cpp:692
#, kde-format
msgid "“%1” is not a paper size. Try a4, a3, a5, letter, legal, or WIDTHxHEIGHT with mm, cm, in or pt after it."
msgstr "“%1”不是纸张大小。请尝试 a4、a3、a5、letter、legal，或在 WIDTHxHEIGHT 后加上 mm、cm、in 或 pt。"

#: src/cli/CommandsLayout.cpp:444 src/cli/CommandsLayout.cpp:491
#, kde-format
msgid "“%1” is not a way to fit. Use scale, centre or shrink."
msgstr "“%1”不是有效的适配方式。请使用 scale、centre 或 shrink。"

#: src/cli/CommandsLayout.cpp:460
#, kde-format
msgctxt "@info"
msgid "Resized %1 page to %2 × %3 mm."
msgid_plural "Resized %1 pages to %2 × %3 mm."
msgstr[0] "已将%1页调整为 %2 × %3 mm。"

#: src/cli/CommandsLayout.cpp:476
#, kde-format
msgid "layout unify works on the whole document; leave --pages off."
msgstr "layout unify 作用于整个文档，请不要使用 --pages。"

#: src/cli/CommandsLayout.cpp:502
#, kde-format
msgid "Brought every page to one size. Wrote %1."
msgstr "已将所有页面统一为同一大小。已写入 %1。"

#: src/cli/CommandsLayout.cpp:514
#, kde-format
msgid "layout bleed needs a bleed (--bleed), in millimetres. Three is the usual answer."
msgstr "layout bleed 需要出血值（--bleed），以毫米为单位。通常取 3。"

#: src/cli/CommandsLayout.cpp:520 src/cli/CommandsLayout.cpp:568
#: src/cli/CommandsLayout.cpp:574 src/cli/CommandsLayout.cpp:700
#, kde-format
msgid "“%1” is not a length. Give millimetres, or a number with mm, cm, in or pt after it."
msgstr "“%1”不是长度。请给出毫米数，或在数字后加上 mm、cm、in 或 pt。"

#: src/cli/CommandsLayout.cpp:537
#, kde-format
msgctxt "@info"
msgid "Gave %1 page a %2 mm bleed."
msgid_plural "Gave %1 pages a %2 mm bleed."
msgstr[0] "已为%1页添加 %2 mm 出血。"

#: src/cli/CommandsLayout.cpp:540
#, kde-format
msgid "The trim is what the pages showed before; the sheet grew where it had to. Wrote %1."
msgstr "裁切范围仍是页面原先显示的内容，纸张则按需要变大。已写入 %1。"

#: src/cli/CommandsLayout.cpp:555
#, kde-format
msgid "layout marks marks every page; leave --pages off."
msgstr "layout marks 会为每一页添加标记，请不要使用 --pages。"

#: src/cli/CommandsLayout.cpp:560
#, kde-format
msgid "“%1” is not a list of marks. Use crop, registration, colour-bar, page-info or all, separated by commas."
msgstr "“%1”不是标记列表。请使用 crop、registration、colour-bar、page-info 或 all，以逗号分隔。"

#: src/cli/CommandsLayout.cpp:580
#, kde-format
msgid "“%1” is not a length. Give points, or a number with mm, cm, in or pt after it."
msgstr "“%1”不是长度。请给出点数，或在数字后加上 mm、cm、in 或 pt。"

#: src/cli/CommandsLayout.cpp:624
#, kde-format
msgid "“%1” is not a place to cut. Give a fraction between 0 and 1, for example 0.5 for the middle."
msgstr "“%1”不是有效的裁切位置。请给出 0 到 1 之间的小数，例如 0.5 表示正中间。"

#: src/cli/CommandsLayout.cpp:643
#, kde-format
msgctxt "@info"
msgid "Cut %1 page in two."
msgid_plural "Cut %1 pages in two."
msgstr[0] "已将%1页一分为二。"

#: src/cli/CommandsLayout.cpp:644
#, kde-format
msgid "Left half first, then the right. Wrote %1."
msgstr "先是左半页，然后是右半页。已写入 %1。"

#: src/cli/CommandsLayout.cpp:645
#, kde-format
msgid "Top half first, then the bottom. Wrote %1."
msgstr "先是上半页，然后是下半页。已写入 %1。"

#: src/cli/CommandsLayout.cpp:653
#, kde-format
msgid "layout overlay needs two files: the document, then what to lay over it."
msgstr "layout overlay 需要两个文件：先是文档，然后是要叠加在它上面的内容。"

#: src/cli/CommandsLayout.cpp:674
#, kde-format
msgid "Laid %1 over %2. Wrote %3."
msgstr "已将 %1 叠加到 %2 上。已写入 %3。"

#: src/cli/CommandsLayout.cpp:687
#, kde-format
msgid "layout poster needs a sheet size (--size), for example a4 or 210x297mm."
msgstr "layout poster 需要纸张大小（--size），例如 a4 或 210x297mm。"

#: src/cli/CommandsLayout.cpp:720
#, kde-format
msgid "Tiled page %2 across %1 sheet."
msgid_plural "Tiled page %2 across %1 sheets."
msgstr[0] "已将第%2页平铺到%1张纸上。"

#: src/cli/CommandsLayout.cpp:721
#, kde-format
msgid "The page is tiled at its own size. Resize it first for a bigger poster. Wrote %1."
msgstr "页面按其自身大小平铺。若要更大的海报，请先调整页面大小。已写入 %1。"

#: src/cli/CommandsLayout.cpp:742
#, kde-format
msgid "Reordered into printer's spreads. Run “nup --per-sheet 2” over this to get the sheets themselves."
msgstr "已重新排序为印刷跨页。对结果运行“nup --per-sheet 2”即可得到实际的纸张。"

#: src/cli/CommandsLayout.cpp:798
#, kde-format
msgid "layout set-labels needs at least one --page-label, as PAGE:STYLE[:PREFIX[:START]]."
msgstr "layout set-labels 至少需要一个 --page-label，格式为 PAGE:STYLE[:PREFIX[:START]]。"

#: src/cli/CommandsLayout.cpp:806
#, kde-format
msgid "“%1” is not a page label. The form is PAGE:STYLE[:PREFIX[:START]], for example 1:roman-lower or 9:decimal:A-:1."
msgstr "“%1”不是页面标签。格式为 PAGE:STYLE[:PREFIX[:START]]，例如 1:roman-lower 或 9:decimal:A-:1。"

#: src/cli/CommandsLayout.cpp:821
#, kde-format
msgid "“%1” is not a numbering style. Use decimal, roman-upper, roman-lower, letter-upper, letter-lower or none."
msgstr "“%1”不是编号样式。请使用 decimal、roman-upper、roman-lower、letter-upper、letter-lower 或 none。"

#: src/cli/CommandsLayout.cpp:832
#, kde-format
msgid "“%1” is not a number to start at."
msgstr "“%1”不是有效的起始编号。"

#: src/cli/CommandsLayout.cpp:845
#, kde-format
msgctxt "@info"
msgid "Wrote %1 numbering range."
msgid_plural "Wrote %1 numbering ranges."
msgstr[0] "已写入%1个编号范围。"

#: src/cli/CommandsLayout.cpp:861
#, kde-format
msgid "“%1” is not a number of painting operators."
msgstr "“%1”不是有效的绘制操作符数量。"

#: src/cli/CommandsLayout.cpp:887
#, kde-format
msgctxt "@info"
msgid "%1 page paints nothing: %2"
msgid_plural "%1 pages paint nothing: %2"
msgstr[0] "有%1页没有绘制任何内容：%2"

#: src/cli/CommandsLayout.cpp:890
#, kde-format
msgid "Take them out with “layout remove --pages %1”."
msgstr "可用“layout remove --pages %1”将它们移除。"

#: src/cli/CommandsLayout.cpp:904
#, kde-format
msgid "layout remove needs the pages to take out (--pages), e.g. 3,7-9."
msgstr "layout remove 需要指定要移除的页面（--pages），例如 3,7-9。"

#: src/cli/CommandsLayout.cpp:919
#, kde-format
msgctxt "@info"
msgid "Took out %1 page."
msgid_plural "Took out %1 pages."
msgstr[0] "已移除%1页。"

#: src/cli/CommandsLayout.cpp:927
#, kde-format
msgid "layout limits takes no arguments."
msgstr "layout limits 不接受任何参数。"

#: src/cli/CommandsLayout.cpp:929
#, kde-format
msgctxt "@title heading before a list"
msgid "What page layout cannot promise:"
msgstr "页面布局无法保证的内容："

#: src/cli/CommandsLayout.cpp:943
#, kde-format
msgid "How content lands on a new sheet: scale, centre or shrink."
msgstr "内容如何落在新纸张上：scale、centre 或 shrink。"

#: src/cli/CommandsLayout.cpp:946
#, kde-format
msgid "Bleed in millimetres. On “marks”, how far outside the trim the marks sit."
msgstr "出血，以毫米为单位。在“marks”中表示标记位于裁切范围外多远处。"

#: src/cli/CommandsLayout.cpp:949
#, kde-format
msgid "Printer's marks to add: crop, registration, colour-bar, page-info or all."
msgstr "要添加的印刷标记：crop、registration、colour-bar、page-info 或 all。"

#: src/cli/CommandsLayout.cpp:951
#, kde-format
msgid "How long a crop mark is, in millimetres."
msgstr "裁切标记的长度，以毫米为单位。"

#: src/cli/CommandsLayout.cpp:953
#, kde-format
msgid "How thick a printer's mark is, in points."
msgstr "印刷标记的粗细，以点为单位。"

#: src/cli/CommandsLayout.cpp:956
#, kde-format
msgid "New /MediaBox as X,Y,WIDTH,HEIGHT in points from the bottom-left corner."
msgstr "新的 /MediaBox，以点为单位、从左下角起给出 X,Y,WIDTH,HEIGHT。"

#: src/cli/CommandsLayout.cpp:958
#, kde-format
msgid "New /CropBox, or “none” to take it away."
msgstr "新的 /CropBox，或用“none”将其移除。"

#: src/cli/CommandsLayout.cpp:960
#, kde-format
msgid "New /BleedBox, or “none” to take it away."
msgstr "新的 /BleedBox，或用“none”将其移除。"

#: src/cli/CommandsLayout.cpp:962
#, kde-format
msgid "New /TrimBox, or “none” to take it away."
msgstr "新的 /TrimBox，或用“none”将其移除。"

#: src/cli/CommandsLayout.cpp:964
#, kde-format
msgid "New /ArtBox, or “none” to take it away."
msgstr "新的 /ArtBox，或用“none”将其移除。"

#: src/cli/CommandsLayout.cpp:966
#, kde-format
msgid "Where to cut a page in two, as a fraction."
msgstr "在何处将页面一分为二，用小数表示。"

#: src/cli/CommandsLayout.cpp:969
#, kde-format
msgid "Cut into a top and a bottom half instead of a left and a right."
msgstr "切成上下两半，而不是左右两半。"

#: src/cli/CommandsLayout.cpp:971
#, kde-format
msgid "Start the overlay again when it runs out, for a letterhead."
msgstr "叠加内容用完后从头再来一遍，适合信头。"

#: src/cli/CommandsLayout.cpp:972
#, kde-format
msgid "How far poster sheets overlap, in millimetres."
msgstr "海报各张纸之间的重叠量，以毫米为单位。"

#: src/cli/CommandsLayout.cpp:974
#, kde-format
msgid "Draw the cut line and number each poster sheet."
msgstr "绘制裁切线，并为每张海报纸编号。"

#: src/cli/CommandsLayout.cpp:976
#, kde-format
msgid "A numbering range, as PAGE:STYLE[:PREFIX[:START]]. Repeat for more."
msgstr "一个编号范围，格式为 PAGE:STYLE[:PREFIX[:START]]。可重复使用以添加多个。"

#: src/cli/CommandsLayout.cpp:979
#, kde-format
msgid "How much painting a page may still hold and count as blank."
msgstr "页面最多可保留多少绘制内容仍算作空白。"

#: src/cli/CommandsLayout.cpp:981
#, kde-format
msgid "Turn printer's spreads back into reading order."
msgstr "将印刷跨页还原为阅读顺序。"

#: src/cli/CommandsLayout.cpp:992
#, kde-format
msgctxt "@info a list of the actions “layout” takes"
msgid "boxes, set-boxes, resize, unify, bleed, marks, split, overlay, poster, booklet, labels, set-labels, blanks, remove or limits"
msgstr "boxes、set-boxes、resize、unify、bleed、marks、split、overlay、poster、booklet、labels、set-labels、blanks、remove 或 limits"

#: src/cli/CommandsLayout.cpp:995
#, kde-format
msgid "layout needs something to do: %1."
msgstr "layout 需要指定一项操作：%1。"

#: src/cli/CommandsLayout.cpp:1047
#, kde-format
msgid "“layout %1” is not something layout does. Try %2."
msgstr "“layout %1”不是 layout 能做的事。请尝试 %2。"

#: src/cli/CommandsLayout.cpp:1056
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout boxes      FILE                 Show the five page boxes, and which are absent"
msgstr "  layout boxes      FILE                 显示五个页面框，以及哪些不存在"

#: src/cli/CommandsLayout.cpp:1058
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout set-boxes  FILE      -o OUT     Write /MediaBox, /CropBox, /BleedBox, /TrimBox, /ArtBox"
msgstr "  layout set-boxes  FILE      -o OUT     写入 /MediaBox、/CropBox、/BleedBox、/TrimBox、/ArtBox"

#: src/cli/CommandsLayout.cpp:1060
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout resize     FILE      -o OUT     Put the pages on a different paper size"
msgstr "  layout resize     FILE      -o OUT     将页面放到不同的纸张大小上"

#: src/cli/CommandsLayout.cpp:1062
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout unify      FILE      -o OUT     Bring every page to one size"
msgstr "  layout unify      FILE      -o OUT     将每一页统一为同一大小"

#: src/cli/CommandsLayout.cpp:1064
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout bleed      FILE      -o OUT     Give the pages a bleed, growing the sheet"
msgstr "  layout bleed      FILE      -o OUT     为页面添加出血，并相应放大纸张"

#: src/cli/CommandsLayout.cpp:1066
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout marks      FILE      -o OUT     Add printer's marks outside the trim"
msgstr "  layout marks      FILE      -o OUT     在裁切范围外添加印刷标记"

#: src/cli/CommandsLayout.cpp:1068
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout split      FILE      -o OUT     Cut each page in two, for scanned books"
msgstr "  layout split      FILE      -o OUT     将每页一分为二，适合扫描的书籍"

#: src/cli/CommandsLayout.cpp:1070
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout overlay    BASE OVER -o OUT     Lay one document over another"
msgstr "  layout overlay    BASE OVER -o OUT     将一个文档叠加到另一个之上"

#: src/cli/CommandsLayout.cpp:1072
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout poster     FILE      -o OUT     Tile one page across several sheets"
msgstr "  layout poster     FILE      -o OUT     将一页平铺到多张纸上"

#: src/cli/CommandsLayout.cpp:1074
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout booklet    FILE      -o OUT     Reorder pages into printer's spreads"
msgstr "  layout booklet    FILE      -o OUT     将页面重新排序为印刷跨页"

#: src/cli/CommandsLayout.cpp:1076
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout labels     FILE                 Show the numbers the reader displays"
msgstr "  layout labels     FILE                 显示阅读器所显示的页码"

#: src/cli/CommandsLayout.cpp:1078
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout set-labels FILE      -o OUT     Write /PageLabels, e.g. i, ii, iii and then 1"
msgstr "  layout set-labels FILE      -o OUT     写入 /PageLabels，例如 i、ii、iii 然后是 1"

#: src/cli/CommandsLayout.cpp:1080
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout blanks     FILE                 Find pages that paint nothing"
msgstr "  layout blanks     FILE                 查找没有绘制任何内容的页面"

#: src/cli/CommandsLayout.cpp:1082
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout remove     FILE      -o OUT     Take pages out"
msgstr "  layout remove     FILE      -o OUT     移除页面"

#: src/cli/CommandsLayout.cpp:1084
#, kde-format
msgctxt "@info:shell one line of the command list; keep the columns lined up"
msgid "  layout limits                          What page layout cannot promise"
msgstr "  layout limits                          页面布局无法保证的内容"

#: src/cli/CommandsConvert.cpp:70
#, kde-format
msgid "Ghostscript is installed, so “to-pdfx” can run on this machine."
msgstr "已安装 Ghostscript，因此“to-pdfx”可以在本机运行。"

#: src/cli/CommandsConvert.cpp:71
#, kde-format
msgid "Ghostscript is not installed, so “to-pdfx” cannot run on this machine. It comes in the “ghostscript” package."
msgstr "未安装 Ghostscript，因此“to-pdfx”无法在本机运行。它由“ghostscript”软件包提供。"

#: src/cli/CommandsConvert.cpp:164
#, kde-format
msgid "Wrote %1 page as SVG."
msgid_plural "Wrote %1 pages as SVG."
msgstr[0] "已将%1页写为 SVG。"

#: src/cli/CommandsConvert.cpp:168
#, kde-format
msgid "Where pdftocairo did the work the text is still text. Where Ghostscript had to stand in for it, the letters are outlines and no longer searchable."
msgstr "由 pdftocairo 完成的部分，文本仍然是文本；由 Ghostscript 代为处理的部分，字母变成了轮廓，不再可以搜索。"

#: src/cli/CommandsConvert.cpp:213
#, kde-format
msgid "No table was found. There may be none, or its columns may not line up well enough to be recognised; “to-text” gives the words either way."
msgstr "未找到表格。可能本来就没有，也可能是列对得不够齐而无法识别；无论哪种情况，“to-text”都能给出其中的文字。"

#: src/cli/CommandsConvert.cpp:222
#, kde-format
msgctxt "@info a table that was found: its page, its size and how sure the detection is"
msgid "Page %1  %2 × %3  confidence %4"
msgstr "第%1页  %2 × %3  置信度 %4"

#: src/cli/CommandsConvert.cpp:233
#, kde-format
msgid "%1 table found. Confidence is how much of a guess it was; below 0.5, check it against the page."
msgid_plural "%1 tables found. Confidence is how much of a guess each was; below 0.5, check them against the page."
msgstr[0] "找到%1个表格。置信度表示识别结果有多大成分是猜测；低于 0.5 时，请对照页面核对。"

#: src/cli/CommandsConvert.cpp:268
#, kde-format
msgid "No table was found in this document. There may be none, or its columns may not line up well enough to be recognised; “tables” shows what was considered."
msgstr "本文档中未找到表格。可能本来就没有，也可能是列对得不够齐而无法识别；“tables”会显示考虑过哪些候选。"

#: src/cli/CommandsConvert.cpp:278
#, kde-format
msgid "%1 table, taken from where the text sits and not from any structure in the file."
msgid_plural "%1 tables, separated by a blank line, taken from where the text sits and not from any structure in the file."
msgstr[0] "%1个表格，多个表格之间以空行分隔，依据文本所在的位置得出，而非取自文件中的任何结构。"

#: src/cli/CommandsConvert.cpp:302
#, kde-format
msgid "Ghostscript is not installed, and it does the conversion to PDF/X. Install the “ghostscript” package and try again."
msgstr "未安装 Ghostscript，而转换为 PDF/X 正是由它完成的。请安装“ghostscript”软件包后重试。"

#: src/cli/CommandsConvert.cpp:309
#, kde-format
msgid "“%1” is not a PDF/X level. Use x1a, x3 or x4."
msgstr "“%1”不是 PDF/X 级别。请使用 x1a、x3 或 x4。"

#: src/cli/CommandsConvert.cpp:354
#, kde-format
msgid "A reader can now show page one before it has the rest. That is worth nothing on a local disk and a great deal over a slow link; the file itself is no smaller."
msgstr "阅读器现在可以在尚未取得其余部分时就显示第一页。这在本地磁盘上毫无意义，在慢速链接上却价值很大；文件本身并没有变小。"

#: src/cli/CommandsConvert.cpp:374
#, kde-format
msgid "Say which version the header should claim: --pdf-version 1.7."
msgstr "请说明文件头应声明哪个版本：--pdf-version 1.7。"

#: src/cli/CommandsConvert.cpp:391
#, kde-format
msgid "Wrote %1, claiming PDF %2."
msgstr "已写入 %1，声明为 PDF %2。"

#: src/cli/CommandsConvert.cpp:403
#, kde-format
msgid "Which PDF/X to write: x1a, x3 or x4. Most printers still ask for x1a."
msgstr "要写入哪种 PDF/X：x1a、x3 或 x4。多数印刷厂仍然要求 x1a。"

#: src/cli/CommandsConvert.cpp:407
#, kde-format
msgid "The version the PDF header should claim, e.g. 1.7."
msgstr "PDF 文件头应声明的版本，例如 1.7。"

#: src/cli/CommandsConvert.cpp:446
#, kde-format
msgid "Draw each page as an SVG file"
msgstr "将每一页绘制为 SVG 文件"

#: src/cli/CommandsConvert.cpp:447
#, kde-format
msgid "Show the tables it can find, and how sure it is"
msgstr "显示能找到的表格，以及识别的把握程度"

#: src/cli/CommandsConvert.cpp:448
#, kde-format
msgid "Write those tables out as comma-separated values"
msgstr "将这些表格导出为逗号分隔值"

#: src/cli/CommandsConvert.cpp:449
#, kde-format
msgid "Convert to PDF/X for a commercial printer"
msgstr "转换为 PDF/X，供商业印刷厂使用"

#: src/cli/CommandsConvert.cpp:450
#, kde-format
msgid "Rewrite so page one arrives over a slow link first"
msgstr "重写文件，使第一页在慢速链接上先到达"

#: src/cli/CommandsConvert.cpp:451
#, kde-format
msgid "Set the PDF version the header claims"
msgstr "设置文件头声明的 PDF 版本"

#: src/cli/CommandsPreflight.cpp:73
#, kde-format
msgctxt "@info where a preflight finding is"
msgid "page %1"
msgstr "第%1页"

#: src/cli/CommandsPreflight.cpp:74
#, kde-format
msgctxt "@info a preflight finding about the document as a whole"
msgid "whole document"
msgstr "整个文档"

#: src/cli/CommandsPreflight.cpp:78
#, kde-format
msgctxt "@info a place and the resource found there"
msgid "%1 · %2"
msgstr "%1 · %2"

#: src/cli/CommandsPreflight.cpp:97
#, kde-format
msgctxt "@info a rule id and what it looks for"
msgid "%1: %2"
msgstr "%1: %2"

#: src/cli/CommandsPreflight.cpp:126
#, kde-format
msgid "“%1” names no rules, so checking against it would look at nothing."
msgstr "“%1”没有指定任何规则，因此用它来检查等于什么都不检查。"

#: src/cli/CommandsPreflight.cpp:138
#, kde-format
msgid "There is no profile called “%1”. Use one of these, or the path to a saved profile: %2"
msgstr "没有名为“%1”的配置文件。请使用下列之一，或给出已保存配置文件的路径：%2"

#: src/cli/CommandsPreflight.cpp:174
#, kde-format
msgctxt "@title:group preflight findings that will get the file rejected"
msgid "Error (%1)"
msgid_plural "Errors (%1)"
msgstr[0] "错误 (%1)"

#: src/cli/CommandsPreflight.cpp:177
#, kde-format
msgctxt "@title:group preflight findings somebody may complain about"
msgid "Warning (%1)"
msgid_plural "Warnings (%1)"
msgstr[0] "警告 (%1)"

#: src/cli/CommandsPreflight.cpp:180
#, kde-format
msgctxt "@title:group preflight findings that are only worth knowing"
msgid "Note (%1)"
msgid_plural "Notes (%1)"
msgstr[0] "提示 (%1)"

#: src/cli/CommandsPreflight.cpp:192
#, kde-format
msgctxt "@info a rule id and the one place it was found"
msgid "%1 · %2"
msgstr "%1 · %2"

#: src/cli/CommandsPreflight.cpp:197
#, kde-format
msgctxt "@info a rule id and how many places it was found in"
msgid "%2 · %1 place"
msgid_plural "%2 · %1 places"
msgstr[0] "%2 · %1处"

#: src/cli/CommandsPreflight.cpp:216
#, kde-format
msgctxt "@info everywhere a repeated finding applies"
msgid "At: %1."
msgstr "位置：%1。"

#: src/cli/CommandsPreflight.cpp:218
#, kde-format
msgctxt "@info where a repeated finding applies, with the rest left out"
msgid "At: %2, and one place more."
msgid_plural "At: %2, and %1 places more."
msgstr[0] "位置：%2，另有%1处未列出。"

#: src/cli/CommandsPreflight.cpp:224
#, kde-format
msgctxt "@info a place and what was found there"
msgid "%1: %2"
msgstr "%1: %2"

#: src/cli/CommandsPreflight.cpp:230
#, kde-format
msgctxt "@info findings left out of the plain report"
msgid "One place more is not listed; --json lists them all."
msgid_plural "%1 places more are not listed; --json lists them all."
msgstr[0] "另有%1处未列出；--json 会全部列出。"

#: src/cli/CommandsPreflight.cpp:241
#, kde-format
msgctxt "@info a repair exists for this finding"
msgid "Can be mended by --fix (%1)."
msgstr "可用 --fix 修复 (%1)。"

#: src/cli/CommandsPreflight.cpp:249
#, kde-format
msgctxt "@info the document that was checked and the profile it was checked against"
msgid "%1 checked against “%2” (%3)."
msgstr "%1：已对照“%2”(%3) 检查。"

#: src/cli/CommandsPreflight.cpp:268
#, kde-format
msgctxt "@title:group rules the profile names that this program cannot judge"
msgid "Asked for but not checked (%1)"
msgstr "要求检查但未检查 (%1)"

#: src/cli/CommandsPreflight.cpp:274
#, kde-format
msgid "Nothing above says anything about these either way."
msgstr "以上内容对这些规则未作任何判断。"

#: src/cli/CommandsPreflight.cpp:281
#, kde-format
msgid "This is a check, not a certification. “preflight limitations” says what it cannot see."
msgstr "这是一次检查，不是认证。“preflight limitations”会说明它看不到哪些问题。"

#: src/cli/CommandsPreflight.cpp:355
#, kde-format
msgid "There is no repair called “%1”. “preflight fixes” lists them."
msgstr "没有名为“%1”的修复。“preflight fixes”会列出所有修复。"

#: src/cli/CommandsPreflight.cpp:387
#, kde-format
msgid "Note: the repaired file could not be checked again: %1"
msgstr "注意：无法对修复后的文件重新检查：%1"

#: src/cli/CommandsPreflight.cpp:426
#, kde-format
msgid "Nothing found here can be mended automatically."
msgstr "这里发现的问题都无法自动修复。"

#: src/cli/CommandsPreflight.cpp:429
#, kde-format
msgctxt "@title heading before a list of repairs"
msgid "Repairs:"
msgstr "修复："

#: src/cli/CommandsPreflight.cpp:438
#, kde-format
msgid "Checked again after the repairs:"
msgstr "修复之后的重新检查："

#: src/cli/CommandsPreflight.cpp:443
#, kde-format
msgid "Wrote the report to %1."
msgstr "已将报告写入 %1。"

#: src/cli/CommandsPreflight.cpp:507
#, kde-format
msgctxt "@info how many rules a profile has, and at which severity"
msgid "%1 rules: %2 as errors, %3 as warnings, %4 as notes."
msgstr "共%1条规则：%2条为错误，%3条为警告，%4条为提示。"

#: src/cli/CommandsPreflight.cpp:513
#, kde-format
msgctxt "@info rules a profile names that this program cannot judge"
msgid "One of them cannot be judged here: %2."
msgid_plural "%1 of them cannot be judged here: %2."
msgstr[0] "其中%1条在此无法判断：%2。"

#: src/cli/CommandsPreflight.cpp:520
#, kde-format
msgid "Check against one with “preflight FILE --profile ID”, or against a profile of your own by giving its file name instead."
msgstr "可用“preflight FILE --profile ID”按其中一个配置文件检查，也可以改为给出您自己配置文件的文件名。"

#: src/cli/CommandsPreflight.cpp:570
#, kde-format
msgid "The rules of “%1”:"
msgstr "“%1”的规则："

#: src/cli/CommandsPreflight.cpp:571
#, kde-format
msgid "Every rule this program knows. A profile names the ones it cares about."
msgstr "本程序已知的全部规则。配置文件会指明它关心其中哪些。"

#: src/cli/CommandsPreflight.cpp:579
#, kde-format
msgctxt "@info a rule id and the severity a profile gives it"
msgid "%1: %2"
msgstr "%1: %2"

#: src/cli/CommandsPreflight.cpp:588
#, kde-format
msgctxt "@info the number a rule compares against"
msgid "Threshold: %1."
msgstr "阈值：%1。"

#: src/cli/CommandsPreflight.cpp:592
#, kde-format
msgid "Not checked: this program cannot judge it, and says so in the report."
msgstr "未检查：本程序无法判断此项，并会在报告中说明这一点。"

#: src/cli/CommandsPreflight.cpp:614
#, kde-format
msgid "Every repair, and what applying it would change:"
msgstr "每一项修复，以及应用它会改变什么："

#: src/cli/CommandsPreflight.cpp:620
#, kde-format
msgid "“preflight FILE --fix -o OUT” applies the ones the findings ask for; “--apply-fix ID” applies one whether anything asked for it or not."
msgstr "“preflight FILE --fix -o OUT”会应用检查结果所要求的那些修复；“--apply-fix ID”则不论是否有结果要求，都会应用指定的那一项。"

#: src/cli/CommandsPreflight.cpp:637
#, kde-format
msgid "What this check cannot promise:"
msgstr "本次检查无法保证的内容："

#: src/cli/CommandsPreflight.cpp:649
#, kde-format
msgid "save-profile needs the id of one profile. “preflight profiles” lists them."
msgstr "save-profile 需要一个配置文件的 id。“preflight profiles”会列出它们。"

#: src/cli/CommandsPreflight.cpp:654
#, kde-format
msgid "There is no profile called “%1”. “preflight profiles” lists them."
msgstr "没有名为“%1”的配置文件。“preflight profiles”会列出它们。"

#: src/cli/CommandsPreflight.cpp:663
#, kde-format
msgid "Wrote “%1” to %2."
msgstr "已将“%1”写入 %2。"

#: src/cli/CommandsPreflight.cpp:664
#, kde-format
msgid "Edit it and check against it with “preflight FILE --profile %1”."
msgstr "可以编辑它，然后用“preflight FILE --profile %1”按它来检查。"

#: src/cli/CommandsPreflight.cpp:673
#, kde-format
msgid "Which profile to check against: an id from “preflight profiles”, or a saved profile file."
msgstr "按哪个配置文件检查：“preflight profiles”中的 id，或已保存的配置文件。"

#: src/cli/CommandsPreflight.cpp:676
#, kde-format
msgid "Apply every repair the findings offer and write the result to -o."
msgstr "应用检查结果提供的每一项修复，并将结果写入 -o。"

#: src/cli/CommandsPreflight.cpp:678
#, kde-format
msgid "Apply one named repair, whether or not a finding asked for it. Repeat for more."
msgstr "应用指定的一项修复，不论是否有检查结果要求它。可重复使用以应用多项。"

#: src/cli/CommandsPreflight.cpp:680
#, kde-format
msgid "Also write the report itself as a PDF."
msgstr "同时把报告本身写成一个 PDF。"

#: src/cli/CommandsPreflight.cpp:711
#, kde-format
msgid "preflight needs a file, or one of: profiles, rules, fixes, limitations, save-profile."
msgstr "preflight 需要一个文件，或以下之一：profiles、rules、fixes、limitations、save-profile。"

#: src/cli/CommandsPreflight.cpp:721
#, kde-format
msgctxt "@info:shell one line of the command list, keep the columns lined up"
msgid "  preflight FILE     [-o OUT]         Check against a profile, and mend faults"
msgstr "  preflight FILE     [-o OUT]         按配置文件检查，并修复问题"

#: src/cli/CommandsPreflight.cpp:723
#, kde-format
msgctxt "@info:shell one line of the command list, keep the columns lined up"
msgid "  preflight profiles                  List the profiles that ship here"
msgstr "  preflight profiles                  列出随本程序附带的配置文件"

#: src/cli/CommandsPreflight.cpp:725
#, kde-format
msgctxt "@info:shell one line of the command list, keep the columns lined up"
msgid "  preflight rules                     Every rule, and whether it is checked"
msgstr "  preflight rules                     列出每一条规则，以及是否会检查"

#: src/cli/CommandsPreflight.cpp:727
#, kde-format
msgctxt "@info:shell one line of the command list, keep the columns lined up"
msgid "  preflight fixes                     Every repair and what it changes"
msgstr "  preflight fixes                     列出每一项修复及其改动"

#: src/cli/CommandsPreflight.cpp:729
#, kde-format
msgctxt "@info:shell one line of the command list, keep the columns lined up"
msgid "  preflight save-profile ID -o FILE   Write a profile out as JSON to edit"
msgstr "  preflight save-profile ID -o FILE   将配置文件导出为 JSON 以便编辑"

#: src/cli/CommandsPreflight.cpp:731
#, kde-format
msgctxt "@info:shell one line of the command list, keep the columns lined up"
msgid "  preflight limitations               What this check cannot see"
msgstr "  preflight limitations               本次检查看不到的内容"

#: src/cli/CommandsObjects.cpp:75
#, kde-format
msgctxt "@info:shell what a text object says, in which font and at which size"
msgid "“%1”  %2 %3 pt"
msgstr "“%1”  %2 %3 pt"

#: src/cli/CommandsObjects.cpp:80
#, kde-format
msgctxt "@info:shell a picture: its resource name and how many pixels it holds"
msgid "%1  %2 × %3 px"
msgstr "%1  %2 × %3 px"

#: src/cli/CommandsObjects.cpp:88
#, kde-format
msgctxt "@info:shell how a shape is painted"
msgid "fill %1  stroke %2  %3 pt"
msgstr "填充 %1  描边 %2  %3 pt"

#: src/cli/CommandsObjects.cpp:116
#, kde-format
msgctxt "@title:column left edge, in points"
msgid "x"
msgstr "x"

#: src/cli/CommandsObjects.cpp:117
#, kde-format
msgctxt "@title:column bottom edge, in points"
msgid "y"
msgstr "y"

#: src/cli/CommandsObjects.cpp:117
#, kde-format
msgctxt "@title:column width, in points"
msgid "w"
msgstr "w"

#: src/cli/CommandsObjects.cpp:118
#, kde-format
msgctxt "@title:column height, in points"
msgid "h"
msgstr "h"

#: src/cli/CommandsObjects.cpp:119
#, kde-format
msgctxt "@title:column place in the stacking order"
msgid "Layer"
msgstr "层次"

#: src/cli/CommandsObjects.cpp:229
#, kde-format
msgid "“%1” is not an object number. Use the number in the first column of “objects list”."
msgstr "“%1”不是对象编号。请使用“objects list”第一列中的数字。"

#: src/cli/CommandsObjects.cpp:239
#, kde-format
msgid "Say which object with --object. “objects list FILE --page N” prints the numbers."
msgstr "请用 --object 指明是哪个对象。“objects list FILE --page N”会打印这些编号。"

#: src/cli/CommandsObjects.cpp:280
#, kde-format
msgid "Page %1 draws nothing, so there is no object %2 on it."
msgstr "第%1页没有绘制任何内容，因此其上不存在对象 %2。"

#: src/cli/CommandsObjects.cpp:282
#, kde-format
msgid "Page %1 has no object %2. Its numbers run from 0 to %3."
msgstr "第%1页没有对象 %2。它的编号范围是 0 到 %3。"

#: src/cli/CommandsObjects.cpp:317
#, kde-format
msgctxt "@info what one editing pass did"
msgid "Moved or resized %1, deleted %2, restyled %3, added %4."
msgstr "已移动或调整大小%1个，删除%2个，重设样式%3个，新增%4个。"

#: src/cli/CommandsObjects.cpp:380
#, kde-format
msgid "This document draws nothing at all."
msgstr "本文档完全没有绘制任何内容。"

#: src/cli/CommandsObjects.cpp:381
#, kde-format
msgid "Page %1 draws nothing."
msgstr "第%1页没有绘制任何内容。"

#: src/cli/CommandsObjects.cpp:395
#, kde-format
msgctxt "@title heading above the objects of one page"
msgid "Page %1"
msgstr "第%1页"

#: src/cli/CommandsObjects.cpp:402
#, kde-format
msgid "%1 object. The number in the first column is what --object takes."
msgid_plural "%1 objects. The number in the first column is what --object takes."
msgstr[0] "共%1个对象。第一列中的数字就是 --object 所接受的值。"

#: src/cli/CommandsObjects.cpp:405
#, kde-format
msgid "Boundaries are in points from the bottom-left corner of the page."
msgstr "边界以点为单位，从页面左下角起算。"

#: src/cli/CommandsObjects.cpp:426
#, kde-format
msgid "Give a point with --at X,Y, or an area with --area X,Y,WIDTH,HEIGHT, in points from the bottom-left corner of the page."
msgstr "请用 --at X,Y 给出一个点，或用 --area X,Y,WIDTH,HEIGHT 给出一块区域，以点为单位，从页面左下角起算。"

#: src/cli/CommandsObjects.cpp:436 src/cli/CommandsObjects.cpp:602
#, kde-format
msgid "“%1” is not a point. The form is X,Y, in points from the bottom-left corner of the page."
msgstr "“%1”不是点。格式为 X,Y，以点为单位，从页面左下角起算。"

#: src/cli/CommandsObjects.cpp:459
#, kde-format
msgid "“%1” is not an area. The form is X,Y,WIDTH,HEIGHT, in points from the bottom-left corner of the page."
msgstr "“%1”不是区域。格式为 X,Y,WIDTH,HEIGHT，以点为单位，从页面左下角起算。"

#: src/cli/CommandsObjects.cpp:514
#, kde-format
msgid "Nothing is drawn at %1, %2 on page %3."
msgstr "第%3页的 %1, %2 处没有绘制任何内容。"

#: src/cli/CommandsObjects.cpp:516
#, kde-format
msgid "Nothing on page %1 meets that area."
msgstr "第%1页上没有内容落在该区域内。"

#: src/cli/CommandsObjects.cpp:525
#, kde-format
msgid "%1 object, topmost first."
msgid_plural "%1 objects, topmost first."
msgstr[0] "共%1个对象，最上层的在前。"

#: src/cli/CommandsObjects.cpp:559
#, kde-format
msgid "Say how far with --by DX,DY, in points. Positive numbers move right and up."
msgstr "请用 --by DX,DY 说明移动多远，以点为单位。正数表示向右和向上移动。"

#: src/cli/CommandsObjects.cpp:573
#, kde-format
msgid "Say how much with --by FACTOR, e.g. 1.5, or --by FX,FY to stretch one way only."
msgstr "请用 --by FACTOR 说明缩放多少，例如 1.5；或用 --by FX,FY 只在一个方向上拉伸。"

#: src/cli/CommandsObjects.cpp:577
#, kde-format
msgid "A factor of zero would flatten the object out of existence."
msgstr "系数为零会把对象压扁得不复存在。"

#: src/cli/CommandsObjects.cpp:585
#, kde-format
msgid "Say how far round with --angle DEGREES, counter-clockwise."
msgstr "请用 --angle DEGREES 说明旋转多少度，按逆时针方向。"

#: src/cli/CommandsObjects.cpp:711 src/cli/CommandsObjects.cpp:842
#, kde-format
msgid "“%1” is not a line width in points."
msgstr "“%1”不是以点为单位的线宽。"

#: src/cli/CommandsObjects.cpp:716
#, kde-format
msgid "Say what to change: --fill, --stroke or --line-width."
msgstr "请说明要更改什么：--fill、--stroke 或 --line-width。"

#: src/cli/CommandsObjects.cpp:787
#, kde-format
msgid "Say what to insert with --shape: text, image, rectangle, ellipse or line."
msgstr "请用 --shape 说明要插入什么：text、image、rectangle、ellipse 或 line。"

#: src/cli/CommandsObjects.cpp:792
#, kde-format
msgid "Say where with --rect X,Y,WIDTH,HEIGHT, in points from the bottom-left corner of the page."
msgstr "请用 --rect X,Y,WIDTH,HEIGHT 说明位置，以点为单位，从页面左下角起算。"

#: src/cli/CommandsObjects.cpp:803
#, kde-format
msgid "Say what it should read with --text."
msgstr "请用 --text 说明它应该显示什么文字。"

#: src/cli/CommandsObjects.cpp:813
#, kde-format
msgid "“%1” is not a text size in points."
msgstr "“%1”不是以点为单位的文字大小。"

#: src/cli/CommandsObjects.cpp:821
#, kde-format
msgid "Say which picture with --image."
msgstr "请用 --image 指明是哪张图片。"

#: src/cli/CommandsObjects.cpp:854
#, kde-format
msgid "“%1” is not a place. The form is X,Y,WIDTH,HEIGHT, in points from the bottom-left corner of the page."
msgstr "“%1”不是位置。格式为 X,Y,WIDTH,HEIGHT，以点为单位，从页面左下角起算。"

#: src/cli/CommandsObjects.cpp:869
#, kde-format
msgctxt "@title heading before a list"
msgid "Reading a page as objects:"
msgstr "把页面当作对象来读取："

#: src/cli/CommandsObjects.cpp:873
#, kde-format
msgctxt "@title heading before a list"
msgid "Changing what is on a page:"
msgstr "更改页面上的内容："

#: src/cli/CommandsObjects.cpp:886
#, kde-format
msgid "Which object, by the number “objects list” prints. Repeat, or separate with commas, to change several at once."
msgstr "指定哪个对象，用“objects list”打印的编号。可重复使用或用逗号分隔，以一次更改多个。"

#: src/cli/CommandsObjects.cpp:890
#, kde-format
msgid "How far to move, as DX,DY in points, or how much to scale, as a factor."
msgstr "移动多远，用以点为单位的 DX,DY 表示；或缩放多少，用系数表示。"

#: src/cli/CommandsObjects.cpp:892
#, kde-format
msgid "Point to scale or turn around, as X,Y in points from the bottom-left corner. Without it, each object uses its own middle."
msgstr "缩放或旋转所围绕的点，用以点为单位的 X,Y 表示，从左下角起算。不指定时，每个对象都以自身中心为准。"

#: src/cli/CommandsObjects.cpp:896
#, kde-format
msgid "Fill colour, a name or #rrggbb. For text, the colour of the letters."
msgstr "填充颜色，可用名称或 #rrggbb。对于文本，即字母的颜色。"

#: src/cli/CommandsObjects.cpp:898
#, kde-format
msgid "Outline colour, a name or #rrggbb."
msgstr "描边颜色，可用名称或 #rrggbb。"

#: src/cli/CommandsObjects.cpp:899
#, kde-format
msgid "Outline width in points."
msgstr "描边宽度，以点为单位。"

#: src/cli/CommandsObjects.cpp:901
#, kde-format
msgid "What to insert: text, image, rectangle, ellipse or line."
msgstr "要插入什么：text、image、rectangle、ellipse 或 line。"

#: src/cli/CommandsObjects.cpp:904
#, kde-format
msgid "Where it goes, as X,Y,WIDTH,HEIGHT in points from the bottom-left corner of the page. Repeat to insert several."
msgstr "放到哪里，用以点为单位的 X,Y,WIDTH,HEIGHT 表示，从页面左下角起算。可重复使用以插入多个。"

#: src/cli/CommandsObjects.cpp:910
#, kde-format
msgid "Standard font for inserted text: Helvetica, Times-Roman or Courier."
msgstr "插入文本使用的标准字体：Helvetica、Times-Roman 或 Courier。"

#: src/cli/CommandsObjects.cpp:923
#, kde-format
msgid "Everything drawn on the page, with the number to grab it by"
msgstr "页面上绘制的所有内容，以及用来选取它们的编号"

#: src/cli/CommandsObjects.cpp:924
#, kde-format
msgid "What is under a point, topmost first"
msgstr "某一点下方有什么，最上层的在前"

#: src/cli/CommandsObjects.cpp:925
#, kde-format
msgid "Shift an object across the page"
msgstr "在页面上移动对象"

#: src/cli/CommandsObjects.cpp:926
#, kde-format
msgid "Make an object larger or smaller"
msgstr "放大或缩小对象"

#: src/cli/CommandsObjects.cpp:927
#, kde-format
msgid "Turn an object, counter-clockwise"
msgstr "旋转对象，逆时针方向"

#: src/cli/CommandsObjects.cpp:928
#, kde-format
msgid "Take an object off the page for good"
msgstr "把对象从页面上永久去掉"

#: src/cli/CommandsObjects.cpp:929
#, kde-format
msgid "Change the colours or the line width"
msgstr "更改颜色或线条宽度"

#: src/cli/CommandsObjects.cpp:930
#, kde-format
msgid "Put text, a picture or a shape on the page"
msgstr "在页面上放置文本、图片或形状"

#: src/cli/CommandsObjects.cpp:931
#, kde-format
msgid "What reading and editing objects cannot reach"
msgstr "读取和编辑页面对象无法做到的事情"

#: src/cli/CommandsObjects.cpp:945
#, kde-format
msgid "Say what to do: objects list, at, move, scale, rotate, delete, restyle, insert or limits."
msgstr "请说明要做什么：objects list、at、move、scale、rotate、delete、restyle、insert 或 limits。"

#: src/cli/CommandsObjects.cpp:976
#, kde-format
msgid "“objects %1” is not a command. Try list, at, move, scale, rotate, delete, restyle, insert or limits."
msgstr "“objects %1”不是一条命令。请尝试 list、at、move、scale、rotate、delete、restyle、insert 或 limits。"

#: src/cli/CommandsForm.cpp:224
#, kde-format
msgid "“%1” is not a number of characters."
msgstr "“%1”不是字符数。"

#: src/cli/CommandsForm.cpp:233
#, kde-format
msgid "“%1” is not a text size."
msgstr "“%1”不是文本大小。"

#: src/cli/CommandsForm.cpp:244
#, kde-format
msgid "“%1” is not a border width."
msgstr "“%1”不是边框宽度。"

#: src/cli/CommandsForm.cpp:252 src/cli/CommandsForm.cpp:568
#, kde-format
msgid "“%1” is not a border. Use solid, dashed, beveled, inset or underline."
msgstr "“%1”不是边框样式。请使用 solid、dashed、beveled、inset 或 underline。"

#: src/cli/CommandsForm.cpp:258 src/cli/CommandsForm.cpp:574
#, kde-format
msgid "“%1” is not an alignment. Use left, centre or right."
msgstr "“%1”不是对齐方式。请使用 left、centre 或 right。"

#: src/cli/CommandsForm.cpp:287
#, kde-format
msgid "Say where the field goes and how big it is, e.g. --at 72,700 --size 200x18."
msgstr "请说明字段的位置和大小，例如 --at 72,700 --size 200x18。"

#: src/cli/CommandsForm.cpp:293
#, kde-format
msgid "Give one --size for them all, or one for every --at."
msgstr "请为所有字段给出一个 --size，或者为每个 --at 各给一个。"

#: src/cli/CommandsForm.cpp:300 src/cli/CommandsForm.cpp:866
#, kde-format
msgid "“%1” is not a place. The form is X,Y, in points from the bottom-left corner of the page as it is shown."
msgstr "“%1”不是位置。格式为 X,Y，以磅为单位，从页面显示时的左下角算起。"

#: src/cli/CommandsForm.cpp:308 src/cli/CommandsForm.cpp:873
#: src/cli/CommandsForm.cpp:893
#, kde-format
msgid "“%1” is not a size. The form is WIDTHxHEIGHT, in points."
msgstr "“%1”不是大小。格式为 WIDTHxHEIGHT，以磅为单位。"

#: src/cli/CommandsForm.cpp:328
#, kde-format
msgid "Say what kind of field with --type: text, password, checkbox, radio, choice, list, button or signature."
msgstr "请用 --type 说明字段的类型：text、password、checkbox、radio、choice、list、button 或 signature。"

#: src/cli/CommandsForm.cpp:333
#, kde-format
msgid "“%1” is not a kind of field. Use text, password, checkbox, radio, choice, list, button or signature."
msgstr "“%1”不是一种字段类型。请使用 text、password、checkbox、radio、choice、list、button 或 signature。"

#: src/cli/CommandsForm.cpp:341
#, kde-format
msgid "Give the field a name with --name. That is the name filling in addresses, and a full stop in it makes a group: Adresse.Strasse and Adresse.Ort belong together."
msgstr "请用 --name 为字段命名。填写地址时用的就是这个名称，名称中的英文句点会构成分组：Adresse.Strasse 和 Adresse.Ort 属于同一组。"

#: src/cli/CommandsForm.cpp:365
#, kde-format
msgid "Only a radio group takes more than one --at."
msgstr "只有单选按钮组才能指定多个 --at。"

#: src/cli/CommandsForm.cpp:375
#, kde-format
msgid "A radio group needs at least two choices, as --options Frau,Herr."
msgstr "单选按钮组至少需要两个选项，例如 --options Frau,Herr。"

#: src/cli/CommandsForm.cpp:379
#, kde-format
msgid "A radio group needs one --at for every choice: %1 given for %2 choices."
msgstr "单选按钮组的每个选项都需要一个 --at：%2 个选项，却只给出了 %1 个。"

#: src/cli/CommandsForm.cpp:410
#, kde-format
msgid "Note: the field is written back with the standard border, background and font. What its author set beyond its name, place, flags, choices and value cannot be read out of the document, so give --colour, --background, --border-colour and the rest again to keep them."
msgstr "注意：字段会以标准的边框、背景和字体写回。除名称、位置、标志、选项和值之外，其作者所做的设置无法从文档中读出，因此请重新给出 --colour、--background、--border-colour 等选项以保留它们。"

#: src/cli/CommandsForm.cpp:463
#, kde-format
msgid "“%1” is a kind of field this cannot change."
msgstr "“%1”这种字段类型无法在此更改。"

#: src/cli/CommandsForm.cpp:527 src/cli/CommandsForm.cpp:856
#, kde-format
msgid "“%1” is not a kind of field."
msgstr "“%1”不是一种字段类型。"

#: src/cli/CommandsForm.cpp:537
#, kde-format
msgid "“%1” asks for page %2, which is not a page."
msgstr "“%1”要求第 %2 页，但该页并不存在。"

#: src/cli/CommandsForm.cpp:602
#, kde-format
msgid "“%1” needs at least two choices and one rectangle for each of them."
msgstr "“%1”至少需要两个选项，并为每个选项各给出一个矩形。"

#: src/cli/CommandsForm.cpp:608
#, kde-format
msgid "“%1” has a place that is not a rectangle."
msgstr "“%1”的位置不是一个矩形。"

#: src/cli/CommandsForm.cpp:623
#, kde-format
msgid "“%1” has no rectangle. Give it as \"rect\": { \"x\": 72, \"y\": 700, \"width\": 200, \"height\": 18 }."
msgstr "“%1”没有矩形。请按 \"rect\": { \"x\": 72, \"y\": 700, \"width\": 200, \"height\": 18 } 的形式给出。"

#: src/cli/CommandsForm.cpp:691
#, kde-format
msgctxt "@info a form field with nothing on any page: kind, name"
msgid "No page  %1  %2"
msgstr "无页面  %1  %2"

#: src/cli/CommandsForm.cpp:701
#, kde-format
msgctxt "@info marks a form field that holds more than one line"
msgid "  (several lines)"
msgstr "  （多行）"

#: src/cli/CommandsForm.cpp:707
#, kde-format
msgctxt "@info where a field sits and how big it is, in points"
msgid "at %1,%2  %3 × %4 pt"
msgstr "位于 %1,%2  %3 × %4 pt"

#: src/cli/CommandsForm.cpp:720
#, kde-format
msgid "label: %1"
msgstr "标签: %1"

#: src/cli/CommandsForm.cpp:723
#, kde-format
msgid "%1 field."
msgid_plural "%1 fields."
msgstr[0] "共 %1 个字段。"

#: src/cli/CommandsForm.cpp:735
#, kde-format
msgid "Note: a radio group takes its labels from --options, so --tooltip is not used for it."
msgstr "注意：单选按钮组的标签取自 --options，因此对它不使用 --tooltip。"

#: src/cli/CommandsForm.cpp:745
#, kde-format
msgid "Added a radio group with %1 button to “%2”."
msgid_plural "Added a radio group with %1 buttons to “%2”."
msgstr[0] "已向“%2”添加一个含 %1 个按钮的单选按钮组。"

#: src/cli/CommandsForm.cpp:750 src/cli/CommandsForm.cpp:790
#, kde-format
msgid "Added %1 field to “%2”."
msgid_plural "Added %1 fields to “%2”."
msgstr[0] "已向“%2”添加 %1 个字段。"

#: src/cli/CommandsForm.cpp:758
#, kde-format
msgid "Give the description to build from with --from-json."
msgstr "请用 --from-json 给出用于构建表单的描述文件。"

#: src/cli/CommandsForm.cpp:767
#, kde-format
msgid "“%1” is not a list of fields: %2"
msgstr "“%1”不是字段列表：%2"

#: src/cli/CommandsForm.cpp:775
#, kde-format
msgid "Entry %1 of “%2” is not a field."
msgstr "“%2”中的第 %1 项不是字段。"

#: src/cli/CommandsForm.cpp:778
#, kde-format
msgid "Entry %1 of “%2”: %3"
msgstr "“%2”中的第 %1 项：%3"

#: src/cli/CommandsForm.cpp:782
#, kde-format
msgid "“%1” describes no fields."
msgstr "“%1”没有描述任何字段。"

#: src/cli/CommandsForm.cpp:798
#, kde-format
msgid "Say which field to take out with --name. Repeat it for more."
msgstr "请用 --name 说明要移除哪个字段。要移除多个，请重复使用该选项。"

#: src/cli/CommandsForm.cpp:807
#, kde-format
msgid "Note: %1 of the names given is not in this document."
msgid_plural "Note: %1 of the names given are not in this document."
msgstr[0] "注意：所给名称中有 %1 个不在本文档中。"

#: src/cli/CommandsForm.cpp:811
#, kde-format
msgid "Took %1 field out of “%2”."
msgid_plural "Took %1 fields out of “%2”."
msgstr[0] "已从“%2”中移除 %1 个字段。"

#: src/cli/CommandsForm.cpp:820
#, kde-format
msgid "Say which field and what to call it: --name Alt --to-name Neu."
msgstr "请说明要重命名哪个字段以及新名称：--name Alt --to-name Neu。"

#: src/cli/CommandsForm.cpp:827
#, kde-format
msgid "“%1” is now called “%2” in %3."
msgstr "在 %3 中，“%1”现已改名为“%2”。"

#: src/cli/CommandsForm.cpp:836
#, kde-format
msgid "Say which field with --name."
msgstr "请用 --name 说明是哪个字段。"

#: src/cli/CommandsForm.cpp:849
#, kde-format
msgid "Note: --page is not used here. To put “%1” on another page, take it out and add it again."
msgstr "注意：此处不使用 --page。要把“%1”放到另一页，请先将它移除，再重新添加。"

#: src/cli/CommandsForm.cpp:877
#, kde-format
msgid "“%1” has nothing on a page to take a size from, so give one with --size."
msgstr "“%1”在页面上没有可供参考大小的内容，请用 --size 给出一个大小。"

