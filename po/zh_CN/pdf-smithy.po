msgstr "  field from-json FILE  -o OUT      根据描述文件构建整个表单"

#: src/cli/CommandsForm.cpp:1345
#, kde-format
msgid "  field import    FILE  -o OUT      Fill the fields from FDF, XFDF or CSV"
msgstr "  field import    FILE  -o OUT      从 FDF、XFDF 或 CSV 填写字段"

