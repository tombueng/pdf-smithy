msgstr "无法写入“%1”：%2"

#: src/core/ImageIO.cpp:259
#, kde-format
msgid "No pages could be rendered."
msgstr "无法渲染任何页面。"

#: src/core/Annotation.cpp:475
#, kde-format
msgid "There is nothing to add."
msgstr "没有要添加的内容。"

#: src/core/Annotation.cpp:921
#, kde-format
msgid "“%1” could not be opened for writing."
msgstr "无法打开“%1”进行写入。"

#: src/core/Annotation.cpp:1147
#, kde-format
msgid "“%1” is not a valid XFDF file: %2"
msgstr "“%1”不是有效的 XFDF 文件：%2"

#: src/core/Annotation.cpp:1153
#, kde-format
msgid "“%1” holds no comments this can use."
msgstr "“%1”中没有可以使用的注释。"

#: src/core/Annotation.cpp:1159
#, kde-format
msgid "One comment names a page this document does not have and was left out."
msgid_plural "%1 comments name pages this document does not have and were left out."
msgstr[0] "有 %1 条注释指向此文档没有的页面，已被略过。"

#: src/core/PageObjects.cpp:566
#, kde-format
msgid "One object could not be moved: its placement cannot be reversed arithmetically."
msgstr "有一个对象无法移动：它的定位无法通过运算求逆。"

#: src/core/PageObjects.cpp:701
