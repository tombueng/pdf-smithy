msgstr "无法启动 Ghostscript。"

#: src/core/Archival.cpp:702
#, kde-format
msgid "Converting took too long and was stopped."
msgstr "转换耗时过长，已停止。"

#: src/core/Archival.cpp:711 src/core/Compressor.cpp:269
#: src/core/Convert.cpp:2445 src/core/ColourTools.cpp:2974
