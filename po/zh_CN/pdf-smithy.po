#: src/cli/main.cpp:1915
#, kde-format
msgid ""
"PDF Smithy (command line)\n"
"\n"
"Commands:\n"
"  info      FILE                      Show page count, size and dimensions\n"
"  merge     FILE...  -o OUT           Glue documents together\n"
"  split     FILE     [-o TEMPLATE]    Break a document apart\n"
"  pages     FILE     -o OUT           Select, reorder and rotate pages\n"
"  compress  FILE     -o OUT           Make a document smaller\n"
"  ocr       FILE     -o OUT           Make a scan searchable\n"
"  sign      FILE     -o OUT           Stamp a signature image onto pages\n"
"  watermark FILE     -o OUT           Lay text across pages\n"
"  meta      FILE                      Show metadata; --sanitize -o OUT strips it\n"
"  protect   FILE     -o OUT           Set or remove a password\n"
"  from-images IMAGE... -o OUT         Build a document from pictures\n"
"  export-images FILE                  Render pages to image files\n"
"  number    FILE     -o OUT           Page numbers, headers and Bates stamping\n"
"  crop      FILE     -o OUT           Trim the empty border off pages\n"
"  redact    FILE     -o OUT           Take content out of an area for good\n"
"  nup       FILE     -o OUT           Put several pages on one sheet\n"
"  annotate  FILE                      List, add, remove or flatten comments\n"
"  outline   FILE                      Show or rewrite the table of contents\n"
"  form      FILE                      List, fill in or flatten form fields\n"
"  text      FILE                      Show the text of a page, or correct it\n"
"  batch     FILE...  --out-dir DIR    Do one thing to many files\n"
"  compare   LEFT RIGHT                Show what changed between two documents\n"
"  archive   FILE     -o OUT           Convert to PDF/A for long-term keeping\n"
"  archive-check FILE                  Look for what stops a file being archival\n"
msgstr ""
"PDF Smithy (命令行)\n"
"\n"
"命令:\n"
"  info      FILE                      显示页数、大小和页面尺寸\n"
"  merge     FILE...  -o OUT           把多个文档粘合到一起\n"
"  split     FILE     [-o TEMPLATE]    把一个文档拆分开\n"
"  pages     FILE     -o OUT           选择、重新排序和旋转页面\n"
"  compress  FILE     -o OUT           让文档变得更小\n"
"  ocr       FILE     -o OUT           让扫描件可以搜索\n"
"  sign      FILE     -o OUT           把签名图片盖到页面上\n"
"  watermark FILE     -o OUT           在页面上铺一层文字\n"
"  meta      FILE                      显示元数据,--sanitize -o OUT 可清除元数据\n"
"  protect   FILE     -o OUT           设置或移除密码\n"
"  from-images IMAGE... -o OUT         用图片生成文档\n"
"  export-images FILE                  把页面渲染成图片文件\n"
"  number    FILE     -o OUT           页码、页眉和 Bates 编号\n"
"  crop      FILE     -o OUT           裁掉页面的空白边\n"
"  redact    FILE     -o OUT           永久取出某个区域中的内容\n"
"  nup       FILE     -o OUT           把多个页面放到一张纸上\n"
"  annotate  FILE                      列出、添加、移除或平面化注释\n"
"  outline   FILE                      显示或重写目录\n"
"  form      FILE                      列出、填写或平面化表单字段\n"
"  text      FILE                      显示某一页的文本,或加以更正\n"
"  batch     FILE...  --out-dir DIR    对多个文件做同一件事\n"
"  compare   LEFT RIGHT                显示两个文档之间的变化\n"
"  archive   FILE     -o OUT           转换为 PDF/A 以便长期保存\n"
"  archive-check FILE                  查找妨碍文件归档的问题\n"

#: src/cli/main.cpp:1943
#, kde-format
msgid ""
"\n"
"Examples:\n"
"  pdf-smithy-cli merge a.pdf b.pdf -o both.pdf\n"
"  pdf-smithy-cli split invoices.pdf --every 1\n"
"  pdf-smithy-cli pages report.pdf --keep 1-3,7 --rotate 4:90 -o short.pdf\n"
"  pdf-smithy-cli compress scan.pdf --level strong -o small.pdf\n"
"  pdf-smithy-cli ocr scan.pdf --languages deu+eng --straighten -o searchable.pdf\n"
"  pdf-smithy-cli sign contract.pdf --image signature.png --pages last -o signed.pdf\n"
"  pdf-smithy-cli watermark offer.pdf --text DRAFT --opacity 20 -o marked.pdf\n"
"  pdf-smithy-cli meta payslip.pdf --sanitize -o clean.pdf\n"
"  pdf-smithy-cli protect contract.pdf --password geheim -o locked.pdf\n"
"  pdf-smithy-cli from-images scan*.png --page-size a4 -o scans.pdf\n"
"  pdf-smithy-cli export-images report.pdf --pages 1-3 --dpi 300\n"
"  pdf-smithy-cli number report.pdf --text \"{page} / {pages}\" -o numbered.pdf\n"
"  pdf-smithy-cli number bundle.pdf --text {bates} --bates ACME- -o stamped.pdf\n"
"  pdf-smithy-cli crop scan.pdf --auto -o trimmed.pdf\n"
"  pdf-smithy-cli redact case.pdf --area 1:72,700,180,16 -o public.pdf\n"
"  pdf-smithy-cli nup slides.pdf --per-sheet 4 --borders -o handout.pdf\n"
"  pdf-smithy-cli annotate report.pdf --list\n"
"  pdf-smithy-cli outline manual.pdf --json > toc.json\n"
"  pdf-smithy-cli form application.pdf --list\n"
"  pdf-smithy-cli text letter.pdf --page 1\n"
"  pdf-smithy-cli batch scans/*.pdf --op ocr --out-dir searchable/\n"
"  pdf-smithy-cli compare contract-v1.pdf contract-v2.pdf\n"
"  pdf-smithy-cli archive invoice.pdf --level 2b -o invoice-archival.pdf\n"
"  pdf-smithy-cli to-pdfx cover.pdf --pdfx-level x4 -o cover-print.pdf\n"
"  pdf-smithy-cli tables report.pdf --pages 3-5\n"
"  pdf-smithy-cli to-svg poster.pdf --pages 1-4 -o poster.svg\n"
"  pdf-smithy-cli linearise handbook.pdf -o handbook-web.pdf\n"
"  pdf-smithy-cli set-version old.pdf --pdf-version 1.7 -o modern.pdf\n"
"  pdf-smithy-cli text letter.pdf --replace \"1:4=Sehr geehrte Frau Meier\" -o fixed.pdf\n"
"  pdf-smithy-cli form application.pdf --set Name=Bueng --set Ort=Bern -o filled.pdf\n"
"  pdf-smithy-cli annotate report.pdf --export-xfdf comments.xfdf\n"
"  pdf-smithy-cli annotate report.pdf --note 2:120,600 --text \"Check this\" -o marked.pdf\n"
"  pdf-smithy-cli split handbook.pdf --bookmarks\n"
"\n"
"Duplicating pages needs no separate command: a range may repeat a page,\n"
"so \"pages FILE --keep 1,1,2-4\" writes page 1 twice."
msgstr ""
"\n"
"示例:\n"
"  pdf-smithy-cli merge a.pdf b.pdf -o both.pdf\n"
"  pdf-smithy-cli split invoices.pdf --every 1\n"
"  pdf-smithy-cli pages report.pdf --keep 1-3,7 --rotate 4:90 -o short.pdf\n"
"  pdf-smithy-cli compress scan.pdf --level strong -o small.pdf\n"
"  pdf-smithy-cli ocr scan.pdf --languages deu+eng --straighten -o searchable.pdf\n"
"  pdf-smithy-cli sign contract.pdf --image signature.png --pages last -o signed.pdf\n"
"  pdf-smithy-cli watermark offer.pdf --text DRAFT --opacity 20 -o marked.pdf\n"
"  pdf-smithy-cli meta payslip.pdf --sanitize -o clean.pdf\n"
"  pdf-smithy-cli protect contract.pdf --password geheim -o locked.pdf\n"
"  pdf-smithy-cli from-images scan*.png --page-size a4 -o scans.pdf\n"
"  pdf-smithy-cli export-images report.pdf --pages 1-3 --dpi 300\n"
"  pdf-smithy-cli number report.pdf --text \"{page} / {pages}\" -o numbered.pdf\n"
"  pdf-smithy-cli number bundle.pdf --text {bates} --bates ACME- -o stamped.pdf\n"
"  pdf-smithy-cli crop scan.pdf --auto -o trimmed.pdf\n"
"  pdf-smithy-cli redact case.pdf --area 1:72,700,180,16 -o public.pdf\n"
"  pdf-smithy-cli nup slides.pdf --per-sheet 4 --borders -o handout.pdf\n"
"  pdf-smithy-cli annotate report.pdf --list\n"
"  pdf-smithy-cli outline manual.pdf --json > toc.json\n"
"  pdf-smithy-cli form application.pdf --list\n"
"  pdf-smithy-cli text letter.pdf --page 1\n"
"  pdf-smithy-cli batch scans/*.pdf --op ocr --out-dir searchable/\n"
"  pdf-smithy-cli compare contract-v1.pdf contract-v2.pdf\n"
"  pdf-smithy-cli archive invoice.pdf --level 2b -o invoice-archival.pdf\n"
"  pdf-smithy-cli to-pdfx cover.pdf --pdfx-level x4 -o cover-print.pdf\n"
"  pdf-smithy-cli tables report.pdf --pages 3-5\n"
"  pdf-smithy-cli to-svg poster.pdf --pages 1-4 -o poster.svg\n"
"  pdf-smithy-cli linearise handbook.pdf -o handbook-web.pdf\n"
"  pdf-smithy-cli set-version old.pdf --pdf-version 1.7 -o modern.pdf\n"
"  pdf-smithy-cli text letter.pdf --replace \"1:4=Sehr geehrte Frau Meier\" -o fixed.pdf\n"
"  pdf-smithy-cli form application.pdf --set Name=Bueng --set Ort=Bern -o filled.pdf\n"
"  pdf-smithy-cli annotate report.pdf --export-xfdf comments.xfdf\n"
"  pdf-smithy-cli annotate report.pdf --note 2:120,600 --text \"Check this\" -o marked.pdf\n"
"  pdf-smithy-cli split handbook.pdf --bookmarks\n"
"\n"
"复制页面不需要单独的命令: 一个范围里可以重复某一页,\n"
"因此 \"pages FILE --keep 1,1,2-4\" 会把第 1 页写入两次。"

#: src/cli/main.cpp:1982
#, kde-format
msgid "The command to run."
msgstr "要运行的命令。"

#: src/cli/main.cpp:1987
#, kde-format
msgid "Where to write the result."
msgstr "结果写到哪里。"

#: src/cli/main.cpp:1988
#, kde-format
msgid "Machine-readable output."
msgstr "机器可读的输出。"

#: src/cli/main.cpp:1989
#, kde-format
msgid "Pages to keep, e.g. 1-3,7,9-last."
msgstr "要保留的页面,例如 1-3,7,9-last。"

#: src/cli/main.cpp:1991
#, kde-format
msgid "Rotate pages, e.g. 1-3:90,7:180."
msgstr "旋转页面,例如 1-3:90,7:180。"

#: src/cli/main.cpp:1993
#, kde-format
msgid "Split into chunks of this many pages."
msgstr "按每段这么多页拆分。"

#: src/cli/main.cpp:1996
#, kde-format
msgid "Split into one file per range, e.g. 1-3,4-9."
msgstr "按范围拆分,每个范围一个文件,例如 1-3,4-9。"

#: src/cli/main.cpp:1998
#, kde-format
msgid "Split into pieces no larger than this, e.g. 5M."
msgstr "拆分成不超过此大小的片段,例如 5M。"

#: src/cli/main.cpp:2000
#, kde-format
msgid "Compression: lossless, balanced, strong or extreme."
msgstr "压缩级别: lossless、balanced、strong 或 extreme。"

#: src/cli/main.cpp:2001
#, kde-format
msgid "Convert to grayscale while compressing."
msgstr "压缩时转换为灰度。"

#: src/cli/main.cpp:2002
#, kde-format
msgid "OCR languages, e.g. deu+eng."
msgstr "OCR 语言,例如 deu+eng。"

#: src/cli/main.cpp:2004
#, kde-format
msgid "Correct crooked scans."
msgstr "校正歪斜的扫描件。"

#: src/cli/main.cpp:2005
#, kde-format
msgid "Signature image to stamp."
msgstr "要盖上的签名图片。"

#: src/cli/main.cpp:2007
#, kde-format
msgid "Where to put it: bottom-right, centre, top-left…"
msgstr "放在哪里: bottom-right、centre、top-left…"

#: src/cli/main.cpp:2009
#, kde-format
msgid "Width as a fraction of the page, e.g. 0.3."
msgstr "宽度占页面的比例,例如 0.3。"

#: src/cli/main.cpp:2015
#, kde-format
msgid "Distance from the page edge, in points."
msgstr "与页面边缘的距离,以点为单位。"

#: src/cli/main.cpp:2017
#, kde-format
msgid "Watermark text."
msgstr "水印文本。"

#: src/cli/main.cpp:2018
#, kde-format
msgid "Watermark angle in degrees."
msgstr "水印角度,以度为单位。"

#: src/cli/main.cpp:2020
#, kde-format
msgid "Watermark strength, 1 to 100 percent."
msgstr "水印强度,1 到 100 百分比。"

#: src/cli/main.cpp:2022
#, kde-format
msgid "Watermark colour, a name or #rrggbb."
msgstr "水印颜色,颜色名或 #rrggbb。"

#: src/cli/main.cpp:2025
#, kde-format
msgid "Draw the watermark as an outline, keeping the page readable."
msgstr "以轮廓方式绘制水印,让页面仍然可读。"

#: src/cli/main.cpp:2026
#, kde-format
msgid "Which pages, e.g. 1-3,last. Default: all."
msgstr "作用于哪些页面,例如 1-3,last。默认: 全部。"

#: src/cli/main.cpp:2029
#, kde-format
msgid "Fit images into a4, a3, a5, letter or legal."
msgstr "把图片适配到 a4、a3、a5、letter 或 legal。"

#: src/cli/main.cpp:2030
#, kde-format
msgid "Resolution for image export, in dots per inch."
msgstr "图片导出的分辨率,以每英寸点数 (DPI) 为单位。"

#: src/cli/main.cpp:2032
#, kde-format
msgid "Image format: png, jpeg or tiff."
msgstr "图片格式: png、jpeg 或 tiff。"

#: src/cli/main.cpp:2035
#, kde-format
msgid "JPEG quality when importing, 0 keeps the pixels."
msgstr "导入时的 JPEG 质量,0 表示保留原始像素。"

#: src/cli/main.cpp:2038
#, kde-format
msgid "Strip metadata, JavaScript and embedded files."
msgstr "清除元数据、JavaScript 和嵌入的文件。"

#: src/cli/main.cpp:2039
#, kde-format
msgid "Password to set."
msgstr "要设置的密码。"

#: src/cli/main.cpp:2042
#, kde-format
msgid "Password the input already has, if any."
msgstr "输入文件现有的密码 (如果有)。"

#: src/cli/main.cpp:2044
#, kde-format
msgid "Remove the password instead of setting one."
msgstr "移除密码,而不是设置密码。"

#: src/cli/main.cpp:2045
#, kde-format
msgid "Ask readers not to print."
msgstr "请求阅读器不要打印。"

#: src/cli/main.cpp:2046
#, kde-format
msgid "Ask readers not to copy text."
msgstr "请求阅读器不要复制文本。"

#: src/cli/main.cpp:2047
#, kde-format
msgid "Split wherever a bookmark starts."
msgstr "在每个书签开始处拆分。"

#: src/cli/main.cpp:2050
#, kde-format
msgid "A colour profile to embed: sRGB for “archive”, a CMYK printing condition for “to-pdfx”. Leave out to look for one on the system."
msgstr "要嵌入的颜色配置文件: “archive”用 sRGB,“to-pdfx”用 CMYK 印刷条件。不指定则在系统中查找一个。"

#: src/cli/main.cpp:2053
#, kde-format
msgid "Document title to write."
msgstr "要写入的文档标题。"

#: src/cli/main.cpp:2055
#, kde-format
msgid "Document author to write."
msgstr "要写入的文档作者。"

#: src/cli/main.cpp:2059
#, kde-format
msgid "How different two pixels may be before they count as changed, in levels of brightness out of 255. On “colour replace” it is a distance in colour between 0 and 1."
msgstr "两个像素相差多少才算发生了变化,以 255 级亮度计。对于“colour replace”,它是 0 到 1 之间的颜色距离。"

#: src/cli/main.cpp:2063
#, kde-format
msgid "Treat a different line break as a change."
msgstr "把不同的换行也视为变化。"

#: src/cli/main.cpp:2065
#, kde-format
msgid "Write a side-by-side picture of one page, with -o."
msgstr "配合 -o 写出某一页的并排对比图。"

#: src/cli/main.cpp:2067
#, kde-format
msgid "Folder to write the finished files into."
msgstr "用于写入处理完成文件的文件夹。"

#: src/cli/main.cpp:2070
#, kde-format
msgid "What to do to each file: compress, sanitize, flatten-comments, flatten-form or ocr."
msgstr "对每个文件做什么: compress、sanitize、flatten-comments、flatten-form 或 ocr。"

#: src/cli/main.cpp:2074
#, kde-format
msgid "Replace a line, as PAGE:LINE=New text. Repeat for more."
msgstr "替换一行,格式为 PAGE:LINE=新文本。可重复使用以替换多行。"

#: src/cli/main.cpp:2076
#, kde-format
msgid "Which page to list the text of."
msgstr "列出哪一页的文本。"

#: src/cli/main.cpp:2079
#, kde-format
msgid "Fill in a field, as NAME=VALUE. Repeat for more."
msgstr "填写一个字段,格式为 NAME=VALUE。可重复使用以填写多个。"

#: src/cli/main.cpp:2081
#, kde-format
msgid "Add a bookmark, as PAGE:Title. Repeat for more."
msgstr "添加一个书签,格式为 PAGE:标题。可重复使用以添加多个。"

#: src/cli/main.cpp:2083
#, kde-format
msgid "Replace the table of contents from a JSON file, as --json writes it."
msgstr "用 JSON 文件替换目录,格式与 --json 写出的一致。"

#: src/cli/main.cpp:2086
#, kde-format
msgid "Write the comments to an XFDF file, without the document."
msgstr "把注释写入 XFDF 文件,不包含文档本身。"

#: src/cli/main.cpp:2089
#, kde-format
msgid "Read comments from an XFDF file and add them."
msgstr "从 XFDF 文件读取注释并添加进来。"

#: src/cli/main.cpp:2090
#, kde-format
msgid "Show the comments instead of changing them."
msgstr "显示注释,而不是修改它们。"

#: src/cli/main.cpp:2092
#, kde-format
msgid "Highlight an area, as PAGE:X,Y,WIDTH,HEIGHT. Repeat for more."
msgstr "高亮一个区域,格式为 PAGE:X,Y,WIDTH,HEIGHT。可重复使用以高亮多个。"

#: src/cli/main.cpp:2094
#, kde-format
msgid "Put a note marker at PAGE:X,Y. Repeat for more."
msgstr "在 PAGE:X,Y 处放置一个便笺标记。可重复使用以放置多个。"

#: src/cli/main.cpp:2099
#, kde-format
msgid "Take every comment out, leaving form fields alone."
msgstr "移除所有注释,但不动表单字段。"

#: src/cli/main.cpp:2100
#, kde-format
msgid "Name to put on the comment."
msgstr "写在注释上的名字。"

#: src/cli/main.cpp:2103
#, kde-format
msgid "Draw the comments into the pages and remove them."
msgstr "把注释绘入页面,然后移除注释本身。"

#: src/cli/main.cpp:2105
#, kde-format
msgid "How many pages go on one sheet, e.g. 2, 4 or 9."
msgstr "一张纸上放多少个页面,例如 2、4 或 9。"

#: src/cli/main.cpp:2107
#, kde-format
msgid "Exact arrangement as COLUMNSxROWS, e.g. 2x3."
msgstr "精确的排列方式,格式为 COLUMNSxROWS,例如 2x3。"

#: src/cli/main.cpp:2109
#, kde-format
msgid "Gap between the slots, in points."
msgstr "各个格位之间的间距,以点为单位。"

#: src/cli/main.cpp:2112
#, kde-format
msgid "Empty border around the sheet, in points."
msgstr "纸张四周的空白边距,以点为单位。"

#: src/cli/main.cpp:2114
#, kde-format
msgid "Draw a hairline around each slot."
msgstr "在每个格位周围绘制细线框。"

#: src/cli/main.cpp:2115
#, kde-format
msgid "Fill downwards before moving right."
msgstr "先向下填充,再向右移动。"

#: src/cli/main.cpp:2117
#, kde-format
msgid "Area to redact, as PAGE:X,Y,WIDTH,HEIGHT in points from the bottom-left corner. Repeat for more."
msgstr "要涂黑的区域,格式为 PAGE:X,Y,WIDTH,HEIGHT,以点为单位,从左下角算起。可重复使用以涂黑多个。"

#: src/cli/main.cpp:2121
#, kde-format
msgid "Leave the gap open instead of painting it black."
msgstr "留出空白,而不是涂成黑色。"

#: src/cli/main.cpp:2122
#, kde-format
msgid "Find the empty border and trim it."
msgstr "找出空白边并裁掉。"

#: src/cli/main.cpp:2123
#, kde-format
msgid "Remove the crop instead of setting one."
msgstr "移除裁剪,而不是设置裁剪。"

#: src/cli/main.cpp:2124
#, kde-format
msgid "Points to trim from the left."
msgstr "从左侧裁掉的点数。"

#: src/cli/main.cpp:2126
#, kde-format
msgid "Points to trim from the right."
msgstr "从右侧裁掉的点数。"

#: src/cli/main.cpp:2128
#, kde-format
msgid "Points to trim from the top."
msgstr "从顶部裁掉的点数。"

#: src/cli/main.cpp:2130
#, kde-format
msgid "Points to trim from the bottom."
msgstr "从底部裁掉的点数。"

#: src/cli/main.cpp:2132
#, kde-format
msgid "Prefix for Bates numbering, e.g. ACME-."
msgstr "Bates 编号的前缀,例如 ACME-。"

#: src/cli/main.cpp:2134
#, kde-format
msgid "Zero padding for the Bates number."
msgstr "Bates 编号的补零位数。"

#: src/cli/main.cpp:2136
#, kde-format
msgid "Number the first stamped page as this."
msgstr "第一个加盖编号的页面从此数字开始。"

#: src/cli/main.cpp:2138
#, kde-format
msgid "Text size in points."
msgstr "文本大小,以点为单位。"

#: src/cli/main.cpp:2142
#, kde-format
msgid "Recognise text even on pages that already have some."
msgstr "即使页面上已有文本,也进行文本识别。"

#: src/cli/main.cpp:2284
#, kde-format
msgid "This build has no OCR support."
msgstr "此版本不支持 OCR。"

#: src/cli/main.cpp:2297
#, kde-format
msgid "Unknown command “%1”."
msgstr "未知命令“%1”。"

#: src/cli/CommandsTypeset.cpp:252
#, kde-format
msgid "“%1” says nothing to change."
msgstr "“%1”没有指明任何要更改的内容。"

#: src/cli/CommandsTypeset.cpp:273
#, kde-format
msgid "“%1” is not yes or no."
msgstr "“%1”既不是 yes 也不是 no。"

#: src/cli/CommandsTypeset.cpp:281
#, kde-format
msgid "“%1” is not a length."
msgstr "“%1”不是有效的长度。"

#: src/cli/CommandsTypeset.cpp:289
#, kde-format
msgid "“%1” needs a font name."
msgstr "“%1”需要一个字体名称。"

#: src/cli/CommandsTypeset.cpp:335 src/cli/CommandsTypeset.cpp:549
#, kde-format
msgid "“%1” is not an alignment. Try left, right, centre or justify."
msgstr "“%1”不是有效的对齐方式。请尝试 left、right、centre 或 justify。"

#: src/cli/CommandsTypeset.cpp:346
#, kde-format
msgid "“%1” is not something a style has. Try font, size, leading, colour, bold, italic, align, space-before, space-after, indent-first, indent-left, indent-right or keep-with-next."
msgstr "“%1”不是样式可以设置的属性。请尝试 font、size、leading、colour、bold、italic、align、space-before、space-after、indent-first、indent-left、indent-right 或 keep-with-next。"

#: src/cli/CommandsTypeset.cpp:360
#, kde-format
msgid "“%1” is not a style. The form is body:size=11 or h1:bold,size=20."
msgstr "“%1”不是有效的样式。格式为 body:size=11 或 h1:bold,size=20。"

#: src/cli/CommandsTypeset.cpp:372
#, kde-format
msgid "“%1” is not a part of the document. Use body, or h1 to h6."
msgstr "“%1”不是文档的组成部分。请使用 body,或 h1 到 h6。"

#: src/cli/CommandsTypeset.cpp:390
#, kde-format
msgid "“%1” is not a length for --%2. Try 12, 12mm or 34pt."
msgstr "“%1”不是 --%2 可用的长度。请尝试 12、12mm 或 34pt。"

#: src/cli/CommandsTypeset.cpp:414
#, kde-format
msgid "typeset measures paper in millimetres, so its margin is --%1-mm. --%1 is points here as everywhere else, and belongs to the commands that stamp and trim."
msgstr "typeset 以毫米度量纸张,所以它的边距选项是 --%1-mm。--%1 在这里和在别处一样以点为单位,属于加盖和裁剪那一类命令。"

#: src/cli/CommandsTypeset.cpp:433 src/cli/CommandsImages.cpp:105
#, kde-format
msgid "“%1” is not a number for --%2."
msgstr "“%1”不是 --%2 可用的数字。"

#: src/cli/CommandsTypeset.cpp:463
#, kde-format
msgid "“%1” is not a page size. Try a4, a3, a5, letter, legal, or a pair with its unit written, as 210x297mm or 595x842pt."
msgstr "“%1”不是有效的页面大小。请尝试 a4、a3、a5、letter、legal,或者写明单位的一对数值,如 210x297mm 或 595x842pt。"

#: src/cli/CommandsTypeset.cpp:494
#, kde-format
msgid "Columns run from 1 to 12."
msgstr "栏数的取值范围是 1 到 12。"

#: src/cli/CommandsTypeset.cpp:584
#, kde-format
msgid "measure needs some text (--text)."
msgstr "measure 需要一些文本 (--text)。"

#: src/cli/CommandsTypeset.cpp:601
#, kde-format
msgid "A font size has to be more than nothing."
msgstr "字体大小必须大于零。"

#: src/cli/CommandsTypeset.cpp:620
#, kde-format
msgctxt "@info a measured width in points and in millimetres"
msgid "%1 pt  (%2 mm)"
msgstr "%1 pt  (%2 mm)"

#: src/cli/CommandsTypeset.cpp:657
#, kde-format
msgid "typeset needs a text file, or “-” to read standard input."
msgstr "typeset 需要一个文本文件,或者用“-”从标准输入读取。"

#: src/cli/CommandsTypeset.cpp:660
#, kde-format
msgid "typeset sets one file at a time."
msgstr "typeset 一次只能排版一个文件。"

#: src/cli/CommandsTypeset.cpp:678
#, kde-format
msgid "Reading from standard input needs an output file (-o)."
msgstr "从标准输入读取时需要一个输出文件 (-o)。"

#: src/cli/CommandsTypeset.cpp:699
#, kde-format
msgid "Standard input could not be read."
msgstr "无法读取标准输入。"

#: src/cli/CommandsTypeset.cpp:732
#, kde-format
msgid "Set %1 paragraph."
msgid_plural "Set %1 paragraphs."
msgstr[0] "已排版 %1 个段落。"

#: src/cli/CommandsTypeset.cpp:798
#, kde-format
msgid "A temporary file could not be made."
msgstr "无法创建临时文件。"

#: src/cli/CommandsTypeset.cpp:826
#, kde-format
msgid "The converted text could not be read back."
msgstr "无法读回转换后的文本。"

#: src/cli/CommandsTypeset.cpp:833
#, kde-format
msgid "Wrote %1  (%2)"
msgstr "已写入 %1  (%2)"

#: src/cli/CommandsTypeset.cpp:846
#, kde-format
msgid "Margin on all four sides, in millimetres."
msgstr "四边的边距,以毫米为单位。"

#: src/cli/CommandsTypeset.cpp:847
#, kde-format
msgid "Top margin, in millimetres. Overrides --margin-mm."
msgstr "上边距,以毫米为单位。会覆盖 --margin-mm。"

#: src/cli/CommandsTypeset.cpp:849
#, kde-format
msgid "Bottom margin, in millimetres. Overrides --margin-mm."
msgstr "下边距,以毫米为单位。会覆盖 --margin-mm。"

#: src/cli/CommandsTypeset.cpp:851
#, kde-format
msgid "Left margin, in millimetres. Overrides --margin-mm."
msgstr "左边距,以毫米为单位。会覆盖 --margin-mm。"

#: src/cli/CommandsTypeset.cpp:853
#, kde-format
msgid "Right margin, in millimetres. Overrides --margin-mm."
msgstr "右边距,以毫米为单位。会覆盖 --margin-mm。"

#: src/cli/CommandsTypeset.cpp:856
#, kde-format
msgid "Font to set the body in: Helvetica, Times, Courier, or a name that suggests one."
msgstr "正文使用的字体: Helvetica、Times、Courier,或者与之相近的名称。"

#: src/cli/CommandsTypeset.cpp:858
#, kde-format
msgid "Distance between baselines, in points. Default: 1.35 times the size."
msgstr "基线之间的距离,以点为单位。默认: 字号的 1.35 倍。"

#: src/cli/CommandsTypeset.cpp:860
#, kde-format
msgid "How the body is set: left, right, centre or justify."
msgstr "正文的排版方式: left、right、centre 或 justify。"

#: src/cli/CommandsTypeset.cpp:862
#, kde-format
msgid "Set the text in this many columns, 1 to 12."
msgstr "把文本排成这么多栏,1 到 12。"

#: src/cli/CommandsTypeset.cpp:863
#, kde-format
msgid "Set the body in bold."
msgstr "正文使用粗体。"

#: src/cli/CommandsTypeset.cpp:864
#, kde-format
msgid "Set the body in italic."
msgstr "正文使用斜体。"

#: src/cli/CommandsTypeset.cpp:865
#, kde-format
msgid "Space above each paragraph, in points."
msgstr "每段上方的间距,以点为单位。"

#: src/cli/CommandsTypeset.cpp:866
#, kde-format
msgid "Space below each paragraph, in points."
msgstr "每段下方的间距,以点为单位。"

#: src/cli/CommandsTypeset.cpp:867
#, kde-format
msgid "Indent for the first line of a paragraph, in points."
msgstr "段落首行的缩进,以点为单位。"

#: src/cli/CommandsTypeset.cpp:869
#, kde-format
msgid "Indent for the whole paragraph from the left, in points."
msgstr "整段从左侧起的缩进,以点为单位。"

#: src/cli/CommandsTypeset.cpp:871
#, kde-format
msgid "Indent for the whole paragraph from the right, in points."
msgstr "整段从右侧起的缩进,以点为单位。"

#: src/cli/CommandsTypeset.cpp:873
#, kde-format
msgid "Running head. {page}, {pages}, {title} and {date} are filled in."
msgstr "页眉。其中的 {page}、{pages}、{title} 和 {date} 会被自动填入。"

#: src/cli/CommandsTypeset.cpp:875
#, kde-format
msgid "Running foot, with the same placeholders as --header."
msgstr "页脚,占位符与 --header 相同。"

#: src/cli/CommandsTypeset.cpp:877
#, kde-format
msgid "Text size of the running head and foot, in points."
msgstr "页眉和页脚的文本大小,以点为单位。"

#: src/cli/CommandsTypeset.cpp:879
#, kde-format
msgid "Break long words at the end of a line."
msgstr "在行尾断开长单词。"

#: src/cli/CommandsTypeset.cpp:880
#, kde-format
msgid "Language the text is in, which decides how it hyphenates, e.g. de."
msgstr "文本所用的语言,它决定如何断词,例如 de。"

#: src/cli/CommandsTypeset.cpp:883
#, kde-format
msgid "Style one part, as body:size=11,align=justify or h1:bold,size=20. Repeat for more."
msgstr "设置某一部分的样式,格式为 body:size=11,align=justify 或 h1:bold,size=20。可重复使用以设置多个。"

#: src/cli/CommandsTypeset.cpp:885
#, kde-format
msgid "Say what this command cannot promise, and do nothing else."
msgstr "说明此命令无法保证的地方,除此之外什么也不做。"

#: src/cli/CommandsTypeset.cpp:886
#, kde-format
msgid "Take the text as it was drawn, without paragraphs or columns."
msgstr "按文本绘制时的原样取出,不分段落也不分栏。"

#: src/cli/CommandsTypeset.cpp:887
#, kde-format
msgid "Baselines closer together than this many points are one line."
msgstr "基线间距小于这么多点时算作同一行。"

#: src/cli/CommandsTypeset.cpp:890
#, kde-format
msgid "A gap this many times the text size starts a new paragraph."
msgstr "间距达到文本大小的这么多倍时开始新的段落。"

#: src/cli/CommandsTypeset.cpp:919
#, kde-format
msgid "Set a text or Markdown file as pages"
msgstr "把文本或 Markdown 文件排版成页面"

#: src/cli/CommandsTypeset.cpp:920
#, kde-format
