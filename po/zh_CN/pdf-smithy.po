msgstr "填写"

#: src/ui/FormEditor.cpp:259
#, kde-format
msgctxt "@title:window"
msgid "Fill In Form"
msgstr "填写表单"

#: src/ui/FormEditor.cpp:330
#, kde-format
msgid "This editor has nothing to fill the form in with."
msgstr "此编辑器没有可用来填写表单的内容。"

#: src/ui/FormEditor.cpp:341
#, kde-format
msgctxt "@info:status"
msgid "Filled in %1 field and made the answers permanent."
msgid_plural "Filled in %1 fields and made the answers permanent."
msgstr[0] "已填写 %1 个字段，并把填写的内容永久固定。"

#: src/ui/FormEditor.cpp:343
#, kde-format
msgctxt "@info:status"
msgid "Filled in %1 field."
msgid_plural "Filled in %1 fields."
msgstr[0] "已填写 %1 个字段。"

