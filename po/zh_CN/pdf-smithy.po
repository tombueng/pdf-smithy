msgstr "请用 --data 说明要读入哪些填写内容，文件扩展名为 .fdf、.xfdf 或 .csv。"

#: src/cli/CommandsForm.cpp:1151
#, kde-format
msgid "Filled in %1 field. The result is in %2."
msgid_plural "Filled in %1 fields. The result is in %2."
msgstr[0] "已填写 %1 个字段。结果保存在 %2 中。"

