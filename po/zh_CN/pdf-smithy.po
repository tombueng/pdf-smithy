#, kde-format
msgid "fonts embed needs a font to embed, as --font “DejaVu Sans”."
msgstr "fonts embed 需要指定要嵌入的字体，例如 --font “DejaVu Sans”。"

#: src/cli/CommandsFonts.cpp:365 src/cli/CommandsFonts.cpp:517
#, kde-format
