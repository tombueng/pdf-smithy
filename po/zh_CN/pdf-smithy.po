msgstr "第 %1 页没有自己的页面大小，因此必须指定一个。"

#: src/core/PageLayout.cpp:810
#, kde-format
msgid "The bleed has to be greater than zero."
msgstr "出血必须大于零。"

#: src/core/PageLayout.cpp:864
#, kde-format
msgid "There are no pages to resize."
msgstr "没有要调整大小的页面。"

#: src/core/PageLayout.cpp:870
#, kde-format
msgid "The paper size has to be at least one point in each direction."
msgstr "纸张大小在每个方向上至少要有一个点。"

#: src/core/PageLayout.cpp:904 src/core/PageLayout.cpp:1047
#: src/core/PageLayout.cpp:1153 src/core/NUp.cpp:60
