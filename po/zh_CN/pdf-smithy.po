msgstr "作为复制来源的表单没有字段。"

#: src/core/FormBuilder.cpp:2008
#, kde-format
msgid "This document already has a field called “%1”; remove it first, or the form would end up with two fields of one name."
msgstr "此文档已有名为“%1”的字段；请先移除它，否则表单中会出现两个同名字段。"

#: src/core/FormBuilder.cpp:2071
#, kde-format
msgid "The form has fields on pages this document does not have."
msgstr "该表单的字段位于此文档没有的页面上。"

#: src/core/FormBuilder.cpp:2125
#, kde-format
msgid "This document has no form to take data out of."
msgstr "此文档没有可从中提取数据的表单。"

#: src/core/FormBuilder.cpp:2176
