msgid "Work on the Pixels"
msgstr "Trabajar con los píxeles"

#: src/ui/ToolImagesDialog.cpp:243
#, kde-format
msgctxt "@title:tab"
msgid "Tidying Up"
msgstr "Limpieza"

#: src/ui/ToolImagesDialog.cpp:267
#, kde-format
