#: src/core/ScanProcessor.cpp:288
#, kde-format
msgid "Neither text recognition nor straightening was requested."
msgstr "No se ha solicitado ni el reconocimiento de texto ni el enderezado."

#: src/core/ScanProcessor.cpp:301
#, kde-format
msgid ""
"Text recognition could not be started for “%1”. Install the matching "
"tesseract-ocr language package."
msgstr ""
"No se ha podido iniciar el reconocimiento de texto para «%1». Instale el "
"paquete de idioma tesseract-ocr correspondiente."

#: src/core/ScanProcessor.cpp:339
#, kde-format
msgid "Cancelled."
msgstr "Cancelado."

#: src/core/Source.cpp:50
#, kde-format
msgid "“%1” needs a password."
msgstr "«%1» necesita una contraseña."

#: src/core/Source.cpp:51
#, kde-format
msgid "That password does not open “%1”."
msgstr "Esa contraseña no abre «%1»."

#: src/core/Splitter.cpp:107
#, kde-format
msgid "The document has no pages to split."
msgstr "El documento no tiene páginas que dividir."

#: src/core/Splitter.cpp:136
#, kde-format
msgid "No page ranges were given."
msgstr "No se ha indicado ningún intervalo de páginas."

#: src/core/Splitter.cpp:176
#, kde-format
msgid "The maximum file size must be greater than zero."
msgstr "El tamaño máximo de archivo debe ser mayor que cero."

#: src/core/Splitter.cpp:212
#, kde-format
msgid "The settings produce no files."
msgstr "Las preferencias no producen ningún archivo."

#: src/core/TextEdit.cpp:531
#, kde-format
msgid "The page does not say which font this text uses."
msgstr "La página no indica qué tipo de letra usa este texto."

#: src/core/TextEdit.cpp:574
#, kde-format
msgid ""
"This font does not say which characters it holds, so replacing its text "
"would produce the wrong letters."
msgstr ""
"Este tipo de letra no indica qué caracteres contiene, por lo que sustituir "
"su texto produciría letras equivocadas."

#: src/core/TextEdit.cpp:1040
#, kde-format
msgid ""
"Some of this text uses characters the font does not explain, so it cannot be "
"read back reliably."
msgstr ""
"Parte de este texto usa caracteres que el tipo de letra no explica, por lo "
"que no se puede volver a leer de forma fiable."

#: src/core/TextEdit.cpp:1098
#, kde-format
msgid "“%1” was left as it was: the face asked for does not contain %2."
msgstr ""
"«%1» se ha dejado tal como estaba: el tipo de letra solicitado no contiene "
"%2."

#: src/core/TextEdit.cpp:1100
#, kde-format
msgid "“%1” was left as it was: this document's font does not contain %2."
msgstr ""
"«%1» se ha dejado tal como estaba: el tipo de letra de este documento no "
"contiene %2."

#: src/core/TextEdit.cpp:1115
#, kde-format
msgid "“%1” is longer than the space it replaces and reaches past it."
msgstr "«%1» es más largo que el espacio al que sustituye y lo sobrepasa."

#: src/core/TextEdit.cpp:1221
#, kde-format
msgctxt "@info %1 is a font family, %2 the reason it could not be used"
msgid ""
"The text keeps the face it had: “%1” could not be put into this document. %2"
msgstr ""
"El texto conserva el tipo de letra que tenía: «%1» no se ha podido "
"incorporar a este documento. %2"

#: src/core/TextEdit.cpp:1288
#, kde-format
msgid "There is no text to change."
msgstr "No hay texto que cambiar."

#: src/core/TextEdit.cpp:1314
#, kde-format
msgid "None of the text to change is on a page of this document."
msgstr ""
"Nada del texto que se va a cambiar está en una página de este documento."

#: src/core/TextEdit.cpp:1379
#, kde-format
msgid ""
"Text is replaced in the page's own font, so the result matches everything "
"around it."
msgstr ""
"El texto se sustituye con el propio tipo de letra de la página, de modo que "
"el resultado concuerda con todo lo que lo rodea."

#: src/core/TextEdit.cpp:1380
#, kde-format
msgid ""
"A replacement that is too wide for its space is squeezed to fit, so that it "
"does not run into what sits beside it. A shorter one simply makes the line "
"shorter."
msgstr ""
"Una sustitución demasiado ancha para su espacio se comprime para que quepa, "
"de modo que no invada lo que hay a su lado. Una más corta simplemente acorta "
"la línea."

#: src/core/TextEdit.cpp:1382
#, kde-format
msgid ""
"Nothing on other lines moves, because a PDF does not record which line "
"follows which."
msgstr ""
"Nada de las demás líneas se mueve, porque un PDF no registra qué línea sigue "
"a cuál."

#: src/core/TextEdit.cpp:1383
#, kde-format
msgid ""
"A font embedded in a document usually carries only the characters that "
"document used. Asking for a character it does not hold is refused rather "
"than drawn wrongly."
msgstr ""
"Un tipo de letra incrustado en un documento suele llevar solo los caracteres "
"que ese documento usó. Pedir un carácter que no contiene se rechaza en lugar "
"de dibujarlo mal."

#: src/core/TextEdit.cpp:1385
#, kde-format
msgid ""
"Text drawn inside an embedded drawing, and text that is part of a scanned "
"picture, cannot be changed this way."
msgstr ""
"El texto dibujado dentro de un dibujo incrustado, y el texto que forma parte "
"de una imagen escaneada, no se pueden cambiar de este modo."

#: src/core/Typeset.cpp:222
#, kde-format
msgid ""
"The character “%1” is outside WinAnsi, which is all the standard fonts can "
"write, and was left out."
msgstr ""
"El carácter «%1» está fuera de WinAnsi, que es todo lo que pueden escribir "
"los tipos de letra estándar, y se ha omitido."

#: src/core/Typeset.cpp:232
#, kde-format
msgid "“%1” is wider than the column and had to be broken across lines."
msgstr ""
"«%1» es más ancho que la columna y ha tenido que dividirse en varias líneas."

#: src/core/Typeset.cpp:240
#, kde-format
msgid ""
"Something is taller than the column holding it and runs past the margin."
msgstr "Algo es más alto que la columna que lo contiene y sobrepasa el margen."

#: src/core/Typeset.cpp:1348
#, kde-format
msgid "Cannot write “%1”: %2"
msgstr "No se puede escribir «%1»: %2"

#: src/core/Typeset.cpp:1890
#, kde-format
msgid "No file to write to was given."
msgstr "No se ha indicado ningún archivo en el que escribir."

#: src/core/Typeset.cpp:1896
#, kde-format
msgid "The type size has to be greater than zero."
msgstr "El tamaño de letra debe ser mayor que cero."

#: src/core/Typeset.cpp:1902
#, kde-format
msgid "A page smaller than an inch square cannot hold text."
msgstr "Una página menor de una pulgada cuadrada no puede contener texto."

#: src/core/Typeset.cpp:1914
#, kde-format
msgid "The margins and columns leave no room for text on a page this size."
msgstr ""
"Los márgenes y las columnas no dejan espacio para el texto en una página de "
"este tamaño."

#: src/core/Typeset.cpp:1948
#, kde-format
msgid "There is no text to lay out."
msgstr "No hay texto que maquetar."

#: src/core/Typeset.cpp:1999
#, kde-format
msgid "Cannot read “%1”."
msgstr "No se puede leer «%1»."

#: src/core/Typeset.cpp:2030
#, kde-format
msgid ""
"Only the fourteen standard fonts are used, so the alphabet is the one "
"WinAnsi covers: western Europe. Greek, Cyrillic, Hebrew, Arabic and CJK need "
"an embedded font, and are reported rather than drawn."
msgstr ""
"Solo se usan los catorce tipos de letra estándar, por lo que el alfabeto es "
"el que cubre WinAnsi: Europa occidental. El griego, el cirílico, el hebreo, "
"el árabe y el CJK necesitan un tipo de letra incrustado, y se informa de "
"ellos en lugar de dibujarlos."

#: src/core/Typeset.cpp:2033
#, kde-format
msgid ""
"Lines are broken one at a time from left to right rather than by balancing a "
"whole paragraph at once, so the spacing is even but not the best possible."
msgstr ""
"Las líneas se dividen de una en una, de izquierda a derecha, en lugar de "
"equilibrando todo el párrafo a la vez, por lo que el espaciado es uniforme, "
"pero no el mejor posible."

#: src/core/Typeset.cpp:2035
#, kde-format
msgid ""
"Hyphenation follows a spelling pattern rather than a dictionary, and stays "
"off unless it is asked for."
msgstr ""
"La división de palabras sigue un patrón ortográfico en lugar de un "
"diccionario, y permanece desactivada salvo que se solicite."

#: src/core/Typeset.cpp:2037
#, kde-format
msgid ""
"Pictures are not drawn. A Markdown image contributes its description in "
"italics, because a caption is more use than an empty frame."
msgstr ""
"Las imágenes no se dibujan. Una imagen de Markdown aporta su descripción en "
"cursiva, porque un pie de imagen es más útil que un marco vacío."

#: src/core/Typeset.cpp:2039
#, kde-format
msgid ""
"Tables are a plain ruled grid: no merged cells, no heading repeated on the "
"following page, and a row is never split across pages."
msgstr ""
"Las tablas son una simple cuadrícula con líneas: sin celdas combinadas, sin "
"encabezado repetido en la página siguiente, y una fila nunca se divide entre "
"páginas."

#: src/core/Typeset.cpp:2041
#, kde-format
msgid ""
"Footnotes, cross-references, an index and a table of contents are not built; "
"Markdown that describes them is set as ordinary text."
msgstr ""
"No se generan notas al pie, referencias cruzadas, un índice alfabético ni un "
"índice; el Markdown que los describe se compone como texto normal."

#: src/core/Typeset.cpp:2043
#, kde-format
msgid ""
"Headers and footers are centred and hold one line, so the page number sits "
"in the middle rather than at the outer edge."
msgstr ""
"Los encabezados y los pies de página van centrados y contienen una sola "
"línea, por lo que el número de página queda en el medio en lugar de en el "
"borde exterior."

#: src/core/Typeset.cpp:2045
#, kde-format
msgid ""
"Text runs from top to bottom and left to right; right-to-left scripts are "
"not laid out."
msgstr ""
"El texto va de arriba abajo y de izquierda a derecha; las escrituras de "
"derecha a izquierda no se maquetan."

