#, kde-format
msgid "One error was found."
msgid_plural "%1 errors were found."
msgstr[0] "Se ha encontrado un error."
msgstr[1] "Se han encontrado %1 errores."

#: src/cli/CommandsPreflight.cpp:281
#, kde-format
msgid ""
"This is a check, not a certification. “preflight limitations” says what it "
"cannot see."
msgstr ""
"Esto es una comprobación, no una certificación. «preflight limitations» "
"indica lo que no puede ver."

#: src/cli/CommandsPreflight.cpp:355
#, kde-format
msgid "There is no repair called “%1”. “preflight fixes” lists them."
msgstr ""
"No existe ninguna reparación llamada «%1». «preflight fixes» las muestra."

#: src/cli/CommandsPreflight.cpp:387
#, kde-format
msgid "Note: the repaired file could not be checked again: %1"
msgstr "Nota: no se ha podido volver a comprobar el archivo reparado: %1"

#: src/cli/CommandsPreflight.cpp:426
#, kde-format
msgid "Nothing found here can be mended automatically."
msgstr "Nada de lo que se ha encontrado aquí se puede reparar automáticamente."

#: src/cli/CommandsPreflight.cpp:429
#, kde-format
msgctxt "@title heading before a list of repairs"
msgid "Repairs:"
msgstr "Reparaciones:"

#: src/cli/CommandsPreflight.cpp:438
#, kde-format
msgid "Checked again after the repairs:"
msgstr "Comprobado de nuevo tras las reparaciones:"

#: src/cli/CommandsPreflight.cpp:443
#, kde-format
msgid "Wrote the report to %1."
msgstr "Se ha escrito el informe en %1."

#: src/cli/CommandsPreflight.cpp:507
#, kde-format
msgctxt "@info how many rules a profile has, and at which severity"
msgid "%1 rules: %2 as errors, %3 as warnings, %4 as notes."
msgstr "%1 reglas: %2 como errores, %3 como advertencias, %4 como notas."

#: src/cli/CommandsPreflight.cpp:513
#, kde-format
msgctxt "@info rules a profile names that this program cannot judge"
msgid "One of them cannot be judged here: %2."
msgid_plural "%1 of them cannot be judged here: %2."
msgstr[0] "Una de ellas no se puede evaluar aquí: %2."
msgstr[1] "%1 de ellas no se pueden evaluar aquí: %2."

#: src/cli/CommandsPreflight.cpp:520
#, kde-format
msgid ""
"Check against one with “preflight FILE --profile ID”, or against a profile "
"of your own by giving its file name instead."
msgstr ""
"Compruebe con uno usando «preflight ARCHIVO --profile ID», o con un perfil "
"propio indicando en su lugar el nombre de su archivo."

#: src/cli/CommandsPreflight.cpp:570
#, kde-format
msgid "The rules of “%1”:"
msgstr "Las reglas de «%1»:"

#: src/cli/CommandsPreflight.cpp:571
#, kde-format
msgid "Every rule this program knows. A profile names the ones it cares about."
msgstr ""
"Todas las reglas que conoce este programa. Un perfil nombra las que le "
"interesan."

#: src/cli/CommandsPreflight.cpp:579
#, kde-format
msgctxt "@info a rule id and the severity a profile gives it"
msgid "%1: %2"
msgstr "%1: %2"

#: src/cli/CommandsPreflight.cpp:588
#, kde-format
msgctxt "@info the number a rule compares against"
msgid "Threshold: %1."
msgstr "Umbral: %1."

#: src/cli/CommandsPreflight.cpp:592
#, kde-format
msgid "Not checked: this program cannot judge it, and says so in the report."
msgstr ""
"No comprobada: este programa no puede evaluarla, y así lo indica en el "
"informe."

#: src/cli/CommandsPreflight.cpp:614
#, kde-format
msgid "Every repair, and what applying it would change:"
msgstr "Todas las reparaciones, y qué cambiaría aplicarlas:"

#: src/cli/CommandsPreflight.cpp:620
#, kde-format
msgid ""
"“preflight FILE --fix -o OUT” applies the ones the findings ask for; “--"
"apply-fix ID” applies one whether anything asked for it or not."
msgstr ""
"«preflight ARCHIVO --fix -o SALIDA» aplica las que piden los hallazgos; «--"
"apply-fix ID» aplica una tanto si algo la ha pedido como si no."

#: src/cli/CommandsPreflight.cpp:637
#, kde-format
msgid "What this check cannot promise:"
msgstr "Lo que esta comprobación no puede garantizar:"

#: src/cli/CommandsPreflight.cpp:649
#, kde-format
msgid ""
"save-profile needs the id of one profile. “preflight profiles” lists them."
msgstr ""
"save-profile necesita el id de un perfil. «preflight profiles» los muestra."

#: src/cli/CommandsPreflight.cpp:654
#, kde-format
msgid "There is no profile called “%1”. “preflight profiles” lists them."
msgstr ""
"No existe ningún perfil llamado «%1». «preflight profiles» los muestra."

#: src/cli/CommandsPreflight.cpp:663
#, kde-format
msgid "Wrote “%1” to %2."
msgstr "Se ha escrito «%1» en %2."

#: src/cli/CommandsPreflight.cpp:664
#, kde-format
msgid "Edit it and check against it with “preflight FILE --profile %1”."
msgstr "Edítelo y compruebe con él usando «preflight ARCHIVO --profile %1»."

#: src/cli/CommandsPreflight.cpp:673
#, kde-format
msgid ""
"Which profile to check against: an id from “preflight profiles”, or a saved "
"profile file."
msgstr ""
"Con qué perfil comprobar: un id de «preflight profiles», o un archivo de "
"perfil guardado."

#: src/cli/CommandsPreflight.cpp:676
#, kde-format
msgid "Apply every repair the findings offer and write the result to -o."
msgstr ""
"Aplicar todas las reparaciones que ofrecen los hallazgos y escribir el "
"resultado en -o."

#: src/cli/CommandsPreflight.cpp:678
#, kde-format
msgid ""
"Apply one named repair, whether or not a finding asked for it. Repeat for "
"more."
msgstr ""
"Aplicar una reparación concreta, tanto si un hallazgo la ha pedido como si "
"no. Repetir para más."

#: src/cli/CommandsPreflight.cpp:680
#, kde-format
msgid "Also write the report itself as a PDF."
msgstr "Escribir también el propio informe como PDF."

#: src/cli/CommandsPreflight.cpp:711
#, kde-format
msgid ""
"preflight needs a file, or one of: profiles, rules, fixes, limitations, save-"
"profile."
msgstr ""
"preflight necesita un archivo, o uno de: profiles, rules, fixes, "
"limitations, save-profile."

#: src/cli/CommandsPreflight.cpp:721
#, kde-format
msgctxt "@info:shell one line of the command list, keep the columns lined up"
msgid ""
"  preflight FILE     [-o OUT]         Check against a profile, and mend "
"faults"
msgstr ""
"  preflight ARCHIVO  [-o SALIDA]      Comprobar con un perfil y reparar "
"fallos"

#: src/cli/CommandsPreflight.cpp:723
#, kde-format
msgctxt "@info:shell one line of the command list, keep the columns lined up"
msgid "  preflight profiles                  List the profiles that ship here"
msgstr ""
"  preflight profiles                  Listar los perfiles que se incluyen "
"aquí"

#: src/cli/CommandsPreflight.cpp:725
#, kde-format
msgctxt "@info:shell one line of the command list, keep the columns lined up"
msgid ""
"  preflight rules                     Every rule, and whether it is checked"
msgstr ""
"  preflight rules                     Todas las reglas, y si se comprueban"

#: src/cli/CommandsPreflight.cpp:727
#, kde-format
msgctxt "@info:shell one line of the command list, keep the columns lined up"
msgid "  preflight fixes                     Every repair and what it changes"
msgstr ""
"  preflight fixes                     Todas las reparaciones y qué cambian"

#: src/cli/CommandsPreflight.cpp:729
#, kde-format
msgctxt "@info:shell one line of the command list, keep the columns lined up"
msgid ""
"  preflight save-profile ID -o FILE   Write a profile out as JSON to edit"
msgstr ""
"  preflight save-profile ID -o ARCHIVO Escribir un perfil como JSON para "
"editarlo"

#: src/cli/CommandsPreflight.cpp:731
#, kde-format
msgctxt "@info:shell one line of the command list, keep the columns lined up"
msgid "  preflight limitations               What this check cannot see"
msgstr ""
"  preflight limitations               Lo que esta comprobación no puede ver"

#: src/cli/CommandsTypeset.cpp:252
#, kde-format
msgid "“%1” says nothing to change."
msgstr "«%1» no indica nada que cambiar."

#: src/cli/CommandsTypeset.cpp:273
#, kde-format
msgid "“%1” is not yes or no."
msgstr "«%1» no es yes ni no."

#: src/cli/CommandsTypeset.cpp:281
#, kde-format
msgid "“%1” is not a length."
msgstr "«%1» no es una longitud."

#: src/cli/CommandsTypeset.cpp:289
#, kde-format
msgid "“%1” needs a font name."
msgstr "«%1» necesita un nombre de tipo de letra."

#: src/cli/CommandsTypeset.cpp:335 src/cli/CommandsTypeset.cpp:548
#, kde-format
msgid "“%1” is not an alignment. Try left, right, centre or justify."
msgstr "«%1» no es una alineación. Pruebe left, right, centre o justify."

#: src/cli/CommandsTypeset.cpp:346
#, kde-format
msgid ""
"“%1” is not something a style has. Try font, size, leading, colour, bold, "
"italic, align, space-before, space-after, indent-first, indent-left, indent-"
"right or keep-with-next."
msgstr ""
"«%1» no es algo que tenga un estilo. Pruebe font, size, leading, colour, "
"bold, italic, align, space-before, space-after, indent-first, indent-left, "
"indent-right o keep-with-next."

#: src/cli/CommandsTypeset.cpp:360
#, kde-format
msgid "“%1” is not a style. The form is body:size=11 or h1:bold,size=20."
msgstr "«%1» no es un estilo. La forma es body:size=11 o h1:bold,size=20."

#: src/cli/CommandsTypeset.cpp:372
#, kde-format
msgid "“%1” is not a part of the document. Use body, or h1 to h6."
msgstr "«%1» no es una parte del documento. Use body, o de h1 a h6."

#: src/cli/CommandsTypeset.cpp:389
#, kde-format
msgid "“%1” is not a length for --%2. Try 12, 12mm or 34pt."
msgstr "«%1» no es una longitud para --%2. Pruebe 12, 12mm o 34pt."

#: src/cli/CommandsTypeset.cpp:413
#, kde-format
msgid ""
"typeset measures paper in millimetres, so its margin is --%1-mm. --%1 is "
"points here as everywhere else, and belongs to the commands that stamp and "
"trim."
msgstr ""
"typeset mide el papel en milímetros, así que su margen es --%1-mm. --%1 son "
"puntos aquí igual que en todas partes, y pertenece a las órdenes que "
"estampan y recortan."

#: src/cli/CommandsTypeset.cpp:462
#, kde-format
msgid ""
"“%1” is not a page size. Try a4, a3, a5, letter, legal, or a pair with its "
"unit written, as 210x297mm or 595x842pt."
msgstr ""
"«%1» no es un tamaño de página. Pruebe a4, a3, a5, letter, legal, o un par "
"con su unidad escrita, como 210x297mm o 595x842pt."

#: src/cli/CommandsTypeset.cpp:493
#, kde-format
msgid "Columns run from 1 to 12."
msgstr "Las columnas van de 1 a 12."

#: src/cli/CommandsTypeset.cpp:583
#, kde-format
msgid "measure needs some text (--text)."
msgstr "measure necesita algo de texto (--text)."

#: src/cli/CommandsTypeset.cpp:600
#, kde-format
msgid "A font size has to be more than nothing."
msgstr "Un tamaño de letra tiene que ser mayor que cero."

#: src/cli/CommandsTypeset.cpp:619
#, kde-format
msgctxt "@info a measured width in points and in millimetres"
msgid "%1 pt (%2 mm)"
msgstr "%1 pt (%2 mm)"

#: src/cli/CommandsTypeset.cpp:656
#, kde-format
msgid "typeset needs a text file, or “-” to read standard input."
msgstr ""
"typeset necesita un archivo de texto, o «-» para leer la entrada estándar."

#: src/cli/CommandsTypeset.cpp:659
#, kde-format
msgid "typeset sets one file at a time."
msgstr "typeset compone un archivo cada vez."

#: src/cli/CommandsTypeset.cpp:677
#, kde-format
msgid "Reading from standard input needs an output file (-o)."
msgstr "Leer de la entrada estándar necesita un archivo de salida (-o)."

#: src/cli/CommandsTypeset.cpp:698
#, kde-format
msgid "Standard input could not be read."
msgstr "No se ha podido leer la entrada estándar."

#: src/cli/CommandsTypeset.cpp:730
#, kde-format
msgid "Set %1 paragraph."
msgid_plural "Set %1 paragraphs."
