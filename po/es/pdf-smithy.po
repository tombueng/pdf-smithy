msgid_plural "%1 things to put right."
msgstr[0] "%1 cosa que corregir."
msgstr[1] "%1 cosas que corregir."

#: src/cli/CommandsFonts.cpp:357
#, kde-format
msgid "fonts embed needs a font to embed, as --font “DejaVu Sans”."
msgstr ""
"fonts embed necesita un tipo de letra que incrustar, como --font «DejaVu "
"Sans»."

#: src/cli/CommandsFonts.cpp:360 src/cli/CommandsFonts.cpp:511
#, kde-format
msgid "“%1” is not a cut. Use bold, italic, bold-italic or regular."
msgstr ""
"«%1» no es un corte de la familia. Use bold, italic, bold-italic o regular."

#: src/cli/CommandsFonts.cpp:366
#, kde-format
msgid ""
"fonts embed needs the characters to put in, as --text “Müller”. Only those "
"go in, which is what keeps the document from growing by a whole font."
msgstr ""
"fonts embed necesita los caracteres que se van a incluir, como --text "
"«Müller». Solo entran esos, que es lo que evita que el documento crezca en "
"todo un tipo de letra."

#: src/cli/CommandsFonts.cpp:375
#, kde-format
msgid ""
"No font called “%1” that could be embedded is installed on this system. "
"“fonts find” says what is there."
msgstr ""
"En este sistema no hay instalado ningún tipo de letra llamado «%1» que se "
"pueda incrustar. «fonts find» dice lo que hay."

#: src/cli/CommandsFonts.cpp:406
#, kde-format
msgctxt "@info page, font, the /Fx name it got, glyph count and size"
