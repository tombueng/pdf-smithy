msgstr "información de la página"

#: src/cli/CommandsLayout.cpp:606 src/ui/ToolLayoutDialog.cpp:933
#, kde-format
msgid "Added %1, %2 mm outside the trim."
msgstr "Se han añadido %1, a %2 mm fuera del corte."

#: src/cli/CommandsLayout.cpp:624
#, kde-format
msgid ""
"“%1” is not a place to cut. Give a fraction between 0 and 1, for example 0.5 "
"for the middle."
msgstr ""
"«%1» no es un lugar por donde cortar. Indique una fracción entre 0 y 1, por "
"ejemplo 0.5 para la mitad."

#: src/cli/CommandsLayout.cpp:643
#, kde-format
msgctxt "@info"
msgid "Cut %1 page in two."
msgid_plural "Cut %1 pages in two."
msgstr[0] "Se ha cortado %1 página en dos."
msgstr[1] "Se han cortado %1 páginas en dos."

#: src/cli/CommandsLayout.cpp:644
#, kde-format
msgid "Left half first, then the right. Wrote %1."
msgstr "Primero la mitad izquierda, después la derecha. Se ha escrito %1."

#: src/cli/CommandsLayout.cpp:645
#, kde-format
msgid "Top half first, then the bottom. Wrote %1."
msgstr "Primero la mitad superior, después la inferior. Se ha escrito %1."

#: src/cli/CommandsLayout.cpp:653
#, kde-format
msgid "layout overlay needs two files: the document, then what to lay over it."
msgstr ""
"layout overlay necesita dos archivos: el documento y, después, lo que se "
"superpone a él."

#: src/cli/CommandsLayout.cpp:658 src/cli/Common.cpp:46 src/cli/main.cpp:74
#: src/core/Archival.cpp:606 src/core/Compressor.cpp:208
