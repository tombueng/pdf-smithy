#, kde-format
msgid "“%1” is not a border. Use solid, dashed, beveled, inset or underline."
msgstr "«%1» no es un borde. Use solid, dashed, beveled, inset o underline."

#: src/cli/CommandsForm.cpp:257 src/cli/CommandsForm.cpp:573
#, kde-format
msgid "“%1” is not an alignment. Use left, centre or right."
msgstr "«%1» no es una alineación. Use left, centre o right."

#: src/cli/CommandsForm.cpp:286
#, kde-format
msgid ""
"Say where the field goes and how big it is, e.g. --at 72,700 --size 200x18."
msgstr ""
"Indique dónde va el campo y qué tamaño tiene, p. ej. --at 72,700 --size "
"200x18."

#: src/cli/CommandsForm.cpp:292
#, kde-format
msgid "Give one --size for them all, or one for every --at."
msgstr "Indique un solo --size para todos, o uno por cada --at."

#: src/cli/CommandsForm.cpp:299 src/cli/CommandsForm.cpp:860
#, kde-format
msgid ""
"“%1” is not a place. The form is X,Y, in points from the bottom-left corner "
"of the page as it is shown."
msgstr ""
"«%1» no es una posición. El formato es X,Y, en puntos desde la esquina "
"inferior izquierda de la página tal como se muestra."

#: src/cli/CommandsForm.cpp:307 src/cli/CommandsForm.cpp:867
#: src/cli/CommandsForm.cpp:887
#, kde-format
msgid "“%1” is not a size. The form is WIDTHxHEIGHT, in points."
msgstr "«%1» no es un tamaño. El formato es ANCHOxALTO, en puntos."

#: src/cli/CommandsForm.cpp:327
#, kde-format
msgid ""
"Say what kind of field with --type: text, password, checkbox, radio, choice, "
"list, button or signature."
msgstr ""
"Indique qué tipo de campo con --type: text, password, checkbox, radio, "
"choice, list, button o signature."

#: src/cli/CommandsForm.cpp:332
#, kde-format
msgid ""
"“%1” is not a kind of field. Use text, password, checkbox, radio, choice, "
"list, button or signature."
msgstr ""
"«%1» no es un tipo de campo. Use text, password, checkbox, radio, choice, "
"list, button o signature."

#: src/cli/CommandsForm.cpp:340
#, kde-format
msgid ""
"Give the field a name with --name. That is the name filling in addresses, "
"and a full stop in it makes a group: “Address.Street” and “Address.Town” "
"belong together."
msgstr ""
"Dé un nombre al campo con --name. Ese es el nombre que se usa al rellenar "
"direcciones, y un punto dentro de él crea un grupo: «Direccion.Calle» y "
"«Direccion.Ciudad» van juntos."

#: src/cli/CommandsForm.cpp:348 src/cli/CommandsForm.cpp:922
#: src/cli/CommandsImages.cpp:67 src/cli/CommandsLayout.cpp:708
