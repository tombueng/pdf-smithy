msgid "%1 object, topmost first."
msgid_plural "%1 objects, topmost first."
msgstr[0] "%1 objeto, empezando por el de más arriba."
msgstr[1] "%1 objetos, empezando por el de más arriba."

#: src/cli/CommandsObjects.cpp:557
#, kde-format
msgid ""
"Say how far with --by DX,DY, in points. Positive numbers move right and up."
msgstr ""
"Indique cuánto con --by DX,DY, en puntos. Los números positivos mueven a la "
"derecha y hacia arriba."

#: src/cli/CommandsObjects.cpp:571
#, kde-format
msgid ""
"Say how much with --by FACTOR, e.g. 1.5, or --by FX,FY to stretch one way "
"only."
msgstr ""
"Indique cuánto con --by FACTOR, p. ej. 1.5, o --by FX,FY para estirar en una "
"sola dirección."

#: src/cli/CommandsObjects.cpp:575
#, kde-format
msgid "A factor of zero would flatten the object out of existence."
msgstr "Un factor de cero aplastaría el objeto hasta hacerlo desaparecer."

#: src/cli/CommandsObjects.cpp:583
#, kde-format
msgid "Say how far round with --angle DEGREES, counter-clockwise."
msgstr "Indique cuánto girar con --angle GRADOS, en sentido antihorario."

#: src/cli/CommandsObjects.cpp:709 src/cli/CommandsObjects.cpp:835
#, kde-format
msgid "“%1” is not a line width in points."
msgstr "«%1» no es un grosor de línea en puntos."

#: src/cli/CommandsObjects.cpp:714
#, kde-format
msgid "Say what to change: --fill, --stroke or --line-width."
msgstr "Indique qué cambiar: --fill, --stroke o --line-width."

#: src/cli/CommandsObjects.cpp:780
#, kde-format
msgid ""
"Say what to insert with --shape: text, image, rectangle, ellipse or line."
msgstr ""
"Indique qué insertar con --shape: text, image, rectangle, ellipse o line."

#: src/cli/CommandsObjects.cpp:785
#, kde-format
msgid ""
"Say where with --rect X,Y,WIDTH,HEIGHT, in points from the bottom-left "
"corner of the page."
msgstr ""
"Indique dónde con --rect X,Y,ANCHO,ALTO, en puntos desde la esquina inferior "
"izquierda de la página."

#: src/cli/CommandsObjects.cpp:796
#, kde-format
msgid "Say what it should read with --text."
msgstr "Indique qué debe decir con --text."

#: src/cli/CommandsObjects.cpp:806
#, kde-format
msgid "“%1” is not a text size in points."
msgstr "«%1» no es un tamaño de texto en puntos."

#: src/cli/CommandsObjects.cpp:814
#, kde-format
msgid "Say which picture with --image."
msgstr "Indique qué imagen con --image."

#: src/cli/CommandsObjects.cpp:818 src/cli/main.cpp:414
#: src/ui/SignEditor.cpp:271 src/ui/WatermarkEditor.cpp:330
#, kde-format
msgid "“%1” could not be read as an image."
msgstr "No se ha podido leer «%1» como imagen."

#: src/cli/CommandsObjects.cpp:847
#, kde-format
msgid ""
"“%1” is not a place. The form is X,Y,WIDTH,HEIGHT, in points from the bottom-"
"left corner of the page."
msgstr ""
"«%1» no es un lugar. La forma es X,Y,ANCHO,ALTO, en puntos desde la esquina "
"inferior izquierda de la página."

#: src/cli/CommandsObjects.cpp:862
#, kde-format
msgctxt "@title heading before a list"
msgid "Reading a page as objects:"
msgstr "Leer una página como objetos:"

#: src/cli/CommandsObjects.cpp:866
#, kde-format
msgctxt "@title heading before a list"
msgid "Changing what is on a page:"
msgstr "Cambiar lo que hay en una página:"

#: src/cli/CommandsObjects.cpp:879
#, kde-format
msgid ""
"Which object, by the number “objects list” prints. Repeat, or separate with "
"commas, to change several at once."
msgstr ""
"Qué objeto, por el número que muestra «objects list». Repita la opción, o "
"separe con comas, para cambiar varios a la vez."

#: src/cli/CommandsObjects.cpp:883
#, kde-format
msgid "How far to move, as DX,DY in points, or how much to scale, as a factor."
msgstr "Cuánto mover, como DX,DY en puntos, o cuánto escalar, como un factor."

#: src/cli/CommandsObjects.cpp:886
#, kde-format
msgid ""
"Point to scale or turn around, as X,Y in points from the bottom-left corner. "
"Without it, each object uses its own middle."
msgstr ""
"Punto alrededor del cual escalar o girar, como X,Y en puntos desde la "
"esquina inferior izquierda. Sin él, cada objeto usa su propio centro."

#: src/cli/CommandsObjects.cpp:890
#, kde-format
msgid "Fill colour, a name or #rrggbb. For text, the colour of the letters."
msgstr ""
"Color de relleno, un nombre o #rrggbb. En el texto, el color de las letras."

#: src/cli/CommandsObjects.cpp:891
#, kde-format
msgid "Outline colour, a name or #rrggbb."
msgstr "Color del contorno, un nombre o #rrggbb."

#: src/cli/CommandsObjects.cpp:892
#, kde-format
msgid "Outline width in points."
msgstr "Grosor del contorno en puntos."

#: src/cli/CommandsObjects.cpp:893
#, kde-format
msgid "What to insert: text, image, rectangle, ellipse or line."
msgstr "Qué insertar: text, image, rectangle, ellipse o line."

#: src/cli/CommandsObjects.cpp:897
#, kde-format
msgid ""
"Where it goes, as X,Y,WIDTH,HEIGHT in points from the bottom-left corner of "
"the page. Repeat to insert several."
msgstr ""
"Dónde va, como X,Y,ANCHO,ALTO en puntos desde la esquina inferior izquierda "
"de la página. Repita la opción para insertar varios."

#: src/cli/CommandsObjects.cpp:903
#, kde-format
msgid "Standard font for inserted text: Helvetica, Times-Roman or Courier."
msgstr ""
"Tipo de letra estándar para el texto insertado: Helvetica, Times-Roman o "
"Courier."

#: src/cli/CommandsObjects.cpp:915
#, kde-format
msgid "Everything drawn on the page, with the number to grab it by"
msgstr "Todo lo dibujado en la página, con el número por el que tomarlo"

#: src/cli/CommandsObjects.cpp:916
#, kde-format
msgid "What is under a point, topmost first"
msgstr "Lo que hay bajo un punto, empezando por el de más arriba"

#: src/cli/CommandsObjects.cpp:917
#, kde-format
msgid "Shift an object across the page"
msgstr "Desplazar un objeto por la página"

#: src/cli/CommandsObjects.cpp:918
#, kde-format
msgid "Make an object larger or smaller"
msgstr "Hacer un objeto más grande o más pequeño"

#: src/cli/CommandsObjects.cpp:919
#, kde-format
msgid "Turn an object, counter-clockwise"
msgstr "Girar un objeto, en sentido antihorario"

#: src/cli/CommandsObjects.cpp:920
#, kde-format
msgid "Take an object off the page for good"
msgstr "Quitar un objeto de la página de forma definitiva"

#: src/cli/CommandsObjects.cpp:921
#, kde-format
msgid "Change the colours or the line width"
msgstr "Cambiar los colores o el grosor de la línea"

#: src/cli/CommandsObjects.cpp:922
#, kde-format
msgid "Put text, a picture or a shape on the page"
msgstr "Poner texto, una imagen o una forma en la página"

#: src/cli/CommandsObjects.cpp:923
#, kde-format
msgid "What reading and editing objects cannot reach"
msgstr "Lo que leer y editar objetos no puede alcanzar"

#: src/cli/CommandsObjects.cpp:937
#, kde-format
msgid ""
"Say what to do: objects list, at, move, scale, rotate, delete, restyle, "
"insert or limits."
msgstr ""
"Indique qué hacer: objects list, at, move, scale, rotate, delete, restyle, "
"insert o limits."

#: src/cli/CommandsObjects.cpp:968
#, kde-format
msgid ""
"“objects %1” is not a command. Try list, at, move, scale, rotate, delete, "
"restyle, insert or limits."
msgstr ""
"«objects %1» no es una orden. Pruebe list, at, move, scale, rotate, delete, "
"restyle, insert o limits."

#: src/cli/CommandsPreflight.cpp:73
