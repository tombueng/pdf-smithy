msgid_plural "%1 places more are not listed; --json lists them all."
msgstr[0] "No se muestra un lugar más; --json los muestra todos."
msgstr[1] "No se muestran %1 lugares más; --json los muestra todos."

#: src/cli/CommandsPreflight.cpp:241
#, kde-format
msgctxt "@info a repair exists for this finding"
msgid "Can be mended by --fix (%1)."
msgstr "Se puede reparar con --fix (%1)."

#: src/cli/CommandsPreflight.cpp:249
#, kde-format
msgctxt ""
"@info the document that was checked and the profile it was checked against"
msgid "%1 checked against “%2” (%3)."
msgstr "%1 comprobado con «%2» (%3)."

#: src/cli/CommandsPreflight.cpp:268
#, kde-format
msgctxt "@title:group rules the profile names that this program cannot judge"
msgid "Asked for but not checked (%1)"
msgstr "Solicitadas pero no comprobadas (%1)"

#: src/cli/CommandsPreflight.cpp:274
#, kde-format
msgid "Nothing above says anything about these either way."
msgstr ""
"Nada de lo anterior dice nada sobre estas, ni en un sentido ni en otro."

#: src/cli/CommandsPreflight.cpp:278 src/core/Preflight.cpp:2876
#, kde-format
msgid "No errors were found among the rules that were checked."
msgstr "No se ha encontrado ningún error entre las reglas comprobadas."

