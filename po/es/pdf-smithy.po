#: src/cli/main.cpp:2039
#, kde-format
msgid "Which pages, e.g. 1-3,last. Default: all."
msgstr "Qué páginas, p. ej. 1-3,last. Predeterminado: all."

#: src/cli/main.cpp:2042
#, kde-format
msgid "Fit images into a4, a3, a5, letter or legal."
msgstr "Ajustar las imágenes a a4, a3, a5, letter o legal."

#: src/cli/main.cpp:2043
#, kde-format
msgid "Resolution for image export, in dots per inch."
msgstr "Resolución para la exportación de imágenes, en puntos por pulgada."

#: src/cli/main.cpp:2045
#, kde-format
msgid "Image format: png, jpeg or tiff."
msgstr "Formato de imagen: png, jpeg o tiff."

#: src/cli/main.cpp:2048
#, kde-format
msgid "JPEG quality when importing, 0 keeps the pixels."
msgstr "Calidad JPEG al importar; 0 conserva los píxeles."

#: src/cli/main.cpp:2051
#, kde-format
msgid "Strip metadata, JavaScript and embedded files."
msgstr "Eliminar los metadatos, el JavaScript y los archivos incrustados."

#: src/cli/main.cpp:2052
#, kde-format
msgid "Password to set."
msgstr "Contraseña a establecer."

#: src/cli/main.cpp:2055
#, kde-format
msgid "Password the input already has, if any."
msgstr "Contraseña que ya tiene la entrada, si la hay."

#: src/cli/main.cpp:2057
#, kde-format
msgid "Remove the password instead of setting one."
msgstr "Quitar la contraseña en lugar de establecer una."

#: src/cli/main.cpp:2058
#, kde-format
msgid "Ask readers not to print."
msgstr "Pedir a los lectores que no impriman."

#: src/cli/main.cpp:2059
#, kde-format
msgid "Ask readers not to copy text."
msgstr "Pedir a los lectores que no copien el texto."

#: src/cli/main.cpp:2060
#, kde-format
msgid "Split wherever a bookmark starts."
msgstr "Dividir allí donde empiece un marcador."

#: src/cli/main.cpp:2063
#, kde-format
msgid ""
"A colour profile to embed: sRGB for “archive”, a CMYK printing condition for "
"“to-pdfx”. Leave out to look for one on the system."
msgstr ""
"Un perfil de color a incrustar: sRGB para «archive», una condición de "
"impresión CMYK para «to-pdfx». Omítalo para buscar uno en el sistema."

#: src/cli/main.cpp:2066
#, kde-format
msgid "Document title to write."
msgstr "Título del documento a escribir."

#: src/cli/main.cpp:2068
#, kde-format
msgid "Document author to write."
msgstr "Autor del documento a escribir."

#: src/cli/main.cpp:2072
#, kde-format
msgid ""
"How different two pixels may be before they count as changed, in levels of "
"brightness out of 255. On “colour replace” it is a distance in colour "
"between 0 and 1."
msgstr ""
"Cuánto pueden diferir dos píxeles antes de contar como cambiados, en niveles "
"de brillo sobre 255. En «colour replace» es una distancia de color entre 0 y "
"1."

#: src/cli/main.cpp:2076
#, kde-format
msgid "Treat a different line break as a change."
msgstr "Considerar un salto de línea distinto como un cambio."

#: src/cli/main.cpp:2078
#, kde-format
msgid "Write a side-by-side picture of one page, with -o."
msgstr ""
"Escribir una imagen de una página, la original y la nueva lado a lado, con "
"-o."

#: src/cli/main.cpp:2080
#, kde-format
msgid "Folder to write the finished files into."
msgstr "Carpeta donde escribir los archivos terminados."

#: src/cli/main.cpp:2083
#, kde-format
msgid ""
"What to do to each file: compress, sanitize, flatten-comments, flatten-form "
"or ocr."
msgstr ""
"Qué hacer con cada archivo: compress, sanitize, flatten-comments, flatten-"
"form u ocr."

#: src/cli/main.cpp:2087
#, kde-format
msgid "Replace a line, as PAGE:LINE=New text. Repeat for more."
msgstr "Sustituir una línea, como PÁGINA:LÍNEA=Texto nuevo. Repita para más."

#: src/cli/main.cpp:2089
#, kde-format
msgid "Which page to list the text of."
msgstr "De qué página listar el texto."

#: src/cli/main.cpp:2092
#, kde-format
msgid "Fill in a field, as NAME=VALUE. Repeat for more."
msgstr "Rellenar un campo, como NOMBRE=VALOR. Repita para más."

#: src/cli/main.cpp:2094
#, kde-format
msgid "Add a bookmark, as PAGE:Title. Repeat for more."
msgstr "Añadir un marcador, como PÁGINA:Título. Repita para más."

#: src/cli/main.cpp:2096
#, kde-format
msgid "Replace the table of contents from a JSON file, as --json writes it."
msgstr ""
"Sustituir el índice a partir de un archivo JSON, tal como lo escribe --json."

#: src/cli/main.cpp:2099
#, kde-format
msgid "Write the comments to an XFDF file, without the document."
msgstr "Escribir los comentarios en un archivo XFDF, sin el documento."

#: src/cli/main.cpp:2102
#, kde-format
msgid "Read comments from an XFDF file and add them."
msgstr "Leer los comentarios de un archivo XFDF y añadirlos."

#: src/cli/main.cpp:2103
#, kde-format
msgid "Show the comments instead of changing them."
msgstr "Mostrar los comentarios en lugar de cambiarlos."

#: src/cli/main.cpp:2105
#, kde-format
msgid "Highlight an area, as PAGE:X,Y,WIDTH,HEIGHT. Repeat for more."
msgstr "Resaltar un área, como PÁGINA:X,Y,ANCHO,ALTO. Se puede repetir."

#: src/cli/main.cpp:2107
#, kde-format
msgid "Put a note marker at PAGE:X,Y. Repeat for more."
msgstr "Colocar una marca de nota en PÁGINA:X,Y. Se puede repetir."

#: src/cli/main.cpp:2112
#, kde-format
msgid "Take every comment out, leaving form fields alone."
msgstr "Quitar todos los comentarios, sin tocar los campos de formulario."

#: src/cli/main.cpp:2113
#, kde-format
msgid "Name to put on the comment."
msgstr "Nombre que figurará en el comentario."

#: src/cli/main.cpp:2116
#, kde-format
msgid "Draw the comments into the pages and remove them."
msgstr "Dibujar los comentarios en las páginas y quitarlos."

#: src/cli/main.cpp:2118
#, kde-format
msgid "How many pages go on one sheet, e.g. 2, 4 or 9."
msgstr "Cuántas páginas van en una hoja, p. ej. 2, 4 o 9."

#: src/cli/main.cpp:2120
#, kde-format
msgid "Exact arrangement as COLUMNSxROWS, e.g. 2x3."
msgstr "Disposición exacta como COLUMNASxFILAS, p. ej. 2x3."

#: src/cli/main.cpp:2122
#, kde-format
msgid "Gap between the slots, in points."
msgstr "Espacio entre los huecos, en puntos."

#: src/cli/main.cpp:2125
#, kde-format
msgid "Empty border around the sheet, in points."
msgstr "Borde vacío alrededor de la hoja, en puntos."

#: src/cli/main.cpp:2127
#, kde-format
msgid "Draw a hairline around each slot."
msgstr "Dibujar una línea muy fina alrededor de cada hueco."

#: src/cli/main.cpp:2128
#, kde-format
msgid "Fill downwards before moving right."
msgstr "Rellenar hacia abajo antes de pasar a la derecha."

#: src/cli/main.cpp:2130
#, kde-format
msgid ""
"Area to redact, as PAGE:X,Y,WIDTH,HEIGHT in points from the bottom-left "
"corner. Repeat for more."
msgstr ""
"Área a censurar, como PÁGINA:X,Y,ANCHO,ALTO en puntos desde la esquina "
"inferior izquierda. Se puede repetir."

#: src/cli/main.cpp:2134
#, kde-format
msgid "Leave the gap open instead of painting it black."
msgstr "Dejar el hueco abierto en lugar de pintarlo de negro."

#: src/cli/main.cpp:2135
#, kde-format
msgid "Find the empty border and trim it."
msgstr "Encontrar el borde vacío y recortarlo."

#: src/cli/main.cpp:2136
#, kde-format
msgid "Remove the crop instead of setting one."
msgstr "Quitar el recorte en lugar de establecer uno."

#: src/cli/main.cpp:2137
#, kde-format
msgid "Points to trim from the left."
msgstr "Puntos que se recortan por la izquierda."

#: src/cli/main.cpp:2139
#, kde-format
msgid "Points to trim from the right."
msgstr "Puntos que se recortan por la derecha."

#: src/cli/main.cpp:2141
#, kde-format
msgid "Points to trim from the top."
msgstr "Puntos que se recortan por arriba."

#: src/cli/main.cpp:2143
#, kde-format
msgid "Points to trim from the bottom."
msgstr "Puntos que se recortan por abajo."

#: src/cli/main.cpp:2145
#, kde-format
msgid "Prefix for Bates numbering, e.g. ACME-."
msgstr "Prefijo para la numeración Bates, p. ej. ACME-."

#: src/cli/main.cpp:2147
#, kde-format
msgid "Zero padding for the Bates number."
msgstr "Relleno con ceros del número Bates."

#: src/cli/main.cpp:2149
#, kde-format
msgid "Number the first stamped page as this."
msgstr "Número que se asigna a la primera página sellada."

#: src/cli/main.cpp:2151
#, kde-format
msgid "Text size in points."
msgstr "Tamaño del texto en puntos."

#: src/cli/main.cpp:2155
#, kde-format
msgid "Recognise text even on pages that already have some."
msgstr "Reconocer el texto incluso en páginas que ya lo tienen."

#: src/cli/main.cpp:2297
#, kde-format
msgid "This build has no OCR support."
msgstr "Esta versión del programa no admite OCR."

#: src/cli/main.cpp:2310
#, kde-format
msgid "Unknown command “%1”."
msgstr "Orden «%1» desconocida."

#: src/core/Annotation.cpp:475
#, kde-format
msgid "There is nothing to add."
msgstr "No hay nada que añadir."

#: src/core/Annotation.cpp:895 src/ui/MainWindow.cpp:1916
#, kde-format
msgid "This document has no comments to write out."
msgstr "Este documento no tiene comentarios que escribir."

#: src/core/Annotation.cpp:921
#, kde-format
msgid "“%1” could not be opened for writing."
msgstr "No se ha podido abrir «%1» para escritura."

#: src/core/Annotation.cpp:1147
#, kde-format
msgid "“%1” is not a valid XFDF file: %2"
msgstr "«%1» no es un archivo XFDF válido: %2"

#: src/core/Annotation.cpp:1153
#, kde-format
msgid "“%1” holds no comments this can use."
msgstr "«%1» no contiene comentarios que se puedan usar aquí."

#: src/core/Annotation.cpp:1159
#, kde-format
msgid "One comment names a page this document does not have and was left out."
msgid_plural ""
"%1 comments name pages this document does not have and were left out."
msgstr[0] ""
"Un comentario menciona una página que este documento no tiene y se ha "
"omitido."
msgstr[1] ""
"%1 comentarios mencionan páginas que este documento no tiene y se han "
"omitido."

#: src/core/Archival.cpp:130 src/core/Preflight.cpp:327
#, kde-format
msgctxt "@item a font the file does not name"
msgid "an unnamed font"
msgstr "un tipo de letra sin nombre"

#: src/core/Archival.cpp:348
#, kde-format
msgid ""
"The document is encrypted. An archive has to be able to open it in fifty "
"years' time, without a password, so PDF/A does not allow that."
msgstr ""
"El documento está cifrado. Un archivo documental tiene que poder abrirlo "
"dentro de cincuenta años, sin contraseña, así que PDF/A no lo permite."

#: src/core/Archival.cpp:351
#, kde-format
msgid ""
"The document contains scripts, or an action that runs when it is opened. PDF/"
"A allows neither."
msgstr ""
"El documento contiene scripts o una acción que se ejecuta al abrirlo. PDF/A "
"no permite ninguna de las dos cosas."

#: src/core/Archival.cpp:354
#, kde-format
msgid "The document carries other files inside it. Only PDF/A-3 allows that."
msgstr "El documento lleva otros archivos dentro. Solo PDF/A-3 lo permite."

#: src/core/Archival.cpp:361
#, kde-format
msgctxt "@item separator in a list of font names"
msgid ", "
msgstr ", "

#: src/core/Archival.cpp:356
#, kde-format
msgid ""
"%1 font is not embedded (%2), so its text will be set in whatever the reader "
"happens to have instead."
msgid_plural ""
"%1 fonts are not embedded (%2), so their text will be set in whatever the "
"reader happens to have instead."
msgstr[0] ""
"%1 tipo de letra no está incrustado (%2), así que su texto se compondrá con "
"lo que tenga a mano el lector."
msgstr[1] ""
"%1 tipos de letra no están incrustados (%2), así que su texto se compondrá "
"con lo que tenga a mano el lector."

#: src/core/Archival.cpp:363 src/core/Preflight.cpp:1592
#, kde-format
msgid ""
"The document has no output intent, so nothing in it says what its colours "
"are meant to look like."
msgstr ""
"El documento no tiene intención de salida, así que nada en él dice qué "
"aspecto deben tener sus colores."

#: src/core/Archival.cpp:373
#, kde-format
msgid "The password protection was removed, because PDF/A does not allow it."
msgstr ""
"Se ha quitado la protección por contraseña, porque PDF/A no la permite."

#: src/core/Archival.cpp:375
#, kde-format
msgid "Scripts and actions that run on their own were removed."
msgstr ""
"Se han quitado los scripts y las acciones que se ejecutan por sí solas."

#: src/core/Archival.cpp:377
#, kde-format
msgid ""
"The files carried inside the document were dropped. Convert to PDF/A-3 if "
"they matter."
msgstr ""
"Se han descartado los archivos que el documento llevaba dentro. Convierta a "
"PDF/A-3 si son importantes."

#: src/core/Archival.cpp:379
#, kde-format
msgid ""
"The fonts were embedded, so the text keeps its shape on a machine that does "
"not have them."
msgstr ""
"Se han incrustado los tipos de letra, así que el texto conserva su forma en "
"una máquina que no los tenga."

#: src/core/Archival.cpp:381
#, kde-format
msgid ""
"An sRGB output intent was added, so the colours are stated rather than "
"assumed."
msgstr ""
"Se ha añadido una intención de salida sRGB, así que los colores quedan "
"declarados en lugar de supuestos."

