msgstr ""
"Los programas de tipo de letra incrustados suman %1 de un archivo de %2."

#: src/ui/ToolFontsDialog.cpp:418
#, kde-format
msgctxt "@info"
msgid ""
"%1 says nothing anywhere about what its character codes mean, so its text "
"cannot be edited."
msgstr ""
"%1 no dice en ninguna parte qué significan sus códigos de carácter, por lo "
"que su texto no se puede editar."

#: src/ui/ToolFontsDialog.cpp:427
#, kde-format
msgid "One thing to put right:"
msgid_plural "%1 things to put right:"
msgstr[0] "Una cosa que corregir:"
msgstr[1] "%1 cosas que corregir:"

