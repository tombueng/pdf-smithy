msgstr[1] ""
"%1 de ellas están por encima de %2 dpi y ocupan %3, más de lo que mostrará "
"cualquier impresora."

#: src/cli/CommandsImages.cpp:360
#, kde-format
msgid "“images resample %1 --max-dpi 150 -o smaller.pdf” brings them down."
msgstr "«images resample %1 --max-dpi 150 -o smaller.pdf» las reduce."

#: src/cli/CommandsImages.cpp:387
#, kde-format
msgid ""
"JPEG 2000 cannot be written. Use --format jpeg, or --format keep to re-pack "
"the pixels without any loss at all."
msgstr ""
"No se puede escribir JPEG 2000. Use --format jpeg, o --format keep para "
"volver a empaquetar los píxeles sin ninguna pérdida."

#: src/cli/CommandsImages.cpp:392
#, kde-format
msgid "“%1” is not a picture format here. Use jpeg or keep."
msgstr "«%1» no es un formato de imagen válido aquí. Use jpeg o keep."

#: src/cli/CommandsImages.cpp:407
#, kde-format
msgid ""
"Left %1 picture alone: its pixels are stored in a form this cannot open."
msgid_plural ""
"Left %1 pictures alone: their pixels are stored in a form this cannot open."
msgstr[0] ""
"Se ha dejado %1 imagen sin tocar: sus píxeles están guardados en un formato "
"que esto no puede abrir."
msgstr[1] ""
"Se han dejado %1 imágenes sin tocar: sus píxeles están guardados en un "
"formato que esto no puede abrir."

#: src/cli/CommandsImages.cpp:416
#, kde-format
msgid "No picture needed re-encoding, so %1 is a copy of the original."
msgstr ""
"Ninguna imagen ha necesitado recodificarse, por lo que %1 es una copia del "
"original."

#: src/cli/CommandsImages.cpp:423 src/ui/ToolImagesDialog.cpp:864
#, kde-format
msgid "%1 left the picture streams."
msgstr "Los flujos de imagen han perdido %1."

#: src/cli/CommandsImages.cpp:465
#, kde-format
msgid "Re-packing at up to %1 dpi, with no loss of quality at all."
msgstr "Volviendo a empaquetar hasta %1 dpi, sin ninguna pérdida de calidad."

#: src/cli/CommandsImages.cpp:469
#, kde-format
msgid "Re-encoding at up to %1 dpi, quality %2."
msgstr "Recodificando hasta %1 dpi, calidad %2."

#: src/cli/CommandsImages.cpp:474
#, kde-format
msgid "A lower --dpi or --quality would give it something to work with."
msgstr "Un --dpi o un --quality más bajos le darían margen para trabajar."

#: src/cli/CommandsImages.cpp:481
#, kde-format
msgid ""
"How fine should the pictures still be? Give --max-dpi, for example 150 for "
"reading on screen or 300 for printing."
msgstr ""
"¿Con cuánto detalle deben quedar las imágenes? Indique --max-dpi, por "
"ejemplo 150 para leer en pantalla o 300 para imprimir."

#: src/cli/CommandsImages.cpp:490
#, kde-format
msgid "--max-dpi has to be more than zero."
msgstr "--max-dpi tiene que ser mayor que cero."

#: src/cli/CommandsImages.cpp:520
#, kde-format
msgid "Every picture is already at or below %1 dpi."
msgstr "Todas las imágenes ya están en %1 dpi o por debajo."

#: src/cli/CommandsImages.cpp:535
#, kde-format
msgid "Which picture should go in? Give --with a file."
msgstr "¿Qué imagen debe entrar? Indique un archivo con --with."

#: src/cli/CommandsImages.cpp:539 src/ui/ToolImagesDialog.cpp:599
#: src/ui/ToolObjectsDialog.cpp:1275
#, kde-format
msgid "“%1” could not be read as a picture."
msgstr "No se ha podido leer «%1» como imagen."

#: src/cli/CommandsImages.cpp:552
#, kde-format
msgid "Page %1 now draws %2, in the place the old picture had."
msgstr ""
"La página %1 dibuja ahora %2, en el lugar que ocupaba la imagen anterior."

#: src/cli/CommandsImages.cpp:554 src/ui/ToolImagesDialog.cpp:617
#, kde-format
msgid "It was stretched to fill that place exactly."
msgstr "Se ha estirado para llenar ese lugar exactamente."

#: src/cli/CommandsImages.cpp:569
#, kde-format
msgid "By how much? Give --angle 90, or any number of degrees."
msgstr "¿Cuánto? Indique --angle 90, o cualquier número de grados."

#: src/cli/CommandsImages.cpp:574
#, kde-format
msgid "“%1” is not an angle in degrees."
msgstr "«%1» no es un ángulo en grados."

#: src/cli/CommandsImages.cpp:592 src/ui/ToolImagesDialog.cpp:644
#, kde-format
msgid "Turned %2 on page %3 by %4°, in one place."
msgid_plural "Turned %2 on page %3 by %4°, in %1 places."
msgstr[0] "Se ha girado %2 %4° en la página %3, en un lugar."
msgstr[1] "Se ha girado %2 %4° en la página %3, en %1 lugares."

#: src/cli/CommandsImages.cpp:596 src/ui/ToolImagesDialog.cpp:648
#, kde-format
msgid "Not one stored byte of the picture was rewritten."
msgstr "No se ha reescrito ni un solo byte almacenado de la imagen."

#: src/cli/CommandsImages.cpp:599
#, kde-format
msgctxt "@info a caveat on the command line"
msgid "Note: "
msgstr "Nota: "

#: src/cli/CommandsImages.cpp:623 src/ui/ToolImagesDialog.cpp:688
#, kde-format
msgid "Page %1 no longer draws %2."
msgstr "La página %1 ya no dibuja %2."

#: src/cli/CommandsImages.cpp:650
#, kde-format
msgid "--brightness and --contrast run from -1 to 1."
msgstr "--brightness y --contrast van de -1 a 1."

#: src/cli/CommandsImages.cpp:653
#, kde-format
msgid ""
"--gamma has to be more than zero. Above 1 lifts the midtones, below 1 lowers "
"them."
msgstr ""
"--gamma tiene que ser mayor que cero. Por encima de 1 sube los tonos medios; "
"por debajo de 1 los baja."

#: src/cli/CommandsImages.cpp:673
#, kde-format
msgid ""
"Nothing to adjust. Try --brightness, --contrast, --gamma, --sharpen, --"
"despeckle, --auto-levels, --grayscale or --black-white."
msgstr ""
"No hay nada que ajustar. Pruebe --brightness, --contrast, --gamma, --"
"sharpen, --despeckle, --auto-levels, --grayscale o --black-white."

#: src/cli/CommandsImages.cpp:688 src/ui/ToolImagesDialog.cpp:1036
#, kde-format
msgid ""
"Worked over the pixels of %1 on page %2; it keeps its place and its size."
msgstr ""
"Se han retocado los píxeles de %1 en la página %2; conserva su lugar y su "
"tamaño."

#: src/cli/CommandsImages.cpp:707
#, kde-format
msgid ""
"Which part should stay? Give --keep-box X,Y,WIDTH,HEIGHT as fractions of the "
"picture, measured from its top-left corner, for example 0,0,1,0.5 for the "
"upper half."
msgstr ""
"¿Qué parte debe quedarse? Indique --keep-box X,Y,ANCHO,ALTO como fracciones "
"de la imagen, medidas desde su esquina superior izquierda, por ejemplo "
"0,0,1,0.5 para la mitad superior."

#: src/cli/CommandsImages.cpp:718
#, kde-format
msgid ""
"“%1” is not an area. The form is X,Y,WIDTH,HEIGHT as fractions, e.g. "
"0.1,0,0.8,1."
msgstr ""
"«%1» no es un área. El formato es X,Y,ANCHO,ALTO como fracciones, por "
"ejemplo 0.1,0,0.8,1."

#: src/cli/CommandsImages.cpp:725
#, kde-format
msgid "The area has to lie inside the picture, as fractions between 0 and 1."
msgstr ""
"El área tiene que estar dentro de la imagen, como fracciones entre 0 y 1."

#: src/cli/CommandsImages.cpp:738 src/ui/ToolImagesDialog.cpp:1081
#, kde-format
msgid "Cropped %1 on page %2. The part cut away has left the file."
msgstr ""
"Se ha recortado %1 en la página %2. La parte cortada ha salido del archivo."

#: src/cli/CommandsImages.cpp:765
#, kde-format
msgid "Where should the pictures go? Give --out-dir a folder."
msgstr "¿Dónde deben ir las imágenes? Dé una carpeta a --out-dir."

#: src/cli/CommandsImages.cpp:768 src/cli/main.cpp:1049
#, kde-format
msgid "“%1” could not be created."
msgstr "No se ha podido crear «%1»."

#: src/cli/CommandsImages.cpp:779
#, kde-format
msgid "“%1” is not a picture format this can write. Try png, jpg, tif or webp."
msgstr ""
"«%1» no es un formato de imagen que esto pueda escribir. Pruebe png, jpg, "
"tif o webp."

#: src/cli/CommandsImages.cpp:814
#, kde-format
msgctxt "@info"
msgid "Wrote one picture, %1."
msgstr "Se ha escrito una imagen, %1."

#: src/cli/CommandsImages.cpp:852
#, kde-format
msgctxt "@info"
msgid "Wrote %1 picture, %2 in all."
msgid_plural "Wrote %1 pictures, %2 in all."
msgstr[0] "Se ha escrito %1 imagen, %2 en total."
msgstr[1] "Se han escrito %1 imágenes, %2 en total."

#: src/cli/CommandsImages.cpp:855
#, kde-format
msgid ""
"Left %1 picture in the document: its pixels are stored in a form this cannot "
"open."
msgid_plural ""
"Left %1 pictures in the document: their pixels are stored in a form this "
"cannot open."
msgstr[0] ""
"Se ha dejado %1 imagen en el documento: sus píxeles están guardados en un "
"formato que esto no puede abrir."
msgstr[1] ""
"Se han dejado %1 imágenes en el documento: sus píxeles están guardados en un "
"formato que esto no puede abrir."

#: src/cli/CommandsImages.cpp:880
#, kde-format
msgid "No picture is stored more than once, so %1 is a copy of the original."
msgstr ""
"Ninguna imagen está guardada más de una vez, por lo que %1 es una copia del "
"original."

#: src/cli/CommandsImages.cpp:883
#, kde-format
msgid "Merged %1 duplicate into the picture it repeated, freeing %2."
msgid_plural ""
"Merged %1 duplicates into the pictures they repeated, freeing %2."
msgstr[0] ""
"Se ha combinado %1 duplicado con la imagen que repetía, liberando %2."
msgstr[1] ""
"Se han combinado %1 duplicados con las imágenes que repetían, liberando %2."

#: src/cli/CommandsImages.cpp:894
#, kde-format
msgid "Which picture, by the resource name “images list” shows."
msgstr "Qué imagen, por el nombre de recurso que muestra «images list»."

#: src/cli/CommandsImages.cpp:896
#, kde-format
msgid "The picture file to put in instead."
msgstr "El archivo de imagen que se pondrá en su lugar."

#: src/cli/CommandsImages.cpp:897
#, kde-format
msgid "Bring anything finer than this down to it, e.g. 150."
msgstr "Remuestrear a la baja todo lo que supere este valor, p. ej. 150."

#: src/cli/CommandsImages.cpp:900
#, kde-format
msgid "Fill the old place exactly instead of fitting the picture inside it."
msgstr ""
"Rellenar exactamente el lugar anterior en vez de ajustar la imagen dentro de "
"él."

#: src/cli/CommandsImages.cpp:903
#, kde-format
msgid ""
"The part of a picture to keep, as X,Y,WIDTH,HEIGHT in fractions from its top-"
"left corner."
msgstr ""
"La parte de una imagen que se conserva, como X,Y,ANCHO,ALTO en fracciones "
"desde su esquina superior izquierda."

#: src/cli/CommandsImages.cpp:904
#, kde-format
msgid "Brightness, -1 to 1."
msgstr "Brillo, de -1 a 1."

#: src/cli/CommandsImages.cpp:905
#, kde-format
msgid "Contrast, -1 to 1."
msgstr "Contraste, de -1 a 1."

#: src/cli/CommandsImages.cpp:906
#, kde-format
msgid "Gamma; above 1 lifts the midtones, below 1 lowers them."
msgstr ""
"Gamma; por encima de 1 aclara los medios tonos, por debajo de 1 los oscurece."

#: src/cli/CommandsImages.cpp:908
#, kde-format
msgid "Sharpen the picture."
msgstr "Enfocar la imagen."

#: src/cli/CommandsImages.cpp:909
#, kde-format
msgid "Take the specks out of a scan."
msgstr "Eliminar las motas de un escaneado."

#: src/cli/CommandsImages.cpp:910
#, kde-format
msgid "Spread the tones over the full range."
msgstr "Extender los tonos a todo el rango."

#: src/cli/CommandsImages.cpp:911
#, kde-format
msgid "Reduce the picture to black and white."
msgstr "Reducir la imagen a blanco y negro."

#: src/cli/CommandsImages.cpp:912
#, kde-format
msgid "Where black turns into white, 0 to 255."
msgstr "Dónde el negro se convierte en blanco, de 0 a 255."

#: src/cli/CommandsImages.cpp:931
#, kde-format
msgid "images needs to know what to do: %1."
msgstr "images necesita saber qué hacer: %1."

#: src/cli/CommandsImages.cpp:979
#, kde-format
msgid "“images %1” is not something this can do. Try %2."
msgstr "«images %1» no es algo que se pueda hacer. Pruebe %2."

#: src/cli/CommandsImages.cpp:987
#, kde-format
msgid "Every picture, with the resolution it really has"
msgstr "Todas las imágenes, con la resolución que tienen realmente"

#: src/cli/CommandsImages.cpp:988
#, kde-format
msgid "Re-encode the pictures, smaller"
msgstr "Volver a codificar las imágenes, más pequeñas"

#: src/cli/CommandsImages.cpp:989
#, kde-format
msgid "Bring anything finer than that down to it"
msgstr "Remuestrear a la baja todo lo que supere ese valor"

#: src/cli/CommandsImages.cpp:990
#, kde-format
msgid "Put another picture in the same place"
msgstr "Poner otra imagen en el mismo lugar"

#: src/cli/CommandsImages.cpp:991
#, kde-format
msgid "Turn one picture, without re-encoding it"
msgstr "Girar una imagen, sin volver a codificarla"

#: src/cli/CommandsImages.cpp:992
#, kde-format
msgid "Stop a page drawing one"
msgstr "Impedir que una página dibuje una imagen"

#: src/cli/CommandsImages.cpp:993
#, kde-format
msgid "Write the stored pictures out as they are"
msgstr "Escribir las imágenes almacenadas tal como están"

#: src/cli/CommandsImages.cpp:994
#, kde-format
msgid "Brightness, contrast, gamma, sharpen, despeckle"
msgstr "Brillo, contraste, gamma, enfoque, eliminación de motas"

#: src/cli/CommandsImages.cpp:995
#, kde-format
msgid "Cut pixels off one picture for good"
msgstr "Recortar píxeles de una imagen de forma definitiva"

#: src/cli/CommandsImages.cpp:996
#, kde-format
msgid "Merge pictures the file stores twice"
msgstr "Combinar las imágenes que el archivo almacena dos veces"

#: src/cli/CommandsImages.cpp:997
#, kde-format
msgid "What working on pictures cannot promise"
msgstr "Lo que el trabajo con imágenes no puede garantizar"

#: src/cli/CommandsLayout.cpp:249 src/cli/CommandsLayout.cpp:322
#, kde-format
msgid "“%1” has no pages."
msgstr "«%1» no tiene páginas."

#: src/cli/CommandsLayout.cpp:263
#, kde-format
msgctxt ""
"@info a page box: its corner, then its size in points and in millimetres"
msgid "%1, %2   %3 × %4 pt   (%5 × %6 mm)"
msgstr "%1, %2   %3 × %4 pt   (%5 × %6 mm)"

#: src/cli/CommandsLayout.cpp:342
#, kde-format
msgctxt "@title heading before the boxes of one page"
msgid "Page %1"
msgstr "Página %1"

#: src/cli/CommandsLayout.cpp:347 src/ui/ToolLayoutDialog.cpp:149
#, kde-format
msgctxt "@info a page box this page does not have at all"
msgid "absent"
msgstr "ausente"

#: src/cli/CommandsLayout.cpp:375
#, kde-format
msgid ""
"“%1” is not a box. Give X,Y,WIDTH,HEIGHT in points from the bottom-left "
"corner, or “none” to take the box away."
msgstr ""
"«%1» no es un recuadro. Indique X,Y,ANCHO,ALTO en puntos desde la esquina "
"inferior izquierda, o «none» para quitar el recuadro."

#: src/cli/CommandsLayout.cpp:381
#, kde-format
msgid ""
"A page without a /MediaBox is not a page, so --media-box cannot be “none”."
msgstr ""
"Una página sin /MediaBox no es una página, así que --media-box no puede ser "
"«none»."

#: src/cli/CommandsLayout.cpp:387
#, kde-format
msgid ""
"layout set-boxes needs at least one of --media-box, --crop-box, --bleed-box, "
"--trim-box or --art-box."
msgstr ""
"layout set-boxes necesita al menos una de las opciones --media-box, --crop-"
"box, --bleed-box, --trim-box o --art-box."

#: src/cli/CommandsLayout.cpp:404
#, kde-format
msgid "Setting %1. These are taken away where the pages have them: %2."
msgstr "Se establece %1. Estos se quitan de las páginas que los tienen: %2."

#: src/cli/CommandsLayout.cpp:414
#, kde-format
msgctxt "@info"
msgid "Wrote the boxes of %1 page to %2."
msgid_plural "Wrote the boxes of %1 pages to %2."
msgstr[0] "Se han escrito los recuadros de %1 página en %2."
msgstr[1] "Se han escrito los recuadros de %1 páginas en %2."

#: src/cli/CommandsLayout.cpp:431
#, kde-format
msgid ""
"layout resize needs a paper size (--size), for example a4, letter or "
"210x297mm."
msgstr ""
"layout resize necesita un tamaño de papel (--size), por ejemplo a4, letter o "
"210x297mm."

#: src/cli/CommandsLayout.cpp:436 src/cli/CommandsLayout.cpp:483
#: src/cli/CommandsLayout.cpp:692
#, kde-format
msgid ""
"“%1” is not a paper size. Try a4, a3, a5, letter, legal, or WIDTHxHEIGHT "
"with mm, cm, in or pt after it."
msgstr ""
"«%1» no es un tamaño de papel. Pruebe a4, a3, a5, letter, legal o "
"WIDTHxHEIGHT seguido de mm, cm, in o pt."

#: src/cli/CommandsLayout.cpp:444 src/cli/CommandsLayout.cpp:491
#, kde-format
msgid "“%1” is not a way to fit. Use scale, centre or shrink."
msgstr "«%1» no es una forma de ajustar. Use scale, centre o shrink."

#: src/cli/CommandsLayout.cpp:460
#, kde-format
msgctxt "@info"
msgid "Resized %1 page to %2 × %3 mm."
msgid_plural "Resized %1 pages to %2 × %3 mm."
msgstr[0] "Se ha cambiado el tamaño de %1 página a %2 × %3 mm."
msgstr[1] "Se ha cambiado el tamaño de %1 páginas a %2 × %3 mm."

#: src/cli/CommandsLayout.cpp:476
#, kde-format
msgid "layout unify works on the whole document; leave --pages off."
msgstr "layout unify actúa sobre todo el documento; no use --pages."

#: src/cli/CommandsLayout.cpp:502
#, kde-format
msgid "Brought every page to one size. Wrote %1."
msgstr "Se han igualado todas las páginas a un mismo tamaño. Se ha escrito %1."

#: src/cli/CommandsLayout.cpp:514
#, kde-format
msgid ""
"layout bleed needs a bleed (--bleed), in millimetres. Three is the usual "
"answer."
msgstr ""
"layout bleed necesita un sangrado (--bleed), en milímetros. Lo habitual son "
"tres."

#: src/cli/CommandsLayout.cpp:520 src/cli/CommandsLayout.cpp:568
#: src/cli/CommandsLayout.cpp:574 src/cli/CommandsLayout.cpp:700
#, kde-format
msgid ""
"“%1” is not a length. Give millimetres, or a number with mm, cm, in or pt "
"after it."
msgstr ""
"«%1» no es una longitud. Indique milímetros, o un número seguido de mm, cm, "
"in o pt."

#: src/cli/CommandsLayout.cpp:537
#, kde-format
msgctxt "@info"
msgid "Gave %1 page a %2 mm bleed."
msgid_plural "Gave %1 pages a %2 mm bleed."
msgstr[0] "Se ha dado a %1 página un sangrado de %2 mm."
msgstr[1] "Se ha dado a %1 páginas un sangrado de %2 mm."

#: src/cli/CommandsLayout.cpp:540
#, kde-format
msgid ""
"The trim is what the pages showed before; the sheet grew where it had to. "
"Wrote %1."
msgstr ""
"El recorte es lo que las páginas mostraban antes; la hoja ha crecido donde "
"hacía falta. Se ha escrito %1."

