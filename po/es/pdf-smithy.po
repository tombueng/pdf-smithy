msgstr "Indique la familia que se va a incrustar."

#: src/ui/ToolFontsDialog.cpp:1023
#, kde-format
msgid ""
"Name the characters to put in. Only those go in, which is what keeps the "
"document from growing by a whole font."
msgstr ""
"Indique los caracteres que se van a añadir. Solo entran esos, que es lo que "
"evita que el documento crezca en un tipo de letra entero."

