#, kde-format
msgctxt "@action:inmenu undo step"
msgid "Move page"
msgid_plural "Move %1 pages"
msgstr[0] "Mover página"
msgstr[1] "Mover %1 páginas"

#: src/core/commands/PageCommands.cpp:129
#, kde-format
msgctxt "@action:inmenu undo step"
msgid "Rotate page"
