msgstr ""
"«%1» no es una lista de marcas. Use crop, registration, colour-bar, page-"
"info o all, separados por comas."

#: src/cli/CommandsLayout.cpp:580
#, kde-format
msgid ""
"“%1” is not a length. Give points, or a number with mm, cm, in or pt after "
"it."
msgstr ""
"«%1» no es una longitud. Indique puntos, o un número seguido de mm, cm, in o "
"pt."

#: src/cli/CommandsLayout.cpp:594 src/ui/ToolLayoutDialog.cpp:909
#, kde-format
msgctxt "@item a kind of printer's mark"
msgid "crop marks"
msgstr "marcas de corte"

