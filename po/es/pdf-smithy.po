#: src/cli/CommandsImages.cpp:356
#, kde-format
msgid ""
"%1 of them sits above %2 dpi and holds %3, more than any printer will show."
msgid_plural ""
"%1 of them sit above %2 dpi and hold %3, more than any printer will show."
msgstr[0] ""
"%1 de ellas está por encima de %2 dpi y ocupa %3, más de lo que mostrará "
