msgstr "Ghostscript ha informado de un error."

#: src/core/Archival.cpp:718
#, kde-format
msgid "Converting produced an empty file."
msgstr "La conversión ha producido un archivo vacío."

#: src/core/Archival.cpp:727
#, kde-format
msgid ""
"Some colours could not be converted to a device-independent space, so a "
"strict check may object to them."
msgstr ""
"Algunos colores no se han podido convertir a un espacio independiente del "
"dispositivo, así que una comprobación estricta puede reprocharlos."

#: src/core/Archival.cpp:735 src/core/Compressor.cpp:309
