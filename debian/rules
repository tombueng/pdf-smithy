#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DBUILD_TESTING=ON

# Run the GUI tests headless on Qt's offscreen platform: no X server is needed,
# and the window size no longer rides on a physical screen. An xvfb screen that
# was a touch too narrow pushed a mode's toolbar past its width and tripped the
# tst_workmode overflow check; offscreen gives the window room and the whole
# suite passes.
#
# fc-cache first: the form and text tests resolve faces like "Liberation Sans"
# through fontconfig, and in a clean build environment the cache is not always
# built by the time the suite runs — an uncached lookup then returns nothing and
# the test sees an empty font family. Building it here is harmless when it is
# already current. The echo leaves the resolved face in the build log, so if a
# font ever does go missing the log says so outright.
override_dh_auto_test:
	fc-cache -f || true
	@echo "preflight: fontconfig resolves Liberation Sans to: $$(fc-match 'Liberation Sans' 2>&1 || echo '<none>')"
	QT_QPA_PLATFORM=offscreen dh_auto_test
